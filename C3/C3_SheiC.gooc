#gool SheiC 2 3 // Type 75

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 2 -r pal "C3\C3_SheiC.gooc" "C3\Out\C3_SheiC.nsentry"

#anim SHIELD_GUY_1       [Sg1mV] 41 1
#anim SHIELD_GUY_2       [Sg2mV] 7 1
#anim SHIELD_GUY_3       [Sg3mV] 7 1
#anim SHIELD_GUY_4       [Sg4mV] 7 1
#anim SHIELD_GUY_5       [Sg5mV] 7 1
#anim SHIELD_GUY_6       [Sg6mV] 7 1
#anim SHIELD_GUY_7       [Sg7mV] 7 1
 
#spawn S_SHIELD_GUY      Shield_Guy_Init

event EventHit           => state Shield_Guy_Squash
event EventHitInvincible => state Shield_Guy_Squash
event EventFling         => state Shield_Guy_Fling

var ShieldFrame, ShieldBaseZ, ShieldVar3, ShieldVar4, ShieldAngle

state Shield_Guy_Init { // 0
    code(yaw) {
        statusb = FLAG_ROT_Y | FLAG_COLLIDABLE | FLAG_SOLID_ALL
        zindex = 24
        trotx = 360deg
        ShieldAngle = yaw
        ShieldBaseZ = z
        ShieldVar4 = 0
        ShieldVar3 = 0
        ShieldTrans()
        roty = troty
        setanim(SHIELD_GUY_1, 20.0)
        changestate(Shield_Guy)
    }
}

state Shield_Guy { // 1
    statusc 0x0
    code() {
        sleepframe(seek(animframe, 20.0, 1.0))
    }
    trans {
        changestateif(Shield_Guy_Trace, distance(player, DIST_NO_Y) < 12m, animframe)
        changestateif(Shield_Guy_Peek, !(time(5s)) && animseq == getanim(SHIELD_GUY_1) && animframe == 20.0)
    }
}

state Shield_Guy_Peek { // 2
    statusc 0x0
    code() {
        save(animframe, animseq) {
            playanim(0, SHIELD_GUY_7)
            playanim(1, SHIELD_GUY_7)
            playanim(2, SHIELD_GUY_7)
            playanim(3, SHIELD_GUY_7)
            playanim(3, SHIELD_GUY_7)
            playanim(4, SHIELD_GUY_7)
            playanim(5, SHIELD_GUY_7)
            playframe(animframe, 0.4s)
            playframesback(SHIELD_GUY_7, 6.0, 0.0)
        }
        changestate(Shield_Guy)
    }
}

state Shield_Guy_Trace { // 3
    stateflag 0x4004001
    statusc 0x0
    trans => sub ShieldTrans
    code(frame) {
        setanim(SHIELD_GUY_1, frame)
        var c, s, player_dx, player_dz, player_relx, player_relz
        do {
            c = cos(troty)
            s = sin(troty)
            player_dx = player -> x - x
            player_dz = z - player -> z
            player_relx = (player_dz * s >> 12) + (player_dx * c >> 12)
            player_relz = (player_dz * c >> 12) - (player_dx * s >> 12)
            v0 = player_relx / 1m
            if (v0 == -4 || v0 == -3 || v0 == -2) {
                ShieldFrame = 0.0
            }
            else if (v0 == -1) {
                ShieldFrame = 10.0
            }
            else if (v0 == 0) {
                ShieldFrame = 20.0
            }
            else if (v0 == 1) {
                ShieldFrame = 30.0
            }
            else if (v0 == 4 || v0 == 3 || v0 == 2) {
                ShieldFrame = 40.0
            }
            if (animframe == ShieldFrame) {
                if (distance(player, DIST_NO_Y) > 12m) {
                    changestate(Shield_Guy)
                }
                else {
                    changestateif(Shield_Guy_Raise, player -> y > y + 2.5m && abs(player_relz) < 3m)
                }
            }
            if (distance(player) > 10m) {
                playframe(seek(animframe, ShieldFrame, 1.0))
            }
            else {
                playframe(seek(animframe, ShieldFrame, 2.0))
            }
        } while (1)
    }
    event(e, a) {
        if (e == EventSpinHit && interrupter == player && player -> statusb \ 0x80) {
            save(velx, vely, velz, troty) {
                troty = atan2(player -> trans)
                interrupter -> speed = 6m
                interrupter -> troty = atan2(player -> trans)
                setvel(6m)
                interrupter -> velx = velx
                interrupter -> vely = vely
                interrupter -> velz = velz
                interrupter -> statusb &= ~FLAG_DPAD_CONTROL
            }
        }
        accevcstate(Shield_Guy_Fling, e == EventSlideHit)
    }
}

sub ShieldTrans() {
    if (abs(degdist(ShieldAngle, atan2(player -> trans))) > 90deg) {
        troty = ShieldAngle + 180deg
    }
    else {
        troty = ShieldAngle
    }
    if (collider) {
        sendevent(Event32, player, troty, 14m)
        if (eventaccepted) {
            SoundPitchDefault()
            soundplay([Sg1mA], 1V)
            ShieldVar4 = 4m
        }
    }
}

inline sub PlayShieldFrames(anim) {
    playanim(0, anim)
    playanim(1, anim)
    playanim(2, anim)
    playanim(3, anim)
    playanim(3, anim)
    playanim(4, anim)
    playanim(5, anim)
}

state Shield_Guy_Raise { // 4
    stateflag 0x4004041
    statusc 0x0
    code() {
        var frame = animframe
        if (animframe == 0) {
            PlayShieldFrames(SHIELD_GUY_2)
        }
        else if (animframe == 10.0) {
            PlayShieldFrames(SHIELD_GUY_3)
        }
        else if (animframe == 20.0) {
            PlayShieldFrames(SHIELD_GUY_4)
        }
        else if (animframe == 30.0) {
            PlayShieldFrames(SHIELD_GUY_5)
        }
        else if (animframe == 40.0) {
            PlayShieldFrames(SHIELD_GUY_6)
        }
        while (player -> stateflag \ 0x8) {
            playframe()
        }
        playframesback(animframe, 0.0)
        changestate(Shield_Guy_Trace, frame)
    }
    event(e, a) {
        if (interrupter == player && (e == EventSlamHit || e == EventJumpedOn)) {
            sendevent(Event21, interrupter, 8.945m)
            rejevret(eventaccepted)
        }
        accevcstate(Shield_Guy_Fling, e == EventSlideHit || e == EventSpinHit)
    }
}

state Shield_Guy_Fling { // 5
    stateflag 0x30
    statusc 0x32
    code(h) {
        EnemyFlingCombo(h)
        EnemyFlingSetDir()
        EnemyFlingSetVel(3m)
        EnemyFlingWaitScale()
    } 
    trans {
        EnemyFlingTrans(2m, EventFling)
    }
}

state Shield_Guy_Squash { // 6
    stateflag 0x23
    statusc 0x32
    code(h) {
        entitysetspawn(0)
        sendevent(EventCombo, player, h)
        EnemyDieClearFlags()
        playframe()
        spawn(9, 4, 1, getins(SetParticleColor), 1)
        playframe()
    }
}

sub SetParticleColor() {
    vfx = (vfx & 0xFFFF00FF) | 3.0
    if (var r = rand(3); r == 0) {
        SetColor1(0x05, 0xBD, 0xBE)
    }
    else if (r == 1) {
        SetColor1(0x0D, 0x4C, 0x4C)
    }
    else if (r == 2) {
        SetColor1(0xE7, 0x85, 0x81)
    }
}