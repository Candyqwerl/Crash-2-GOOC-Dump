#gool FflOC 57 5

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 2 -r pal "C3\C3_FflOC.gooc" "C3\Out\C3_FflOC.nsentry"

#anim FIREFLY [JuFAV] 12 0

#sprite DUST_PARTICLE[Cr10T]
#tex 0x808080 0 3 0 9 768 96 32 32

#anim NIGHT_SHADOW[ShacV] 1 1

#sprite FLARES[Eg1AT]
#tex 0xC0C0C0 0 3 4 7 336 16 16 16
#tex 0x808080 0 3 4 7 336 16 16 16
#tex 0xC0C0C0 1 3 5 4 192 64 64 64
#tex 0x808080 0 3 6 7 832 64 32 32
#tex 0xD0D0D0 0 3 6 7 832 64 32 32
#tex 0xC0C0C0 0 3 4 7 336 16 16 16
#tex 0xC0C0C0 0 3 8 7 352 16 16 16
#tex 0xC0C0C0 0 3 9 7 256 64 64 64
#tex 0xC0C0C0 0 3 10 7 832 32 32 32

#spawn S_0                __s_0
#spawn S_FIREFLY          Firefly_Init
#spawn S_2                __s_2
#spawn S_3                __s_3
#spawn S_FLARE_MASTER     Flare_Master
#spawn S_FLARE_SLAVE      Flare_Slave
#spawn S_GLOW             Firefly_Glow
#spawn S_FIREFLY_PATH     Firefly_Path_Init

var Lifetime, HasTarget, TargetX, TargetY, TargetZ, FireflyID, BonusFlag, CollectionFrame, LightSourceRegistered, DetachWarningStart, OrbitYOff,
    DetachGroundY, FireflyBaseY, FireflyBaseX, IdleBobAmpY, IdleBobAmpX, FlyAwaySpeed, OrbitPitch, TargetOrbitPitch, OrbitYaw, OrbitYawSpeed,
    OrbitRadius, TargetOrbitRadius, PathBobOffset, PathBobVelocity, NextBobTime, CanFollowPath, FlarePulse, FlareAlpha, GlowAlpha, FlareScreenAngle, RotateFlare

// Replace stateflag bits 0x10000 with 0x40000 if using in c2

state Firefly_Init { // 0
    code(lifetime, lifetime_override, has_target, target_x, target_y, target_z, index, bonus_flag, y_off) {
        vfx = (vfx & 0xFFFFFF00) | 0x600
        Lifetime = lifetime * 1s / 1.2s
        if (lifetime_override >= 0) {
            Lifetime = lifetime_override * 1s / 1.2s
        }
        HasTarget = has_target
        TargetX = target_x
        TargetY = target_y
        TargetZ = target_z
        FireflyID = index
        BonusFlag = bonus_flag
        y += y_off
        LightSourceRegistered = 0
        if (FireflyID && GLOBAL_126 & (1 << FireflyID)) {
            return
        }
        FlarePulse = 16.0
        spawn(FflOC, S_FLARE_MASTER, 1)
        DetachWarningStart = Lifetime - 62
        trotx = 180deg
        playnull()
        RegisterLightSource()
        changestate(Firefly_Idle)
    }
    event(e, a) {
        if (e == EventDespawn) {
            accev()
            KillLightSource()
        }
        if (e == EventRespawn) {
            miscfunc(x, player, 0, 9)
            KillLightSource()
            accevcstate(Firefly_Kill)
        }
    }
}

sub UpdateFireflyRotation() {
    var v1, yaw, v3
    var local_z = velz
    var local_x = velx
    var neg_yaw
    yaw = atan(local_x, local_z)
    neg_yaw = -yaw
    yaw &= 0xFFF
    var flat_spd = (((local_z >> 8) * cos(neg_yaw)) >> 4) - (((local_x >> 8) * sin(neg_yaw)) >> 4)
    rotx = -(atan(vely, flat_spd) & 0xFFF)
    rotz = yaw
    roty = yaw
}

sub RegisterLightSource() {
    if (!LightSourceRegistered) {
        if (GLOBAL_54) {
            if (!GLOBAL_120) {
                GLOBAL_120 = self
                LightSourceRegistered = 1
            }
        }
        else {
            GLOBAL_54 = self
            LightSourceRegistered = 1
        }
        if (LightSourceRegistered) {
            if (GLOBAL_54) {
                if (GLOBAL_120) {
                    GLOBAL_55 = 2.0
                }
                else {
                    GLOBAL_55 = 1.0
                }
            }
            else if (GLOBAL_120) {
                GLOBAL_54 = GLOBAL_120
                GLOBAL_120 = 0
                GLOBAL_55 = 1.0
            }
            else {
                GLOBAL_55 = 0
            }
        }
    }
}

sub DeregisterLightSource() {
    if (LightSourceRegistered) {
        LightSourceRegistered = 0
        if (GLOBAL_54 == self) {
            GLOBAL_54 = 0
        }
        if (GLOBAL_120 == self) {
            GLOBAL_120 = 0
        }
        if (GLOBAL_54) {
            if (GLOBAL_120) {
                GLOBAL_55 = 2.0
            }
            else {
                GLOBAL_55 = 1.0
            }
        }
        else if (GLOBAL_120) {
            GLOBAL_54 = GLOBAL_120
            GLOBAL_120 = 0
            GLOBAL_55 = 1.0
        }
        else {
            GLOBAL_55 = 0
        }
    }
}

sub RegisterFireflyCollection() {
    if (FireflyID) {
        entitysetstate(8)
        GLOBAL_126 |= 1 << FireflyID
        id = 0
    }
    else {
        entitysetspawn(0)
    }
}

state Firefly_Idle { // 1
    event => state Firefly_Init
    code() {
        statusb = FLAG_ROT_Y | FLAG_COLLIDABLE
        sleepframes(FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            FireflyBaseY = y
            FireflyBaseX = x
        }
        if (!LightSourceRegistered) {
            RegisterLightSource()
        }
        var0 = ((frametime & 31) << 14) >> 8
        if (var0 > 90deg) {
            var0 = 180deg - var0
        }
        rotx = var0 - 45deg

        var0 = (((frametime + 7) & 31) << 14) >> 8
        if (var0 > 90deg) {
            var0 = 180deg - var0
        }
        var0 -= 45deg
        if ((var0 > 0deg && y < FireflyBaseY) || (var0 < 0deg && FireflyBaseY < y) || y == FireflyBaseY) {
            IdleBobAmpY = rand(0.6m) + 0.4m
        }
        y = FireflyBaseY + ((sin(var0) * (IdleBobAmpY >> 4)) >> 8)

        var0 = (time(32) * 0x7E07) >> 8
        if (var0 > 180deg) {
            var0 = 360deg - var0
        }
        var0 -= 90deg
        if ((var0 > 0deg && x < FireflyBaseX) || (var0 < 0deg && FireflyBaseX < x) || x == FireflyBaseX) {
            IdleBobAmpX = rand(0.3m) + 0.2m
        }
        x = FireflyBaseX + ((sin(var0) * (IdleBobAmpX >> 4)) >> 8)
        troty = atan2(player -> trans)
        rotz = roty
        changestateif(Firefly_Attached, collider || (abs(x - player -> x) < 1.2m && abs(z - player -> z) < 1.2m && abs(y - player -> y) < 1.5m))
    }
}

state Firefly_Attached { // 2
    stateflag 0x10001 
    statusc 0x0
    event => state Firefly_Init
    code() {
        sleepframes(FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            RegisterFireflyCollection()
            CollectionFrame = frametime
            OrbitYOff = 0.75m
            statusb = FLAG_ROT_Y
            vecx = x - player -> x
            vecy = y - (player -> y + OrbitYOff)
            vecz = z - player -> z
            {
                var orbit_z = vecz
                var orbit_x = vecx
                var neg_yaw = 0
                OrbitYaw = atan(orbit_x, orbit_z)
                neg_yaw = -OrbitYaw
                OrbitYaw &= 0xFFF
                var flat_spd = (((orbit_z >> 8) * cos(neg_yaw)) >> 4) - (((orbit_x >> 8) * sin(neg_yaw)) >> 4)
                OrbitPitch = atan(vecy, flat_spd) & 0xFFF
                var0 = 0s
            }
            if (OrbitPitch > 180deg) {
                OrbitPitch = 0deg
            }
            OrbitRadius = distance(player, DIST_EXACT)
            if (OrbitRadius < 1.5m) {
                OrbitRadius = 1.5m
            }
            TargetOrbitRadius = OrbitRadius
            TargetOrbitPitch = OrbitPitch
            OrbitYawSpeed = 60deg
        }
        if (!LightSourceRegistered) {
            RegisterLightSource()
        }
        if (OrbitRadius == TargetOrbitRadius) {
            TargetOrbitRadius = 1.5m + rand(1.6m)
        }
        OrbitRadius = seek(OrbitRadius, TargetOrbitRadius, 215.95deg)
        if (OrbitPitch == TargetOrbitPitch) {
            if (frametime - CollectionFrame >= DetachWarningStart) {
                TargetOrbitPitch = rand(10deg) - 60deg
            }
            else {
                TargetOrbitPitch = rand(80deg) + 15deg
            }
        }
        OrbitPitch = degseek(OrbitPitch, TargetOrbitPitch, 45deg)
        OrbitYaw = (OrbitYaw + OrbitYawSpeed) & 0xFFF
        OrbitYawSpeed = seek(OrbitYawSpeed, 16.8deg, 1deg)
        {
            var oldx = x, oldy = y, oldz = z
            trotx = -OrbitPitch
            trotz = OrbitYaw
            troty = OrbitYaw
            vecx = player -> x
            vecy = player -> y + OrbitYOff
            vecz = player -> z
            vectransf2(vvec, vtrans, OrbitRadius, 0, 0)
            velx = ((x + (player -> velx >> 3)) - oldx) >> 2
            vely = ((y + (player -> vely >> 5)) - oldy) >> 2
            velz = ((z + (player -> velz >> 3)) - oldz) >> 2
            x = oldx + velx
            y = oldy + vely
            z = oldz + velz
            UpdateFireflyRotation()
            var0 = frametime - CollectionFrame
        }
        if (var0 >= DetachWarningStart) {
            OrbitYOff = seek(OrbitYOff, 2.5m, 0.14m)
        }
        changestateif(Firefly_Detached, var0 >= Lifetime)
    }
}

state Firefly_Detached { // 3
    stateflag 0x10001 
    statusc 0x0
    event => state Firefly_Init
    code() {
        sleepframes(FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            projectzoneshadow(var0)
            if (eventaccepted) {
                DetachGroundY = vecy
                var0 = vecy - player -> y
                if (var0 > 0) {
                    if (var0 > 4m) {
                        DetachGroundY = player -> y
                    }
                }
                else if (var0 < -2m) {
                    DetachGroundY = player -> y
                }
            }
            else {
                DetachGroundY = player -> y
            }
            FireflyBaseY = y - DetachGroundY
            FlyAwaySpeed = 0.4m
            if (HasTarget) {
                if (BonusFlag) {
                    if (TargetX < x) {
                        HasTarget = 0
                    }
                }
                else {
                    if (z < TargetZ) {
                        HasTarget = 0
                    }
                    if (z - TargetZ > 60m) {
                        HasTarget = 0
                    }
                }
            }
            if (BonusFlag) {
                if (!HasTarget) {
                    TargetX = player -> x + 20m
                    TargetY = player -> y
                    TargetZ = player -> z + 15m
                }
            }
            else if (!HasTarget) {
                TargetX = player -> x
                TargetY = player -> y
                TargetZ = player -> z - 20m
            }
        }
        {
            var dx, dz, v3
            dx = TargetX - x
            dz = TargetZ - z
            changestateif(Firefly_Vanish, abs(dx) + abs(dz) <= (FlyAwaySpeed << 1))
            while (abs(dx) >= 128.0 || abs(dz) >= 128.0) {
                dx >>= 6
                dz >>= 6
            }
            velx = (((FlyAwaySpeed >> 8) * dx) / (abs(dx) + abs(dz))) << 8
            velz = (((FlyAwaySpeed >> 8) * dz) / (abs(dx) + abs(dz))) << 8
        }
        FireflyBaseY = seek(FireflyBaseY, 1m, 0.16m)
        {
            var old_ground_y = DetachGroundY
            projectzoneshadow(var0)
            if (eventaccepted) {
                DetachGroundY = vecy
                var0 = vecy - old_ground_y
                if (var0 > 0m) {
                    if (var0 > 4m) {
                        DetachGroundY = old_ground_y + 0.1m
                    }
                }
                else if (var0 < -3m) {
                    DetachGroundY = old_ground_y - 0.1m
                }
            }
            else {
                DetachGroundY = old_ground_y
            }
            vely = ((DetachGroundY + FireflyBaseY) - y) >> 3
            x += velx
            y += vely
            z += velz
        }
        UpdateFireflyRotation()
        FlyAwaySpeed = seek(FlyAwaySpeed, 1m, 16.0)
    }
}

state Firefly_Vanish { // 4
    stateflag 0x10002
    event => state Firefly_Init
    code() {
        statusb = FLAG_PHYSICS_ENGINE
        do (var loops = 0) {
            playframes(FIREFLY, 0.0, 11.0)
        } while ({ loops += 1.0 }; loops < 3.0)
        KillLightSource()
        playnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            if (BonusFlag) {
                vely = 4m
                velx = 25m
                velz = -(4m + rand(4m))
                if (rand(2)) {
                    velz = -velz
                }
            }
            else {
                vely = 4m
                velz = -25m
                velx = 4m + rand(4m)
                if (rand(2)) {
                    velx = -velx
                }
            }
        }
        UpdateFireflyRotation()
    }
}

state Firefly_Kill { // 5
    code => sub KillLightSource
}

sub KillLightSource() {
    DeregisterLightSource()
}

state Flare_Master { // 6
    stateflag 0x10001 
    code() {
        vfx = (vfx & 0xFFFFFF00) | 0x6
        SetScale(0xA3, 0xA2, 0x1000)
        spawn(FflOC, S_FLARE_SLAVE, 1, 1.0, -3.0, 0.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 2.0, -2.0, 1.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 3.0, 2.0, 3.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 4.0, 2.2, 4.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 5.0, 6.0, 5.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 6.0, 8.0, 6.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 7.0, 11.0, 7.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 8.0, 12.0, 8.0)
        spawn(FflOC, S_GLOW, 1, 2.0)
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            SetRot(0deg)
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        // Native reads creator -> FlarePulse here then discards the value, same dead read as c2
        zindex = creator -> zindex
        FlarePulse = (16.0 * time(12)) / 12
        if (FlarePulse >= 8.0) {
            FlarePulse = 16.0 - FlarePulse
        }
        FlarePulse += 8.0
        FlareAlpha = 0
        GlowAlpha = 0
        {
            var camdx = (x - CAMTRANSX) >> 8
            var camdz = (z - CAMTRANSZ) >> 8
            var neg_yaw = -CAMROTY
            var depth = 0
            depth = ((camdx * sin(neg_yaw)) >> 4) - ((camdz * cos(neg_yaw)) >> 4)
            var0 = depth
            if (var0 >= 0m) {
                var0 -= 12m
                if (var0 < 0m) {
                    var0 = 0m
                }
                if (var0 <= 14m) {
                    GlowAlpha = (((14m - var0) >> 8) * 10.0) / 0x15E0
                }
            }
            var0 = depth
            if (var0 >= 0m) {
                var0 -= 4m
                if (var0 < 0m) {
                    var0 = 0m
                }
                if (var0 <= 12m) {
                    FlareAlpha = (((12m - var0) >> 8) << 10) / 0x12C0
                }
            }
            zindex = (zindex - (depth >> 13)) + 24
            FlareAlpha = (FlarePulse * FlareAlpha) >> 12
            GlowAlpha = (FlarePulse * GlowAlpha) >> 12
        }
        if (FlareAlpha || GlowAlpha) {
            moveto2d(null, 0, 0)
            FlareScreenAngle = atan(y, x)
            velx = (((-x) << 1) + (((-x) << 1) >> 2)) / 12
            vely = (((-y) << 1) + (((-y) << 1) >> 2)) / 12
        }
    }
}

state Flare_Slave { // 7
    stateflag 0x10001 
    __transargs
    code(type, offset, frame) {
        SetRot(0deg)
        do {
            if (FlareAlpha) {
                setanim(FLARES)
                playframe(frame)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            setanim(FLARES)
            vfx = (vfx & 0xFFFFFF00) | 0x6
            RotateFlare = 0
            if (type == 0) {
                scalex = 0x40E
                scaley = 0x40E
            }
            else if (type == 1.0) {
                scalex = 0x103
                scaley = 0x103
                RotateFlare = 1
            }
            else if (type == 2.0) {
                scalex = 0x103
                scaley = 0x103
                RotateFlare = 1
            }
            else if (type == 3.0) {
                scalex = 0x207
                scaley = 0x207
            }
            else if (type == 4.0) {
                scalex = 0x103
                scaley = 0x103
            }
            else if (type == 5.0) {
                scalex = 0x81
                scaley = 0x81
            }
            else if (type == 6.0) {
                scalex = 0x103
                scaley = 0x103
            }
            else if (type == 7.0) {
                scalex = 0x40E
                scaley = 0x40E
            }
            else if (type == 8.0) {
                scalex = 0x207
                scaley = 0x207
            }
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        velx = creator -> velx
        vely = creator -> vely
        velz = creator -> velz
        FlareAlpha = creator -> FlareAlpha
        FlareScreenAngle = creator -> FlareScreenAngle
        zindex = creator -> zindex
        if (FlareAlpha) {
            x += (velx * offset) >> 8
            y += (vely * offset) >> 8
            if (RotateFlare) {
                rotz = FlareScreenAngle + 45deg
            }
            moda = 16.0 - FlareAlpha
        }
    }
}

state Firefly_Glow { // 8
    stateflag 0x10001 
    code(frame) {
        SetRot(0deg)
        do {
            if (GlowAlpha) {
                setanim(FLARES)
                playframe(frame)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            animseq = getanim(FLARES)
            vfx = (vfx & 0xFFFFFF00) | 0x6
            scalex = 0x40E
            scaley = 0x40E
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        GlowAlpha = creator -> GlowAlpha
        zindex = creator -> zindex
        if (GlowAlpha) {
            moda = 16.0 - GlowAlpha
        }
    }
}

state Firefly_Path_Init { // 9
    code() {
        LightSourceRegistered = 0
        FlarePulse = 16.0
        spawn(FflOC, S_FLARE_MASTER, 1)
        trotx = 180deg
        playnull()
        RegisterLightSource()
        PathBobOffset = 0
        PathBobVelocity = 0
        NextBobTime = frametime + rand(50)
        OrbitYaw = 0
        OrbitRadius = 0.65m
        TargetOrbitRadius = OrbitRadius
        changestate(Firefly_Path_Wait)
    }
    event(e, a) {
        if (e == EventDespawn) {
            accev()
            KillLightSource()
        }
        if (e == EventRespawn) {
            KillLightSource()
            accevcstate(Firefly_Kill)
        }
    }
}

sub FireflyPathMotion() {
    var oldx = x, oldy = y, oldz = z
    calcpath(pathprog)
    if (frametime >= NextBobTime) {
        PathBobVelocity += (rand(1.6m) + 0.9m) / 25
        NextBobTime = frametime + (rand(22) + 5)
    }
    {
        var oldbob = PathBobOffset
        if (PathBobVelocity || PathBobOffset == 0) {
            PathBobVelocity -= PathBobOffset / 25
            PathBobOffset += PathBobVelocity
            if (oldbob >= 0) {
                if (PathBobOffset < 1) {
                    PathBobVelocity -= PathBobVelocity >> 3
                }
            }
            else if (PathBobOffset >= 0) {
                PathBobVelocity -= PathBobVelocity >> 3
            }
        }
        y += PathBobOffset + 0.6m
    }
    if (!CanFollowPath) {
        x += (cos(OrbitYaw) * OrbitRadius) >> 12
    }
    z += (sin(OrbitYaw) * OrbitRadius) >> 12
    OrbitYaw = (OrbitYaw + 0xA3) & 0xFFF
    OrbitRadius = seek(OrbitRadius, TargetOrbitRadius, 0x4CC)
    velx = (x - oldx) >> 2
    vely = (y - oldy) >> 2
    velz = (z - oldz) >> 2
    x = oldx + velx
    y = oldy + vely
    z = oldz + velz
    UpdateFireflyRotation()
}

state Firefly_Path_Wait { // 10
    event => state Firefly_Path_Init
    code() {
        statusb = 0
        sleepframes(FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            pathprog = 0
            CanFollowPath = false
        }
        if (!LightSourceRegistered) {
            RegisterLightSource()
        }
        changestateif(Firefly_Path_Active, x - player -> x < 3.75m)
        FireflyPathMotion()
    }
}

state Firefly_Path_Active { // 11
    event => state Firefly_Path_Init
    code() {
        statusb = FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | 0x800 | 0x2000
        sleepframes(FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            trotx = 360deg
            yzapproach = 180deg
            CanFollowPath = 1
            PathBobVelocity += 30.4
        }
        pathprog = spd(pathprog, 5.5)
        if (pathprog >= pathlen) {
            pathprog = pathlen - 1
        }
        FireflyPathMotion()
        changestateif(Firefly_Path_End_Idle, pathprog >= pathlen - 1)
    }
}

state Firefly_Path_End_Idle { // 12
    event => state Firefly_Path_Init
    code() {
        statusb = 0
        CanFollowPath = false
        TargetOrbitRadius = 1m
        sleepframes(FIREFLY, 0.0, 11.0)
    }
    trans {
        FireflyPathMotion()
    }
}
   
