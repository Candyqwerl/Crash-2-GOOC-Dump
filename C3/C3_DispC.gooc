    if (level == 0xA00) misc = 3;
    if (level == 0xC00) misc = 4;
    if (level == 0x1900) misc = 5;
    if (level == 0xF00) misc = 6;
    if (level == 0x1600) misc = 7;
    if (level == 0x1500) misc = 8;
