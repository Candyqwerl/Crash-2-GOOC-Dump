var mem1, mem2, mem3, mem4, mem5, mem6, mem7, mem8,
    mem9, mem10, mem11, DisplayFrame, DisplayVar13, DisplayVar14, DisplayVar15, DisplayVar16,
    LocalizedTextFrame, DisplayVar18, DisplayVar19

/*--- HUD Counters / Collectable Icons ---*/
expr DisplayVarField         = DisplayVar13
expr DisplayRequestMode      = DisplayVar14
expr DisplayRewardType       = DisplayVar15

/*----- Pause Menu Controller -----*/
expr MenuLevelNumber         = DisplayFrame
expr MenuExitPromptFrame     = DisplayVar13
expr MenuHasLevelNumber      = DisplayVar18

/*--- Pause Inventory / Item Panels ---*/
expr PauseCompletionPercent  = DisplayVar13
expr PauseBossCount          = DisplayVar14
expr PauseCrystalCount       = DisplayVar15
expr PauseGemCount           = DisplayVar16
expr PanelCollectedItemCount = DisplayVar18
expr PanelTotalitemCount     = DisplayVar19

/*--- Collectable Manager ---*/
expr CollectedRewardType     = DisplayVar15
expr CollectedRewardArg      = DisplayVar16

/*--- Time Trial ---*/
expr TrialRecordStatByte     = DisplayVar13
expr TrialFreezeFrames       = DisplayVar14
expr TrialElapsedFrames      = DisplayVar15

expr REWARD_POWER        = 700.0
expr RELIC_PLATINUM      = 600.0
expr RELIC_GOLD          = 500.0
expr RELIC_SAPPHIRE      = 400.0
expr REWARD_RELIC        = 399.0
expr REWARD_GEM          = 300.0
expr REWARD_GEM_SPECIAL  = 301.0
expr REWARD_CRYSTAL      = 200.0
expr REWARD_TIME         = 110.0
expr REWARD_1UP          = 97.0

inline sub SetVFX2D() {
    vfx = (vfx & 0xFFFFFF00) | 0x6
}

inline sub TextScaleDefault() {
    SetScale(0xA3, 0x103, 0x1000)
}

state HUD_Life_Display { // 0
    code() {
        LIFEICONTRANSX = 100.0
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        SetScale(0x333, 2.0, 2.0)
        x = 130.0
        vecy = 190.0
        z = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem2)
        DisplayRequestMode = 0
        vecz = 0
        zindex = 4000
        playanim(0, PICKUP_LIFE, 4)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Display_Hidden)
    }
}

state HUD_Wumpa_Display { // 1
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        vfx = (vfx & 0xFFFFFF00) | 0x6
        SetScale(0x199, 2.0, 2.0)
        x = -200.0
        vecy = 190.0
        z = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem1)
        DisplayRequestMode = 0
        vecz = 0
        zindex = 4000
        playanim(0, FRUIT_WUMPA, 0.18s)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Display_Hidden)
    }
}

state HUD_Box_Display { // 2
    code() {
        statusb = FLAG_INVISIBLE | FLAG_NO_CAMERA_CLIP
        vfx = (vfx & 0xFFFFFF00) | 0xE
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        SetScale(0x1800, 0x1333, 0x1800)
        x = -40.0
        vecy = 190.0
        z = 0
        setanim(BOX_DISPLAY)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem11)
        DisplayRequestMode = 0
        vecz = -10.0
        rotx = 40deg
        zindex = 4000
        moda = 4.0
        SetColor2(-0xDD8, 0x6D7, 0x432)
        SetColor1(0x80, 0x80, 0x80)
        playframe(DisplayFrame, 4)
        if (GLOBAL_148 == 0) {
            BOXCOUNTER = 0
            return
        }
        statusb &= ~FLAG_INVISIBLE
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Display_Hidden)
    }
}

inline sub DisplaySleep() {
    if (spawn == S_WUMPA_DISPLAY || spawn == S_BONUS_WUMPA_DISPLAY) {
        do {
            animframe = (animframe + 1.0) % 14.0
            playframe()
        } while (1)
    }
    else {
        sleepframe(DisplayFrame)
    }
}

state Display_Hidden { // 3
    statusc 0x0
    code() {
        statusb |= FLAG_INVISIBLE
        DisplaySleep()
    }
    event(e, a) {
        if (e == Event3 || e == Event32 || e == Event17) {
            if (DisplayRequestMode != 1) {
                DisplayRequestMode = 2
            }
            statetime = frametime
            if (e == Event17) {
                DisplayRequestMode = 1
            }
        }
    }
    trans {
        sendeventif(Event12, child, STATUS_FIRSTFRAME, self)
        v0 = getfield(player, DisplayVarField)
        if (!(v0 == getfield(self, DisplayVarField) || spawn == S_BOX_DISPLAY) || (buttonhold(PAD_TRIANGLE) || DisplayRequestMode)) {
            spawn2(DispC, S_VARIABLE_DISPLAY, 1, 32, -12.0, 16.0 - vecz, 40.0)
            changestate(Display_Show)
        }
    }
}

state Display_Show { // 4
    statusc 0x0
    event => state Display_Hidden
    code() {
        statusb &= ~FLAG_INVISIBLE
        DisplaySleep()
    }
    trans {
        once {
            if (spawn == S_BOX_DISPLAY) {
                settrans(BoxDisplayTrans)
                BoxDisplayTrans()
                return
            }
        }
        changestateif(Display_Hide, frametime - statetime >= 37)
        vecy = seek(vecy, 102.0, 10.0)
        if (vecy == 102.0) {
            if (getfield(player, DisplayVarField) > getfield(self, DisplayVarField)) {
                unless (time(3)) {
                    statetime = frametime
                    if (spawn == S_WUMPA_DISPLAY) {
                        soundpitch(4.0)
                        soundsetup(0, 0, 11)
                        sounddecay(64)
                        soundplay([tal0A], 0.2V)
                    }
                    setfield(self, DisplayVarField, getfield(self, DisplayVarField) + 1.0)
                }
            }
            else {
                setfield(self, DisplayVarField, getfield(player, DisplayVarField))
            }
            if (DisplayRequestMode == 1) {
                interrupter = child
                spawn2(FruiC, FruiC_S_1UP_GOTO_HUD, 1)
                if (interrupter == child) {
                    player -> mem2 += 1.0
                }
                DisplayRequestMode = 0
            }
            else {
                DisplayRequestMode = 0
            }
        }
        y = vecy + vecz
    }
}

sub BoxDisplayTrans() {
    if (getfield(self, DisplayVarField) < 10.0) {
        x = -40.0
    }
    else if (getfield(self, DisplayVarField) < 100.0) {
        x = -66.0
    }
    else {
        x = -82.0
    }
    roty = spd(roty, 180deg)
    changestateif(Display_Hide, frametime - statetime >= 37)
    vecy = seek(vecy, 102.0, 10.0)
    setfield(self, DisplayVarField, getfield(player, DisplayVarField))
    if (vecy == 102.0) {
        DisplayRequestMode = 0
    }
    y = vecy + vecz
}

state Display_Hide { // 5
    statusc 0x0
    code => state Display_Show
    event => state Display_Hidden
    trans {
        v0 = getfield(player, DisplayVarField)
        changestateif(Display_Show, v0 != getfield(self, DisplayVarField) || buttonhold(PAD_TRIANGLE) || DisplayRequestMode)
        if (vecy < 190.0) {
            vecy += 4.0
        }
        else {
            changestate(Display_Hidden)
        }
        y = vecy + vecz
    }
}

state Variable_Display { // 6
    stateflag 0x10001
    event => state Menu_Text
    code(fontsize, base_x, y_off, x_off) {
        playnull()
        if (fontsize == 0x10) {
            invincible = FONT_SMALL
            SetScale(0xA3, 0x103, 0x1000)
        }
        else {
            invincible = FONT_BIG
            SetScale(0x146, 0x207, 0x1000)
        }
        velx = base_x + x_off
        z = parent -> z
        SetVFX2D()
        zindex = 4000
        SetRot(0deg)
        if (parent -> spawn == S_WUMPA_DISPLAY || parent -> spawn == S_BONUS_WUMPA_DISPLAY) {
            SetColor1(0x1FF, 0x000, 0x000)
            SetColor2(0x1FF, 0x1FF, 0x000)
            SetColor3(0x1FF, 0x1FF, 0x000)
            SetColor4(0x000, 0x17C, 0x000)
        }
        else if (parent -> spawn == S_BOX_DISPLAY) {
            SetColor1(0xAC, 0x4E, 0x0C)
            SetColor2(0x9D, 0x3F, 0x09)
            SetColor3(0x8E, 0x30, 0x06)
            SetColor4(0x78, 0x28, 0x06)
            var0 = GLOBAL_148 >> 8
            do {
                statusb = parent -> statusb
                x = parent -> x + velx
                y = parent -> y + y_off
                var v1 = var0
                var v2 = getfield(parent, parent -> DisplayVarField) >> 8
                setanim(TEXT)
                playframe(0)
            } while (1)
        }
        else if (parent -> spawn == S_BONUS_BOX_DISPLAY) {
            SetColor1(0xAC, 0x4E, 0x0C)
            SetColor2(0x9D, 0x3F, 0x09)
            SetColor3(0x8E, 0x30, 0x06)
            SetColor4(0x78, 0x28, 0x06)
            var0 = GLOBAL_188 >> 8
            do {
                statusb = parent -> statusb
                x = parent -> x + velx
                y = parent -> y + y_off
                var v1 = var0
                var v2 = getfield(parent, parent -> DisplayVarField) >> 8
                setanim(TEXT)
                playframe(1.0)
            } while (BONUSSTATE != BONUS_COMPLETED)
        }
        else {
            TextColorDefault()
        }
        do {
            statusb = parent -> statusb
            x = parent -> x + velx
            y = parent -> y + y_off
            var v1 = getfield(parent, parent -> DisplayVarField) >> 8
            setanim(TEXT)
            playframe(2.0)
        } while (1)
    }
}

state HUD_Bonus_Wumpa_Display { // 7
    stateflag 0x10001
    code() {
        movetolist(1.0)
        SetRot(0deg)
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        SetScale(0xCC, 1.0, 1.0)
        x = -200.0
        y = -190.0
        vely = -102.0
        z = 0
        setanim(FRUIT_WUMPA)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem4)
        spawn2(DispC, S_VARIABLE_DISPLAY, 1, 0x10, -8.0, 8.0, 20.0)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Bonus_Variable_Update)
    }
}

