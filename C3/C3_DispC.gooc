        if (LEVEL == LEVEL_WarpRoom) {
            sleepnull()
        }
        GAMEFLAGS &= ~0x2
        GLOBAL_17 = 6.0
        GLOBAL_193 = 0
        loadlevel(LEVEL_Title)
        sleepnull()
    }
}

state Display_Kill { // 30
    stateflag 0x40020
    statusc 0x0
    code() {}
}

state Box_Counter { // 31
    code() {
        y += 1.5m
        statusb = FLAG_STRING_CENTER
        TextColorDefault()
        SetScale(0x800)
        invincible = FONT_BIG
        zindex = 300
        playnull()
        spawn2(DispC, S_HOLOGRAM, 1, x, y - 1m, z)
        do {
            var total = GLOBAL_148 >> 8
            var broken = BOXCOUNT >> 8
            setanim(TEXT)
            playframe(1.0)
        } until (GAMEFLAGS & 0x100000)
        KillEntity()
    }
    trans {
        once {
            if (var item_offs = LEVEL >> 8; item_offs < 32) {
                misc = SAVEDGEMPOOL1 & (1 << item_offs)
            }
            else {
                misc = SAVEDGEMPOOL2 & (1 << (item_offs - 32))
            }
            field_61 = misc
            if (var item_offs = LEVEL >> 8; item_offs < 32) {
                misc = GEMPOOL1 & (1 << item_offs)
            }
            else {
                misc = GEMPOOL2 & (1 << (item_offs - 32))
            }
            field_61 = field_61 || misc
            if (LEVEL == 0x500
                || LEVEL == 0x1F00
                || LEVEL == 0x1700
                || LEVEL == 0x1300
                || LEVEL == 0x2500
                || LEVEL == 0x2000
                || LEVEL == 0x1400
                || LEVEL == 0x1500
                || LEVEL == 0x2700
                || LEVEL == 0x2100
                || LEVEL == 0xD00
                || LEVEL == 0x1900) {
                    field_63 = 25m
                }
            else {
                field_63 = 8m
            }
        }
        changestateif(Box_Counter_Reward, ((BOXCOUNT == GLOBAL_148 && distance(player) < field_63) || (entitygetstate(3) || field_61)) && !(STATUS_FIRSTFRAME), REWARD_GEM + LEVEL)
    }
}

state Box_Counter_Reward { // 32
    code(reward) {
        calcpath(0)
        cascadeevent(Event12, self, self)
        if (var item_offs = (reward - REWARD_GEM) >> 8; item_offs < 32) {
            misc = SAVEDGEMPOOL1 & (1 << item_offs)
        }
        else {
            misc = SAVEDGEMPOOL2 & (1 << (item_offs - 32))
        }
        field_61 = misc
        if (var item_offs = (reward - REWARD_GEM) >> 8; item_offs < 32) {
            misc = GEMPOOL1 & (1 << item_offs)
        }
        else {
            misc = GEMPOOL2 & (1 << (item_offs - 32))
        }
        field_61 = field_61 || misc
        if (entitygetstate(3) || field_61) {
            entitysetspawn(0)
        }
        else {
            spawn2(FruiC, FruiC_S_FRUIT_HOP, 1, reward, id)
            creator = objectspawned
            spawn(9, 63, 1, -1.0, 0, 400.0, 0.8S, 50, reward) // Firework
            do {
                misc = LEVEL == 0x2500
                    || LEVEL == 0x2000
                    || LEVEL == 0x1400
                    || LEVEL == 0x1500
                    || LEVEL == 0xC00
                    || LEVEL == 0x1000
                    || LEVEL == 0x2700
                    || LEVEL == 0x2100
                    || LEVEL == 0xD00
                    || LEVEL == 0x1900
                sendeventif(Event2, creator, misc && distance(player) < 5m, 0)
                playnull()
            } until (entitygetstate(3))
        
        }
    }
}

state HUD_TimeTrial_Start { // 33
    stateflag 0x10001
    code() {
        miscfunc(player, parent, 2, 12) // movetolist(parent)
        statusb = FLAG_STRING_CENTER
        TextColorDefault()
        zindex = 1000
        SetRot(0deg)
        TrialFreezeFrames = 0
        TrialElapsedFrames = 0
        {
            var prev_relic_tier
            {
                var sapp_bits_low = (GLOBAL_175 & ~(GLOBAL_179 | GLOBAL_181)) | GLOBAL_179
                var sapp_bits_high = (GLOBAL_176 & ~(GLOBAL_180 | GLOBAL_182)) | GLOBAL_180
                var gold_bits_low = (GLOBAL_177 & ~(GLOBAL_179 | GLOBAL_181)) | GLOBAL_181
                var gold_bits_high = (GLOBAL_178 & ~(GLOBAL_180 | GLOBAL_182)) | GLOBAL_182
                if (var relic_offs = LEVEL >> 8; relic_offs < 32) {
                    misc = sapp_bits_low & (1 << relic_offs)
                }
                else {
                    misc = sapp_bits_high & (1 << (relic_offs - 32))
                }
                if (misc) {
                    prev_relic_tier += 1
                }
                if (var relic_offs = LEVEL >> 8; relic_offs < 32) {
                    misc = gold_bits_low & (1 << relic_offs)
                }
                else {
                    misc = gold_bits_high & (1 << (relic_offs - 32))
                }
                if (misc) {
                    prev_relic_tier += 2
                }
                var record_time, record_stats, record_name // emitted by miscfunc, get prev tt data?
                miscfunc(LEVEL + 3, player, 19, 15)
                record_time = sp
                record_stats = sp
                record_name = sp
                TrialRecordStatByte = (record_stats & 0xFF0000) >> 16
                if (prev_relic_tier == 0) {
                    record_stats = (record_stats & ~0xFF0000) | (((record_stats & 0xFF0000) + 0x10000) & 0xFF0000)
                }
                else if (prev_relic_tier == 1) {
                    record_stats = (record_stats & 0xFFFFFF) | (((record_stats & -0x1000000) + 0x1000000) & -0x1000000)
                }
                {
                    var v9 = record_name, v10 = record_stats, v11 = record_time
                    miscfunc(LEVEL + 3, player, 20, 15)
                }
            }
            interrupter = DOCTOR
            sendevent(Event7, interrupter, 100.0)
            GLOBAL_173 = frametime
            GLOBAL_187 = self
            broadcastevent(Event66, 0, self)
            y += 700.0
            SetScale(0, 0x6C0, 0x566)
            do (var start_frame = frametime) {
                scalex = seek(scalex, 0x566, 0xDD)
                TimeTrialTrans()
            } while (frametime - start_frame < 6)
            {
                var target_x = LEVEL == 0x1F00 || LEVEL == 0x1700 || LEVEL == 0x1300 ? 68.0 : 172.0
                var target_y = -101.0
                unless (GLOBAL_139 & 0x10) {
                    save (scalex, scaley, scalez) {
                        TextScaleDefault()
                        SetTextLanguage1(177.0, 178.0, 179.0, 180.0, 181.0)
                        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, 0, 18.0, 2, 8.0, 0x2500) // Entering Time Trial text
                    }
                }
                GLOBAL_139 |= 0x10
                SetVFX2D()
                SetRot(0deg)
                moveto2d()
                if (x < -300.0) {
                    x = -300.0
                }
                else if (x > 300.0) {
                    x = 300.0
                }
                if (y < -200.0) {
                    y = -200.0
                }
                else if (y > 200.0) {
                    y = -200.0
                }

                {
                    var start_x = x
                    var start_y = y
                    var start_scalex = scalex
                    var start_scaley = scaley
                    do (var start_frame = frametime) {
                        x = start_x + ((target_x - start_x) * (frametime - start_frame)) / 6
                        y = start_y + ((target_y - start_y) * (frametime - start_frame)) / 6
                        scalex = start_scalex + ((0xA3 - start_scalex) * (frametime - start_frame)) / 6
                        scaley = start_scaley + ((0x103 - start_scaley) * (frametime - start_frame)) / 6
                        TimeTrialTrans()
                    } while (frametime - start_frame < 6)
                    TextScaleDefault()
                    SetTrans(target_x, target_y, 0)
                    SetTRot(x, y, z)
                }
            }
        }
        stateflag |= 0x100000
        do {
            TimeTrialTrans()
        } while (1)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event19 || (e == Event12 && interrupter != player))
        if (e == Event39) {
            if (a[1.0] == 1) {
                accev()
                stateflag |= 0x20
                settrans(TextBlink)
            }
            accevcstate(HUD_TimeTrial_End, a[1.0] == 0)
        }
        if (e == Event16) {
            accev()
            TrialFreezeFrames += 25 * a[0]
            if (GLOBAL_173 > frametime) {
                GLOBAL_173 = frametime
            }
            soundpitch(4.0)
            soundsetup(0, 11)
            sounddecay(64)
            soundplay([tal0A], 1V)
        }
    }
}

sub TimeTrialTrans() {
    TextColorDefault()
    if ((GAMEFLAGS & 0x1000)
        && !((player -> stateflag & 0x8000000)
            || ((player -> stateflag & 0x20)
                && !(player -> stateflag & 0x2)
                && !(player -> stateflag & 0x1000)
                && !(player -> stateflag & 0x400)))
        && !(stateflag & 0x20)) {
            if (TrialFreezeFrames) {
                GLOBAL_173 = frametime - TrialElapsedFrames
                TrialFreezeFrames -= 1
                SetTextColor(0xC8, 0xC8, 0xFF, 0xA0, 0xA0, 0xE1)
                if (!time(5)) {
                    if (!time(10)) {
                        soundpitch(0x399)
                        sounddecay(0xC8)
                        soundsetup(0, self, 8)
                        soundplay([Clt0A], 1V)
                    }
                    else {
                        soundpitch(0x266)
                        sounddecay(0xC8)
                        soundsetup(0, self, 8)
                        soundplay([Clt0A], 1V)
                    }
                }
            }
            TrialElapsedFrames = frametime - GLOBAL_173
        }
    if (TrialElapsedFrames >= 600s - 1) {
        TrialElapsedFrames = 600s - 1
        GLOBAL_173 = frametime - TrialElapsedFrames
        SetTextColor(0x80, 0xC8, 0x00, 0x80, 0x00, 0x00)
    }
    if (stateflag & 0x20) {
        invincible = FONT_BIG
        unless (stateflag & 0x2000000) {
            x = seek(trotx, trotx - 62.0, 0xC66)
            y = seek(troty, troty + 16.0, 0x333)
            scalex = seek(scalex, 0x146, 32)
            scaley = seek(scaley, 0x207, 51)
        }
    }
    var c = (TrialElapsedFrames % 25) * 100 / 25
    var s = (TrialElapsedFrames / 25) % 60
    var m = TrialElapsedFrames / 1500
    setanim(TEXT)
    playframe(182.0)
}

state HUD_TimeTrial_End { // 34
    stateflag 0x2010021
    event => state HUD_TimeTrial_Start
    code(skip_results, arg) {
        GLOBAL_173 = 0
        GLOBAL_187 = 0
        if (skip_results) {
            return
        }
        spawn2(66, 4, 1, TrialElapsedFrames, skip_results) // EntNC-4 (Enter Name Screen)
        {
            var start_x = x
            var start_y = y
            do (var start = frametime) {
                x = start_x + ((-start_x) * (frametime - start)) / 5
                y = start_y + ((-start_y) * (frametime - start)) / 5
                TimeTrialTrans()
            } while (frametime - start < 5)
            x = 0
            y = 0
        }
        settrans(TextBlink)
        stateflag |= 0x100000
        do {
            TimeTrialTrans()
        } while (1)
    }
}


sub TextBlink() {
    if (time(12) < 2) {
        statusb |= FLAG_INVISIBLE
    }
    else {
        statusb &= ~FLAG_INVISIBLE
    }
}

state Menu_Button { // 35
    stateflag 0x48001
    __transargs
    code(index, anim, frame, x_off, y_off, obj) {
        statusb = creator -> statusb
        zindex = creator -> zindex
        unless (creator -> stateflag & 0x40000) {
            stateflag &= ~0x40000
        }
        SetVFX2D()
        invincible = FONT_SMALL
        setanim(anim, frame)
        var value
        do {
            value = var0
            playframe()
        } while (1)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event12 || e == Event1)
    }
    trans {
        x = parent -> x + x_off
        if (obj == 1) {
            TextFlashFast()
            return
        }
        y = parent -> y + y_off
        if (parent -> stalltime == index) {
            if (obj) {
                interrupter = obj
                interrupter -> y = y
            }
            TextFlashFast()
        }
        else if (index < 0) {
            SetTextColor(0x1FF, 0x190, 0, 0x1FF, 0, 0)
        }
        else {
            SetTextColor(0xA0, 0x8B, 0x60, 0xA0, 0x60, 0x6)
        }
    }
}

state Menu_Text { // 36
    stateflag 0x40001
    code(anim, frame, x_off, y_off, flags, textmode, varfield) {
        if (textmode == 0) {
            TextColorDefault()
        }
        else if (textmode == 8.0) {
            SetColor1(0x1FF, 0x000, 0x000)
            SetColor2(0x1FF, 0x1FF, 0x000)
            SetColor3(0x1FF, 0x1FF, 0x000)
            SetColor4(0x000, 0x17C, 0x000)
            settrans(TextBlinkKill)
        }
        else if (textmode == 2.0) {
            SetColor1(0xFF, 0xFF, 0xFF)
            SetColor2(0xFF, 0xFF, 0xFF)
            SetColor3(0x40, 0x40, 0x40)
            SetColor4(0x40, 0x40, 0x40)
        }
        else if (textmode == 4.0) {
            SetColor1(0x1FF, 0x000, 0x000)
            SetColor2(0x1FF, 0x1FF, 0x000)
            SetColor3(0x1FF, 0x1FF, 0x000)
            SetColor4(0x000, 0x17C, 0x000)
        }
        else if (textmode == 7.0) {
            TextColorDefault()
            settrans(TextFlashFast)
        }
        else if (textmode == 5.0) {
            TextDefaultColor()
            settrans(TextFlashSlow)
        }
        else if (textmode == 6.0) {
            TextDefaultColor()
            settrans(TextFlashMedium)
        }
        else if (textmode == 9.0) {
            SetTextColor(0xA0, 0x8B, 0x60, 0xA0, 0x60, 0x6)
        }

        if (flags & 0x1) {
            x = parent -> x + x_off
            y = parent -> y + y_off
        }
        else {
            x = x_off
            y = y_off
        }
        if (flags & 0x4) {
            invincible = FONT_BIG
        }
        else {
            invincible = FONT_SMALL
        }
        zindex = creator -> zindex
        if (flags & 0x2) {
            statusb |= FLAG_STRING_CENTER
        }
        else {
            statusb &= ~FLAG_STRING_CENTER
        }
        unless (creator -> stateflag & 0x40000) {
            stateflag &= ~0x40000
        }
        SetVFX2D()
        animseq = anim
        var v1, v2
        do {
            v1 = getfield(creator, varfield + 1.0)
            v2 = getfield(creator, varfield)
            playframe(frame)
        } while (1)
    }
}

sub TextFlashSlow() {
    if (frametime & 31) {
        SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
    }
    else {
        SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
    }
}

sub TextFlashMedium() {
    if ((frametime & 31) == 15) {
        SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
    }
    else {
        SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
    }
}

sub TextFlashFast() {
    if (frametime & 3) {
        SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
    }
    else {
        SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
    }
}

sub TextBlinkKill() {
    if ((frametime - statetime) % 25 < 12) {
        statusb &= ~FLAG_INVISIBLE
    }
    else {
        statusb |= FLAG_INVISIBLE
    }
    changestateif(Display_Kill, frametime - statetime >= 3s)
}

state Pause_Menu_Inventory { // 37
    stateflag 0x40001
    event => state Menu_Text
    code(reward, x_off, y_off, flags) {
        stalltime = reward
        if (flags & 0x1) {
            x = parent -> x + x_off
            y = parent -> y + y_off
        }
        else {
            x = x_off
            y = y_off
        }
        troty = 10deg + rand(10deg)
        trotx = 0
        statusb = creator -> statusb | FLAG_NO_CAMERA_CLIP
        zindex = 350
        vfx = (vfx & 0xFFFFFF00) | 0xE
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        unless (creator -> stateflag & 0x40000) {
            stateflag &= ~0x40000
        }
        if (reward == REWARD_1UP) {
            tpc = 0
            setanim(PICKUP_LIFE)
            SetScale(0x146, 0x103, 0x1000)
        }
        else if (reward >= REWARD_POWER) {
            SetVFX2D()
            vfx &= 0xFF00FFFF
            vfx = (vfx & 0xFFFF00FF) | 0x600
            setanim(POWERUP)
            statusb |= 0x100000
            stalltime = (reward - REWARD_POWER) >> 8
            if (flags & 0x2) {
                roty = 0
                tpc = 0
                SetScale(0x800)
            }
            else {
                SetScale(0x1000)
            }
        }
        else if (reward >= REWARD_RELIC) {
            SetRelicColor(reward)
            if (flags & 0x8) {
                SetScale(0xAE1)
                SetColor2(-0xA49, -0x4A5, 0xB58)
            }
            else if (flags & 0x40) {
                SetScale(0x800)
                SetColor2(-0xA49, -0x485, 0xB58)
            }
            else {
                SetScale(0x1000)
            }
            setanim(RELIC)
        }
        else if (reward >= REWARD_GEM) {
            if (flags & 0x8) {
                SetScale(0x8F5)
            }
            else if (flags & 0x4) {
                SetScale(0xA3D)
            }
            else {
                SetScale(0x11EB)
            }
            SetGemColor(reward - REWARD_GEM)
            if (flags & 0x8) {
                SetColor2(-0x2C1, 0x78B, 0xDD6)
                SetColor1(0xA0, 0xA0, 0xA0)
            }
            else {
                SetColor2(-0x2C1, 0x78B, 0xDD6)
            }
            rotx = 20deg
            rotz = 0
            if (flags & 0x2) {
                do {
                    SetScale(0x28F)
                    do {
                        playframe(0)
                    } while (rand(0xC8))
                    SetScale(0x51E)
                    playframe(0)
                    SetScale(0xA3D)
                    playframe(0, 2)
                    SetScale(0x51E)
                    playframe(0)
                } while (1)
            }
        }
        else if (reward >= REWARD_CRYSTAL) {
            if (flags & 0x8) {
                SetScale(0.4S)
            }
            else if (flags & 0x4) {
                SetScale(2S)
            }
            else {
                SetScale(1S)
            }
            moda = 4.0
            SetColor1(0x80, 0x80, 0x80)
            SetColor2(-0x8B5, -0x83A, 0xA9B)
            setanim(CRYSTAL)
            spawn2(DispC, S_CRYSTAL_GLOW, 1, 0)
        }
        if (flags & 0x20) {
            colr2 = creator -> colr2
            colg2 = creator -> colg2
            colb2 = creator -> colb2
        }
        if (flags & 0x10) {
            spawn(9, 52, 2, colr1 >> 1, colg1 >> 1, colb1 >> 1, 1.0, 0x999)
        }
        sleep()
    }
    trans {
        roty = spd(roty, 90deg)
    }
}

state Pause_Menu_Background { // 38
    stateflag 0x42001
    code() {
        statusb = 0x100000 | FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        vfx = (vfx & 0xFFFF00FF) | 0x600
        SetTrans(0, 0, 0)
        SetScale(0xA37, 0x103A, 0x1000)
        zindex = -1000
        moda = 16.0
        while (moda == 0) {
            moda = seek(moda, 0, 0x555)
            playanim(0, PAUSE_BACKGROUND)
        }
        stateflag &= ~0x2000
        do {
            stalltime += 1
            playanim(0, PAUSE_BACKGROUND)
        } while (1)
    }
    event(e, a) {
        accevcstate(Pause_Menu_Background_Kill, e == Event12)
    }
}

state Pause_Menu_Background_Kill { // 39
    stateflag 0x40001
    code() {
        while (moda < 16.0) {
            moda = seek(moda, 16.0, 0x555)
            playanim(0, PAUSE_BACKGROUND)
        }
        playanim(0, PAUSE_BACKGROUND)
    }
}

state Box_Hologram { // 40
    event => state Pause_Menu_Root
    code(x_pos, y_pos, z_pos) {
        statusb = 0x100000
        stalltime = 2
        SetScale(0x1CCC)
        SetTrans(x_pos, y_pos, z_pos)
        vfx = (vfx & 0xFF00FFFF) | 0x70000
        moda = var0
        zindex = 20
        sleepanim(0, BOX_PICKUP)
    }
    trans {
        once {
            v0 = 6.4
        }
        unless (rand(10)) {
            v0 = 1.6 + rand(6.4)
        }
        field_61 = abs(z - CAMTRANSZ)
        if (field_61 < 4m) {
            if (field_61 <= 1m) {
                v0 = 16.0
            }
            else {
                v0 = 16.0 - 1.0 / (field_61 * 6.4)
            }
        }
        if (player -> stateflag \ 0x10800) {
            var0 = 16.0
        }
        moda = seek(moda, v0, 0x111)
        roty = spd(roty, 180deg)
    }
}

sub TextColorDefault() {
    SetTextColor(0x1FF, 0x190, 0, 0x1FF, 0, 0)
}

state STATE_41 { // 41 // no idea what the fuck this is, cant find it used anywhere
    code(x_pos, y_pos, arg) {
        GLOBAL_110 = self
        x = x_pos
        y = y_pos
        statusb = FLAG_NO_CAMERA_CLIP
        trotx = 180deg
        vfx = (vfx & 0xFFFF00FF) | 0xE
        if (GLOBAL_105 == 2) {
            var0 = 0
        }
        else {
            var0 = 0x11EB
        }
        SetScale(0S)
        SetRot(0deg)
        zindex = 262
        troty = 0
        playnull()
        do {
            roty += degdist(roty, troty) / 12
            scalex = seek(scalex, var0, spd(1S))
            scaley = seek(scaley, var0, spd(1S))
            scalez = seek(scalez, var0, spd(1S))
            if (player -> stateflag & 0x800) {
                playnull()
            }
            else {
                playanim(0, ANIM_0x7200)
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event15) {
            troty = a[0]
        }
        if (e == Event21) {
            troty = a[0]
            roty = troty
        }
        if (e == Event20) {
            if (GLOBAL_105 != 2) {
                var0 = a[0]
            }
        }
        if (e == Event19) {
            accev()
            if (GLOBAL_105 == 2) {
                var0 = 0
            }
            else {
                var0 = 1.12S
            }
        }
    }
}

state TimeTrial_Record_Row { // 42
    stateflag 0x50001
    statusc 0x0
    event => state Menu_Text
    code(level, rank, x_pos, y_pos) {
        stateflag = parent -> stateflag
        SetVFX2D()
        statusb = FLAG_STRING_CENTER
        TextDefaultColor()
        zindex = 1000
        SetRot(0deg)
        SetTrans(x_pos, y_pos, 0)
        TextScaleDefault()
        var record_time, record_name, v3, v4
        do {
            miscfunc(level + rank, player, 19, 15)
            record_time = sp
            record_name = sp
            v3 = sp
            v4 = 0
            if (!record_time || !record_name) {
                if (var lang = GLOBAL_151; lang == 3.0) {
                    if (rank == 0) {
                        record_name = 0x202E31
                    }
                    else if (rank == 1) {
                        record_name = 0x202E32
                    }
                    else if (rank == 2) {
                        record_name = 0x202E33
                    }
                }
                else if (lang == 1.0 || lang == 4.0) {
                    if (rank == 0) {
                        record_name = 0x204F31
                    }
                    else if (rank == 1) {
                        record_name = 0x204F32
                    }
                    else if (rank == 2) {
                        record_name = 0x204F33
                    }
                }
                else if (lang == 2.0) {
                    if (rank == 0) {
                        record_name = 0x524531
                    }
                    else if (rank == 1) {
                        record_name = 0x524532
                    }
                    else if (rank == 2) {
                        record_name = 0x524533
                    }
                }
                else {
                    if (rank == 0) {
                        record_name = 0x545331
                    }
                    else if (rank == 1) {
                        record_name = 0x545332
                    }
                    else if (rank == 2) {
                        record_name = 0x545333
                    }
                }
            }
            var c = (record_time % 25) * 100 / 25
            var s = (record_time / 25) % 60
            var m = record_time / 1500
            var n = &record_name
            setanim(TEXT)
            playframe(183.0)
        } while (1)
    }
}

inline sub SetParentColor(r, g, b) {
    parent -> colr1 = r
    parent -> colg1 = g
    parent -> colb1 = b
}

state Crystal_Glow { // 43
    stateflag 0x40001
    code(a0) {
        DisplayFrame = 0
        if (a0) {
            if (LEVEL == 0xF00) {
                DisplayFrame = 1
                DisplayVar13 = 0x88
                DisplayVar16 = 0x12C000
                yzapproach = -0x88
                DisplayVar14 = 0x7D000
                DisplayVar15 = -0x71
            }
        }
        unless (creator -> stateflag & 0x40000) {
            stateflag &= ~0x40000
        }
        if ((creator -> vfx & 0xFF) == 6 || (creator -> vfx & 0xFF) == 11 || (creator -> vfx & 0xFF) == 13 || (creator -> vfx & 0xFF) == 14) {
            vfx = creator -> vfx
        }
        else {
            SetVFX2D()
        }
        vfx &= 0xFF00FFFF
        vfx = (vfx & 0xFFFF00FF) | 0x600
        SetRot(0deg)
        zindex = creator -> zindex
        if (LEVEL == 0xF00) {
            zindex -= 37
        }
        else {
            zindex -= 80
        }
        playanim(0, CRYSTAL_GLOW)
        unless (creator -> stateflag & 0x40000) {
            stateflag &= ~0x40000
        }
        sleepanim(0, CRYSTAL_GLOW)
    }
    trans {
        x = parent -> x
        y = parent -> y
        z = parent -> z
        statusb = parent -> statusb & FLAG_INVISIBLE
        if (var glint = frametime & 31; glint == 0 || glint == 2) {
            SetParentColor(0xF4, 0xAF, 0xFF)
        }
        else if (glint == 1) {
            SetParentColor(0xFF, 0xFF, 0xFF)
        }
        else {
            SetParentColor(0xE9, 0x5F, 0xFF)
        }
        x = parent -> x
        y = parent -> y
        z = parent -> z
        unless (STATUS_FIRSTFRAME) {
            if (DisplayFrame) {
                var0 = player -> z - z
                if (var0 < 0) {
                    vecx = yzapproach
                    vecy = DisplayVar16
                    var0 = -var0
                }
                else {
                    vecx = DisplayVar15
                    vecy = DisplayVar14
                }
                if (var0 > vecy) {
                    var0 = vecy
                }
                rotz = DisplayVar13 + (var0 * vecx) / vecy
            }
        }
    }
}

