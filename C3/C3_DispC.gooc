inline sub KillDisplayChildren() {
    if (child) {
        cascadeevent(Event12, self, self)
        playnull()
    }
}

inline sub SetTextLanguage1(german, spanish, italian, french, english) {
    if (var lang = GLOBAL_151; lang == 3.0) {
        LocalizedTextFrame = german
    }
    else if (lang == 1.0) {
        LocalizedTextFrame = spanish
    }
    else if (lang == 4.0) {
        LocalizedTextFrame = italian
    }
    else if (lang == 2.0) {
        LocalizedTextFrame = french
    }
    else {
        LocalizedTextFrame = english
    }
}

inline sub SetTextLanguage2(german, spanish, italian, fallback) {
    if (var lang = GLOBAL_151; lang == 3.0) {
        LocalizedTextFrame = german
    }
    else if (lang == 1.0) {
        LocalizedTextFrame = spanish
    }
    else if (lang == 4.0) {
        LocalizedTextFrame = italian
    }
    else {
        LocalizedTextFrame = fallback
    }
}

inline sub SetTextLanguage3(german, italian, spanish, french, english) {
    if (var lang = GLOBAL_151; lang == 3.0) {
        LocalizedTextFrame = german
    }
    else if (lang == 4.0) {
        LocalizedTextFrame = italian
    }
    else if (lang == 1.0) {
        LocalizedTextFrame = spanish
    }
    else if (lang == 2.0) {
        LocalizedTextFrame = french
    }
    else {
        LocalizedTextFrame = english
    }
}

state Pause_Menu_Root { // 14
    stateflag 0x40001
    code() {
        KillDisplayChildren()
        DisplayVar19 = 0
        TextColorDefault()
        zindex = creator -> zindex
        {
            var level = LEVEL
            if (player -> stateflag & 0x20 || GLOBAL_109 == 2 || GAMEFLAGS & -0x80000000) {
                field_61 = 2.0
            }
            else {
                field_61 = 3.0
            }
            if (GLOBAL_173 && !(player -> stateflag & 0x800)) {
                groundy = y
                onstateexit(SUB_1453)
                y += 18.0
                field_61 += 1.0
            }
        }
        SetLevelName(LEVEL)
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), misc, x - 80.0, -4.0, 0, 0, offsetof(MenuLevelNumber)) // Level name
        SetLevelID(LEVEL)
        MenuLevelNumber = misc
        if (MenuLevelNumber) {
            MenuHasLevelNumber = MenuLevelNumber > 0
        }
        if (var lang = GLOBAL_151; lang == 3.0) {
            if (MenuHasLevelNumber) {
                LocalizedTextFrame = 45.0
            }
            else {
                LocalizedTextFrame = 46.0
            }
        }
        else if (lang == 1.0) {
            if (MenuHasLevelNumber) {
                LocalizedTextFrame = 47.0
            }
            else {
                LocalizedTextFrame = 48.0
            }
        }
        else if (lang == 4.0) {
            if (MenuHasLevelNumber) {
                LocalizedTextFrame = 49.0
            }
            else {
                LocalizedTextFrame = 46.0
            }
        }
        else if (lang == 2.0) {
            if (MenuHasLevelNumber) {
                LocalizedTextFrame = 50.0
            }
            else {
                LocalizedTextFrame = 51.0
            }
        }
        else {
            if (MenuHasLevelNumber) {
                LocalizedTextFrame = 52.0
            }
            else {
                LocalizedTextFrame = 46.0
            }
            if (GLOBAL_109 == 2) {
                LocalizedTextFrame = 53.0
            }
        }
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, x - 80.0, -23.0, 0, 0, offsetof(MenuLevelNumber)) // Level / boss number
        MenuLevelNumber = abs(MenuLevelNumber)
        statusb = FLAG_NO_CAMERA_CLIP | FLAG_STRING_CENTER
        SetTextLanguage1(54.0, 55.0, 56.0, 57.0, 58.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 0, getanim(TEXT), LocalizedTextFrame, 0, 0, 0) // Resume button
        SetTextLanguage2(59.0, 60.0, 61.0, 62.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 1.0, getanim(TEXT), LocalizedTextFrame, 0, -18.0, 0) // Options button
        if (field_61 >= 3.0) {
            SetTextLanguage1(63.0, 64.0, 65.0, 66.0, 67.0)
            if (LEVEL != LEVEL_WarpRoom) {
                LocalizedTextFrame = 9.0
            }
            MenuExitPromptFrame = LocalizedTextFrame
            spawn2(DispC, S_MENU_BUTTON, 1, 2.0, getanim(TEXT), LocalizedTextFrame, 0, -36.0, 0) // Quit / Exit level button
            if (field_61 >= 4.0) {
                SetTextLanguage1(4.0, 69.0, 70.0, 71.0, 72.0)
                spawn2(DispC, S_MENU_BUTTON, 1, 3.0, getanim(TEXT), LocalizedTextFrame, 0, -54.0, 0) // Restart Trial button
            }
        }
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, interrupter != self && e == Event12)
    }
    trans {
        once {
            DisplayVar19 = 0
        }
        if (STATUS_FIRSTFRAME) {
            TextScaleDefault()
            SetRot(0deg)
            stalltime = 0
            field_61 = 2.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x100000) {
                if (dirpress(PAD_UP) && stalltime > 0) {
                    stalltime -= 1.0
                }
                if (dirpress(PAD_DOWN) && stalltime < field_61 - 1.0) {
                    stalltime += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (var button_index = stalltime; button_index == 0) {
                        sendevent(Event12, parent, self)
                    }
                    else if (button_index == 1.0) {
                        changestate(Pause_Menu_Options, 0, 0, 0)
                    }
                    else if (button_index == 2.0) {
                        if (LEVEL == LEVEL_WarpRoom) {
                            changestate(Pause_Menu_Confirm_Exit, MenuExitPromptFrame, 0, 0)
                        }
                        else {
                            LevelExit()
                        }
                    }
                    else {
                        sendeventif(Event12, parent, button_index == 3.0, 0)
                    }
                }
            }
            if (buttonpress(PAD_SELECT) && LEVEL != LEVEL_WarpRoom && field_61 >= 3.0) {
                LevelExit()
            }
        }
    }
}

sub SUB_1453() {
    y = groundy
}

sub LevelExit() {
    sendevent(Event15, player, 6.0)
    GLOBAL_193 = 0
    if (LEVEL == LEVEL_WarpRoom) {
        GLOBAL_114 = 0
        GLOBAL_131 = 0
        GAMEFLAGS &= ~0x2
        GLOBAL_17 = 6.0
        loadlevel(LEVEL_Title)
    }
    else {
        if (LEVEL == 0x1F00 || LEVEL == 0x2500 || LEVEL == 0x2000 || LEVEL == 0x1400 || LEVEL == 0x1500) {
            miscfunc(null, player, 23, 12)
        }
        if (GLOBAL_191 >= 0) {
            loadlevel(0x3A00)
        }
        else {
            loadlevel(LEVEL_WarpRoom)
        }
    }
}

state Pause_Menu_Options { // 15
    stateflag 0x40001
    event => state Pause_Menu_Root
    code(unused_option, VibrationOBJ, ScreenCenterOBJ) {
        KillDisplayChildren()
        SetVec(-100)
        field_63 = -100
        unused_option = 0
        VibrationOBJ = 0
        field_61 = 1.0
        SetTextLanguage1(73.0, 74.0, 75.0, 76.0, 77.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 0, getanim(TEXT), LocalizedTextFrame, 0, 36.0, 0) // Sound options button
        if (miscfunc(null, player, 20, 12) >= 3.32s) {
            spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 78.0, 0, ((field_61 >> 8) - 2) * -18.0, 0) // Vibration On/Off button
            VibrationOBJ = objectspawned
            vecz = field_61
            field_61 += 1.0
        }
        if (var lang = GLOBAL_151; lang == 3.0) {
            LocalizedTextFrame = 79.0
        }
        else if (lang == 4.0) {
            LocalizedTextFrame = 80.0
        }
        else {
            LocalizedTextFrame = 81.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), LocalizedTextFrame, 0, ((field_61 >> 8) - 2) * -18.0, 0) // Screen centering button
        ScreenCenterOBJ = objectspawned
        field_63 = field_61
        field_61 += 1.0
        SetTextLanguage3(82.0, 83.0, 84.0, 85.0, 86.0)
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), LocalizedTextFrame, 0, ((field_61 >> 8) - 2) * -18.0, 0) // Language button
        vecy = field_61
        field_61 += 1.0
        SetTextLanguage1(87.0, 88.0, 89.0, 90.0, 91.0)
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), LocalizedTextFrame, 0, ((field_61 >> 8) - 2) * -18.0, 0) // Done button
        field_61 += 1.0
        UpdateOptionValue()
        sleepnull()
    }
    trans {
        once {
            TextScaleDefault()
            SetRot(0deg)
            stalltime = 0
            field_61 = 2.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x100000) {
                if (dirpress(PAD_UP) && stalltime > 0) {
                    stalltime -= 1.0
                }
                if (dirpress(PAD_DOWN) && stalltime < field_61 - 1.0) {
                    stalltime += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (stalltime == 0) {
                        changestate(Pause_Menu_Sound_Options, 0, 0, 0)
                    }
                    else if (stalltime == vecx) {
                        GLOBAL_32 = GLOBAL_32 ^ 1
                    }
                    else if (stalltime == vecz) {
                        GLOBAL_32 = GLOBAL_32 ^ 2
                    }
                    else if (stalltime == vecy) {
                        changestate(Pause_Menu_Language)
                    }
                    else {
                        changestateif(Pause_Menu_Root, stalltime == field_61 - 1.0)
                    }
                }
            }
        }
        if (stalltime == field_63) {
            if (dirhold(PAD_W) && GLOBAL_91 > -15) {
                GLOBAL_91 -= 1
            }
            if (dirhold(PAD_E) && GLOBAL_91 < 15) {
                GLOBAL_91 += 1
            }
        }
        unless (STATUS_FIRSTFRAME) {
            UpdateOptionValue()
        }
    }
}

sub UpdateOptionValue(unused_option, VibrationOBJ, ScreenCenterOBJ) __trans {
    if (VibrationOBJ) {
        interrupter = VibrationOBJ
        if (GLOBAL_32 & 2) {
            if (var lang = GLOBAL_151; lang == 3.0) {
                interrupter -> animframe = 92.0
            }
            else if (lang == 1.0) {
                interrupter -> animframe = 93.0
            }
            else {
                interrupter -> animframe = 94.0
            }
        }
        else {
            if (var lang = GLOBAL_151; lang == 3.0) {
                interrupter -> animframe = 95.0
            }
            else if (lang == 1.0) {
                interrupter -> animframe = 96.0
            }
            else {
                interrupter -> animframe = 78.0
            }
        }
    }
    interrupter = ScreenCenterOBJ
    interrupter -> var0 = GLOBAL_91
}

state Pause_Menu_Debug { // 16
    stateflag 0x40001
    event => state Pause_Menu_Root
    __transargs
    code(DebugValueOBJ, NoCheatsOBJ) {
        KillDisplayChildren()
        SetVec(-100)
        field_63 = -100
        yzapproach = -100
        field_62 = -100
        field_61 = 0
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 97.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // Get All button
        vecx = field_61
        field_61 += 1.0
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 98.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // Get Relics button
        yzapproach = field_61
        field_61 += 1.0
        if (LEVEL == LEVEL_WarpRoom) {
            if (GLOBAL_150 & 0x2000000) {
                spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 99.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // Close Levels button
            }
            else {
                spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 100.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // Open Levels button
            }
            vecy = field_61
            field_61 += 1.0
        }
        if (GLOBAL_21) {
            spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 101.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // No Cheats button
            NoCheatsOBJ = objectspawned
            field_63 = field_61
            field_61 += 1.0
        }
        groundvel = GLOBAL_195
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 102.0, 70.0, ((field_61 >> 8) - 3) * -18.0, 1, 0x900, 0x3500) // Debug R value
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 103.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // Debug P value button
        DebugValueOBJ = objectspawned
        interrupter = DebugValueOBJ
        interrupter -> var0 = GLOBAL_111
        field_62 = field_61
        field_61 += 1.0
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), 91.0, 0, ((field_61 >> 8) - 3) * -18.0, 0) // Done button
        field_61 += 1.0
        sleepnull()
    }
    trans {
        once {
            TextScaleDefault()
            SetRot(0deg)
            stalltime = 0
            field_61 = 2.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x100000) {
                if (dirpress(PAD_UP) && stalltime > 0) {
                    stalltime -= 1.0
                }
                if (dirpress(PAD_DOWN) && stalltime < field_61 - 1.0) {
                    stalltime += 1.0
                }
                if (buttonpress(PAD_SELECT)) {
                    if (stalltime == vecx) {
                        SAVEDGEMPOOL2 |= 0x7C000000
                        GLOBAL_160 = 31
                        SAVEDCRYSTALPOOL1 = 0x7FFBFE00
                        SAVEDCRYSTALPOOL2 = 29
                        GLOBAL_175 |= 0x7FFBFE00
                        GLOBAL_176 |= 29
                        GLOBAL_150 |= 0x1F0000
                        if (pad(5, 2, 2, 6)) {
                            SAVEDGEMPOOL1 = -1
                            SAVEDGEMPOOL2 = -1
                        }
                        changestate(Pause_Menu_Root)
                    }
                    else if (stalltime == yzapproach) {
                        GLOBAL_177 |= -0x400
                        GLOBAL_178 |= 0xFF
                        changestate(Pause_Menu_Root)
                    }
                    else if (stalltime == vecy) {
                        if (GLOBAL_150 & 0x2000000) {
                            GLOBAL_150 &= ~0x2000000
                        }
                        else {
                            GLOBAL_150 |= 0x2000000
                        }
                        changestate(Pause_Menu_Root)
                    }
                    else if (stalltime == vecz) {
                        if (pad(5, 2, 2, 6)) {
                            GLOBAL_21 |= 2
                            changestate(Pause_Menu_Root)
                        }
                    }
                    else if (stalltime == field_63) {
                        GLOBAL_21 = 0
                        GLOBAL_150 &= ~0x2000000
                    }
                    else {
                        changestateif(Pause_Menu_Root, stalltime == field_61 - 1.0)
                    }
                }
            }
        }
        if (stalltime == field_62) {
            if (dirhold(PAD_W)) {
                GLOBAL_111 -= 1
                interrupter = NoCheatsOBJ
                interrupter -> var0 = GLOBAL_111
            }
            else if (dirhold(PAD_E)) {
                GLOBAL_111 += 1
                interrupter = NoCheatsOBJ
                interrupter -> var0 = GLOBAL_111
            }
        }
    }
}

