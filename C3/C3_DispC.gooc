        spawn2(DispC, S_MENU_BUTTON, 1, -1.0, getanim(TEXT), prompt_frame, 0, 36.0, 0) // Quit confirmation heading
        field_61 = 0
        if (var lang = GLOBAL_151; lang == 2.0) {
            LocalizedTextFrame = 109.0
        }
        else if (lang == 3.0) {
            LocalizedTextFrame = 110.0
        }
        else if (lang == 4.0 || lang == 1.0) {
            LocalizedTextFrame = 111.0
        }
        else {
            LocalizedTextFrame = 112.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), LocalizedTextFrame, 0, (field_61 >> 8) * -18.0, 0) // Yes button
        field_61 += 1.0
        if (var lang = GLOBAL_151; lang == 2.0) {
            LocalizedTextFrame = 113.0
        }
        else if (lang == 3.0) {
            LocalizedTextFrame = 114.0
        }
        else {
            LocalizedTextFrame = 115.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, field_61, getanim(TEXT), LocalizedTextFrame, 0, (field_61 >> 8) * -18.0, 0) // No button
        field_61 += 1.0
        sleepnull()
    }
    trans {
        once {
            TextScaleDefault()
            SetRot(0deg)
            stalltime = 0
            field_61 = 2.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x100000) {
                if (dirpress(PAD_UP) && stalltime > 0) {
                    stalltime -= 1.0
                }
                if (dirpress(PAD_DOWN) && stalltime < field_61 - 1.0) {
                    stalltime += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (stalltime == 0) {
                        LevelExit()
                    }
                    else {
                        changestateif(Pause_Menu_Root, stalltime == 1.0)
                    }
                }
            }
        }
    }
}

state Pause_Menu_Sound_Options { // 19
    stateflag 0x40001
    event => state Pause_Menu_Root
    code(MonoStereoOBJ, MusicVolOBJ, SFXVolOBJ) {
        KillDisplayChildren()
        if (MONOSOUND) {
            animframe = 116.0
        }
        else {
            animframe = 117.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, 0, getanim(TEXT), animframe, 0, 54.0, 0) // Mono/Stereo button
        MonoStereoOBJ = objectspawned
        spawn2(DispC, S_MENU_BUTTON, 1, 1.0, getanim(TEXT), 118.0, 0, 18.0, 0) // Music volume value
        MusicVolOBJ = objectspawned
        spawn2(DispC, S_MENU_BUTTON, 1, 2.0, getanim(TEXT), 118.0, 0, -18.0, 0) // Sound effects volume value
        SFXVolOBJ = objectspawned
        UpdateSoundOptionValue()
        if (var lang = GLOBAL_151; lang == 3.0) {
            LocalizedTextFrame = 119.0
        }
        else if (lang == 2.0) {
            LocalizedTextFrame = 120.0
        }
        else if (lang == 1.0 || lang == 4.0) {
            LocalizedTextFrame = 121.0
        }
        else {
            LocalizedTextFrame = 122.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, 1.0, getanim(TEXT), LocalizedTextFrame, 0, 36.0, 0) // Music volume button
        SetTextLanguage1(123.0, 124.0, 125.0, 126.0, 127.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 2.0, getanim(TEXT), LocalizedTextFrame, 0, 0, 0) // Sound effects button
        SetTextLanguage1(87.0, 88.0, 89.0, 90.0, 91.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 3.0, getanim(TEXT), LocalizedTextFrame, 0, -36.0, 0) // Done button
        sleepnull()
    }
    trans {
        once {
            TextScaleDefault()
            SetRot(0deg)
            stalltime = 0
            field_61 = 4.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x100000) {
                if (dirpress(PAD_UP) && stalltime > 0) {
                    stalltime -= 1.0
                }
                if (dirpress(PAD_DOWN) && stalltime < field_61 - 1.0) {
                    stalltime += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (var button_index = stalltime; button_index == 0) {
                        MONOSOUND = !MONOSOUND
                    }
                    else {
                        changestateif(Pause_Menu_Root, button_index == 3.0)
                    }
                }
            }
        }
        unless (STATUS_FIRSTFRAME) {
            if (var button_index = stalltime; button_index == 0) {
                if (dirpress(PAD_W) || dirpress(PAD_E)) {
                    MONOSOUND = !MONOSOUND
                }
            }
            else if (button_index == 1.0) {
                if (dirhold(PAD_W) && MUSVOL > 0) {
                    MUSVOL -= 4
                }
                if (dirhold(PAD_E) && MUSVOL < 0xFF) {
                    MUSVOL += 4
                }
            }
            else if (button_index == 2.0) {
                if (dirhold(PAD_W) && SFXVOL > 0) {
                    SFXVOL -= 4
                }
                if (dirhold(PAD_E) && SFXVOL < 0xFF) {
                    SFXVOL += 4
                }
            }
            UpdateSoundOptionValue()
        }
    }
}

sub UpdateSoundOptionValue(MonoStereoOBJ, MusicVolOBJ, SFXVolOBJ) __trans {
    interrupter = MonoStereoOBJ
    if (!MONOSOUND) {
        if (var lang = GLOBAL_151; lang == 1.0) {
            interrupter -> animframe = 128.0
        }
        else {
            interrupter -> animframe = 117.0
        }
    }
    else {
        var v1 = GLOBAL_151
        interrupter -> animframe = 116.0
    }
    if (MUSVOL < 0) {
        MUSVOL = 0
    }
    if (MUSVOL > 255) {
        MUSVOL = 255
    }
    interrupter = MusicVolOBJ
    interrupter -> var0 = MUSVOL * 100 / 255
    if (SFXVOL < 0) {
        SFXVOL = 0
    }
    if (SFXVOL > 255) {
        SFXVOL = 255
    }
    interrupter = SFXVolOBJ
    interrupter -> var0 = SFXVOL * 100 / 255
}

inline sub CountPoolBits(pool) {
    do (var bit = 0) {
        if (pool & (1 << bit)) {
            misc += 1
        }
    } while ({ bit += 1 }; bit < 32)
}

inline sub CountRelicTiers(goldbits, sappbits) {
    do (var bit = 0) {
        if (goldbits & (1 << bit)) {
            if (sappbits & (1 << bit)) {
                groundvel += 1
            }
            else {
                density += 1
            }
        }
        else if (sappbits & (1 << bit)) {
            field_63 += 1
        }
    } while ({ bit += 1 }; bit < 32)
}

state Pause_Menu_Init { // 20
    stateflag 0x40001
    code() {
        stalltime = GAMEFLAGS
        do {
            GLOBAL_73 = seek(GLOBAL_73, 8, 1)
            playnull()
        } until (GLOBAL_73 == 8)
        playnull()
        playnull()
        GAMEFLAGS &= ~0x28042001
        playnull()
        GLOBAL_73 = 0
        playnull()
        spawn2(DispC, S_PAUSE_BACKGROUND, 1)
        playnull()
        while (child -> stateflag & 0x2000) {
            playnull()
        }
        TextColorDefault()
        zindex = 100
        TextScaleDefault()
        field_62 = GLOBAL_23
        if (field_62) {
            misc = 0x8100
        }
        else {
            misc = 0x8200
        }
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), misc, 84.0, 116.0, 0, 0, 0x3E00) // Name / CRASH B text
        x = -144.0
        y = -61.0
        spawn2(DispC, S_PAUSE_MENU_ROOT, 1)
        creator = objectspawned
        SetScale(0x146, 0x207, 0x1000)
        {
            var v1 = SAVEDCRYSTALPOOL1
            var v2 = SAVEDCRYSTALPOOL2
            misc = 0
            CountPoolBits(GLOBAL_27)
            CountPoolBits(GLOBAL_28)
            PauseBossCount = misc
            misc = 0
            CountPoolBits(v1)
            CountPoolBits(v2)
            PauseCrystalCount = misc
            v1 = SAVEDGEMPOOL1
            v2 = SAVEDGEMPOOL2
            misc = 0
            CountPoolBits(v1)
            CountPoolBits(v2)
            PauseGemCount = misc
            v2 &= 0x7C000000
            misc = 0
            CountPoolBits(v2)
            yzapproach = PauseGemCount - misc
            misc = 0
            CountPoolBits((GLOBAL_150 & 0xFFFF))
            groundy = misc
            field_63 = 0
            density = 0
            groundvel = 0
            v1 = GLOBAL_175
            v2 = GLOBAL_177
            CountRelicTiers(v2, v1)
            v1 = GLOBAL_176
            v2 = GLOBAL_178
            CountRelicTiers(v2, v1)
            PauseCompletionPercent = PauseCrystalCount + (PauseGemCount + (groundy + (groundvel + (density + field_63))))
            if (GLOBAL_27 & 64) {
                PauseCompletionPercent += 1
            }
            if (GLOBAL_27 & 8) {
                PauseCompletionPercent += 1
            }
            if (GLOBAL_27 & 16) {
                PauseCompletionPercent += 1
            }
            if (GLOBAL_27 & 32) {
                PauseCompletionPercent += 1
            }
            if (GLOBAL_27 & 128) {
                PauseCompletionPercent += 1
            }
            v1 = GLOBAL_175 | GLOBAL_177
            v2 = GLOBAL_176 | GLOBAL_178
            unless (v1 \ -4.0 && v2 \ 63 && SAVEDGEMPOOL1 \ -2 && SAVEDGEMPOOL2 \ 0x7C00003F) {
                if (PauseCompletionPercent > 99) {
                    PauseCompletionPercent = 99
                }
            }
        }
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 131.0, 148.0, -74.0, 6, 5.0, offsetof(PauseCompletionPercent)) // Completion percentage
        TextScaleDefault()
        do (var panel, sequence) {
            spawn2(DispC, S_PAUSE_ITEM_PANEL, 1, panel, sequence, 0x5F, 84.0, 0)
            var0 = objectspawned
            panel = (panel + 1.0) % 5.0
            sequence += 1.0
            if (panel == 4.0 && LEVEL <= 7.0) {
                panel = (panel + 1.0) % 5.0
                sequence += 1.0
            }
            while (child == var0) {
                playnull()
            }
            playnull(2)
        } while (1)
    }
    event(e, a) {
        accevcstate(Pause_Menu_Close, interrupter != self && e == Event12)
    }
}

state Pause_Menu_Item_Panel { // 21
    stateflag 0x40001
    event => state Pause_Menu_Root
    code(panel, sequence, duration, base_x, base_y) {
        field_61 = sequence
        if (panel == 0) {
            SpawnCrystalPanel(base_x, base_y)
        }
        else if (panel == 1.0) {
            SpawnPowerPanel(base_x, base_y)
        }
        else if (panel == 2.0) {
            SpawnGemPanel(base_x, base_y)
        }
        else if (panel == 3.0) {
            SpawnRelicPanel(base_x, base_y)
        }
        else if (panel == 4.0) {
            SpawnTimeRecordsPanel(base_x, base_y)
        }
        do (var start = frametime) {
            if (buttonpress(PAD_TRIANGLE)) {
                break
            }
            playnull()
        } while (frametime - start < duration)
    }
    trans {
        PauseCrystalCount = creator -> PauseCrystalCount
        PauseGemCount = creator -> PauseGemCount
        yzapproach = creator -> yzapproach
        field_63 = creator -> field_63
        density = creator -> density
        groundvel = creator -> groundvel
    }
}

sub SpawnCrystalPanel(base_x, base_y) {
    SetTextLanguage1(132.0, 133.0, 134.0, 135.0, 136.0)
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x + 67.0, base_y + 69.0, 2, 0, 0x2500) // Crystals heading
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 137.0, base_x + 6.0, base_y + 21.0, 0, 0, offsetof(PauseCrystalCount)) // Crystal count
    spawn2(DispC, S_INVENTORY, 1, REWARD_CRYSTAL, base_x + 110.0, base_y, 4)
}

sub SpawnGemPanel(base_x, base_y) {
    if (var lang = GLOBAL_151; lang == 3.0) {
        LocalizedTextFrame = 138.0
    }
    else if (lang == 2.0 || lang == 1.0 || lang == 4.0) {
        LocalizedTextFrame = 139.0
    }
    else {
        LocalizedTextFrame = 140.0
    }
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x + 67.0, base_y + 69.0, 2, 0, 0x2500) // Gems heading
    {
        var v1 = SAVEDGEMPOOL1
        var v2 = SAVEDGEMPOOL2
        do (var i = 0) {
            if (var gem_bit = 58 + (i >> 8); gem_bit < 32) {
                misc = v1 & (1 << gem_bit)
            }
            else {
                misc = v2 & 1 << (gem_bit - 32)
            }
            if (misc) {
                misc = 4
            }
            else {
                misc = 2
            }
            unless (i & 0x1FF) {
                var0 = -6.0
            }
            else {
                var0 = 6.0
            }
            spawn2(DispC, S_INVENTORY, 1, 358.0 + i, base_x + (i * 28) + 11.0, base_y + (27.0 + var0), misc) // Special Gems
        } while ({ i += 1.0 }; i < 5.0)
    }
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 141.0, base_x - 2.0, base_y + 5.0, 0, 0, 0x3900) // Clear gem count
    spawn2(DispC, S_INVENTORY, 1, REWARD_GEM, base_x + 88.0, base_y - 5.0, 0)
    PanelCollectedItemCount = PauseGemCount
    PanelTotalitemCount = 42
    if (GLOBAL_150 & 0x400000) {
        PanelTotalitemCount += 1
    }
    if (GLOBAL_150 & 0x800000) {
        PanelTotalitemCount += 1
    }
    if (density + groundvel >= 30) {
        PanelTotalitemCount += 1
    }

    if (var lang = GLOBAL_151; lang == 3.0) {
        LocalizedTextFrame = 142.0
    }
    else if (lang == 2.0 || lang == 1.0 || lang == 4.0) {
        LocalizedTextFrame = 143.0
    }
    else {
        LocalizedTextFrame = 144.0
    }
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x, base_y - 21.0, 0, 0, offsetof(PanelCollectedItemCount)) // Gem count / total
}

sub SpawnRelicPanel(base_x, base_y) {
    SetTextLanguage1(145.0, 146.0, 147.0, 148.0, 149.0)
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x + 67.0, base_y + 69.0, 2, 0, 0x2500) // Relics heading
    {
        var row_y = base_y + 45.0
        if (groundvel) {
            if (var lang = GLOBAL_151; lang == 3.0) {
                LocalizedTextFrame = 150.0
            }
            else if (lang == 1.0 || lang == 4.0) {
                LocalizedTextFrame = 151.0
            }
            else if (lang == 2.0) {
                LocalizedTextFrame = 152.0
            }
            else {
                LocalizedTextFrame = 153.0
            }
            spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x - 16.0, row_y, 0, 0, 0x3500) // Platinum relic count
            row_y -= 20.0
        }
        if (density) {
            if (var lang = GLOBAL_151; lang == 1.0 || lang == 4.0) {
                LocalizedTextFrame = 154.0
            }
            else if (lang == 2.0) {
                LocalizedTextFrame = 155.0
            }
            else {
                LocalizedTextFrame = 156.0
            }
            spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x - 16.0, row_y, 0, 0, 0x3A00) // Gold relic count
            row_y -= 20.0
        }
        if (field_63 || !(density + groundvel)) {
            if (var lang = GLOBAL_151; lang == 3.0 || lang == 2.0) {
                LocalizedTextFrame = 157.0
            }
            else if (lang == 1.0) {
                LocalizedTextFrame = 158.0
            }
            else if (lang == 4.0) {
                LocalizedTextFrame = 159.0
            }
            else {
                LocalizedTextFrame = 160.0
            }
            spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x - 16.0, row_y, 0, 0, 0x3F00) // Sapphire relic count
        }
    }
    PanelCollectedItemCount = field_63 + (density + groundvel)
    PanelTotalitemCount = 28
    if (GLOBAL_150 & 0x400000) {
        PanelTotalitemCount += 1
    }
    if (GLOBAL_150 & 0x800000) {
        PanelTotalitemCount += 1
    }
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 161.0, base_x - 4.0, base_y - 20.0, 0, 0, offsetof(PanelCollectedItemCount)) // Relic count / total
    if (groundvel) {
        field_61 = RELIC_PLATINUM
    }
    else if (density) {
        field_61 = RELIC_GOLD
    }
    else {
        field_61 = RELIC_SAPPHIRE
    }
    spawn2(DispC, S_INVENTORY, 1, field_61, base_x + 108.0, base_y - 37.0, 0)
}

sub SpawnTimeRecordsPanel(base_x, base_y) {
    SetTextLanguage1(162.0, 163.0, 164.0, 165.0, 166.0)
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x + 67.0, base_y + 69.0, 2, 0, 0x2500) // Times heading
    spawn2(DispC, S_TIMETRIAL_RECORD, 1, LEVEL, 0, base_x + 68.0, base_y + 35.0)
    spawn2(DispC, S_TIMETRIAL_RECORD, 1, LEVEL, 1, base_x + 68.0, base_y + 4.0)
    spawn2(DispC, S_TIMETRIAL_RECORD, 1, LEVEL, 2, base_x + 68.0, base_y - 23.0)

}

sub SpawnPowerPanel(base_x, base_y) {
    SetTextLanguage1(167.0, 168.0, 169.0, 170.0, 171.0)
    spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x + 67.0, base_y + 69.0, 2, 0, 0x2500) // Powers heading
    var featured_power, power_count
    misc = 0
    CountPoolBits(GLOBAL_160)
    power_count = misc
    featured_power = power_count - (field_61 / 5.0) % power_count + 1
    if (power_count == 0) {
        SetTextLanguage1(172.0, 173.0, 174.0, 175.0, 176.0)
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), LocalizedTextFrame, base_x + 67.0, base_y + 9.0, 2, 0, 0x2500) // No powers text
    }
    var icon_x = base_x + 8.0
    var small_power_bits = GLOBAL_160 & (31 & ~(1 << featured_power))
    var small_power_count = 0
    misc = 0
    CountPoolBits(small_power_bits)
    small_power_count = misc
    icon_x += (4 - small_power_count) * 20.0
    var power_offs = 0
    do {
        if (small_power_bits & (1 << (power_offs >> 8))) {
            spawn2(DispC, S_INVENTORY, 1, REWARD_POWER + power_offs, icon_x, base_y + 33.0, 2)
            icon_x += 40.0
        }
    } while ({ power_offs += 1.0 }; power_offs < 5.0)
    if (power_count) {
        spawn2(DispC, S_INVENTORY, 1, REWARD_POWER + (featured_power << 8), base_x + 67.0, base_y - 5.0, 0)
    }
}

state Pause_Menu_Close { // 22
    stateflag 0x40001
    statusc 0x3
    code(resume_game) {
        cascadeevent(Event12, self)
        WaitChildNull()
        GLOBAL_73 = 8
        GAMEFLAGS = stalltime
        playnull()
        playnull()
        do {
            playnull()
            GLOBAL_73 = seek(GLOBAL_73, 0, 1)
        } while (GLOBAL_73)
        if (resume_game == 0) {
            GAMEFLAGS &= ~0x800000
            FadeToBlack()
            var0 = frametime
            do {
                playnull()
            } until (FADECONTROL == -1 || frametime - var0 >= 7)
        }
        PAUSEMENU = 0
        sendeventif(Event80, player, resume_game == 0, 0)
    }
}

state HUD_Collectable_Display { // 23
    statusc 0x0
    code(reward, x_pos, hide) {
        SetRewardAttributes(reward)
        zindex = 2000
        if (hide) {
            if (animseq == getanim(GEM_1) || animseq == getanim(RELIC) || animseq == getanim(POWERUP)) {
                animseq = 0
            }
            statusb = FLAG_INVISIBLE
            y = -102.0
            var0 = 0
        }
        else {
            y = -190.0
            var0 = getfield(player, DisplayVarField)
        }
        x = x_pos
        changestate(HUD_Collectable_Display_Show)
    }
}

state HUD_Collectable_Display_Show { // 24
    statusc 0x0
    code() {
        sleepframe(DisplayFrame)
    }
    trans {
        changestateif(HUD_Collectable_Display_Hide, frametime - statetime >= 1.5s && DisplayRewardType < REWARD_RELIC)
        y = seek(y, -102.0, 10.0)
        roty = spd(roty, 180deg)
        if (DisplayRewardType >= REWARD_CRYSTAL && getfield(player, DisplayVarField) > var0) {
            statusb &= ~FLAG_INVISIBLE
            if (DisplayRewardType >= REWARD_POWER) {
                statusb |= 0x100000
                stalltime = (getfield(player, DisplayVarField) - REWARD_POWER) >> 8
                setanim(POWERUP)
            }
            else if (DisplayRewardType >= REWARD_RELIC) {
                SetRelicColor(getfield(player, DisplayVarField))
            }
            else if (DisplayRewardType >= REWARD_GEM) {
                SetGemColor(getfield(player, DisplayVarField))
            }
        }
        if (GAMEFLAGS & 0x100000) {
            statusb |= FLAG_INVISIBLE
        }
    }
}

state HUD_Collectable_Display_Hide { // 25
    statusc 0x0
    code() {
        do {
            y = seek(y, -190.0, 4.0)
            playframe(DisplayFrame)
        } while (y != -190.0)
        sendevent(Event1, parent)
    }
    trans {
        changestateif(HUD_Collectable_Display_Show, buttonhold(PAD_TRIANGLE) && v0 == getfield(player, DisplayVarField))
        roty = spd(roty, 180deg)
    }
}

expr GEM_RED = 58.0
expr GEM_GREEN = 59.0
expr GEM_PURPLE = 60.0
expr GEM_BLUE = 61.0
expr GEM_YELLOW = 62.0

sub SetGemColor(reward) {
    if (reward == GEM_RED) {
        SetColor1(0x6C, 0x08, 0x08)
        setanim(GEM_1)
    }
    else if (reward == GEM_GREEN) {
        SetColor1(0x08, 0x6C, 0x08)
        setanim(GEM_2)
    }
    else if (reward == GEM_PURPLE) {
        SetColor1(0x6C, 0x08, 0x6C)
        setanim(GEM_3)
    }
    else if (reward == GEM_BLUE) {
        SetColor1(0x00, 0x00, 0x80)
        if (animseq != getanim(GEM_1)) {
            scalex = scalex * 1.2 >> 8
            scaley = scaley * 0.6 >> 8
            scalez = scalez * 1.2 >> 8
        }
        setanim(GEM_1)
    }
    else if (reward == GEM_YELLOW) {
        SetColor1(0x80, 0x80, 0x00)
        if (animseq != getanim(GEM_1)) {
            scalex = scalex * 0.9 >> 8
            scaley = scaley * 1.2 >> 8
            scalez = scalez * 0.9 >> 8
        }
        setanim(GEM_1)
    }
    else {
        SetColor1(0x5A, 0x5A, 0x6C)
        setanim(GEM_1)
    }
    moda = 4.0
    SetColor2(0x00, 0xE77, 0x6D7)
}

sub SetRelicColor(reward) {
    setanim(RELIC)
    if (reward >= RELIC_PLATINUM) {
        SetColor1(0xFF, 0xED, 0xE9)
    }
    else if (reward >= RELIC_GOLD) {
        SetColor1(0xD8, 0xD2, 0x09)
    }
    else {
        SetColor1(0x20, 0xA5, 0xFF)
    }
    SetColor2(-0xBFF, 0xA26, -0x302)
    moda = 4.0
}

sub SetRewardAttributes(reward) {
    DisplayRewardType = reward
    SetScale(0x147A)
    vfx = (vfx & 0xFFFFFF00) | 0xB
    vfx = (vfx & 0xFF00FFFF) | 0x30000
    if (reward == REWARD_CRYSTAL) {
        SetColorC2Obj(4.0, 0x80, 0x80, 0x80, -0xCCC, -0x800, 0x00)
        setanim(CRYSTAL)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem7)
        if (!child) {
            spawn2(DispC, S_CRYSTAL_GLOW, 1, 0)
        }
    }
    else if (reward == REWARD_POWER) {
        DisplayFrame = 0
        DisplayVarField = offsetof(mem10)
        animseq = 0
        SetVFX2D()
        vfx &= 0xFF00FFFF
    }
    else if (reward == REWARD_RELIC || reward == RELIC_SAPPHIRE || reward == RELIC_GOLD || reward == RELIC_PLATINUM) {
        DisplayFrame = 0
        DisplayVarField = offsetof(mem10)
        SetRelicColor(player -> mem10)
        animseq = 0
    }
    else if (reward == REWARD_GEM) {
        animseq = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem8)
        SetGemColor(player -> mem8)
    }
    else if (reward == REWARD_GEM_SPECIAL) {
        animseq = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem9)
        SetGemColor(player -> mem9)
    }
}

sub CheckPlayerInventory(reward, x_pos, hide) {
    var item, prev_child = child
    if (hide) {
        x = x_pos
        item = true
    }
    else if (reward == REWARD_RELIC || reward == RELIC_SAPPHIRE || reward == RELIC_GOLD || reward == RELIC_PLATINUM || reward == REWARD_POWER) {
        item = player -> mem10
    }
    else if (reward == REWARD_CRYSTAL) {
        item = player -> mem7
    }
    else if (reward == REWARD_GEM) {
        item = player -> mem8
    }
    else if (reward == REWARD_GEM_SPECIAL) {
        item = player -> mem9
    }
    if (item) {
        spawn2(DispC, S_COLLECTABLE_DISPLAY, 1, reward, x_pos, hide)
        if (prev_child != child) {
            field_62 += 1.0
        }
    }
}

state Collectable_Manager_Init { // 26
    code() {
        statusb = FLAG_STRING_CENTER | FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        x = 0
        z = 0
        DisplayVar14 = 0
        field_62 = 0
        changestate(Collectable_Manager)
    }
}

state Collectable_Manager { // 27
    code() {
        statusb |= FLAG_INVISIBLE
        y = 190.0
        sleepframe(DisplayFrame)
    }
    event(e, a) {
        if (e == Event32) {
            CollectedRewardType = a[0]
            CollectedRewardArg = a[1.0]
            if (field_62 == 0) {
                if (CollectedRewardType == RELIC_SAPPHIRE || CollectedRewardType == RELIC_GOLD || CollectedRewardType == RELIC_PLATINUM || CollectedRewardType == REWARD_POWER || CollectedRewardType == REWARD_CRYSTAL) {
                    CheckPlayerInventory(CollectedRewardType, 0, true)
                }
                else if (CollectedRewardType == REWARD_GEM) {
                    CheckPlayerInventory(REWARD_GEM, -40.0, true)
                }
                else if (CollectedRewardType == REWARD_GEM_SPECIAL) {
                    CheckPlayerInventory(REWARD_GEM_SPECIAL, 40.0, true)
                }
            }
            accevret()
        }
        if (e == Event1) {
            field_62 -= 1.0
        }
    }
    trans {
        if (buttonhold(PAD_TRIANGLE)) {
            if (field_62 == 0 && !(GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED)) {
                CheckPlayerInventory(REWARD_CRYSTAL, 0, 0)
                CheckPlayerInventory(REWARD_GEM, -40.0, 0)
                CheckPlayerInventory(REWARD_GEM_SPECIAL, 40.0, 0)
                CheckPlayerInventory(player -> mem10, 0, 0)
            }
        }
    }
}

state Demo_Text { // 28
    stateflag 0x10001
    code(x_pos, y_pos) {
        statusb = FLAG_STRING_CENTER
        SetVFX2D()
        zindex = 100
        DEMOTEXTOBJ = self
