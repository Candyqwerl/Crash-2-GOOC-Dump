#gool UfoOC 51 3

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 2 -r pal "C3\C3_UfoOC.gooc" "C3\Out\C3_UfoOC.nsentry"

#anim UFO_IDLE     [Uf1rV] 17 1
#anim UFO_ARMED_1  [Uf2rV] 4 0
#anim UFO_ARMED_2  [Uf3rV] 3 0
#anim UFO_FIRE     [Uf5rV] 17 1
#anim SPARKS       [Uf4rV] 17 1
#anim ASS_HEAD     [Uf6rV] 1 0
#anim UFO_SHADOW   [Uf7rV] 1 0

#spawn S_UFO       UFO_Init
#spawn S_HEAD      Head
#spawn S_SPARKS    Sparks
#spawn S_SHADOW    Shadow

event EventJumpedOn      => state UFO_Squash
event EventHit           => state UFO_Squash
event EventSpinHit       => state UFO_Fling
event EventHitInvincible => state UFO_Squash
event EventFling         => state UFO_Fling

var CycleOffs, CycleLen, TurnDuration, FireAnimLoops, IdleAnimLoops, UFOTrackOffset, HoverHeight, TravelDuration

inline sub SpawnReflection() {
    if (ZONEFLAGS & 0x800) {
        spawn(13, 11, 1) // FutOC-11
    }
}

state UFO_Init {
    code(max_track, cyclelen, cycleoffs, turndur, height, fire_loops, idle_loops, pathloop) {
        FireAnimLoops = fire_loops + 1.0
        IdleAnimLoops = idle_loops - 1.0
        pathdist = max_track
        CycleLen = cyclelen * 1s / 1.2s
        CycleOffs = cycleoffs * 1s / 1.2s
        TurnDuration = turndur * 1s / 1.2s
        UFOTrackOffset = 0m
        HoverHeight = height
        density = 0.15m
        zindex = fieldval(ENTITY_FIELD_ZINDEX)
        if (zindex == 0) {
            zindex = 25
        }
        groundy = y
        trotx = 720deg
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        TravelDuration = (CycleLen - (TurnDuration << 1)) >> 1
        spawn(UfoOC, S_SHADOW, 1)
        SpawnReflection()
        spawn(UfoOC, S_HEAD, 1, 0)
        spawn(UfoOC, S_SPARKS, 1)
        if (pathloop == true) {
            changestate(UFO_Circle)
        }
        else {
            changestate(UFO)
        }
    }
}

state UFO {
    stateflag 0x4085
    statusc 0
    code() {
        do {
            do {
                do (var loops = 0) {
                    playframes(UFO_IDLE, 0.0, 16.0)
                    loops += 1.0
                } while (loops < IdleAnimLoops)
                unless (HoverHeight < 2.25m) {
                    break
                }
            } while (1)
            playanim(0, UFO_ARMED_1)
            playanim(1, UFO_ARMED_1)
            playanim(2, UFO_ARMED_1)
            playanim(2, UFO_ARMED_1)
            do (var loops = 0) {
                playframes(UFO_FIRE, 0.0, 16.0)
                loops += 1.0
            } while (loops < FireAnimLoops)
            playanim(0, UFO_ARMED_2)
            playanim(1, UFO_ARMED_2)
            playanim(1, UFO_ARMED_2)
        } while (1)
    }
    event(e, a) {
        rejevret(e == EventSpinHit && (player -> y < y + 0.5m || player -> vely >= 0))
        accevcstate(UFO_Abduct_Player, e == Event81)
    }
    trans {
        unless (STATUS_FIRSTFRAME) {
            var cycle_time = time(CycleLen, CycleOffs)
            if (cycle_time >= 0 && cycle_time <= TurnDuration) {
                troty += (cycle_time * -180deg) / TurnDuration
                calcpath(0)
            }
            else if (cycle_time >= TurnDuration && cycle_time <= TurnDuration + TravelDuration) {
                calcpath(((cycle_time - TurnDuration) * (pathlen - 1.0)) / TravelDuration)
            }
            else if (cycle_time >= TurnDuration + TravelDuration && cycle_time <= (TurnDuration << 1) + TravelDuration) {
                troty += ((cycle_time - (TurnDuration + TravelDuration)) * -180deg) / TurnDuration
                calcpath(pathlen - 1.0)
            }
            else if (cycle_time >= (TurnDuration << 1) + TravelDuration && cycle_time <= CycleLen) {
                calcpath((pathlen - 1.0) + (((cycle_time - ((TurnDuration << 1) + TravelDuration)) * -(pathlen - 1.0)) / (CycleLen - ((TurnDuration << 1) + TravelDuration))))
            }
        }
        if (pathdist) {
            var v1 = 0
            var deg_to_player = 0deg
            var pathrot = troty
            save (troty, statusa, statusb, x, y, z, pathprog) {
                statusb = FLAG_PATH_CALCS | FLAG_TRACK_PATH_SIGN
                x = player -> x
                y = player -> y
                z = player -> z
                calcpath(0)
                v1 = troty
                troty += 90deg
                setvel(UFOTrackOffset, vvel)
            }
            x += velx
            z += velz
            if (abs(UFOTrackOffset - vecy) > 0.1m) {
                deg_to_player = degdist(troty, atan2(player -> trans))
                if (abs(deg_to_player) < 60deg) {
                    if (deg_to_player < -45deg) {
                        deg_to_player = -45deg
                    }
                    else if (deg_to_player > 45deg) {
                        deg_to_player = 45deg
                    }
                    troty += deg_to_player
                }
            }
            UFOTrackOffset = seek(UFOTrackOffset, vecy, spd(2m))
            if (UFOTrackOffset < -pathdist) {
                troty = pathrot
                UFOTrackOffset = -pathdist
            }
            else if (UFOTrackOffset > pathdist) {
                UFOTrackOffset = pathdist
                troty = pathrot
            }
            y += HoverHeight
            vecx = CAMTRANSX
            vecy = CAMTRANSY
            vecz = CAMTRANSZ
            roty = atan2(self, vecx)
            if (collider) {
                if (!(player -> statusa & FLAG_GROUNDLAND) && ((player -> stateflag & 0x10) || y - 0.14m < player -> y)) {
                    sendevent(EventHit, collider, 100.0)
                }
                else {
                    sendevent(Event24, collider, 100.0)
                }
            }
        }
    }
}

state UFO_Circle {
    stateflag 0x4085
    statusc 0
    code => state UFO
    event => state UFO
    trans {
        unless (STATUS_FIRSTFRAME) {
            var cycle_time = time(CycleLen, CycleOffs)
            if (cycle_time >= 0 && cycle_time <= CycleLen) {
                calcpath((cycle_time * (pathlen - 1.0)) / CycleLen)
            }
        }
        if (pathdist) {
            var deg_to_player = 0deg
            var pathrot = troty
            save (troty, statusa, statusb, x, y, z, pathprog) {
                statusb = FLAG_PATH_CALCS | FLAG_TRACK_PATH_SIGN
                x = player -> x
                y = player -> y
                z = player -> z
                calcpath(0)
                troty += 90deg
                setvel(UFOTrackOffset, vvel)
            }
            x += velx
            z += velz
            if (abs(UFOTrackOffset - vecy) > 0.1m) {
                deg_to_player = degdist(troty, atan2(player -> trans))
                if (abs(deg_to_player) < 60deg) {
                    if (deg_to_player < -45deg) {
                        deg_to_player = -45deg
                    }
                    else if (deg_to_player > 45deg) {
                        deg_to_player = 45deg
                    }
                    troty += deg_to_player
                }
            }
            UFOTrackOffset = seek(UFOTrackOffset, vecy, spd(2m))
            if (UFOTrackOffset < -pathdist) {
                troty = pathrot
                UFOTrackOffset = -pathdist
            }
            else if (UFOTrackOffset > pathdist) {
                UFOTrackOffset = pathdist
                troty = pathrot
            }
            y += HoverHeight
            vecx = CAMTRANSX
            vecy = CAMTRANSY
            vecz = CAMTRANSZ
            roty = atan2(self, vecx)
            if (collider) {
                if (player -> vely < 0 || y - 0.14m < player -> y) {
                    sendevent(EventHit, collider, 100.0)
                }
                else {
                    sendevent(Event24, collider, 100.0)
                }
            }
        }
    }
}

state UFO_Abduct_Player {
    stateflag 0x4085
    statusc 0x10
    code() {
        velx = player -> x - x
        vecx = player -> x
        velz = player -> z - z
        vecz = player -> z
        vely = 0
        statusb = FLAG_COLLIDABLE | FLAG_PHYSICS_ENGINE
        do {
            x += player -> x - vecx
            vecx = player -> x
            z += player -> z - vecz
            vecz = player -> z
            y = seek(y, player -> y + 2m, spd(1m))
            if (frametime - statetime >= 1s) {
                statusb = 0
            }
            if (animseq != getanim(UFO_FIRE)) {
                setanim(UFO_FIRE, -1.0)
            }
            playframe((animframe + 1.0) % 17.0)
        } while (1)
    }
}

state UFO_Fling {
    stateflag 0x30
    statusc 0x32
    code(h) {
        EnemyFlingCombo(h)
        EnemyFlingSetDir()
        EnemyFlingSetVel(3m)
        EnemyFlingWaitScale()
    } 
    trans {
        EnemyFlingTrans(2m, EventFling)
    }
}

state UFO_Squash {
    stateflag 0x23
    statusc 0x32
    code(h) {
        entitysetspawn(0)
        sendevent(EventCombo, player, h)
        EnemyDieClearFlags()
        playframe()
        spawn(9, 4, 1, getins(SetParticleColor), 1)
        playframe()
    }
}

sub SetParticleColor() {
    vfx = (vfx & 0xFFFF00FF) | 0x300
    if (var r = rand(3); r == 0) {
        SetColor1(0x05, 0xBD, 0xBE)
    }
    else if (r == 1) {
        SetColor1(0x0D, 0x4C, 0x4C)
    }
    else if (r == 2) {
        SetColor1(0xE7, 0x85, 0x81)
    }
}

state Head {
    statusc 0x12
    __transargs
    code(vert) {
        vfx = (vfx & 0xFFFFFF00) | 0x5
        statusb = FLAG_ROT_Y | 0x2000
        trotx = 360deg
        yzapproach = 90deg
        zindex = 32
        SpawnReflection()
        sleepanim(0, ASS_HEAD)
    }
    trans {
        getvert(vtrans, parent, vert)
        troty = degseek(atan2(player -> trans), 1750deg)
        trotz = degseek(atan2_3d(self, player -> trans), 750deg)
    }
}

state Sparks {
    statusc 0x12
    code() {
        var0 = 0
        zindex = 32
        voice = 0
        SpawnReflection()
        do {
            if (parent -> animseq == getanim(UFO_FIRE)) {
                if (var0 == 2) {
                    soundfadet(0.1s, voice)
                    soundfadev(0V, voice, 3)
                }
                if (var0 != 1) {
                    soundpitch(0x343)
                    soundplay([Uf2rA], 1V)
                    soundpitch(0x2E7)
                    soundcount(0xFFFF)
                    sounddecay(0xF5)
                    soundplay([Uf4rA], 1V)
                }
                var0 = 1
                statusb = FLAG_COLLIDABLE
                setanim(SPARKS)
                playframe(parent -> animframe)
            }
            else {
                if (var0 == 1) {
                    soundfadet(0.1s, voice)
                    soundfadev(0V, voice, 3)
                }
                if (var0 != 2) {
                    soundpitch(0x343)
                    soundplay([Uf3rA], 1V)
                    soundpitch(0x343)
                    soundcount(0xFFFF)
                    sounddecay(0xF5)
                    soundplay([Uf1rA], 1V)
                }
                var0 = 2
                statusb = 0
                playnull()
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event10) {
            accev()
            sendevent(Event10, parent, a[0])
        }
    }
    trans {
        rotx = parent -> rotx
        roty = parent -> roty
        rotz = parent -> rotz
        x = parent -> x
        y = parent -> y
        z = parent -> z
        if ((!(player -> stateflag & 0x20) && !player -> invincible) && !(parent -> stateflag & 0x20)) {
            sendevent(Event24, collider, 100.0)
            sendeventif(Event81, parent, eventaccepted)
        }
    }
}

state Shadow {
    statusc 0x12
    code() {
        zindex = 32
        do {
            x = parent -> x
            z = parent -> z
            roty = parent -> roty
            playanim(0, UFO_SHADOW)
        } while (1)
    }
}