expr BoxGhostTargetStart      = BoxVar2
expr BoxGhostTargetEnd        = BoxVar3
expr BoxTransFunc             = BoxVar4
expr BoxCollisionMask         = BoxVar5
expr BoxPathParent            = BoxVar5
expr BoxBaseY                 = BoxVar10
// Wave
expr BoxWaveOriginX           = BoxVar5
expr BoxWaveOriginZ           = BoxVar11
// Slot
expr BoxSlotLastChangeTime    = BoxVar5
expr BoxSlotInterval          = BoxVar10
expr BoxSlotIndex             = BoxVar11
// Spring
expr BoxSpringPopulsion       = BoxVar8
// Fruit
expr BoxFruitHits             = BoxVar8
expr BoxFruitBreakPoint       = BoxVar9
