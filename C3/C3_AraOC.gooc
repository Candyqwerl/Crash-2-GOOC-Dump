#gool AraOC 55 3

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 2 -r pal "C3\C3_AraOC.gooc" "C3\Out\C3_AraOC.nsentry"

#anim BOUNCE_TARP        [TN1mV] 16 1
#anim BALCONY            [BalqV] 1 1
#anim PLATFORM_1         [PlaqV] 1 1
#anim PLATFORM_2         [PlayV] 1 1
#anim SKY                [Sk1qV] 1 1

#spawn S_BOUNCE_TARP     Bounce_Tarp_Init
#spawn S_SKY             Sky
#spawn S_BALCONY         Balcony
#spawn S_PLATFORM_FIRE   Platform
#spawn S_HANG_BOOST      Hang_Boost
#spawn S_PLATFORM        Platform

var BouncePropulsion, BounceCooldown

state Sky { // 0
    stateflag 0x10001
    statusc 0
    code() {
        if (LEVEL == LEVEL_HangEmHigh) {
            settrans(SkyRotate)
            statusb = FLAG_NO_CAMERA_CLIP
            SetScale(0.1S)
            zindex = -4000
            sleepanim(0, SKY)
        }
    }
    trans {
        x = CAMTRANSX
        y = CAMTRANSY
        z = CAMTRANSZ
    }
}

sub SkyRotate() {
    x = CAMTRANSX
    y = CAMTRANSY
    z = CAMTRANSZ
    roty = spd(roty, 8deg)
}

state Bounce_Tarp_Init { // 1
    statusc 0
    code(yaw, propulsion) {
        roty = yaw
        BouncePropulsion = propulsion
        statusb = FLAG_SOLID_FULL
        zindex = 24
        BounceCooldown = frametime
        changestate(Bounce_Tarp)
    }
}

state Bounce_Tarp { // 2
    stateflag 0x4081
    statusc 0x80012
    code() {
        sleepanim(0, BOUNCE_TARP)
    }
    event(e, a) {
        if (player -> y > y - 0.25m && interrupter == player && (e == EventJumpedOn || e == EventSlamHit)) {
            BounceCooldown = frametime + 1
            sendevent(Event21, interrupter, BouncePropulsion)
            rejevcstate(Bounce_Tarp_Bounce)
        }
        rejevret(e == EventJumpedOn
            || e == EventSlamHit
            || e == EventSlideHit
            || e == EventSpinHit
            || e == EventHit
            || e == EventHitInvincible
            || e == EventFling
        )
    }
    trans {
        if (collider && player -> y > y - 0.25m
            && !(player -> stateflag & 0x80000)
            && !(player -> stateflag & 0x10)
            && !(player -> stateflag & 0x800)) {
                sendevent(Event21, collider, BouncePropulsion)
                if (eventaccepted) {
                    BounceCooldown = frametime + 1
                    changestate(Bounce_Tarp_Bounce)
                }
            }
    }
}

state Bounce_Tarp_Bounce { // 3
    stateflag 0x4081
    statusc 0x80012
    event => state Bounce_Tarp
    code() {
        soundpitch((14.4 + rand(3.2)) * 0.295 >> 8)
        sounddecay(6.4s)
        soundplay([BT1mA], 0.4V)
        playframes(BOUNCE_TARP, 0.0, 15.0)
        changestate(Bounce_Tarp)
    }
    trans {
        if (collider && player -> y > y - 0.25m
            && !(player -> stateflag & 0x80000)
            && !(player -> stateflag & 0x10)
            && !(player -> stateflag & 0x800)) {
                sendevent(Event21, collider, BouncePropulsion)
                if (eventaccepted) {
                    BounceCooldown = frametime + 1
                    changestateif(Bounce_Tarp_Bounce, frametime - statetime >= 0.25s)
                }
            }
    }
}

state Balcony { // 4
    code(yaw) {
        roty = yaw
        statusb = 0
        zindex = fieldval(ENTITY_FIELD_ZINDEX)
        if (!zindex) zindex = 26;
        sleepanim(0, BALCONY)
    }
}

state Platform { // 5
    stateflag 0x201
    code(yaw) {
        roty = yaw
        statusb = 0
        zindex = fieldval(ENTITY_FIELD_ZINDEX)
        if (!zindex) zindex = 26;
        if (spawn == S_PLATFORM_FIRE) {
            sleepanim(0, PLATFORM_1)
        }
        else {
            sleepanim(0, PLATFORM_2)
        }
    }
}

state Hang_Boost { // 6
    stateflag 0x800201
    code(sx, sy, sz, a) {
        SetScale(sx, sy, sz)
        y += 3m
        statusb = FLAG_COLLIDABLE
        sleepnull()
    }
    trans {
        if (collider && collider -> stateflag & 0x8) {
            collider -> vely = spd(collider -> vely, 10m)
        }
    }
}