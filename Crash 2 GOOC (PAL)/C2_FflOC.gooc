#gool FflOC 57 5

#include "goolstdlib.gooc"

#anim JUNGLE_FIREFLY[JuFcV] 12 0

#sprite DUST_PARTICLE[Cr10T]
#tex 0x808080 0 3 0 9 768 96 32 32

#anim NIGHT_SHADOW[ShacV] 1 0

#sprite FLARES[Nj3cT]
#tex 0xC0C0C0 0 3 4 7 272 16 16 16
#tex 0x808080 0 3 4 7 272 16 16 16
#tex 0xC0C0C0 1 3 0 4 000 64 64 64
#tex 0x808080 0 3 5 7 704 64 32 32
#tex 0xD0D0D0 0 3 5 7 704 64 32 32
#tex 0xC0C0C0 0 3 4 7 272 16 16 16
#tex 0xC0C0C0 0 3 6 7 288 16 16 16
#tex 0xC0C0C0 0 3 7 7 448 64 64 64
#tex 0xC0C0C0 0 3 9 7 704 32 32 32

#spawn S_0              __s_0
#spawn S_FIREFLY        Firefly_Init
#spawn S_2              __s_2
#spawn S_3              __s_3
#spawn S_FLARE_MASTER   Flare_Master
#spawn S_FLARE_SLAVE    Flare_Slave
#spawn S_GLOW           Firefly_Glow
#spawn S_FIREFLY_PATH   Firefly_Path_Init

var Lifetime, HasTarget, TargetX, TargetY, TargetZ, FireflyID, BonusFlag, CollectionFrame, LightSourceRegistered,
    DetachWarningWindow, OrbitYOff, DetachY, FireflyBaseY, FireflyBaseX, IdleBobAmpY, IdleBobAmpX, FlyAwaySpeed, OrbitPitch, TargetOrbitPitch,
    OrbitYaw, OrbitYawSpeed, OrbitRadius, TargetOrbitRadius, PathBobOffset, PathBobVelocity, NextBobTime, CanFollowPath, FlarePulse, FlareAlpha,
    GlowAlpha, FlareScreenAngle, RotateFlare

state Firefly_Init { // 0
    code(lifetime, has_target, target_ax, target_ay, target_az, local_id, bonus_flag) {
        Lifetime = lifetime * 1s / 1.2s
        HasTarget = has_target
        TargetX = target_ax
        TargetY = target_ay
        TargetZ = target_az
        FireflyID = local_id
        BonusFlag = bonus_flag
        LightSourceRegistered = false
        if (FireflyID && GLOBAL_126 & (1 << FireflyID)) {
            return
        }
        FlarePulse = 16.0
        spawn(FflOC, S_FLARE_MASTER, 1)
        DetachWarningWindow = Lifetime - 2.5s
        trotx = 180deg
        playnull()
        RegisterLightSource()
        y += 0.2m
        changestate(Firefly_Idle)
    }
    event(e, a) {
        if (e == EventDespawn) {
            accev()
            KillLightSource()
        }
        if (e == EventRespawn) {
            miscfunc(x, player, 0, 9)
            KillLightSource()
            accevcstate(Firefly_Kill)
        }
    }
}

sub UpdateFireflyRotation() {
    var pitch, yaw, angle
    var local_z = velz, local_x = velx, neg_yaw, flat_spd
    angle = atan(local_x, local_z)
    yaw = angle % 360deg
    neg_yaw = -angle
    local_z = ((local_z >> 8) * cos(neg_yaw)) >> 4
    flat_spd = local_z - (((local_x >> 8) * sin(neg_yaw)) >> 4)
    pitch = atan(vely, flat_spd) % 360deg
    rotx = -pitch
    rotz = yaw
    roty = yaw
}

sub RegisterLightSource(){
    if(!LightSourceRegistered) {
        if (GLOBAL_54) {
            if (GLOBAL_120 == 0) {
                GLOBAL_120 = self
                GLOBAL_55 += 1.0
                LightSourceRegistered = true >> 8
            }
        }
        else {
            GLOBAL_54 = self
            GLOBAL_55 += 1.0
            LightSourceRegistered = true >> 8
        }
    }
}

sub DeregisterLightSource(){
    if (LightSourceRegistered) {
        GLOBAL_55 -= 1.0
        LightSourceRegistered = false
        if (GLOBAL_55 < 0) {
            GLOBAL_55 = 0
        }
        if (GLOBAL_54 == self) {
            GLOBAL_54 = 0
            if (GLOBAL_120) {
                GLOBAL_54 = GLOBAL_120
                GLOBAL_120 = 0
            }
        }
        if (GLOBAL_120 == self) {
            GLOBAL_120 = 0
        }
    }
}

sub RegisterFireflyCollection(){
    if (FireflyID) {
        entitysetstate(8)
        GLOBAL_126 |= 1 << FireflyID
        id = 0
    }
    else {
        entitysetspawn(0)
    }
}

state Firefly_Idle { // 1
    event => state Firefly_Init
    code() {
        statusb = FLAG_ROT_Y | FLAG_COLLIDABLE
        sleepframes(JUNGLE_FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            FireflyBaseY = y
            FireflyBaseX = x
        }
        if(!LightSourceRegistered) {
            RegisterLightSource()
        }
        var0 = (frametime & 31) << 6
        if (var0 > 90deg) {
            var0 = 180deg - var0
        }
        rotx = var0 - 45deg

        var0 = ((frametime + 0.3s) & 31) << 6
        if (var0 > 90deg) {
            var0 = 180deg - var0
        }
        var0 -= 45deg
        if ((var0 > 0deg && y < FireflyBaseY) || (var0 < 0deg && FireflyBaseY < y) || y == FireflyBaseY) {
            IdleBobAmpY = rand(0.6m) + 0.4m
        }
        var0 = (sin(var0) * (IdleBobAmpY >> 4)) >> 8
        y = FireflyBaseY + var0

        var0 = (time(1.3s) * 0x7E07) >> 8
        if (var0 > 180deg) {
            var0 = 360deg - var0
        }
        var0 -= 90deg
        if ((var0 > 0deg && x < FireflyBaseX) || (var0 < 0deg && FireflyBaseX < x) || x == FireflyBaseX) {
            IdleBobAmpX = rand(0.3m) + 0.2m
        }
        x = FireflyBaseX + ((sin(var0) * (IdleBobAmpX >> 4)) >> 8)
        troty = atan2(player -> trans)
        rotz = roty
        changestateif(Firefly_Attached, collider || (abs(x - player -> x) < 1.2m && abs(z - player -> z) < 1.2m && abs(y - player -> y) < 1.5m))
    }
}

state Firefly_Attached { // 2
    stateflag 0x40001
    statusc 0
    event => state Firefly_Init
    code() {
        sleepframes(JUNGLE_FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            RegisterFireflyCollection()
            CollectionFrame = frametime
            OrbitYOff = 0.75m
            statusb = FLAG_ROT_Y

            vecx = x - player -> x
            vecy = y - (player -> y + OrbitYOff)
            vecz = z - player -> z
            var orbit_z = vecz
            var orbit_x = vecx
            var neg_yaw = 0deg
            OrbitYaw = atan(orbit_x, orbit_z)
            neg_yaw = -OrbitYaw
            orbit_z = ((orbit_z >> 8) * cos(neg_yaw)) >> 4
            var flat_spd = orbit_z - (((orbit_x >> 8) * sin(neg_yaw)) >> 4)
            OrbitYaw &= 0xFFF
            OrbitPitch = atan(vecy, flat_spd) % 360deg
            var0 = 0
            if (OrbitPitch > 180deg) {
                OrbitPitch = 0deg
            }
            OrbitRadius = distance(player, DIST_EXACT)
            if (OrbitRadius < 1.5m) {
                OrbitRadius = 1.5m
            }
            TargetOrbitRadius = OrbitRadius
            TargetOrbitPitch = OrbitPitch
            OrbitYawSpeed = 60deg
        }
        if (GLOBAL_119 & 0x2000) {
            changestateifn(Firefly_Kill, BonusFlag)
        }
        else {
            changestateif(Firefly_Kill, BonusFlag)
        }
        if (TargetOrbitRadius == OrbitRadius) {
            TargetOrbitRadius = 1.5m + rand(1.6m)
        }
        OrbitRadius = seek(OrbitRadius, TargetOrbitRadius, 215.95deg)
        if (OrbitPitch == TargetOrbitPitch) {
            if (frametime - CollectionFrame >= DetachWarningWindow) {
                TargetOrbitPitch = rand(10deg) - 60deg
            }
            else {
                TargetOrbitPitch = rand(80deg) + 15deg
            }
        }

        /*TODO: Fix this? CE gool disasm shows native restarting after a nop with no preceding gool instruction..
        * Crash 3 uses degseek here but causes issues with pre detach rise and orbit height..? I dont know. Current implementation looks weird but seems to work fine. */
        OrbitPitch = seek(loopseek(OrbitPitch, TargetOrbitPitch), 45deg)

        OrbitYaw = (OrbitYaw + OrbitYawSpeed) % 360deg
        OrbitYawSpeed = seek(OrbitYawSpeed, 16.8deg, 1deg)

        var oldx = x, oldy = y, oldz = z
        trotx = -OrbitPitch
        troty = OrbitYaw
        trotz = OrbitYaw
        vecx = player -> x
        vecy = player -> y + OrbitYOff
        vecz = player -> z
        vectransf2(vvec, vtrans, OrbitRadius, 0, 0)

        velx = ((x + (player -> velx >> 3)) - oldx) >> 2
        vely = ((y + (player -> vely >> 5)) - oldy) >> 2
        velz = ((z + (player -> velz >> 3)) - oldz) >> 2
        x = oldx + velx
        y = oldy + vely
        z = oldz + velz
        UpdateFireflyRotation()

        var0 = frametime - CollectionFrame
        if (var0 >= DetachWarningWindow) {
            OrbitYOff = seek(OrbitYOff, 2.5m, 0.14m)
            changestateif(Firefly_Detached, var0 >= Lifetime)
        }
    }
}


state Firefly_Detached { // 3
    stateflag 0x40001
    statusc 0
    event => state Firefly_Init
    code() {
        sleepframes(JUNGLE_FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            projectzoneshadow(var0)
            if (eventaccepted) {
                DetachY = vecy
                var0 = vecy - player -> y
                if (var0 > 0m) {
                    if (var0 > 4m) {
                        DetachY = player -> y
                    }
                }
                else if (var0 < -2m) {
                    DetachY = player -> y
                }
            }
            else {
                DetachY = player -> y
            }

            FireflyBaseY = y - DetachY
            FlyAwaySpeed = 0.4m

            if (HasTarget) {
                if (BonusFlag) {
                    if (TargetX < x) {
                        HasTarget = 0
                    }
                }
                else {
                    if (z < TargetZ || z - TargetZ > 60m) {
                        HasTarget = 0
                    }
                }
            }

            if (BonusFlag) {
                unless(HasTarget) {
                    TargetX = player -> x + 20m
                    TargetY = player -> y
                    TargetZ = player -> z + 15m
                }
            }
            else {
                unless(HasTarget) {
                    TargetX = player -> x
                    TargetY = player -> y
                    TargetZ = player -> z - 20m
                }
            }
        }

        var dx = TargetX - x, dz = TargetZ - z
        changestateif(Firefly_Vanish, abs(dx) + abs(dz) <= (FlyAwaySpeed << 1))
        unless(abs(dx) + abs(dz) <= (FlyAwaySpeed << 1)) {
            while (abs(dx) >= 0.32m || abs(dz) >= 0.32m) {
                dx >>= 6
                dz >>= 6
            }
            var dist = abs(dx) + abs(dz)
            velx = (((FlyAwaySpeed >> 8) * dx) / dist) << 8
            velz = (((FlyAwaySpeed >> 8) * dz) / dist) << 8
        }

        FireflyBaseY = seek(FireflyBaseY, 0.36m, 0.16m)
        var old_y = DetachY
        projectzoneshadow(var0)
        if (eventaccepted) {
            DetachY = vecy
            var0 = vecy - old_y
            if (var0 > 0m) {
                if (var0 > 4m) {
                    DetachY = old_y + 0.1m
                }
            }
            else if (var0 < -3m) {
                DetachY = old_y - 0.1m
            }
            else {
                DetachY = old_y
            }
        }

        vely = ((DetachY + FireflyBaseY) - y) >> 3
        x += velx
        y += vely
        z += velz
        UpdateFireflyRotation()
        FlyAwaySpeed = seek(FlyAwaySpeed, 1m, 16.0)

    }
}

state Firefly_Vanish { // 4
    stateflag 0x40002
    event => state Firefly_Init
    code() {
        statusb = FLAG_PHYSICS_ENGINE
        var loops = 0
        do {
            playframes(JUNGLE_FIREFLY, 0.0, 11.0)
            loops += 1.0
        } while (loops < 3.0)
        KillLightSource()
        playnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            vely = 4m
            if (BonusFlag) {
                velx = 25m
                velz = -(4m + rand(4m))
                if (rand(2)) {
                    velz = -velz
                }
            }
            else {
                velz = -25m
                velx = 4m + rand(4m)
                if (rand(2)) {
                    velx = -velx
                }
            }
        }
        UpdateFireflyRotation()
    }
}

sub KillLightSource(){
    DeregisterLightSource()
}

state Firefly_Kill { // 5
    code => sub KillLightSource
}

state Flare_Master { // 6
    stateflag 0x40001
    code() {
        vfx = (vfx & 0xFFFFFF00) | 0x6
        SetScale(0xA3, 0xA2, 0x1000)
        spawn(FflOC, S_FLARE_SLAVE, 1, 1.0, -3.0, 0.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 2.0, -2.0, 1.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 3.0, 2.0, 3.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 4.0, 2.2, 4.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 5.0, 6.0, 5.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 6.0, 8.0, 6.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 7.0, 11.0, 7.0)
        spawn(FflOC, S_FLARE_SLAVE, 1, 8.0, 12.0, 8.0)
        spawn(FflOC, S_GLOW, 1, 2.0)
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            SetRot(0deg)
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        /*creator -> FlarePulse ... dead read?*/
        zindex = creator -> zindex
        FlarePulse = (time(12) * 16.0) / 12
        if (FlarePulse >= 8.0) {
            FlarePulse = 16.0 - FlarePulse
        }
        FlarePulse += 8.0

        FlareAlpha = 0
        GlowAlpha = 0
        var camdx = (x - CAMTRANSX) >> 8
        var camdz = (z - CAMTRANSZ) >> 8
        var depth = ((camdx * sin(-CAMROTY)) >> 4) - ((camdz * cos(-CAMROTY)) >> 4)

        if (depth >= 0m) {
            var fade = depth - 12m
            if (fade < 0m) {
                fade = 0m
            }
            if (fade <= 14m) {
                GlowAlpha = (((14m - fade) >> 8) * 10.0) / 21.875
            }
        }

        if (depth >= 0m) {
            var fade = depth - 4m
            if (fade < 0m) {
                fade = 0m
            }
            if (fade <= 12m) {
                FlareAlpha = (((12m - fade) >> 8) << 10) / 18.75
            }
        }

        zindex = zindex - ((depth * 3) >> 13) + 24
        FlareAlpha = (FlarePulse * FlareAlpha) >> 12
        GlowAlpha = (FlarePulse * GlowAlpha) >> 12

        if (FlareAlpha || GlowAlpha) {
            moveto2d(null, 0, 0)
            FlareScreenAngle = atan(y, x)
            velx = (((-x) << 1) + (((-x) << 1) >> 2)) / 12
            vely = (((-y) << 1) + (((-y) << 1) >> 2)) / 12
        }
    }
}

state Flare_Slave { // 7
    stateflag 0x40001
    __transargs
    code(type, offset, frame) {
        do {
            if (FlareAlpha) {
                setanim(FLARES)
                playframe(frame)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            setanim(FLARES, -1.0)
            vfx = (vfx & 0xFFFFFF00) | 0x6
            RotateFlare = 0
            if (type == 0) {
                scalex = 4.055
                scaley = 4.055
            }
            else if (type == 1.0) {
                scalex = 1.015
                scaley = 1.015
                RotateFlare = 1
            }
            else if (type == 2.0) {
                scalex = 1.015
                scaley = 1.015
                RotateFlare = 1
            }
            else if (type == 3.0) {
                scalex = 2.03
                scaley = 2.03
            }
            else if (type == 4.0) {
                scalex = 1.015
                scaley = 1.015
            }
            else if (type == 5.0) {
                scalex = 0.505
                scaley = 0.505
            }
            else if (type == 6.0) {
                scalex = 1.015
                scaley = 1.015
            }
            else if (type == 7.0) {
                scalex = 4.055
                scaley = 4.055
            }
            else if (type == 8.0) {
                scalex = 2.03
                scaley = 2.03
            }
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        velx = creator -> velx
        vely = creator -> vely
        velz = creator -> velz
        FlareAlpha = creator -> FlareAlpha
        FlareScreenAngle = creator -> FlareScreenAngle
        zindex = creator -> zindex
        if (FlareAlpha) {
            x += (velx * offset) >> 8
            y += (vely * offset) >> 8
            if (RotateFlare) {
                rotz = FlareScreenAngle + 45deg
            }
            moda = 16.0 - FlareAlpha
        }
    }
}

state Firefly_Glow { // 8
    stateflag 0x40001
    code(frame) {
        do {
            if (GlowAlpha) {
                setanim(FLARES)
                playframe(frame)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            setanim(FLARES, -1.0)
            vfx = (vfx & 0xFFFFFF00) | 0x6
            scalex = 4.055
            scaley = 4.055
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        GlowAlpha = creator -> GlowAlpha
        zindex = creator -> zindex
        if (GlowAlpha) {
            moda = 16.0 - GlowAlpha
        }
    }
}

state Firefly_Path_Init { // 9
    code() {
        LightSourceRegistered = false
        FlarePulse = 360deg
        spawn(FflOC, S_FLARE_MASTER, 1)
        trotx = 180deg
        playnull()
        RegisterLightSource()
        PathBobOffset = 0m
        PathBobVelocity = 0m
        NextBobTime = frametime + rand(2s)
        OrbitYaw = 0deg
        OrbitRadius = 0.65m
        TargetOrbitRadius = OrbitRadius
        changestate(Firefly_Path_Wait)
    }
    event(e, a) {
        if (e == EventDespawn) {
            accev()
            KillLightSource()
        }
        if (e == EventRespawn) {
            KillLightSource()
            accevcstate(Firefly_Kill)
        }
    }
}

sub FireflyPathMotion() {
    var oldx = x, oldy = y, oldz = z
    var oldbob = 0, bobdelta = 0

    calcpath(pathprog)

    if (frametime >= NextBobTime) {
        PathBobVelocity += (rand(1.6m) + 0.9m) / 25
        NextBobTime = frametime + rand(0.9s) + 0.2s
    }

    oldbob = PathBobOffset
    if (PathBobVelocity || PathBobOffset == 0) {
        bobdelta = PathBobVelocity - (PathBobOffset / 25)
        PathBobOffset += bobdelta
        PathBobVelocity = bobdelta

        if (oldbob >= 0) {
            if (PathBobOffset < 1) {
                PathBobVelocity -= PathBobVelocity >> 3
            }
        }
        else if (PathBobOffset >= 0) {
            PathBobVelocity -= PathBobVelocity >> 3
        }
    }

    y += PathBobOffset + 0.6m
    if (!CanFollowPath) {
        x += (cos(OrbitYaw) * OrbitRadius) >> 12
        z += (sin(OrbitYaw) * OrbitRadius) >> 12
        OrbitYaw = (OrbitYaw + 14.35deg) % 360deg
        OrbitRadius = seek(OrbitRadius, TargetOrbitRadius, 4.8)
    }

    velx = (x - oldx) >> 2
    vely = (y - oldy) >> 2
    velz = (z - oldz) >> 2
    x = oldx + velx
    y = oldy + vely
    z = oldz + velz
    UpdateFireflyRotation()
}

state Firefly_Path_Wait { // 10
    event => state Firefly_Path_Init
    code() {
        statusb = 0
        sleepframes(JUNGLE_FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            pathprog = 0
            CanFollowPath = false
        }
        unless(LightSourceRegistered) {
            RegisterLightSource()
        }
        changestateif(Firefly_Path_Active, x - player -> x < 3.75m)
        FireflyPathMotion()
    }
}

state Firefly_Path_Active { // 11
    event => state Firefly_Path_Init
    code() {
        statusb = FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | 0x800 | 0x2000
        sleepframes(JUNGLE_FIREFLY, 0.0, 11.0)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            trotx = 360deg
            yzapproach = 180deg
            CanFollowPath = true >> 8
            PathBobVelocity += 30.4
        }

        pathprog = spd(pathprog, 5.5)
        if (pathprog >= pathlen) {
            pathprog = pathlen - 1
        }
        FireflyPathMotion()
        changestateif(Firefly_Path_End_Idle, pathprog >= pathlen - 1)
    }
}

state Firefly_Path_End_Idle { // 12
    event => state Firefly_Path_Init
    code() {
        statusb = 0
        CanFollowPath = false
        TargetOrbitRadius = 0.36m
        sleepframes(JUNGLE_FIREFLY, 0.0, 11.0)
    }
    trans {
        FireflyPathMotion()
    }
}

