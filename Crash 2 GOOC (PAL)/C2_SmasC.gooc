#gool SmasC 32 5

#include "goolstdlib.gooc"

#anim SMASHER                 [Sm1eV] 16 1
#anim SMASHER_CONST           [Sm2eV] 21 1
#anim ROLLER                  [Ro1eV] 1 1
#anim ROLLER_REFLECTION       [Ro2eV] 1 1
#anim ICE_SLIDE               [Is1eV] 1 1
#anim ICICLE_1                [Ic1eV] 42 1
#anim ICICLE_2                [Ic2eV] 42 1
#anim ICICLE_3                [Ic3eV] 42 1
   
#spawn S_SMASHER              Smasher_Init
#spawn S_SMASHER_CONST        Smasher_Const_Init
#spawn S_ROLLER               Roller_Init
#spawn S_ICICLE               Icicle_Init
#spawn S_ICE_SLIDE            Ice_Slide_Init
#spawn S_ROLLER_REFLECTION    Roller_Reflection

var TriggerDistance, SmasherCycleLen, SmasherCycleOff, SmashDelay,
    RollerStartDist, RollerYoff, RollerSpeed, RollerStopDist, RollerLastX, EntityID

state Smasher_Init { // 0
    code(dist, delay) {
        TriggerDistance = dist
        SmashDelay = delay * 1s / 1.2s
        zindex = 24
        statusb = FLAG_SOLID_SIDES
        changestate(Smasher)
    }
}

state Smasher { // 1
    code() {
        sleepanim(0, SMASHER)
    }
    trans {
        changestateif(Smasher_Triggered, abs(x - player -> x) < TriggerDistance && !(player -> stateflag & 0x20) && !player -> invincible)
    }
}

state Smasher_Triggered { // 2
    code() {
        WaitFrame(0, SMASHER, SmashDelay)
        changestate(Smasher_Smash)
    }
}

state Smasher_Smash { // 3
    stateflag 0x81
    code() {
        SoundPitchDefault(0.23)
        soundplay([SDoGA], 0.4V)
        statusb |= FLAG_COLLIDABLE
        playframes(SMASHER, 2.0, animframe, 15.0)
        tpc = 0
        SoundPitchDefault()
        soundplay([CsmsA], 0.75V)
        if (SHAKEY == 0) {
            SHAKEY = 0 > 3.2m / 256 - abs(x - player -> x) / (1m / 256) ? 0 : 3.2m / 256 - abs(x - player -> x) / (1m / 256)
        }
        wait(1.25s)
        changestate(Smasher_Retract)
    }
    trans {
        if (collider) {
            if (abs(x - player -> x) < TriggerDistance - 0.2m && !(player -> stateflag & 0x20) && !player -> invincible) {
                sendevent(EventCrush, collider, 100.0)
                if (eventaccepted) {
                    statusb &= ~FLAG_COLLIDABLE
                }
            }
        }
    }
}

state Smasher_Retract { // 4
    code() {
        SoundPitchDefault(0.23)
        soundplay([SUpGA], 0.4V)
        playframesback(SMASHER, animframe, 0.0)
        changestate(Smasher)
    }
    trans {
        changestateif(Smasher_Smash, animframe < 7.5 && abs(x - player -> x) < TriggerDistance && !(player -> stateflag & 0x20)  & !player -> invincible)
    }
}

state Smasher_Const_Init { // 5
    code(cyclelen, cycleoff, dist) {
        SmasherCycleLen = cyclelen * 1s / 1.2s
        SmasherCycleOff = cycleoff * 1s / 1.2s
        TriggerDistance = dist
        zindex = 24
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        changestate(Smasher_Const)
    }
}

state Smasher_Const { // 6
    code() {
        setanim(SMASHER_CONST)
        sleepframe(20.0)
    }
    trans {
        changestateifn(Smasher_Const_Smash, time(SmasherCycleLen, SmasherCycleOff) || !(!(player -> stateflag & 0x20) && !player -> invincible))
    }
}

state Smasher_Const_Smash { // 7
    stateflag 0x81
    trans => state Smasher_Smash
    code() {
        SoundPitchDefault(0.23)
        soundplay([SDoGA], 0.2V)
        statusb |= FLAG_COLLIDABLE
        playframesback(SMASHER_CONST, 4.0, 20.0, 0.0)
        SoundPitchDefault()
        soundplay([CsmsA], 0.75V)
        if (SHAKEY == 0) {
            SHAKEY = 0 > 3.2m / 256 - ((abs(x - player -> x) / (1m / 256)) >> 1) ? 0 : 3.2m / 256 - ((abs(x - player -> x) / (1m / 256)) >> 1)
        }
        tpc = 0
        wait(0.2s)
        SoundPitchDefault(0.23)
        soundplay([SUpGA], 0.2V)
        playframes(SMASHER_CONST, 0.0, 20.0)
        changestate(Smasher_Const)
    }
}

state Roller_Init { // 8
    code(cycleoff, startdist, speed, reflection) {
        RollerSpeed = 0.25s * speed
        RollerStartDist = startdist
        pathprog = (cycleoff - 128.0) * pathlen >> 15
        if (pathprog >= pathlen) {
            pathprog = pathlen - 1
        }
        else if (pathprog <= -pathlen) {
            pathprog = -pathlen + 1
        }
        calcpath(abs(pathprog))
        rotz = 90deg
        zindex = -5
        density = 0.2m
        RollerYoff = 0.2m
        RollerStopDist = z - 2m
        statusb = FLAG_TRACK_PATH_ROT | FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        statusa |= FLAG_PATH_END
        if (reflection) {
            spawn(SmasC, S_ROLLER_REFLECTION, 1)
            groundy = y - 4.8m
        }
        changestate(Roller)
    }
}

state Roller { // 9
    code() {
        sleepanim(0, ROLLER)
    }
    trans {
        save(groundy) {
            RollerLastX = x
            if (!STATUS_PATH_END || player -> z > RollerStopDist && player -> z < RollerStopDist + RollerStartDist) {
                if (STATUS_PATH_END) {
                    soundpitch(3.625)
                    sounddecay(5.78s)
                    soundplay([RoleA], 0.5V)
                }
                statusb &= ~FLAG_INVISIBLE
                LoopPathProg(spd(5.4))
                rotx = rotx - (360deg * (RollerLastX - x)) / RollerSpeed
                y += RollerYoff
            }
            else if (player -> z >= RollerStopDist + RollerStartDist) {
                statusb |= FLAG_INVISIBLE
            }
            sendevent(Event24, collider, 100.0)
        }
    }
}

state Roller_Reflection { // 10
    stateflag 0x40001
    statusc 0x12
    code() {
        zindex = 0
        do {
            if (GLOBAL_119 & 0x1000) {
                x = parent -> x
                z = parent -> z
                vfx = parent -> vfx
                scaley = parent -> scaley
                scalez = parent -> scalez
                roty = parent -> roty
                rotx = -(parent -> rotx + 180deg)
                rotz = parent -> rotz
                scalex = -(parent -> scalex)
                y = parent -> groundy - (parent -> y - parent -> groundy)
                playanim(0, ROLLER_REFLECTION)
            }
            else {
                playnull()
            }
        } while (1)
    }
}

state Icicle_Init { // 11
    code(dist, falldist, reflection, obj) {
        TriggerDistance = dist
        groundy = y - (falldist - 1.5m)
        EntityID = obj
        zindex = 24
        statusb = FLAG_SOLID_SIDES | FLAG_COLLIDABLE
        setanim(ICICLE_3)
        roty = (id * 0xEA2) % 0xFDD
        if (reflection) {
            if (ZONEFLAGS & 0x800) {
                spawn(9, 28, 1)
            }
            else {
                vfx = (vfx & 0xFFFF00FF) | 0xC00
            }
        }
        changestate(Icicle)
    }
}

state Icicle { // 12
    code() {
        sleepframe(0)
    }
    event(e, a) {
        accevcstate(Icicle_Fall, e == Event3)
    }
    trans {
        changestateif(Icicle_Fall, abs(x - player -> x) < TriggerDistance)
    }
}

state Icicle_Fall { // 13
    stateflag 0x81
    code() {
        entitysetspawn(0)
        soundpitch((8.0 + rand(0.8)) * 0.43 >> 8)
        sounddecay(4s)
        soundplay([Sk1GA], 0.2V)
        playframes(ICICLE_3, 3.0, 0, 19.0)
        settrans(IcicleFalling)
        statusb |= FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND
        playframes(20.0, 24.0)
        do { playframe() } until(statusa \ FLAG_GROUNDLAND)
        if (EntityID) {
            interrupter = objectget(EntityID)
            sendeventif(Event23, interrupter, interrupter)
        }
        SoundPitchDefault(0.3)
        sounddecay(4s)
        soundplay([nbr0A], 0.5V)
        tpc = 0
        statusb = 0
        playframes(27.0, 40.0)
    }
}

sub IcicleFalling(){
    vely = spd(vely, -100m)
    sendevent(Event24, collider, 100.0)
}

state Ice_Slide_Init { // 14
    stateflag 0x80000201
    code(xrot, scax, scay, scaz) {
        scalex = scax >> 2
        scaley = scay >> 2
        scalez = scaz >> 2
        scalex = scalex * 1.1 >> 8
        statusb = FLAG_COLLIDABLE | FLAG_INVISIBLE | FLAG_2D | FLAG_SOLID_TOP
        rotz = 90deg
        rotx = xrot
        changestate(Ice_Slide)
    }
}

state Ice_Slide { // 15
    stateflag 0x80000201
    statusc 0x200002
    code() {
        sleepanim(0, ICE_SLIDE)
    }
    trans {
        once {
            field_61 = 0
        }
        sendevent(Event15, player, 9.0)
        if (collider && statusa & 0x4000 || !(frametime - field_61 >= 0.18s)) {
            player -> statusa |= 0x2000000
            if (collider) {
                field_61 = frametime
            }
            sendevent(Event54, player)
            player -> velx += vecx >> 2
            player -> vely += vecy >> 2
            player -> velz += vecz >> 2
        }
    }
}