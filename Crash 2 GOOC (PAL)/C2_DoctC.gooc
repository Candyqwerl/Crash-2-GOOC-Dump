#gool DoctC 5 1

#include "goolstdlib.gooc"
#include "C2_ShadC.gooh"

#anim WITCH_DOCTOR           [WD10V] 1 0
#anim WITCH_DOCTOR_GOLD      [WD30V] 1 0
#anim ANIM_006               [1010I] 6 1
#anim ANIM_009               [1011I] 13 1
#anim WITCH_DOCTOR_FEATHER   [WD20V] 16 0

#sprite DOCTOR_SPARKLE_BLUE[Cr10T]
#tex 0xFF1700 0 3 8 6 704 32 32 32
#tex 0xCC1200 0 3 8 6 704 32 32 32
#tex 0x990E00 0 3 8 6 704 32 32 32
#tex 0x660900 0 3 8 6 704 32 32 32
#tex 0x330400 0 3 8 6 704 32 32 32

#sprite DOCTOR_SPARKLE_GOLD[Cr10T]
#tex 0x00E6FF 0 3 8 6 704 32 32 32
#tex 0x00B8CC 0 3 8 6 704 32 32 32
#tex 0x008A99 0 3 8 6 704 32 32 32
#tex 0x005C66 0 3 8 6 704 32 32 32
#tex 0x002E33 0 3 8 6 704 32 32 32

#sprite DOCTOR_SPARKLE_RED[Cr10T]
#tex 0x0023FF 0 3 8 6 704 32 32 32
#tex 0x001CCC 0 3 8 6 704 32 32 32
#tex 0x001599 0 3 8 6 704 32 32 32
#tex 0x000E66 0 3 8 6 704 32 32 32
#tex 0x000733 0 3 8 6 704 32 32 32

#sprite DOCTOR_SPARKLE_PURPLE[Cr10T]
#tex 0xEB00B4 0 3 8 6 704 32 32 32
#tex 0xBC0090 0 3 8 6 704 32 32 32
#tex 0x8D006C 0 3 8 6 704 32 32 32
#tex 0x5E0048 0 3 8 6 704 32 32 32
#tex 0x2F0024 0 3 8 6 704 32 32 32

#sprite DOCTOR_SPARKLE_GREEN[Cr10T]
#tex 0x00BE00 0 3 8 6 704 32 32 32
#tex 0x009800 0 3 8 6 704 32 32 32
#tex 0x007200 0 3 8 6 704 32 32 32
#tex 0x004C00 0 3 8 6 704 32 32 32
#tex 0x002600 0 3 8 6 704 32 32 32

#sprite DOCTOR_SPARKLE_WHITE[Cr10T]
#tex 0xFFFFFF 0 3 8 6 704 32 32 32

expr DOCTOR_STATUS_GET_HEALTH = 4.0
expr DOCTOR_STATUS_SET_LIGHT = 7.0

#spawn S_DOCTOR                 Witch_Doctor_Init
#spawn S_1                      __s_1
#spawn S_DOCTOR_FEATHER         Doctor_Feather
#spawn S_DOCTOR_SPARKLE         Doctor_Sparkle
#spawn S_DOCTOR_PARTICLE        Doctor_Particle
#spawn S_DOCTOR_PARTICLE_DECEL  Doctor_Particle
#spawn S_6                      __s_6
#spawn S_7                      __s_7

event Event15 => sub DoctorStatus
event Event19 => sub KillDoctor

var mem1, mem2, mem3, mem4, mem5,
    mem6, mem7, mem8, mem9, mem10,
    DoctorHealth, DoctorFloatOffset, DoctorFollowing, DoctorFaceDirOffset,
    DoctorXDistance, DoctorSize, DoctorLookTime, DoctorLightTimeLeft

inline sub SoundAddDoctor() {
    soundpitch(5.08)
    sounddecay(9.6s)
    soundplay([WD10A], 1V)
}

inline sub SoundKillDoctor() {
    soundpitch(3.263)
    sounddelay(0.18s)
    sounddecay(9.6s)
    soundplay([WD20A], 1V)
}

inline sub SoundHitInvincible() {
    soundpitch(3.625)
    sounddecay(10.22s)
    soundplay([sht0A], 0.7V)
}

inline sub SpawnDoctorFeather() {
    spawn(DoctC, S_DOCTOR_FEATHER, 1, 0x00, 0x17, 0xFF)
    spawn(DoctC, S_DOCTOR_FEATHER, 1, 0xFF, 0xE6, 0x00)
    spawn(DoctC, S_DOCTOR_FEATHER, 1, 0xFF, 0x23, 0x00)
    spawn(DoctC, S_DOCTOR_FEATHER, 1, 0xB4, 0x00, 0xEB)
    spawn(DoctC, S_DOCTOR_FEATHER, 1, 0x00, 0xBE, 0x00)
}

sub FollowTarget() {
    var0 = distance(vecx, self, 0)
    if (DoctorHealth == 3.0) {
        x = seek(x, vecx, spd(20m))
        y = seek(y, vecy, spd(20m))
        z = seek(z, vecz, spd(20m))
        changestateif(Witch_Doctor_On_Willy, x == vecx && y == vecy && z == vecz)
    }
    else if (abs(var0) > 30m) {
        x = x + vecx >> 1
        y = y + vecy >> 1
        z = z + vecz >> 1
    }
    else if (DoctorFollowing) {
        trotz = abs(var0) + 1m
        velx = spd(velx, vecx - x << 5)
        vely = spd(vely, vecy - y << 5)
        velz = spd(velz, vecz - z << 5)
        DoctorXDistance = 1.5m
        if (var0 < 0.75m) {
            DoctorLookTime = frametime
            DoctorFollowing = 0
        }
    }
    else {
        trotz = (abs(var0) >> 3) + 0.2m
        velx = spd(velx, vecx - x << 2)
        vely = spd(vely, vecy - y << 6)
        velz = spd(velz, vecz - z << 2)
        if (var0 > 1m) {
            DoctorFollowing = 1.0
        }
        DoctorXDistance = 1m
        if (frametime - 15s >= DoctorLookTime) {
            DoctorLookTime = frametime
        }
    }
    if (trotz > 4.5m) {
        trotz = 4.5m
    }
}

sub SetTargetPosition() {
    if (DoctorHealth == 1.0 || DoctorHealth == 2.0) {
        save(trotx, troty, trotz) {
            vecx = collider -> x
            vecy = collider -> y
            vecz = collider -> z
            trotx = 0deg
            troty = collider -> troty + DoctorFaceDirOffset
            trotz = 0deg
            vectransf2(vvec, player, 0, DoctorXDistance, 1.3m + sin(abs(DoctorFloatOffset), 0.3m))
        }
    }
    else if (DoctorHealth == 3.0) {
        getvert(vvec, collider, 1.0)
    }
}

state Witch_Doctor_Init { // 0
    code(health) {
        collider = player
        vfx = (vfx & 0xFFFF00FF) | 0x100
        collider -> creator = self
        DOCTOR = self
        zindex = 15
        trotx = 4m
        troty = 4m
        trotz = 4m
        DoctorFloatOffset = 0
        trotx = 200deg
        DoctorFollowing = 0
        DoctorSize = 1S
        DoctorLookTime = frametime
        DoctorXDistance = 1.5m
        if (health == 1.0) {
            DoctorHealth = 1.0
            seqplay(DoctorHealth)
            statusb = FLAG_ROT_Y | FLAG_PHYSICS_ENGINE | 0x400 | 0x1000
            x = player -> x
            y = player -> y + 3m
            z = player -> z
            changestate(Witch_Doctor)
        }
        else if (health == 2.0 || health == 3.0) {
            DoctorHealth = 2.0
            seqplay(DoctorHealth)
            statusb = FLAG_ROT_Y | FLAG_PHYSICS_ENGINE | 0x400 | 0x1000
            DoctorSize = 1.3S
            x = CAMTRANSX
            y = CAMTRANSY
            z = CAMTRANSZ + -2m
            changestate(Witch_Doctor)
        }
        else {
            changestate(Witch_Doctor_Dead)
        }
    }
}

state Witch_Doctor { // 1
    stateflag 0x20009
    statusc 0
    code() {
        do {
            if (DoctorHealth == 1.0) {
                playanim(0, WITCH_DOCTOR)
            }
            else {
                playanim(0, WITCH_DOCTOR_GOLD)
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event6) {
            rejevret(DoctorHealth >= 3.0 || (DoctorHealth >= 2.0 && (collider -> stateflag & 0x4000000 || collider -> stateflag & 0x20000000)))
            if (interrupter -> spawn != 13) {
                sendevent(Event40, collider, a[0], -2)
                rejevret(!eventaccepted)
            }
            DoctorHealth += 1.0
            seqplay(DoctorHealth)
            SoundAddDoctor()
            spawn(DoctC, S_DOCTOR_PARTICLE_DECEL, 10)
            if (DoctorHealth >= 3.0) {
                sendevent(Event6, collider, a[0])
                SetInvincible(5)
                accevret()
            }
            else {
                DoctorSize = 1.3S
                SetScale(2S)
            }
            accevcstate(Witch_Doctor_Collect)
        }
        if (e == EventHit) {
            creator = collider -> interrupter
            sendevent(Event10, creator, 0)
            if (eventaccepted) {
                SoundHitInvincible()
            }
            creator = collider -> collider
            broadcastevent(Event43, 0, 0)
            if (DoctorHealth >= 3.0) {
                accevret()
            }
            if (DoctorHealth == 2.0) {
                SoundKillDoctor()
                SpawnDoctorFeather()
                SetInvincible(4)
                DoctorSize = 16.0
                SetScale(1.5S)
                DoctorHealth += -1.0
                seqplay(DoctorHealth)
                accevret()
            }
            accevcstate(Witch_Doctor_Die)
        }
    }
    trans {
        if (DoctorHealth == 2.0) {
            if (FRAMETIME < 32) {
                unless(time(0.15s)) {
                    spawn(DoctC, S_DOCTOR_SPARKLE, 1, 34.0, self, 0.3s)
                }
            }
            else unless(time(0.55s)) {
                spawn(DoctC, S_DOCTOR_SPARKLE, 1, 34.0, self, 0.3s)
            }
        }
        if (abs(degdist(collider -> roty + 120deg, GAMEDIR)) < 80deg) {
            DoctorFaceDirOffset = DoctorFollowing ? 200deg : 150deg
        } 
        else {
            DoctorFaceDirOffset = DoctorFollowing ? -20deg : 20deg
        }
        if (!DoctorFollowing && frametime - DoctorLookTime >= 1s && !(frametime - DoctorLookTime >= 6s)) {
            trotx = 60deg
            troty = GAMEDIR
        }
        else {
            trotx = 200deg
            troty = collider -> roty + (abs(DoctorFloatOffset >> 6) + -(abs(DoctorFloatOffset >> 7)))
        }
        rotz = roty
        rotx = abs(DoctorFloatOffset >> 7)
        if (scalex != DoctorSize) {
            scalex = seek(scalex, DoctorSize, 0.1S)
            scaley = seek(scaley, DoctorSize, 0.1S)
            scalez = seek(scalez, DoctorSize, 0.1S)
        }
        zindex = player -> zindex - 9
        SetTargetPosition()
        FollowTarget()
    }
}

state Witch_Doctor_On_Willy { // 2
    stateflag 0x9
    statusc 0
    event => state Witch_Doctor
    code() {
        statusb &= ~FLAG_ROT_Y
        DoctorSize = 1.5S
        while (collider -> invincible && !(collider -> stateflag \ 0x42408)) {
            playanim(0, WITCH_DOCTOR_GOLD)
        }
        SoundKillDoctor()
        DoctorHealth -= 1.0
        seqplay(DoctorHealth)
        DoctorSize = 1S
        statusb |= FLAG_ROT_Y
        changestate(Witch_Doctor)
    }
    trans {
        unless(time(0.18s)) {
            spawn(DoctC, S_DOCTOR_SPARKLE, 1, 34.0, self, 0.3s)
        }
        if (abs(degdist(CAMROTY, player -> roty)) < 90deg) {
            zindex = player -> zindex + 70
        }
        else {
            zindex = player -> zindex - 50
        }
        roty = collider -> roty
        rotz = roty
        getvert(vtrans, collider, 1.0)
        rotx = collider -> field_60 >> 8
        creator = collider -> collider
        sendevent(Event10, creator, 0)
        if (eventaccepted) {
            SoundHitInvincible()
            spawn(DoctC, S_DOCTOR_PARTICLE, 10)
        }
        trotx = 1m
        troty = 3m
        trotz = 1m
        broadcastevent(EventHitInvincible, 5, 0)
        if (eventaccepted) {
            SoundHitInvincible()
            spawn(DoctC, S_DOCTOR_PARTICLE, 10)
        }
        if (scalex != DoctorSize) {
            scalex = seek(scalex, DoctorSize, 0.1S)
            scaley = seek(scaley, DoctorSize, 0.1S)
            scalez = seek(scalez, DoctorSize, 0.1S)
        }
    }
}

state Witch_Doctor_Die { // 3
    stateflag 0xB
    statusc 0
    event => state Witch_Doctor_Dead
    code() {
        statusb &= ~(FLAG_ROT_Y | FLAG_PHYSICS_ENGINE | FLAG_GRAVITY)
        SoundKillDoctor()
        SpawnDoctorFeather()
        while (scalex > 0.04S) {
            playanim(0, WITCH_DOCTOR)
        }
        changestate(Witch_Doctor_Dead)
    }
    trans {
        once {
            DoctorHealth = 0
            seqplay(DoctorHealth)
            var0 = 1S
        }
        scalex = loopseek(v0, 1.2S, 0.2S)
        scaley = scalex
        scalez = scalex
    }
}

state Witch_Doctor_Dead { // 4
    statusc 0
    code() {
        statusb = FLAG_INVISIBLE
        DoctorHealth = 0
        seqplay(DoctorHealth)
        sleepanim(0, DOCTOR_SPARKLE_BLUE)
    }
    event(e, a) {
        if (e == Event6) {
            if (interrupter -> spawn != 13) {
                sendevent(Event40, collider, a[0], -2)
                if (!eventaccepted) {
                    rejevret()
                }
            }
            DoctorHealth = 1.0
            seqplay(DoctorHealth)
            creator = a[0]
            x = creator -> x
            velx = 0
            rotx = 0
            y = creator -> y
            vely = 0
            roty = 0
            z = creator -> z
            velz = 0
            rotz = 0
            DoctorFloatOffset = 0
            trotx = 200deg
            DoctorFollowing = 0
            DoctorXDistance = 1.5m
            SoundAddDoctor()
            spawn(DoctC, S_DOCTOR_PARTICLE_DECEL, 10)
            SetScale(1S)
            DoctorSize = 1S
            statusb = FLAG_ROT_Y | FLAG_PHYSICS_ENGINE | 0x400 | 0x1000
            accevcstate(Witch_Doctor_Collect)
        }
    }
}

state Doctor_Sparkle { // 5
    stateflag 0xA0001
    code(v, o, t) {
        player = o
        zindex = 24
        SetRot(0deg)
        SetScale(0S)
        field_61 = t - 5
        getvert(vtrans, player, rand(v))
        WaitFrame(0, DOCTOR_SPARKLE_GOLD, t)
    }
     trans {
		once {
            v0 = 0.3S
        }
        unless(STATUS_FIRSTFRAME) {
            scalex = seek(scalex, v0, 0.06S)
            scaley = seek(scaley, v0, 0.06S)
            scalez = seek(scalez, v0, 0.06S)
            if (frametime - statetime >= field_61) {
                v0 = 0S
            }
        }
    }
}

sub DoctorParticleAnim() {
    playanim(4, DOCTOR_SPARKLE_GOLD)
    playframe(3.0)
    playframe(4.0)
    playframe(2.0)
    playframe(1.0)
    playframe(0, 0.1s)
    save(animseq) { playanim(0, DOCTOR_SPARKLE_WHITE) }
    playframe(0)
    playframe(1.0, 0.1s)
    playframe(2.0, 0.1s)
    save(animseq) { playanim(0, DOCTOR_SPARKLE_WHITE) }
    playframe(3.0, 0.1s)
    playframe(4.0, 0.1s)
}

state Kill { // 6
    stateflag 0x20
    statusc 0
    code() { }
}

state Doctor_Feather { // 7
    stateflag 0x80
    code(r, g, b) {
        SetScale(1.5S)
        DoctorFloatOffset = y
        v0 = -10m
        SetColor(r << 1, g << 1, b << 1)
        moda = 16.0
        x += randi(-0.2m, 0.2m)
        z += randi(-0.2m, 0.2m)
        y += 0.2m
        zindex = 25
        SetRot(0deg, rand(360deg), 0deg)
        ExplodeParticleSetSpeed(1m, 1m, 3.5m, 1.5m)
        statusb = FLAG_PHYSICS_ENGINE | FLAG_STRING_CENTER
        setanim(WITCH_DOCTOR_FEATHER, rand(16.0))
        do {
            animframe = (animframe + 1.0) % 16.0
            playframe(animframe, 0.1s)
        } until(vely < 0)
        vely = -0.2m
        v0 >>= 4
        while (scalex > 0.1S) {
            velx >>= 1
            velz >>= 1
            animframe = (animframe + 1.0) % 16.0
            playframe(animframe, 0.1s)
        }
    }
    event(e, a) {
        accevcstate(Kill, e == EventRespawn)
    }
    trans { // MIPS
        unless(STATUS_FIRSTFRAME) {
            vely = spd(vely, v0)
            roty += 2deg
            if (y < DoctorFloatOffset - 2m) {
                scalex -= 0.2S
                scaley -= 0.2S
                scalez -= 0.2S
            }
        }
    }
}

state Doctor_Particle { // 8
    stateflag 0xA0080
    code() {
        movetolist(3.0)
        zindex = 100
        SetRot(0deg, 0deg, rand(360deg))
        y += 0.75m
        velx = randi(-10m, 10m)
        vely = randi(-10m, 10m)
        velz = randi(-10m, 10m)
        statusb = FLAG_PHYSICS_ENGINE
        SetScale(0.4S)
        DoctorParticleAnim()
    }
    trans {
        rotz += 10deg
        if (frametime - statetime >= 1 && spawn == S_DOCTOR_PARTICLE_DECEL) {
            velx = velx * 0.7 >> 8
            vely = vely * 0.7 >> 8
            velz = velz * 0.7 >> 8
        }
    }
}

sub DoctorStatus(a) {
    if (interrupter) {
        if (a == DOCTOR_STATUS_GET_HEALTH) {
            interrupter -> var0 = DoctorHealth
        }
        else if (a == DOCTOR_STATUS_SET_LIGHT) {
            DoctorLightTimeLeft = interrupter -> var0
        }
    }
}

sub KillDoctor() {
    changestate(Witch_Doctor_Dead)
}

sub Sub_728(){ }

state Witch_Doctor_Collect { // 9
    stateflag 0x12000B
    statusc 0
    code() { }
    trans {
        changestate(Witch_Doctor)
    }
}

sub Sub_732(){ }
