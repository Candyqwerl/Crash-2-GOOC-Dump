#gool SpaOC 35 5

#include "goolstdlib.gooc"

#anim SPACE_BOX              [BI10V] 1 1
#anim SPACE_JETPACK          [Je1iV] 1 1
#anim SPACE_GOGGLES          [Je2iV] 1 1
#anim SPACE_DOOR             [Do1iV] 26 1
#anim SPACELOCK              [Do2iV] 50 1
#anim ALARM_OFF              [Do3iV] 1 1
#anim ALARM_ON               [Do4iV] 1 1

#sprite LIGHT                [Cr10T]
#tex 0x808080 0 0 11 8 848 16 16 16

#anim JETPACK_DISCARD        [Rp1iV] 21 1
#anim JETPACK_EQUIP          [Rp2iV] 29 1
#anim CABLE                  [Ca1iV] 400 1
#anim SPACEBALL              [Sb1iV] 100 1
#anim SPACEGUN_1             [SG10V] 8 1
#anim SPACEGUN_2             [SG20V] 12 1
#anim SPACEGUN_3             [SG30V] 4 1
#anim SPACEGUN_4             [SG40V] 8 1
#anim SPACEGUN_5             [SG50V] 8 1
#anim SPACEGUN_6             [SG60V] 12 1
#anim SPACEGUN_7             [SG70V] 4 1
#anim SPACEGUN_8             [SG80V] 8 1
#anim SPACEGUN_9             [SG90V] 8 1
#anim SPACEGUN_A             [SGa0V] 12 1
#anim SPACEGUN_B             [SGb0V] 4 1
#anim SPACEGUN_C             [SGc0V] 8 1
#anim SPACEGUN_D             [SGd0V] 4 1
#anim SPACEGUN_E             [SGe0V] 4 1
#anim SPACEGUN_F             [SGf0V] 4 1

#spawn S_SPACE_BOX           Space_Box
#spawn S_SPACE_JETPACK       Space_Jetpack
#spawn S_SPACE_GOGGLES       Space_Goggles
#spawn S_SPACE_DOOR          Space_Door_Init
#spawn S_4                   __S_4
#spawn S_SPACE_ZERO_G        Space_Zero_Gravity
#spawn S_SPACELOCK           Spacelock
#spawn S_7                   __S_7
#spawn S_SPACE_FLOOR         Space_Floor
#spawn S_SPACE_PAD           Space_Pad
#spawn S_SPACE_ALARM         Space_Alarm
#spawn S_SPACE_CABLE_1       Space_Cable_Spawn
#spawn S_SPACE_CABLE_2       Space_Cable
#spawn S_SPACE_GUN           Space_Gun_Init
#spawn S_SPACEBALL_HOMING    Spaceball_Homing_Init
#spawn S_SPACE_RING          Space_Ring
#spawn S_SPACEBALL           Spaceball
#spawn S_SPACEBALL_PATH      Spaceball_Path

#include "C2_ShadC.gooh"

var BallCyclelen, BallCycleOffs, BallPathlen, SpaceVar4, SpaceVar5, SpaceVar6, SpaceVar7,
    SpaceVar8, SpaceVar9, SpaceVar10, RadiusCycle, RadiusInc, RadiusPhase, OrbitRadius,
    SpaceVar15, OrbitAngle, CableSpark

state Space_Box { // 0
    code() {
        zindex = 24
        statusb = FLAG_SOLID_FULL
        if (CHECKPOINTCOUNT) {
            entitysetstate(1)
        }
        if (entitygetstate(2)) {
            y += 2m
            changestate(Space_Box_Float)
        }
        vely = 2m
        sleepanim(0, SPACE_BOX)
    }
    event(e, a) {
        accevcstate(Space_Box_Float, e == Event58)

    }
}

state Space_Box_Float { // 1
    code() {
        sleepanim(0, SPACE_BOX)
    }
    trans {
        once {
            statusb |= FLAG_PHYSICS_ENGINE
        }
        vely = vely * (0.62m / 256) >> 8
        unless(abs(vely) & -0.16m) {
            settrans(Space_Box_Trans)
        }
    }
}

sub Space_Box_Trans() __trans {
    once {
        v0 = 0
        groundy = y
        statusb &= ~FLAG_PHYSICS_ENGINE
        entitysetstate(1)
    }
    y = groundy + sin(loopseek(v0, 0.25m, 1m >> 7), 0.245m)
}

state Space_Jetpack { // 2
    code() {
        if (CHECKPOINTCOUNT || entitygetstate(2)) {
            return
        }
        spawn(SpaOC, S_SPACE_GOGGLES, 1)
        zindex = 24
        do {
            playanim(0, SPACE_JETPACK)
        } until(distance(player, DIST_NO_Y) < 5m)

        do {
            sendevent(Event58, player)
            playanim(0, SPACE_JETPACK)
        } until(player -> stateflag & 0x4000000)
        
        sleepanim(0, SPACE_JETPACK)
    }
    event(e, a) {
        accevcstate(Space_Jetpack_Equip, e == EventTriggered)
    }
    trans{
        once {
            v0 = 0
            groundy = y - 0.125m
        }
        roty += 5deg
        y = groundy + sin(loopseek(v0, 0.25m, 1m >> 7), 0.245m)
        sendeventif(Event9, player, (player -> z < z - 5m || player -> y < y - 0.5m) && !(player -> stateflag & 0x4000000), 100.0)
    }
}

state Space_Jetpack_Equip { // 3
    code(){
        entitysetstate(1)
        statusb = 0
        roty = 180deg
        x = player -> x
        y = player -> y
        z = player -> z
        entitysetspawn(0)
        sendevent(Event12, child)
        playframes(JETPACK_EQUIP, 0.0, 28.0)
    }
}

state Space_Goggles { // 4
    code() {
        zindex = 24
        sleepanim(0, SPACE_GOGGLES)
    }
    event(e, a) {
        accevcstate(Kill, e == Event12)
    }
    trans {
        once {
            v0 = 0x1900
            groundy = y
        }
        y = groundy + sin(loopseek(v0, 0.19m, 1m >> 7), 0.18m)
    }
}

state Space_Floor { // 5
    statusc 0x22
    code() {
        unless(player -> stateflag & 0x4000000) {
            settrans(SpacePadTrans)
        }
        y += 2m
        statusb = FLAG_INVISIBLE | FLAG_COLLIDABLE
        SetScale(2S, 6S, 2S)
        sleepanim(0, LIGHT)
    }
    trans {
        if (collider) {
            if (collider -> stateflag & 0x4000000) {
                sendevent(Event58, collider)
                changestateif(Kill, eventaccepted)
            }
        }
    }
}

state Kill { // 6
    stateflag 0
    statusc 0
    code(){ }
}

state Space_Pad { // 7
    statusc 0x22
    trans => sub SpacePadTrans
    code() {
        zindex = 25
        playframes(JETPACK_DISCARD, 0.0, 20.0)
        movetolist(3.0)
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL
        sleep()
    }
}

sub SpacePadTrans() {
    sendeventif(Event9, player, player -> y < y - 2m, 100.0)
    if (player -> z > z + 3m) {
        player -> z = z + 3m
    }
}

state Space_Door_Init { // 8
    statusc 0x22
    code() {
        zindex = fieldval(ENTITY_FIELD_ZINDEX)
        if (zindex == 0) zindex = 24;
        setanim(SPACE_DOOR)
        if (player -> z <= z + 8m) {
            animframe = 25.0
            changestate(Space_Door_Open)
        }
        else {
            animframe = 0
            changestate(Space_Door_Wait)
        }
        statusb = FLAG_COLLIDABLE | FLAG_INVISIBLE
    }
}

state Space_Door_Wait { // 9
    statusc 0x22
    code() {
        soundpitch(3.625)
        sounddecay(6.4s)
        soundplay([SDCTA], 0.75V)
        playframesback(SPACE_DOOR, 2.0, animframe, 0.0)
        do {
            if (GLOBAL_3 != frametime || z >= GLOBAL_11) {
                GLOBAL_3 = frametime
                GLOBAL_11 = z
            }
            playframe()
        } while (1)
    }
    trans {
        changestateif(Space_Door_Open, player -> velz < 0 && player -> z <= z + 8m)
    }
}

state Space_Door_Open { // 10
    statusc 0x22
    code() {
        soundpitch(3.625)
        sounddecay(6.4s)
        soundplay([SDOTA], 0.75V)
        if (player -> z < z) {
            playframes(SPACE_DOOR, 2.0, animframe, 25.0)
        }
        else if (player -> z <= z + 4m) {
            playframes(SPACE_DOOR, 2.0, animframe, 25.0)
        }
        else {
            playframes(SPACE_DOOR, 1.0, animframe, 25.0)
        }
        sleep()
    }
    trans { 
        changestateif(Space_Door_Wait, player -> velz > 0 && player -> z > z + 4.1m)
    }
}

state Space_Zero_Gravity { // 11
    stateflag 0x4000001
    statusc 0x22
    code(t, ax, ay, az) {
        spawn(9, 27, 1, ax, ay, az, 0, 2.0)
        v0 = 0
        ins46(ax, ax)
        do {
            getvert(vtrans, 0, time(2) << 8)
            spawn(9, 19, 1, -1.0, ax * -6, ay * -6, az * -6)
            if (frametime - statetime >= 0.18s) {
                v0 -= 4.5deg
            }
            else {
                v0 += 4.5deg
            }
            creator -> velx += ax * v0 >> 8
            creator -> vely += ay * v0 >> 8
            creator -> velz += az * v0 >> 8
            playnull()
        } until(frametime - statetime >= t)

        while (child) {
            playnull()
        }
    }
}

state Spacelock { // 12
    statusc 0x22
    code() {
        spawn(SpaOC, S_SPACE_ALARM, 1)
        statusb = FLAG_NO_CAMERA_CLIP
        zindex = 24
        if (CHECKPOINTCOUNT) {
            entitysetstate(1)
        }
        changestateif(Spacelock_Sleep, entitygetstate(2))
        sleepanim(0, SPACELOCK)
    }
    event(e, a) {
        accevcstate(Spacelock_Triggered, e == EventTriggered)
    }
}

state Spacelock_Triggered { // 13
    statusc 0x22
    code() {
        broadcastevent(Event58, self)
        entitysetstate(1)
        statusb = FLAG_NO_CAMERA_CLIP
        vfx = (vfx & 0xFFFFFF00) | 0x6
        soundpitch(3.625)
        sounddecay(6.4s)
        soundplay([SLoTA], 1.28V)
        vfx = vfx & 0xFFFFFF00
        playframes(SPACELOCK, 0.0, 49.0)
        changestate(Spacelock_Sleep)
    }
}

state Spacelock_Sleep { // 14
    statusc 0x22
    code(){
        sleepanim(49, SPACELOCK)
    }
}

state Space_Alarm { // 15
    statusc 0x22
    code() {
        unless(entitygetstate(creator -> id, 2)) {
            do {
                playanim(0, ALARM_OFF)
            } until(player -> stateflag & 0x4000000)
            
            do (var beeps = 0) {
                vfx = (vfx & 0xFFFFFF00) | 0x6
                soundpitch(6.893)
                sounddecay(6.4s)
                soundplay([SpATA], 0.5V)
                vfx = vfx & 0xFFFFFF00
                playanim(0, ALARM_ON, 0.4s)
                playanim(0, ALARM_OFF, 0.4s)
                beeps += 1.0
            } while (beeps < 9.0)
        }
        changestate(Space_Alarm_Sleep)
    }
}

state Space_Alarm_Sleep { // 16
    statusc 0x22
    code() {
        sleepanim(0, ALARM_ON)
    }
}

sub SpaceObjectTrans() {
    if (frametime - GLOBAL_3 >= 0.1s || z > GLOBAL_11) {
        statusb &= ~FLAG_INVISIBLE
    }
    else {
        statusb |= FLAG_INVISIBLE
    }
}

state Space_Cable_Spawn { // 17
    statusc 0x22
    trans => sub SpaceObjectTrans
    code() {
        spawn(SpaOC, S_SPACE_CABLE_2, 1)
        z += 1m
        playframes(CABLE, 389.0, 399.0)
        CableSpark = -1
        changestate(Space_Cable)
    }
}

state Space_Cable { // 18
    statusc 0x22
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        sleepframes(CABLE, 0.0, 399.0)
    }
    trans {
        nofirst {
            unless(statusb & FLAG_INVISIBLE) {
                if (abs(z - player -> z) < 2m) {
                    sendeventif(EventShock2, player, 
                    pointclip(getvert(vvec, self, 0), player)
                    || pointclip(getvert(vvec, self, 1.0), player)
                    || pointclip(getvert(vvec, self, 2.0), player)
                    || pointclip(getvert(vvec, self, 3.0), player)
                    || pointclip(getvert(vvec, self, 4.0), player)
                    || pointclip(getvert(vvec, self, 5.0), player)
                    || pointclip(getvert(vvec, self, 6.0), player)
                    || pointclip(getvert(vvec, self, 7.0), player)
                    || pointclip(getvert(vvec, self, 8.0), player), 100.0)
                }
                if (CableSpark != child && FRAMETIME < 34) {
                    unless(rand(4)) {
                        unless(rand(2)) {
                            spawn(9, 24, 1, 0)
                            CableSpark = objectspawned
                        }
                        else {
                            spawn(9, 24, 1, 8.0)
                            CableSpark = objectspawned
                        }
                    }
                }
            }
        }
        SpaceObjectTrans()
    }
}

state Space_Gun_Init { // 19
    statusc 0x22
    code(cycleoffs) {
        vfx = (vfx & 0xFF00FFFF) | 0x10000
        statusb = FLAG_COLLIDABLE | FLAG_NO_CAMERA_CLIP
        if (cycleoffs == 0) {
            changestate(SpaceGun_Phase_1)
        }
        else if (cycleoffs == 1.0) {
            changestate(SpaceGun_Phase_2)
        }
        else {
            changestateif(SpaceGun_Phase_3, cycleoffs == 2.0)
        }
    }
}

inline sub PlaySpacegunFrames22(anim) {
    playanim(0, anim)
    playanim(1, anim)
    playanim(2, anim)
    playanim(2, anim)
    playanim(3, anim)
    playanim(4, anim)
    playanim(5, anim)
    playanim(6, anim)
}

inline sub PlaySpacegunFrames44(anim) {
    playanim(0, anim)
    playanim(1, anim)
    playanim(2, anim)
    playanim(3, anim)
    playanim(4, anim)
    playanim(4, anim)
    playanim(5, anim)
    playanim(6, anim)
}

inline sub PlaySpacegunFrames(anim) {
    playanim(0, anim)
    playanim(1, anim)
    playanim(2, anim)
    playanim(3, anim)
    playanim(4, anim)
    playanim(4, anim)
    playanim(5, anim)
    playanim(6, anim)
}

inline sub SoundSpaceGun() {
    soundpitch(3.262)
    sounddelay(0.18s)
    sounddecay(8s)
    soundplay([SGuTA], 0.8V)
}

state SpaceGun_Phase_1 { // 20
    statusc 0x22
    code() {
        if (animseq == getanim(SPACEGUN_7)) {
            playframesback(SPACEGUN_4, 7.0, 0.0)
            PlaySpacegunFrames22(SPACEGUN_1)
        }
        else if (animseq == getanim(SPACEGUN_B)) {
            PlaySpacegunFrames(SPACEGUN_C)
            PlaySpacegunFrames22(SPACEGUN_1)
        }
        SoundSpaceGun()
        playframes(SPACEGUN_2, 0.0, 11.0)
        do (var i = 0) {
            playanim(0, SPACEGUN_D)
            playanim(1, SPACEGUN_D)
            playanim(2, SPACEGUN_D)
            playanim(2, SPACEGUN_D)
            i += 1.0
        } while (i < 5.0)
        playanim(0, SPACEGUN_3)
        playanim(1, SPACEGUN_3)
        playanim(2, SPACEGUN_3)
        playanim(2, SPACEGUN_3)
        changestate(SpaceGun_Phase_2)
    }
    trans {
        sendevent(EventBurn, collider, 100.0)
        SpaceObjectTrans()
    }
}


state SpaceGun_Phase_2 { // 21
    statusc 0x22
    trans => state SpaceGun_Phase_1
    code() {
        if (animseq == getanim(SPACEGUN_3)) {
            PlaySpacegunFrames44(SPACEGUN_4)
            PlaySpacegunFrames22(SPACEGUN_5)
        }
        else if (animseq == getanim(SPACEGUN_B)) {
            playframesback(SPACEGUN_8, 7.0, 0.0)
            PlaySpacegunFrames22(SPACEGUN_5)
        }
        SoundSpaceGun()
        playframes(SPACEGUN_6, 0.0, 11.0)
        do (var i = 0) {
            playanim(0, SPACEGUN_E)
            playanim(1, SPACEGUN_E)
            playanim(2, SPACEGUN_E)
            playanim(2, SPACEGUN_E)
            i += 1.0
        } while (i < 5.0)
        playanim(0, SPACEGUN_7)
        playanim(1, SPACEGUN_7)
        playanim(2, SPACEGUN_7)
        playanim(2, SPACEGUN_7)
        changestate(SpaceGun_Phase_3)
    }
}

state SpaceGun_Phase_3 { // 22
    statusc 0x22
    trans => state SpaceGun_Phase_1
    code() {
        if (animseq == getanim(SPACEGUN_7)) {
            PlaySpacegunFrames44(SPACEGUN_8)
            PlaySpacegunFrames22(SPACEGUN_9)
        }
        else if (animseq == getanim(SPACEGUN_3)) {
            playframesback(SPACEGUN_C, 7.0, 0.0)
            PlaySpacegunFrames22(SPACEGUN_9)
        }
        SoundSpaceGun()
        playframes(SPACEGUN_A, 0.0, 11.0)
        do (var i = 0){
            playanim(0, SPACEGUN_F)
            playanim(1, SPACEGUN_F)
            playanim(2, SPACEGUN_F)
            playanim(2, SPACEGUN_F)
            i += 1.0
        } while (i < 5.0)
        playanim(0, SPACEGUN_B)
        playanim(1, SPACEGUN_B)
        playanim(2, SPACEGUN_B)
        playanim(2, SPACEGUN_B)
        changestate(SpaceGun_Phase_1)
    }
}

state Spaceball_Homing_Init { // 23
    statusc 0x22
    code(dist) {
        statusb = FLAG_SOLID_ALL | FLAG_COLLIDABLE
        field_61 = dist
        vecx = x
        vecy = y
        vecz = z
        changestate(Spaceball_Homing)
    }
}

state Spaceball_Homing { // 24
    statusc 0
    code() {
        do {
            soundpitch(3.625)
            sounddelay(1s)
            sounddecay(6.4s)
            soundplay([SBaTA], 0.1V)

            soundpitch(3.625)
            sounddelay(3s)
            sounddecay(6.4s)
            soundplay([SBaTA], 0.1V)

            playframes(SPACEBALL, 0.0, 99.0)
        } while (1)
    }
    event(e, a) {
        accevcstate(Spaceball_Fling, e == EventSpinHit)
    }
    trans {
        SpaceObjectTrans()
        roty = CAMROTY
        if (distance(vecx, player, DIST_EXACT) < field_61) {
            x = seek(x, player -> x, spd(1m))
            y = seek(y, player -> y + 1m, spd(1m))
            z = seek(z, player -> z, spd(1m))
        }
        else {
            x = seek(x, vecx, spd(0.5m))
            y = seek(y, vecy, spd(0.5m))
            z = seek(z, vecz, spd(0.5m))
        }
        v0 = animframe / 30.0
        if (v0 == 1 || v0 == 3) {
            statusc |= 0x20
            sendevent(Event24, collider, 100.0)
        }
        else {
            statusc &= ~0x20
        }
    }
}

state Space_Ring { // 25
    statusc 0x22
    code(count, radius_min, radius_max, orbit_cyclet, orbit_cycleoffs, radius_cyclet, radius_cycleoffs, unused, orbit) {
        var orbit_cycletime = orbit_cyclet * 1s / 1.2s
        var orbit_cycleoffs = orbit_cycleoffs * 1s / 1.2s
        var radius_cycletime = radius_cyclet * 1s / 1.2s
        var radius_cycleoffs = radius_cycleoffs * 1s / 1.2s
        var angle_inc = 360deg / count
        var angle = 0

        do (var balls = 0) {
            spawn(SpaOC, S_SPACEBALL, 1, angle)
            angle += angle_inc
            balls += 1
        } while (balls < count)

        statusb = FLAG_INVISIBLE
        OrbitRadius = radius_min
        RadiusCycle = radius_cycletime << 1
        RadiusInc = (radius_max - radius_min) / radius_cycletime

        if (radius_max == radius_min) {
            do {
                changestateif(Spaceball_Shrink, player -> z < z - 0.5m)
                if (orbit && orbit_cycletime) {
                    rotx = (time(orbit_cycletime, orbit_cycleoffs) << 12) / orbit_cycletime
                }
                else {
                    rotx = 0deg
                }
                playnull()
            } while (1)
        }
        else {
            do {
                changestateif(Spaceball_Shrink, player -> z < z - 0.5m)
                if (orbit && orbit_cycletime) {
                    rotx = (time(orbit_cycletime, orbit_cycleoffs) << 12) / orbit_cycletime
                }
                else {
                    rotx = 0deg
                }
                RadiusPhase = time(RadiusCycle, radius_cycleoffs)
                if (RadiusPhase > radius_cycletime) {
                    OrbitRadius = radius_min + ((RadiusPhase - radius_cycletime) * RadiusInc)
                }
                else {
                    OrbitRadius = radius_min + ((radius_cycletime - RadiusPhase) * RadiusInc)
                }
                playnull()
            } while (1)
        }
    }
}

state Spaceball_Shrink { // 26
    statusc 0x22
    code() {
        while (scalex > 0S) {
            scalex = seek(scalex, 0S, 1.6)
            scaley = seek(scaley, 0S, 1.6)
            scalez = seek(scalez, 0S, 1.6)
            playframe()
        }
        entitysetspawn(0)
    }
}

state Spaceball { // 27
    statusc 0x10
    code(angle) {
        spawn(ShadC, ShadC_S_SHADOW, 1, 0, 1.5S, 0)
        OrbitAngle = angle
        statusb = FLAG_COLLIDABLE | FLAG_HAS_SHADOW
        vecx = parent -> x
        vecy = parent -> y
        vecz = parent -> z
        trotx = 0deg
        troty = 0deg
        trotz = 90deg
        sleepframes(SPACEBALL, 0.0, 99.0)
    }
    trans {
        nofirst {
            unless(statusb & FLAG_INVISIBLE) {
                trotx = parent -> rotx + OrbitAngle
                vectransf2(vvec, vtrans, 0, parent -> OrbitRadius, 0)
            }
        }
        sendevent(EventExplode, collider, 100.0)
        changestateif(Spaceball_Explode, eventaccepted)
        scalex = parent -> scalex
        scaley = parent -> scaley
        scalez = parent -> scalez
        SpaceObjectTrans()
    }
}

state Spaceball_Path { // 28
    statusc 0
    code(cyclelen, cycleoffs) {
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL
        BallCyclelen = cyclelen * 1s / 1.2s
        BallCycleOffs = cycleoffs * 1s / 1.2s
        BallPathlen = (pathlen << 1) / (BallCyclelen + 1)
        sleepframes(SPACEBALL, 0.0, 99.0)
    }
    trans {
        nofirst {
            unless(statusb & FLAG_INVISIBLE) {
                var cycletime = time(BallCyclelen, BallCycleOffs)
                calcpath(abs((BallCyclelen - (BallCycleOffs >> 1)) * BallPathlen))
                if (BallCyclelen >= BallCyclelen >> 1) {
                    statusa |= 0x4
                }
            }
        }
        SpaceObjectTrans()
    }
}

state Spaceball_Fling { // 29
    stateflag 0x30
    statusc 0x12
    code(h) {
        EnemyFlingCombo(h)
        EnemyFlingSetDir()
        EnemyFlingSetVel(3m)
        EnemyFlingWaitScale()
    } 
    trans {
        EnemyFlingTrans(2m, EventFling)
    }
}

state Spaceball_Explode { // 30
    stateflag 0x22
    statusc 0x12
    code() {
        spawn(9, 40, 1, 0, 2)
        playnull()
        entitysetspawn(0)
    }
}
