            roty = 22.5deg
            ins72(0x100, 0x200)
            GLOBAL_50 = 0xFFFFFF
            GLOBAL_51 = 0xFFFFFF
        }
        if (rotx != roty) {
            var0 = roty - rotx
            if (var0 < -16) {
                var0 = -16
            }
            else if (var0 > 16) {
                var0 = 16
            }
            rotx += var0
            GLOBAL_50 = (0xFF + ((-0x9B * rotx) >> 8)) | (((0xFF + ((-0xB9 * rotx) >> 8)) << 8) | ((0xFF + ((-0xD7 * rotx) >> 8)) << 16))
            GLOBAL_51 = (0xFF + ((0 * rotx) >> 8)) | (((0xFF + ((0 * rotx) >> 8)) << 8) | ((0xFF + ((0 * rotx) >> 8)) << 16))
