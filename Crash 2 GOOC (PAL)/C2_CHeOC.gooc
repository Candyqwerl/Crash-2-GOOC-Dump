sub UpdateHologramFX() {
    if (!WarpVar6) {
        if (!rand(30)) {
            WarpVar10 <<= 1
            WarpVar7 = (3 + rand(5)) << 2
            WarpVar6 += 1
        }
    }
    else if (WarpVar6 == WarpVar7) {
        if (!rand(40)) {
            WarpVar7 = 0
            WarpVar6 -= 1
            if (WarpVar10 > 0x2710) {
                WarpVar10 >>= 1
            }
        }
    }
    else {
        WarpVar6 = seek(WarpVar6, WarpVar7, 1)
    }

    if (!rand(60)) {
        if (!rand(2)) {
            WarpVar10 = 0x1047 + rand(0x411B)
        }
        else {
            WarpVar10 = -(0x1047 + rand(0x411B))
        }
    }
    if (!WarpVar9) {
        if (!rand(2)) {
            vecy = -vecy
            WarpVar9 = 0x57E3F
        }
    }
    stalltime = (WarpVar6 & -4) | (GAMETICK & 3)
    if (WarpVar9 + WarpVar10 >= 0x57E40 || WarpVar9 + WarpVar10 < 0) {
        vecy = -vecy
    }
    WarpVar9 = (WarpVar9 + (WarpVar10 + 0x57E40)) % 0x57E40
    vecx = (0x2BF20 + WarpVar9) + WarpVar8
    if (!rand(15)) {
        WarpVar11 = rand(0x333)
    }
    WarpVar13 = seek(WarpVar13, WarpVar11, 0xCC)
    var0 = WarpVar13 + (time(0.1s) * 0x199)
    var0 = 16.0 - var0
    var0 = var0 * WarpVar14 >> 8
    moda = 16.0 - var0
}


state Projector_Robot { // 12
    code(yawspd) {
        soundpitch(16.0)
        soundplay([PSt2A], 0.06V)
        WarpVar14 = yawspd
        var0 = atan(-player -> x, -player -> z) % 360deg
        troty = (var0 - 45deg) % 360deg
        trotx = -90.1deg
        WarpVar15 = -22deg
        spawn(37, 0, 1) // LenFC-0
        GLOBAL_54 = 0
        GLOBAL_120 = 0
        spawn(CHeOC, S_PROJECTOR_LIGHT, 1, 1)
        spawn(CHeOC, S_PROJECTOR_LIGHT, 1, 2)
        zindex = 24
        statusb = 0
        troty = 0
        trotz = 0
        WarpVar6 = 2.7m
        WarpVar7 = 2.7m
        WarpVar8 = frametime + rand(4s) + 0.5s
        WarpVar9 = 0
        WarpVar10 = 0
        WarpVar13 = 0
        WarpVar11 = frametime + rand(4s) + 2s
        SetVec(x, y, z)
        do {
            if (frametime >= WarpVar11) {
                WarpVar11 = frametime + rand(4s) + 2s
                if (trotx != -90deg) {
                    if (!rand(4)) {
                        sounddecay(2.58s)
                        soundpitch((13.12 + rand(5.28)) * 0.36 >> 8)
                        soundplay([sv16A], 0.2V + rand(0.03V))
                    }
                    else {
                        sounddecay(2.58s)
                        soundpitch((13.12 + rand(5.28)) * 0.36 >> 8)
                        soundplay([sv26A], 0.2V + rand(0.03V))
                    }
                }
                if (WarpVar9 == 0) {
                    WarpVar10 = 7.0
                }
                else {
                    WarpVar10 = ((WarpVar6 - 2.7m) * 6 / 2.5m) << 8
                }
            }
            WarpVar9 = seek(WarpVar9, WarpVar10, 1.0)
            if (trotx == -90deg) {
                break
            }
            playframe(WarpVar9)
            if (WarpVar13 & 1) {
                setanim(PROJECTOR_ROBOT_1)
            }
            else {
                setanim(PROJECTOR_ROBOT_2)
            }
            WarpVar13 += 1
        } while (1)
    }
    event(e, a) {
        if (e == Event14) {
            WarpVar15 = -90deg
        }
    }
    trans {
        unless(STATUS_FIRSTFRAME) {
            if (creator) {
                vecx = creator -> x
                vecy = creator -> y
                vecz = creator -> z
            }
            if (frametime >= WarpVar8) {
                WarpVar8 = (frametime + rand(3s)) + 0.5s
                if (trotx != -22deg) {
                    WarpVar7 = 5.2m
                }
                else {
                    WarpVar7 = 2.7m + rand(2.5m)
                }
            }
            WarpVar6 = seek(WarpVar6, WarpVar7, 360deg)
            var0 = WarpVar15 - trotx
            if (var0 > 0) {
                var0 = var0 >> 3
                if (!var0) {
                    var0 = 1
                }
                if (var0 > 8) {
                    var0 = 8
                }
            }
            else if (var0 < 0) {
                var0 = var0 >> 3
                if (!var0) {
                    var0 = -1
                }
                if (var0 < -8) {
                    var0 = -8
                }
            }
            trotx += var0
            troty = spd(troty, WarpVar14)
            trotz = troty
            vectransf2(vvec, vtrans, WarpVar6, 0, 0)
            UpdateProjectorAngle()
            sendevent(EventHit, collider, 100.0)
        }
    }
}

sub UpdateProjectorAngle() {
    save(vecx, vecy, vecz) {
        vecx = creator -> x
        vecy = creator -> y
        vecz = creator -> z
        roty = spd(roty, 360deg)
        rotx = degseek(rotx, atan2_3d(self, vecx) + 90deg, 90deg)
        rotz = degseek(rotz, atan2(creator -> trans), 180deg)
    }
}

state Cutscene_Room_Dimmer { // 13
