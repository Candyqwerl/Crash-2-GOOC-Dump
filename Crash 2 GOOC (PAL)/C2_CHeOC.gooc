state WarpRoom_Idle { // 1
    statusc 0x0
    code() {
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            WarpVar6 = 0
            WarpVar7 = 0
            CapturePlayerPosition()
        }
        DebugCheats()
        UpdateFacingTarget()
        if (player -> stateflag & 0x8000) {
            WarpVar18 = 1
            player -> troty = CAMROTY
            player -> roty = CAMROTY
        }
        else if (WarpVar18) {
            WarpVar18 = 0
            if (WarpVar3 == 1) {
                WarpVar5 = WarpVar3
                changestate(LoadSave_Triggered, 1)
            }
            else {
                SetCutsceneIndex()
                changestateif(Cutscene_Start, getfield(self, 0x4F00))
            }
        }
        if (GLOBAL_21 & 2) {
            misc = buttonhold(PAD_E)
            if (misc) {
                misc = FloorIndex != 5
            }
            if (misc) {
                WarpVar16 = WarpVar19
                WarpVar19 += 1
                if (WarpVar19 > 18) {
                    WarpVar19 = 1
                }
                changestate(Cutscene_Start)
            }
        }
        var0 = WarpVar3
        ResolveFacingDoorLevel()
        changestateif(WarpDoor_LoadLevel, var0 >= 0)
        var0 = WarpVar3
        FilterCameraTarget()
        if (WarpVar5 != var0) {
            WarpVar5 = var0
            WarpVar7 = 1
        }
        WarpVar6 += 1.0
        if (player -> x != rotx) {
            WarpVar6 = 0
            WarpVar22 = 1
        }
        if (player -> y != roty) {
            WarpVar6 = 0
            WarpVar22 = 1
        }
        if (player -> z != rotz) {
            WarpVar6 = 0
            WarpVar22 = 1
        }
        if (!WarpVar5) {
            WarpVar6 = 0
        }
