state Portal_Swirl_Init { // 19
    code(index, slot) {
        WarpVar10 = index
        WarpVar9 = slot
        FloorIndex = creator -> FloorIndex
        vfx = (vfx & 0xFFFFFF00) | 0x3
        if (index == 0.0) {
            zindex = -400
        }
        else if (index == 1.0) {
            zindex = -250
        }
        else if (index == 2.0) {
            zindex = -100
        }
        else if (index == 3.0) {
            zindex = 160
        }
        else if (index == 4.0) {
            zindex = 220
        }
        if (FloorIndex == 1) {
            zindex -= 30
        }
        changestate(Portal_Swirl)
    }
}

state Portal_Swirl { // 20
    code() {
        do {
            if (WarpVar1) {
                playanim(0, WARP_PORTAL_SWIRL)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (WarpVar9) {
            WarpVar11 = creator -> WarpVar11
            WarpVar1 = creator -> WarpVar1
            WarpVar7 = creator -> WarpVar7
            WarpVar14 = creator -> WarpVar14
            WarpVar16 = creator -> WarpVar16
            WarpVar17 = creator -> WarpVar17
            y = parent -> WarpVar3
        }
        else {
            WarpVar11 = creator -> WarpVar11
            y = parent -> WarpVar6
            WarpVar1 = parent -> WarpVar2
            WarpVar7 = parent -> WarpVar8
            WarpVar14 = parent -> WarpVar15
            WarpVar16 = parent -> WarpVar18
            WarpVar17 = parent -> WarpVar19
        }
        if (WarpVar1) {
            var phase = WarpVar14 + (4m * (WarpVar10 >> 8))
            var S4 = ((phase >> 8) << 8) / 0x1F40
            var radius = -(phase + 7.5m) >> 8
            moda = 16.0 - (((S4 << 4) * WarpVar11) >> 8)
            x = (radius * WarpVar16) >> 4
            z = (radius * WarpVar17) >> 4
            rotx = S4 << 2
            roty = WarpVar1
            rotz = (WarpVar1 + 90deg) % 360deg
            scalex = 6S - ((S4 * 5.5S) >> 8)
            scaley = scalex
            scalez = scalex
            var0 = radius
        }
    }
}

state Portal_Background_Init { // 21
    code(slot) {
        FloorIndex = creator -> FloorIndex
        WarpVar9 = slot
        vfx = (vfx & 0xFFFFFF00) | 0x3
        if (FloorIndex == 5) {
            zindex = 200
            SetScale(6S)
        }
        else {
            zindex = 0
        }
        FloorIndex = creator -> FloorIndex
        changestate(Portal_Background)
    }
}

state Portal_Background { // 22
    code() {
        do {
            if (WarpVar1) {
                if (FloorIndex == 5) {
                    playanim(0, GLOW)
                }
                else {
                    playanim(0, WARP_PORTAL_BG)
                }
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (WarpVar9) {
            WarpVar11 = creator -> WarpVar11
            WarpVar1 = creator -> WarpVar1
            WarpVar16 = creator -> WarpVar16
            WarpVar17 = creator -> WarpVar17
            y = parent -> WarpVar3
        }
        else {
            WarpVar11 = creator -> WarpVar11
            WarpVar1 = parent -> WarpVar2
            y = parent -> WarpVar6
            WarpVar16 = parent -> WarpVar18
            WarpVar17 = parent -> WarpVar19
        }
        if (WarpVar1) {
            var0 = -0x2AF8
            x = (var0 * WarpVar16) >> 4
            z = (var0 * WarpVar17) >> 4
            rotx = spd(rotx, -90deg)
            roty = WarpVar1
            rotz = (WarpVar1 + 90deg) % 360deg
            moda = 16.0 - ((16.0 * WarpVar11) >> 8)
        }
        else {
            moda = 16.0
        }
    }
}

state Portal_Particles_Init { // 23
    code(slot) {
        WarpVar9 = slot
        changestate(Portal_Particles)
    }
}

state Portal_Particles { // 24
    code() {
        do (var frame = 0) {
            if (WarpVar1) {
                setanim(WARP_PARTICLES)
                playframe(frame)
            }
            else {
                playnull()
            }
            frame += 1.0
            if (frame >= 120.0) {
                frame = 0
            }
        } while (1)
    }
    trans {
        if (WarpVar9) {
            WarpVar11 = creator -> WarpVar11
            WarpVar1 = creator -> WarpVar1
            WarpVar16 = creator -> WarpVar16
            WarpVar17 = creator -> WarpVar17
            y = parent -> WarpVar3
        }
        else {
            WarpVar11 = creator -> WarpVar11
            WarpVar1 = parent -> WarpVar2
            y = parent -> WarpVar6
            WarpVar16 = parent -> WarpVar18
            WarpVar17 = parent -> WarpVar19
        }
        if (WarpVar1) {
            var0 = -0x12C0
            x = (var0 * WarpVar16) >> 4
            z = (var0 * WarpVar17) >> 4
            roty = WarpVar1
            rotz = (WarpVar1 + 90deg) % 360deg
            rotx = spd(rotx, -30deg)
            moda = 16.0 - ((0xCCD * WarpVar11) >> 8)
        }
        else {
            moda = 16.0
        }
    }
}

state Secret_Door_Init { // 25
    code(index) {
        zindex = -26
        rotx = 0deg
        rotz = 0deg
        if (index == 1) {
            setanim(SECRET_DOOR_1)
            SetTrans(-4122.0, 200000.0, -2383.2)
            roty = 60deg
        }
        else if (index == 2) {
            setanim(SECRET_DOOR_2)
            SetTrans(-4122.0, 200000.0, 2383.2)
            roty = 120deg
        }
        else if (index == 3) {
            setanim(SECRET_DOOR_3)
            SetTrans(6.0, 200000.0, 4766.8)
            roty = 90deg
        }
        else if (index == 4) {
            setanim(SECRET_DOOR_4)
            SetTrans(4134.0, 200000.0, 2383.2)
            roty = 240deg
        }
        else if (index == 5) {
            setanim(SECRET_DOOR_5)
            SetTrans(4134.0, 200000.0, -2383.2)
            roty = 300deg
        }
        WarpVar1 = y
        WarpVar2 = 0
        WarpVar6 = 0
        WarpVar3 = 0
        WarpVar7 = frametime + rand(4s)
        WarpVar17 = 0
        changestate(Secret_Door_Active)
    }
}

state Secret_Door_Active { // 26
    code() {
        sleepframe(0)
    }
    trans {
        if (WarpVar17 && !child) {
            WarpVar17 = 0
            parent -> WarpVar17 = parent -> WarpVar17 - 1
        }
        if (frametime >= WarpVar7) {
            WarpVar6 += (rand(0x6400) + 0x6400) / 25
            WarpVar7 = frametime + rand(8s) + 4s
            if (abs(degdist(CAMROTY, roty)) < 60.05deg && parent -> WarpVar17 == 0) {
                parent -> WarpVar17 = parent -> WarpVar17 + 1
                WarpVar17 = 1
                spawn(CHeOC, S_ANTENNA_GLOW, 1, 0, 2s)
                spawn(CHeOC, S_ANTENNA_GLOW, 1, 1.0, 2s)
            }
        }
        var old_offset = WarpVar2
        if (WarpVar2 == 0 || WarpVar6) {
            var next_velocity = WarpVar6 - (WarpVar2 / 25)
            var next_offset = WarpVar2 + next_velocity
            WarpVar2 = next_offset
            WarpVar6 = next_velocity
            if (old_offset >= 0) {
                if (next_offset < 1) {
                    WarpVar6 -= WarpVar6 >> 2
                }
            }
            else if (next_offset >= 0) {
                WarpVar6 -= WarpVar6 >> 2
            }
        }
        WarpVar3 = (sin((frametime << 5) & 0xFFF) * 0.075m) >> 12
        y = WarpVar1 + WarpVar2 + WarpVar3
    }
}

state Antenna_Glow { // 27
    __transargs
    code(vert, t) {
        do {
            playanim(0, GLOW)
            if (frametime > WarpVar1) {
                break
            }
        } while (1)
        tpc = 0
        do {
            if (!child) {
                break
            }
            playnull()
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            vecy = parent -> roty
            WarpVar1 = frametime + t
            SetRot(0deg)
        }
        if (vert != -1.0) {
            getvert(vtrans, creator, vert)
        }
        SetScale(rand(0.6S) + 0.4S)
        if ((frametime & 15) < 1 && FRAMETIME < 36 && abs(degdist(CAMROTY, vecy)) < 60.05deg) {
            spawn(9, 24, 1, vert)
        }
    }
}

state WarpLift_Init { // 28
    statusc 0x200002
    code() {
        FloorIndex = player -> y / 100m
        if (FloorIndex < 0) {
            FloorIndex = 0
        }
        if (FloorIndex >= 6) {
            FloorIndex = 5
        }
        WarpVar3 = FloorIndex
        spawn(CHeOC, S_WARP_LIFT_BARRIER, 1)
        pathprog = (FloorIndex * 90.0) + 9.0
        calcpath(pathprog)
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | 0x400000
        changestate(WarpLift_Wait)
    }
}

sub CheckPlayerStance() {
    if (player -> speed == 0
        && y - 0.1m < player -> y
        && player -> y < y + 0.1m
        && distance(player, DIST_EXACT | DIST_NO_Y) <= 0.5m
        && ((player -> stateflag & 0x2000) || dirhold(PAD_NONE))) {
        var0 = 1
        stateflag |= 0x400000
    }
    else {
        var0 = 0
        stateflag &= ~0x400000
    }
}

state WarpLift_Wait { // 29
    statusc 0x200002
    code() {
        WarpVar3 = FloorIndex
        sleepanim(0, WARP_LIFT)
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            WarpVar3 = -1
        }
        if (e == Event14) {
            accev()
            WarpVar3 = FloorIndex
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            zindex = 40
        }
        CheckPlayerStance()
        if (!var0) {
            statetime = frametime
            return
        }
        if (frametime - statetime >= 0.5s) {
            changestate(Warp_Lift_Ready)
        }
    }
}

state Warp_Lift_Ready { // 30
    stateflag 0x400001
    statusc 0x200002
    code() {
        WarpVar3 = FloorIndex
        sleepanim(0, WARP_LIFT)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            zindex = 40
            WarpVar10 = 0
            if (FloorIndex < 5) {
                misc = 0
                IteratePool(SAVEDCRYSTALPOOL1)
                IteratePool(SAVEDCRYSTALPOOL2)
                if (GLOBAL_21 & 1 || misc >= ((FloorIndex + 1) * 5)) {
                    WarpVar10 += 1
                }
            }
            if (FloorIndex) {
                WarpVar10 += 2
            }
            sendevent(Event77, player, WarpVar10)
        }
        if (buttonhold(PAD_X)) {
            sendevent(EventBounce, player, 12.64912m)
            changestate(WarpLift_Wait)
        }
        WarpVar7 = 0
        if (dirhold(PAD_N)) {
            if (WarpVar10 & 1) {
                WarpVar7 = 1
                sendevent(Event77, player, 1)
                changestate(WarpLift_Move)
            }
        }
        else if (dirhold(PAD_S)) {
            if (WarpVar10 & 2) {
                WarpVar7 = -1
                sendevent(Event77, player, 2)
                changestate(WarpLift_Move)
            }
        }
    }
}

state WarpLift_Move { // 31
    stateflag 0x400001
    statusc 0x200002
    code() {
        WarpVar3 = FloorIndex
        soundpitch(0x6E4)
        sounddecay(0xFF)
        soundplay([ElL2A], 0.3V)
        sleepanim(0, WARP_LIFT)
    }
    trans {
        once {
            WarpVar9 = 0
            WarpVar1 = (FloorIndex * 90.0) + 9.0
            WarpVar2 = WarpVar1
            if (WarpVar7 > 0) {
                WarpVar2 += 90.0
            }
            else {
                WarpVar2 -= 90.0
            }

            {
                var next_floor = 0
                if (WarpVar7 < 0) {
                    next_floor = FloorIndex - 1
                }
                else {
                    next_floor = FloorIndex + 1
                }

                if (next_floor == 0) {
                    loadfile([Wrp1T])
                    loadfile([WrpaT])
                }
                else if (next_floor == 1) {
                    loadfile([Wrp2T])
                    loadfile([WrpbT])
                }
                else if (next_floor == 2) {
                    loadfile([Wrp3T])
                    loadfile([WrpcT])
                }
                else if (next_floor == 3) {
                    loadfile([Wrp4T])
                    loadfile([WrpdT])
                }
                else if (next_floor == 4) {
                    loadfile([Wrp5T])
                    loadfile([WrpeT])
                }
            }
            WarpVar8 = 0
        }
        changestateif(WarpLift_Arrive, pathprog == WarpVar2 && abs(degdist(player -> troty, CAMROTY)) <= 5deg)
        var0 = pathprog - WarpVar1
        field_61 = (pathprog - 9.0) % 90.0
        if (field_61 >= 6.0 && field_61 <= 25.0) {
            statusb |= 0x40000000
            field_61 -= 6.0
            if (field_61 >= 12.0) {
                field_61 = 12.0
            }
            zindex = ((60 * field_61) / 12.0) + 40
        }
        else {
            zindex = 40
            statusb &= ~0x40000000
        }
        if (WarpVar2 > pathprog) {
            pathprog += 61
            if (pathprog > WarpVar2) {
                pathprog = WarpVar2
            }
            if (var0 >= 0x1100 && var0 <= 0x1900) {
                if (((!(GLOBAL_21 & 1) || buttonpress(PAD_TRIANGLE)) && !(DEBUG && buttonpress(PAD_R2))) || FloorIndex == 4) {
                    if (FloorIndex == 0) {
                        if (!(64 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossRipperRoo
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 1) {
                        if (!(0x100 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossKimodo
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 2) {
                        if (!(8 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossTazTiger
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 3) {
                        if (!(0x200 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossNGin
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 4) {
                        misc = 0
                        IteratePool(SAVEDGEMPOOL1)
                        IteratePool(SAVEDGEMPOOL2)
                        var gem_count = misc
                        if (!(0x80 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossCortex
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                        else if (gem_count >= 42) {
                            var0 = LEVEL_GameWin
                            changestate(WarpLift_Load_Boss)
                        }
                        else {
                            var0 = LEVEL_GameEnd
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                }
                WarpVar9 = 1
                zindex = 40
                ins72(0, 0x1000)
                soundpitch(0x6E4)
                sounddelay(1s)
                sounddecay(0xFF)
                soundplay([ElA2A], 0.3V)
                pathprog = WarpVar1 + 79.0
                if (pathprog >= pathlen) {
                    pathprog = pathlen - 1
                }
                calcpath(pathprog)
                player -> x = x
                player -> z = z
                player -> troty = (CAMROTY + 285deg) % 360deg
                player -> roty = player -> troty
                ins72(0x400, 0x100)
                FloorIndex += 1
                WarpVar3 = FloorIndex
            }
        }
        else {
            pathprog -= 61
            if (pathprog < WarpVar2) {
                pathprog = WarpVar2
            }
            if (var0 >= -0x1280 && var0 <= -0x980) {
                WarpVar9 = 1
                ins72(0, 0x2000)
                soundpitch(6.893)
                sounddelay(1s)
                sounddecay(10.22s)
                soundplay([ElA2A], 0.3V)
                pathprog = WarpVar1 - 0x4E19
                calcpath(pathprog)
                player -> x = x
                player -> z = z
                player -> troty = (CAMROTY + 230deg) % 360deg
                ins72(0x400, 0x100)
                FloorIndex -= 1
                WarpVar3 = FloorIndex
            }
        }
        if (abs(WarpVar2 - pathprog) < 10.0) {
            WarpVar8 -= 0.4deg
            if (WarpVar8 < 4.75deg) {
                WarpVar8 =  4.75deg
            }
        }
        else {
            WarpVar8 += 0.38deg
            if (WarpVar8 > 16deg) {
                WarpVar8 = 16deg
            }
        }
        roty += WarpVar8
        calcpath(pathprog)
        if (WarpVar9) {
            if (WarpVar9 == 1) {
                statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_HAS_SHADOW | 0x40000000
            }
            if (WarpVar9 == 4) {
                WarpVar9 += 1
                statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | FLAG_HAS_SHADOW | 0x40000000
            }
            if (WarpVar9 < 5) {
                WarpVar9 += 1
                player -> y = y
                statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | 0x400000
            }
        }
    }
}

state WarpLift_Arrive { // 32
    statusc 0x200002
    code() {
        if (player -> stateflag & 0x2000) {
            if (FloorIndex == 0) {
                deloadfile([Wrp1T])
                deloadfile([WrpaT])
            }
            else if (FloorIndex == 1) {
                deloadfile([Wrp2T])
                deloadfile([WrpbT])
            }
            else if (FloorIndex == 2) {
                deloadfile([Wrp3T])
                deloadfile([WrpcT])
            }
            else if (FloorIndex == 3) {
                deloadfile([Wrp4T])
                deloadfile([WrpdT])
            }
            else if (FloorIndex == 4) {
                deloadfile([Wrp5T])
                deloadfile([WrpeT])
            }
        }
        changestate(WarpLift_Wait)
    }
}

state Warp_Lift_Barrier { // 33
    code() {
        zindex = 200
        x -= 8.0
        do {
            if (WarpVar3 >= 0) {
                playanim(0, WARP_LIFT_BARRIER)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        WarpVar3 = creator -> WarpVar3
        FloorIndex = creator -> FloorIndex
        if (WarpVar3 >= 0) {
            var S3, S4
            S3 = WarpVar3 * 0x9C4000
            y = S3 - 8.0
            roty = (CAMROTY / 30deg) * 30deg
        }
    }
}

state Cutscene_Extras { // 34
    code(type, spawner, a0) {
        var0 = 0
        statusb = -0x7FF00000
        vfx = (vfx & 0xFFFF00FF) | 0x800
        WarpVar11 = 16.0
        moda = WarpVar11
        creator = spawner
        if (type == 0) {
            if (getfreepages() < 2) {
                return
            }
            loadfile([Sis1T])
            loadfile([S402V])
            loadfile([Si12G])
        }
        else if (type == 1) {
            if (getfreepages() < 2) {
                return
            }
            loadfile([Sis1T])
            loadfile([S602V])
            loadfile([Si12G])
        }
        else if (type == 2) {
            if (getfreepages() < 1) {
                return
            }
            loadfile([Sis1T])
            loadfile([S702V])
            loadfile([Si12G])
        }
        until(v0 || creator -> pathprog >= a0) {
            playnull()
        }
        if (type == 0) {
            WarpVar11 = 0
            loadfile([S412V])
            loadfile([Si12G])
            setanim(SIS_HEAD_9)
            do {
                animframe = creator -> pathprog - a0 << 8
                if (var0 || animframe > 254.0) {
                    break
                }
                playframe()
            } while (1)
            deloadfile([S402V])
            deloadfile([Si12G])
            setanim(SIS_HEAD_10)
            do {
                animframe = creator -> pathprog - (a0 + 0xFF) << 8
                if (var0 || animframe > 225.0) {
                    break
                }
                if (animframe >= 215.0) {
                    WarpVar11 = 16.0
                }
                playframe()
            } while (1)
            deloadfile([S412V])
            deloadfile([Si12G])
            deloadfile([Sis1T])
        }
        else if (type == 1) {
            WarpVar11 = 0
            loadfile([S612V])
            loadfile([Si12G])
            setanim(SIS_HEAD_1)
            do {
                animframe = creator -> pathprog - a0 << 8
                if (var0 || animframe > 254.0) {
                    break
                }
                playframe()
            } while (1)
            deloadfile([S602V])
            deloadfile([Si12G])
            setanim(SIS_HEAD_2)
            do {
                animframe = creator -> pathprog - (a0 + 0xFF) << 8
                if (var0 || animframe > 140.0) {
                    break
                }
                if (animframe >= 130.0) {
                    WarpVar11 = 16.0
                }
                playframe()
            } while (1)
            deloadfile([S612V])
            deloadfile([Si12G])
            deloadfile([Sis1T])
        }
        else if (type == 2) {
            WarpVar11 = 0
            setanim(SIS_HEAD_0)
            do {
                animframe = creator -> pathprog - a0 << 8
                if (var0 || animframe > 153.0) {
                    break
                }
                playframe()
            } while (1)
            deloadfile([S602V])
            deloadfile([Si12G])
            deloadfile([Sis1T])
        }
        else if (type == 3) {
            settrans(CrystalRotate)
            SetScale(0S)
            spawn(9, 47, 1, 0)
            SetColor2(-0xCCC, -0x800, 0x000)
            vfx = (vfx & 0xFFFFFF00) | 0xA
            vfx = (vfx & 0xFF00FFFF) | 0x40000
            moda = 4.0
            WarpVar11 = moda
            x = x + player -> x >> 1
            z = z + player -> z >> 1
            do (var start = frametime) {
                scalex = seek(scalex, 0.5S, 0.04S)
                scaley = seek(scaley, 0.5S, 0.04S)
                scalez = seek(scalez, 0.5S, 0.04S)
                playanim(0, CRYSTAL)
            } while (frametime - start < 4s)
            do (var start = frametime) {
                scalex = seek(scalex, 0S, 0.04S)
                scaley = seek(scaley, 0S, 0.04S)
                scalez = seek(scalez, 0S, 0.04S)
                playanim(0, CRYSTAL)
            } while (frametime - start < 0.5s)
        }
    }
    event(e, a) {
        if (e == Event12) {
            accev()
            var0 = 1.0
        }
    }
    trans {
        roty = parent -> roty
        stalltime = parent -> stalltime
        vecy = parent -> vecy
        vecx = parent -> vecx
        moda = seek(moda, WarpVar11, 1.925)
    }
}

sub CrystalRotate() {
    roty = spd(roty, 90deg)
    if (child) {
        child -> scalex = scalex
        child -> scaley = scaley
        child -> scalez = scalez
    }
}
