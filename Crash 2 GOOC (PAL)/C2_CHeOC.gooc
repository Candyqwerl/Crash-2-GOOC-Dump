state Monty_Hall_Init { // 0
    code(floor) {
        FloorIndex = floor
        GLOBAL_131 = 0
        WarpVar13 = 0
        WarpVar14 = 0
        WarpVar15 = 0
        WarpVar22 = 1
        WarpVar5 = 0
        WarpVar3 = 0
        WarpVar18 = 0
        WarpVar16 = 0
        WarpVar19 = 1
        WarpVar11 = 0
        WarpVar10 = 0
        WarpVar20 = objectget(OBJ_WARP_LIFT)
        if (FloorIndex == 0) {
            WarpRoomTable = WarpRoomDoorTable0
        }
        else if (FloorIndex == 1) {
            WarpRoomTable = WarpRoomDoorTable1
        }
        else if (FloorIndex == 2) {
            WarpRoomTable = WarpRoomDoorTable2
        }
        else if (FloorIndex == 3) {
            WarpRoomTable = WarpRoomDoorTable3
        }
        else if (FloorIndex == 4) {
            WarpRoomTable = WarpRoomDoorTable4
        }
        else {
            WarpRoomTable = WarpRoomDoorTable5
        }

        if (FloorIndex == 5) {
            WarpVar8 = 0
            WarpVar17 = 0
            if ((GLOBAL_150 & 4) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 1)
            }
            if ((GLOBAL_150 & 2) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 2)
            }
            if ((GLOBAL_150 & 1) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 3)
            }
            if ((GLOBAL_150 & 16) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 4)
            }
            if ((GLOBAL_150 & 8) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 5)
            }
        }
        else {
            spawn(CHeOC, S_CUTSCENE, 1)
            WarpVar8 = objectspawned
        }
        spawn(CHeOC, S_PORTAL_FX, 1)
        WarpVar9 = objectspawned
        changestate(WarpRoom_Idle)
    }
}

sub UpdateFacingTarget() {
    WarpVar1 = atan(-player -> x, -player -> z) % 360deg
    WarpVar3 = 0
    if (WarpVar1 < 20.05deg || WarpVar1 >= 340deg) {
        WarpVar3 = 1
    }
    else if (WarpVar1 >= 160deg) {
        if (WarpVar1 < 200.05deg) {
            WarpVar3 = 4
        }
        else if (WarpVar1 >= 220deg && WarpVar1 < 260.1deg) {
            WarpVar3 = 5
        }
        else if (WarpVar1 >= 280deg && WarpVar1 < 320.05deg) {
            WarpVar3 = 6
        }
    }
    else {
        if (WarpVar1 >= 40deg && WarpVar1 < 80.1deg) {
            WarpVar3 = 2
        }
        else if (WarpVar1 >= 100deg && WarpVar1 < 140.05deg) {
            WarpVar3 = 3
        }
    }
    WarpVar2 = distance(player, DIST_NO_Y)
}

sub ApplyCameraFocusTarget(){
    var S3 = 0, S4 = 1, S5 = -1, S6 = 0, S7 = 22, target_yaw = 0
    if (var target = var0; target == 1) {
        S7 = 0
        target_yaw = 0deg
        S5 = 7m
    }
    else if (target == 2) {
        target_yaw = 60deg
    }
    else if (target == 3) {
        target_yaw = 120deg
    }
    else if (target == 4) {
        target_yaw = 180deg
    }
    else if (target == 5) {
        target_yaw = 240deg
    }
    else if (target == 6) {
        target_yaw = 300deg
    }
    ins72(0x500, S6)
    ins72(0x600, S3)
}

sub CapturePlayerPosition() {
    rotx = player -> x
    roty = player -> y
    rotz = player -> z
    WarpVar22 = 0
}

sub FilterCameraTarget() {
    if (var0 < 1) {
        var0 = 0
    }
    else if (var0 == 1) {
        if (WarpVar2 < 4.5m) {
            var0 = 0
        }
    }
    else if (WarpVar2 < 2.5m) {
        var0 = 0
    }
}

sub ResolveFacingDoorLevel() {
    var0 -= 2
    if (var0 < 0) {
        var0 = -1
    }
    else {
        var pointer = var0 << 9
        var level = WarpRoomTable[pointer]
        var min_dist = WarpRoomTable[pointer + 1.0]
        var unlock_masks = SecretDoorUnlockMasks
        var unlock_mask = 0
        if (var0 < 5) {
            unlock_mask = unlock_masks[var0 << 8]
        }
        if (WarpVar2 < min_dist || (FloorIndex == 5 && !(GLOBAL_21 & 1) && !(GLOBAL_150 & unlock_mask))) {
            var0 = -1
        }
        else {
            var0 = level
        }
    }
}

inline sub IteratePool(global) {
    do (var i = 0) {
        if (global & (1 << i)) {
            misc += 1
        }
        i += 1
    } while (i < 32)
}

sub SetCutsceneIndex(){
    WarpVar16 = 0
    if (FloorIndex != 5) {
        var gem_count, crystal_count
        misc = 0
        IteratePool(SAVEDGEMPOOL1)
        IteratePool(SAVEDGEMPOOL2)
        gem_count = misc
        misc = 0
        IteratePool(SAVEDCRYSTALPOOL1)
        IteratePool(SAVEDCRYSTALPOOL2)
        crystal_count = misc
        if (!(2 & PREVBOXCOUNT)) {
            WarpVar16 = 1
        }
        else if (!(4 & PREVBOXCOUNT)) {
            if (crystal_count >= 1) {
                WarpVar16 = 2
            }
            else {
                if (!(0x4000 & PREVBOXCOUNT)) {
                    WarpVar16 = 14
                }
                else if (!(0x8000 & PREVBOXCOUNT)) {
                    WarpVar16 = 15
                }
                else if (!(0x10000 & PREVBOXCOUNT)) {
                    WarpVar16 = 16
                }
            }
        }
        else if (!(8 & PREVBOXCOUNT) && crystal_count >= 3) {
            WarpVar16 = 3
        }
        else if (!(16 & PREVBOXCOUNT) && crystal_count >= 5) {
            WarpVar16 = 4
        }
        else if (!(32 & PREVBOXCOUNT) && 64 & GLOBAL_27) {
            WarpVar16 = 5
        }
        else if (!(64 & PREVBOXCOUNT) && crystal_count >= 10) {
            WarpVar16 = 6
        }
        else if (!(0x80 & PREVBOXCOUNT) && 0x100 & GLOBAL_27) {
            WarpVar16 = 7
        }
        else if (!(0x100 & PREVBOXCOUNT) && crystal_count >= 12) {
            WarpVar16 = 8
        }
        else if (!(0x200 & PREVBOXCOUNT) && crystal_count >= 15) {
            WarpVar16 = 9
        }
        else if (!(0x400 & PREVBOXCOUNT) && crystal_count >= 17) {
            WarpVar16 = 10
        }
        else if (!(0x800 & PREVBOXCOUNT) && crystal_count >= 20) {
            WarpVar16 = 11
        }
        else if (!(0x1000 & PREVBOXCOUNT) && 0x200 & GLOBAL_27) {
            WarpVar16 = 12
        }
        else if (!(0x80 & GLOBAL_27) && !(0x2000 & PREVBOXCOUNT) && crystal_count >= 25) {
            WarpVar16 = 13
        }
        else if (!(0x20000 & PREVBOXCOUNT) && gem_count >= 1) {
            WarpVar16 = 17
        }
        else if (!(0x40000 & PREVBOXCOUNT) && gem_count >= 42 && 0x80 & GLOBAL_27) {
            WarpVar16 = 18
        }
        if (WarpVar16) {
            PREVBOXCOUNT += 1 << WarpVar16
        }
    }
}

