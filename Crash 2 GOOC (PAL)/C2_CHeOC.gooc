    if (DEBUG) {
        if (dirpress(PAD_N) || dirpress(PAD_S) || dirpress(PAD_W) || dirpress(PAD_E) || buttonpress(0x9FF)) { // TODO: Give proper enum
            if (var step = WarpVar13; step == 0) {
                if (dirpress(PAD_E)) {
                    WarpVar13 += 1.0
                }
