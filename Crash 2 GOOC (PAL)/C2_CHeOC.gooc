sub DeloadPortalVIDO() {
    if (GLOBAL_126) {
        ins75(GLOBAL_126, null)
        GLOBAL_126 = 0
    }
    if (WarpVar13) {
        WarpVar13 = 0
        deloadfile([Car1T])
        deloadfile([wdr0D])
    }
}

state Portal_FX_Load_VIDO { // 16
    code() {
        if (WarpVar13 == 0) {
            do {
                playnull()
            } until(getpayload(& [Car1T]) <= getfreepages())
            loadfile([Car1T])
            loadfile([wdr0D])
            WarpVar13 = 1
        }
        until(isloaded([Car1T]) && isloaded([wdr0D])){
            playnull()
        }
        if (GLOBAL_126 == 0) {
            GLOBAL_126 = ins74([wdr0D], null)
        }
        WarpVar12 = 1.0
        changestate(Portal_FX_Active)
    }
    event(e, a) {
        if (e == Event41 || e == Event26) {
            DeloadPortalVIDO()
        }
        accevcstate(Portal_FX_Kill, e == Event14)
    }
}

state Portal_FX_Active { // 17
    code() {
        spawn(CHeOC, S_PORTAL_BG, 1, 1)
        spawn(CHeOC, S_PORTAL_BG, 1, 0)

        do (var index = 0) {
            spawn(CHeOC, S_PORTAL_SWIRL, 1, index, 1)
            spawn(CHeOC, S_PORTAL_SWIRL, 1, index, 0)
            index += 1.0
        } while (index < 5.0)

        if (FloorIndex != 5) {
            spawn(CHeOC, S_PORTAL_PARTICLES, 1, 1)
            spawn(CHeOC, S_PORTAL_PARTICLES, 1, 0)
        }
        do {
            do (var i = 0) {
                if (GLOBAL_126) {
                    ins76(GLOBAL_126, i)
                    ins77(0, misc, GLOBAL_126, WARP_PORTAL_SWIRL) // fucker
                }
                var0 = (GLOBAL_126[1.0] + 1.0) >> 1
                vecx = i - var0
                if (vecx < 0) {
                    vecx = -vecx
                }
                var S5 = vecx / (var0 >> 8)
                var S6 = 1.0 - S5
                vecx = ((S5 * 0x9F) >> 8) + 0x60
                vecy = ((S6 * 0x9F) >> 8) + 0x60
                GLOBAL_136 = 0x6000 | (vecx << 16) | vecy
                GLOBAL_137 = (0x1000 * WarpVar11) >> 8
                playnull()
                i += 1.0
            } while (i < GLOBAL_126[1.0])
        } while (1)
    }
    event(e, a) {
        if (e == Event41 || e == Event26) {
            DeloadPortalVIDO()
        }
        if (e == Event14) {
            accev()
            WarpVar12 = 0
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            WarpVar20 = FloorIndex * 100m
        }
        WarpVar7 = -1.0
        WarpVar8 = -1.0
        var S3 = 0
        do (var table = PortalSlotTable) {
            if (CAMROTY < table[S3]) {
                WarpVar7 = table[S3 + 1.0]
                WarpVar8 = table[S3 + 2.0]
                break
            }
            S3 += 3.0
        } while (1)
        if (FloorIndex == 5) {
            var unlock_masks = SecretDoorUnlockMasks
            if (WarpVar7 >= 0) {
                var S6 = unlock_masks[WarpVar7]
                if (!(GLOBAL_150 & S6) && !(GLOBAL_21 & 1)) {
                    WarpVar7 = -1
                }
            }
            if (WarpVar8 >= 0) {
                var S7 = unlock_masks[WarpVar8]
                if (!(GLOBAL_150 & S7) && !(GLOBAL_21 & 1)) {
                    WarpVar8 = -1
                }
            }
        }
        if (WarpVar7 >= 0) {
            S3 = WarpVar7 << 1
            WarpVar1 = WarpRoomTable[S3]
            WarpVar3 = WarpRoomTable[S3 + 1.0] + WarpVar20
            WarpVar16 = sin(WarpVar1)
            WarpVar17 = cos(WarpVar1)
            if (WarpVar7 & 1) {
                var0 = 0
            }
            else {
                var0 = 6
            }
            WarpVar14 = (((time(0.5s, var0) << 8) / 12) * 0x64000) >> 8
        }
        else {
            WarpVar1 = 0
        }
        if (WarpVar8 >= 0) {
            S3 = WarpVar8 << 1
            WarpVar2 = WarpRoomTable[S3]
            WarpVar6 = WarpRoomTable[S3 + 1.0] + WarpVar20
            WarpVar18 = sin(WarpVar2)
            WarpVar19 = cos(WarpVar2)
            if (WarpVar8 & 1) {
                var0 = 0
            }
            else {
                var0 = 6
            }
            WarpVar15 = (((time(0.5s, var0) << 8) / 12) * 0x64000) >> 8
        }
        else {
            WarpVar2 = 0
        }
        if (WarpVar11 != WarpVar12) {
            WarpVar11 = seek(WarpVar11, WarpVar12, 10)
        }
        changestateifn(Portal_FX_Kill, getfield(self, 74.0))
    }
