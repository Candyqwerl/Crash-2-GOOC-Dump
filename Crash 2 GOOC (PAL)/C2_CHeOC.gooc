        if (scalex == 1) {
            x = creator -> x
            y = creator -> y
            z = creator -> z
            vecx = creator -> vecx
            vecy = creator -> vecy
            vecz = creator -> vecz
            trotx = -creator -> trotx
            troty = creator -> troty + 180deg
            trotz = troty
            vectransf2(vvec, vtrans, 8m, 0, 0)
        }
        else if (scalex == 2) {
            x = creator -> x
            y = creator -> y
            z = creator -> z
        }
