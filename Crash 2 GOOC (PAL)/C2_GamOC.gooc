#gool GamOC 62 5

#include "goolstdlib.gooc"

#anim CORTEX_BG             [Cb1YV] 1 1
#anim CORTEX_SIDE_EYE_1     [C40YV] 6 1
#anim CORTEX_SIDE_EYE_2     [C41YV] 6 1
#anim CORTEX_SIDE_EYE_3     [C42YV] 6 1
#anim CORTEX_SIDE_EYE_4     [C43YV] 6 1
#anim CORTEX_SIDE_EYE_5     [C44YV] 6 1
#anim CORTEX_SIDE_EYE_6     [C45YV] 6 1
#anim CORTEX_SIDE_EYE_LOOP  [C32YV] 100 1
  
#anim CORTEX_EXIT_EN        [C10YV] 80 1
#anim CORTEX_CONTINUE_EN    [C20YV] 50 1
#anim CORTEX_GAME_OVER_EN   [C30YV] 186 1
#anim CORTEX_WARP_IN_EN     [C31YV] 18 1
  
#anim CORTEX_EXIT_FR        [C10FV] 80 1
#anim CORTEX_CONTINUE_FR    [C20FV] 50 1
#anim CORTEX_GAME_OVER_FR   [C30FV] 186 1
#anim CORTEX_WARP_IN_FR     [C31FV] 18 1
  
#anim CORTEX_EXIT_DE        [C10GV] 80 1
#anim CORTEX_CONTINUE_DE    [C20GV] 50 1
#anim CORTEX_GAME_OVER_DE   [C30GV] 186 1
#anim CORTEX_WARP_IN_DE     [C31GV] 18 1
  
#anim CORTEX_EXIT_ES        [C10SV] 80 1
#anim CORTEX_CONTINUE_ES    [C20SV] 50 1
#anim CORTEX_GAME_OVER_ES   [C30SV] 186 1
#anim CORTEX_WARP_IN_ES     [C31SV] 18 1
  
#anim CORTEX_EXIT_IT        [C10IV] 80 1
#anim CORTEX_CONTINUE_IT    [C20IV] 50 1
#anim CORTEX_GAME_OVER_IT   [C30IV] 186 1
#anim CORTEX_WARP_IN_IT     [C31IV] 18 1

#include "C2_DispC.gooh"
#include "C2_FONT_SMALL.gooc"

#text MENU_TEXT FONT_SMALL[Cr20T]
">"           // 0.0
"CONTINUER?"  // 1.0
"OUI"         // 2.0
"NON"         // 3.0
"WEITER?"     // 4.0
"JA"          // 5.0
"NEIN"        // 6.0
"CONTINUA?"   // 7.0
"SI"          // 8.0
"NO"          // 9.0
"?CONTINUAR?" // 10.0
"CONTINUE?"   // 11.0
"YES"         // 12.0

#spawn S_GAME_OVER   GameOver_Controller
#spawn S_LOAD_LEVEL  GameOver_Load_Level
#spawn S_BACKGROUND  GameOver_Background
#spawn S_MENU        GameOver_Menu

var HologramStatic, SavedMusicVolume

expr LANG_FR = 2.0
expr LANG_DE = 3.0
expr LANG_IT = 4.0
expr LANG_ES = 1.0

expr MenuChoiceYes = 0.0
expr MenuChoiceNo = 1.0
expr ModePlayDemo = 0
expr ModeContinueToWarp = 1.0
expr ModeReplayIntro = 2.0
expr ModeNoToWarp = 3.0
expr ModeNoToTitle = 4.0

state GameOver_Background { // 0
    code() {
        SetRot(0deg)
        SetScale(1.5S)
        zindex = -200
        y += 0.3m
        sleepanim(0, CORTEX_BG)
    }
}

state GameOver_Menu { // 1
    code() {
        movetolist(3.0)
        SetTrans(-112.0, -71.0, 0.0)
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -2.0, getanim(MENU_TEXT), 0, 176.0, 0, 1)
            player = objectspawned
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(MENU_TEXT), 1.0, 0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 0, getanim(MENU_TEXT), 2.0, 192.0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 1.0, getanim(MENU_TEXT), 3.0, 192.0, -18.0, player)
        }
        else if (lang == LANG_DE) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -2.0, getanim(MENU_TEXT), 0, 160.0, 0, 1)
            player = objectspawned
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(MENU_TEXT), 4.0, 0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 0.0, getanim(MENU_TEXT), 5.0, 176.0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 1.0, getanim(MENU_TEXT), 6.0, 176.0, -18.0, player)
        }
        else if (lang == LANG_IT) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -2.0, getanim(MENU_TEXT), 0, 160.0, 0, 1)
            player = objectspawned
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(MENU_TEXT), 7.0, 0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 0.0, getanim(MENU_TEXT), 8.0, 176.0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 1.0, getanim(MENU_TEXT), 9.0, 176.0, -18.0, player)
        }
        else if (lang == LANG_ES) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -2.0, getanim(MENU_TEXT), 0, 192.0, 0, 1)
            player = objectspawned
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(MENU_TEXT), 10.0, 0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 0.0, getanim(MENU_TEXT), 8.0, 208.0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 1.0, getanim(MENU_TEXT), 9.0, 208.0, -18.0, player)
        }
        else {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -2.0, getanim(MENU_TEXT), 0, 160.0, 0, 1)
            player = objectspawned
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(MENU_TEXT), 11.0, 0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 0.0, getanim(MENU_TEXT), 12.0, 176.0, 0, player)
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, 1.0, getanim(MENU_TEXT), 9.0, 176.0, -18.0, player)
        }
        sleepnull()
    }
    event(e, a) {
        if (e == Event12) {
            accev()
            var0 = true
        }
    }
    trans {
        once {
            SetScale(0xA3, 0x103, 0x1000)
            SetRot(0deg)
            stalltime = 0
            field_61 = 2.0
        }
        unless(STATUS_FIRSTFRAME) {
            unless(stateflag & 0x400000) {
                if (dirpress(PAD_UP) && stalltime > 0) {
                    save(vfx) {
                        vfx = (vfx & 0xFFFFFF00) | 0x6
                        soundpitch(0x7F)
                        sounddecay(0xF0)
                        soundplay([Mb10A], 0.5V)
                    }
                    stalltime -= 1.0
                }
                if (dirpress(PAD_DOWN) && stalltime < field_61 - 1.0) {
                    save(vfx) {
                        vfx = (vfx & 0xFFFFFF00) | 0x6
                        soundpitch(0x7F)
                        sounddecay(0xF0)
                        soundplay([Mb10A], 0.5V)
                    }
                    stalltime += 1.0
                }
                if (buttonpress(PAD_START | PAD_X)) {
                    save(vfx) {
                        vfx = (vfx & 0xFFFFFF00) | 0x6
                        soundpitch(4.0)
                        sounddecay(0xF0)
                        soundplay([tal0A], 0.8V)
                    }
                    sendevent(Event3, creator, stalltime)
                    stateflag |= 0x400000
                }
            }
        }
    }
}

inline sub PlayCortexGameOverSpeech(WarpInAnimFile, SpeechFile1, SpeechFile2, SpeechAnimFile, WarpInAnim, SpeechAnim) {
    save(MUSVOL, GLOBAL_74) {
        GLOBAL_74 = 0
        MUSVOL = 0
        field_61 = 0
        loadfile([CrtxT])
        loadfile(WarpInAnimFile)
        loadfile([Co1YG])
        spawn2(9, 44, 1, SpeechFile1, SpeechFile2, 2.0, 0x61A8, 8.0)
        creator = objectspawned
        loadfile(SpeechAnimFile)
        loadfile([Co1YG])
        playnull()
        until(isloaded([Co1YG]) && isloaded(SpeechAnimFile) && isloaded(SpeechFile1) && isloaded([Co1YG]) && isloaded(WarpInAnimFile)) {
            playnull()
        }
        sendevent(EventTriggered, creator)
        playframes(WarpInAnim, 0.0, 17.0)
        while (creator -> pathprog < 17) {
            playframe()
        }
        field_62 = 0
        deloadfile(WarpInAnimFile)
        deloadfile([Co1YG])
        setanim(SpeechAnim)
        do {
            animframe = creator -> pathprog - 17 << 8
            if (animframe > 185.0) {
                break
            }
            else {
                playframe()
            }
        } while (1)
        animframe = 185.0
        deloadfile(SpeechAnimFile)
        deloadfile([Co1YG])
        cascadeevent(Event12, self)
        deloadfile([CrtxT])
    }
}

state GameOver_Controller { // 2
    stateflag 0x20000001
    code() {
        SetTrans(0, 0, 0)
        SavedMusicVolume = MUSVOL
        SetRot(5deg, 0deg, 0deg)
        y = CAMTRANSY
        x = CAMTRANSX
        z = CAMTRANSZ - 7.5m
        spawn(GamOC, S_BACKGROUND, 1)
        GLOBAL_74 = 0
        GAMEFLAGS &= ~0x800001
        playnull()
        playnull()
        playnull()
        playnull()
        spawn(GamOC, S_MENU, 1)
        statusb = 0x100000
        HologramStatic = 0
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            PlayCortexGameOverSpeech([C31FV], [C30FO], [C31FO], [C30FV], CORTEX_WARP_IN_FR, CORTEX_GAME_OVER_FR)
        }
        else if (lang == LANG_DE) {
            PlayCortexGameOverSpeech([C31GV], [C30GO], [C31GO], [C30GV], CORTEX_WARP_IN_DE, CORTEX_GAME_OVER_DE)
        }
        else if (lang == LANG_IT) {
            PlayCortexGameOverSpeech([C31IV], [C30IO], [C31IO], [C30IV], CORTEX_WARP_IN_IT, CORTEX_GAME_OVER_IT)
        }
        else if (lang == LANG_ES) {
            PlayCortexGameOverSpeech([C31SV], [C30SO], [C31SO], [C30SV], CORTEX_WARP_IN_ES, CORTEX_GAME_OVER_ES)
        }
        else {
            PlayCortexGameOverSpeech([C31YV], [C30YO], [C31YO], [C30YV], CORTEX_WARP_IN_EN, CORTEX_GAME_OVER_EN)
        }
        stateflag &= ~0x20000000
        sleepframes(CORTEX_SIDE_EYE_LOOP, 0.0, 99.0)
    }
    event(e, a) {
        if (e == Event3) {
            if (stateflag & 0x20000000) {
                if (a[0]) {
                    spawn(GamOC, S_LOAD_LEVEL, 1, ModeNoToTitle)
                }
                else {
                    spawn(GamOC, S_LOAD_LEVEL, 1, ModeContinueToWarp)
                }
                epc = 0
            }
            else {
                accevcstate(GameOver_Continue, a[0] == MenuChoiceYes)
                accevcstate(GameOver_Exit, a[0] == MenuChoiceNo)
            }
        }
    }
    trans {
        stalltime = HologramStatic & -4 | GAMETICK & 3
        if (animseq) {
            moda = seek(moda, 0.0, 0x222)
        }
        else {
            moda = 16.0
        }
    }
}

inline sub PlayCortexChoiceSpeech(AnimFile, SpeechFile, SpeechAnim, FrameMax) {
    loadfile(AnimFile)
    loadfile([Co1YG])
    loadfile(SpeechFile)
    soundpitch(8.0)
    soundplay(SpeechFile, 0V)
    CortexFaceScreenCenter()
    save(MUSVOL, GLOBAL_74) {
        GLOBAL_74 = 0
        MUSVOL = 0
        field_61 = 0
        loadfile([CrtxT])
        loadfile(AnimFile)
        loadfile([Co1YG])
        spawn2(9, 44, 1, SpeechFile, 1.0, 0x61A8, 8.0)
        creator = objectspawned
        playframe()
        until(isloaded(SpeechFile) && isloaded([Co1YG]) && isloaded(AnimFile)) {
            playframe()
        }
        sendevent(EventTriggered, creator)
        playframe()
        field_62 = 0
        setanim(SpeechAnim)
        do {
            animframe = creator -> pathprog << 8
            if (animframe > FrameMax) {
                break
            }
            else {
                playframe()
            }
        } while (1)
        animframe = FrameMax
        deloadfile(AnimFile)
        deloadfile([Co1YG])
        cascadeevent(Event12, self)
        deloadfile([CrtxT])
    }
    deloadfile(AnimFile)
    deloadfile([Co1YG])
    deloadfile(SpeechFile)
}


state GameOver_Exit { // 3
    code() {
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            PlayCortexChoiceSpeech([C10FV], [C10FO], CORTEX_EXIT_FR, 79.0)
        }
        else if (lang == LANG_DE) {
            PlayCortexChoiceSpeech([C10GV], [C10GO], CORTEX_EXIT_DE, 79.0)
        }
        else if (lang == LANG_IT) {
            PlayCortexChoiceSpeech([C10IV], [C10IO], CORTEX_EXIT_IT, 79.0)
        }
        else if (lang == LANG_ES) {
            PlayCortexChoiceSpeech([C10SV], [C10SO], CORTEX_EXIT_ES, 79.0)
        }
        else {
            PlayCortexChoiceSpeech([C10YV], [C10YO], CORTEX_EXIT_EN, 79.0)
        }
        spawn(GamOC, S_LOAD_LEVEL, 1, ModeNoToWarp)
        sleep()
    }
}

inline sub PlayCortexSideEyeFrames(anim) {
    playanim(0, anim)
    playanim(1, anim)
    playanim(2, anim)
    playanim(3, anim)
    playanim(4, anim)
    playanim(5, anim)
}

sub CortexFaceScreenCenter() {
    do {
        if (animframe == 12.0) {
            PlayCortexSideEyeFrames(CORTEX_SIDE_EYE_1)
            return
        }
        else if (animframe == 29.0) {
            PlayCortexSideEyeFrames(CORTEX_SIDE_EYE_2)
            return
        }
        else if (animframe == 46.0) {
            PlayCortexSideEyeFrames(CORTEX_SIDE_EYE_3)
            return
        }
        else if (animframe == 62.0) {
            PlayCortexSideEyeFrames(CORTEX_SIDE_EYE_4)
            return
        }
        else if (animframe == 79.0) {
            PlayCortexSideEyeFrames(CORTEX_SIDE_EYE_5)
            return
        }
        else if (animframe == 96.0) {
            PlayCortexSideEyeFrames(CORTEX_SIDE_EYE_6)
            return
        }
        else {
            if (animseq != getanim(CORTEX_SIDE_EYE_LOOP)) {
                setanim(CORTEX_SIDE_EYE_LOOP, -1.0)
            }
            playframe((animframe + 1.0) % 100.0)
        }
    } while (1)
}

state GameOver_Continue { // 4
    code() {
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            PlayCortexChoiceSpeech([C20FV], [C20FO], CORTEX_CONTINUE_FR, 49.0)
        }
        else if (lang == LANG_DE) {
            PlayCortexChoiceSpeech([C20GV], [C20GO], CORTEX_CONTINUE_DE, 49.0)
        }
        else if (lang == LANG_IT) {
            PlayCortexChoiceSpeech([C20IV], [C20IO], CORTEX_CONTINUE_IT, 49.0)
        }
        else if (lang == LANG_ES) {
            PlayCortexChoiceSpeech([C20SV], [C20SO], CORTEX_CONTINUE_ES, 49.0)
        }
        else {
            PlayCortexChoiceSpeech([C20YV], [C20YO], CORTEX_CONTINUE_EN, 49.0)
        }
        spawn(GamOC, S_LOAD_LEVEL, 1, ModeContinueToWarp)
        sleep()
    }
}

state GameOver_Load_Level { // 5
    code(mode) {
        if (mode == ModePlayDemo) {
            GLOBAL_131 = 0
            GLOBAL_17 = 6.0
            GLOBAL_10 = 6.0
            GAMEFLAGS &= ~0x2
            miscfunc(null, player, 11, 12)
            if (var demo_index = GLOBAL_114; demo_index == 0) var0 = LEVEL_TurtleWoods;
            else if (demo_index == 1) var0 = LEVEL_PlantFood;
            else if (demo_index == 2) var0 = LEVEL_SnowGo;
            else if (demo_index == 3) var0 = LEVEL_RockIt;
            else if (demo_index == 4) var0 = LEVEL_TheEelDeal;
            else if (demo_index == 5) var0 = LEVEL_BearIt;
            else if (demo_index == 6) var0 = LEVEL_BossNGin;
            GLOBAL_114 = (GLOBAL_114 + 1) % 7
        }
        else if (mode == ModeContinueToWarp) {
            LIFECOUNT = STARTLIVES
            CURRENTLEVEL = 0x63
            var0 = LEVEL_WarpRoom
        }
        else if (mode == ModeReplayIntro) {
            miscfunc(null, player, 11, 12)
            GLOBAL_131 = 0
            GLOBAL_10 = 0
            var0 = LEVEL_Intro
        }
        else if (mode == ModeNoToWarp) {
            miscfunc(null, player, 11, 12)
            GLOBAL_90 |= 1
            LIFECOUNT = STARTLIVES
            CURRENTLEVEL = 0x63
            var0 = LEVEL_WarpRoom
        }
        else if (mode == ModeNoToTitle) {
            GLOBAL_131 = 0
            GLOBAL_17 = 6.0
            GLOBAL_10 = 6.0
            GAMEFLAGS &= ~0x2
            miscfunc(null, player, 11, 12)
            var0 = LEVEL_Title
        }
        FadeToBlack()
        WaitFadeFrame()
        if (parent -> spawn == 0) {
            MUSVOL = parent -> SavedMusicVolume
        }
        loadlevel(var0)
        sleepnull()
    }
}

state Kill { // 6
    statusc 0x0
    code() { }
}
