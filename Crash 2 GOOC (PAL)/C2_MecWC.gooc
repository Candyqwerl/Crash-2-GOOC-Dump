#gool MecWC 21 3

#include "goolstdlib.gooc"
#include "C2_ShadC.gooh"

#anim MECH_BOB              [Mw1cV] 32 1
#anim MECH_FLOATER          [Mw2cV] 32 1

#spawn S_MECH_FLOATER       Mech_Init
#spawn S_MECH_HANGER        Mech_Init
#spawn S_MECH_OLD           Mech_Init
#spawn S_MECH_BOB           Mech_Init
#spawn S_MECH_PATH          Mech_Init
#spawn S_MECH_PATH_FLOATER  Mech_Init

event EventHit           => state Mech_Squash
event EventHitInvincible => state Mech_Squash
event EventFling         => state Mech_Fling

var MechVar1, CycleOff, CycleLen, TurnDuration, MechVar5, MechTrackOffset, TravelDuration

state Mech_Init {
    statusc 0x12
    code(max_trackoffs, cyclelen, cycleoff, turnlen) {
        pathdist = max_trackoffs
        CycleLen = cyclelen * 1s / 1.2s
        CycleOff = cycleoff * 1s / 1.2s
        TurnDuration = turnlen
        MechTrackOffset = 0
        density = 0.15m
        zindex = 25
        MechVar5 = 0
        spawn(ShadC, ShadC_S_SHADOW_STATIONARY, 1, 0, 1S, 10)
        if (spawn == S_MECH_BOB) {
            statusb = FLAG_ROT_Y | FLAG_COLLIDABLE | FLAG_SOLID_ALL | 0x20000000
            changestate(Mech_Bob)
        }
        if (spawn == S_MECH_PATH || spawn == S_MECH_PATH_FLOATER) {
            statusb = FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | FLAG_COLLIDABLE | FLAG_SOLID_ALL | 0x20000000
            changestate(Mech_Path)
        }
        statusb = FLAG_TRACK_PATH_SIGN | FLAG_COLLIDABLE | FLAG_SOLID_SIDES | 0x800 | 0x2000 | 0x20000000
        TravelDuration = CycleLen - (TurnDuration << 1) >> 1
        changestate(Mech_Path_Track)
    }
}

inline sub SpawnTrailSmoke() {
    if (FRAMETIME < 36 && !rand(15)) {
        spawn(9, 0, 1, 0)
    }
}

state Mech_Path {
    stateflag 0x5
    statusc 0
    code => state Mech_Path_Track
    event => state Mech_Path_Track
    trans {
        SpawnTrailSmoke()
        pathprog = (pathprog + spd(CycleLen)) % (pathlen - 1.0)
        calcpath(pathprog)
        sendevent(EventHit, collider, 100.0)
    }
}

state Mech_Bob {
    stateflag 0x5
    statusc 0
    code => state Mech_Path_Track
    event => state Mech_Path_Track
    trans {
        SpawnTrailSmoke()
        var HalfCycleLen = CycleLen >> 1
        var cycletime = time(CycleLen, CycleOff)
        var PathSegTime = 0
        if (HalfCycleLen > 0 && cycletime >= 0 && cycletime <= HalfCycleLen) {
            PathSegTime = cycletime
            var PathPoint = (PathSegTime * (pathlen - 1.0)) / HalfCycleLen
            calcpath(PathPoint)
            pathprog = PathPoint
        }
        else if (CycleLen - HalfCycleLen > 0 && cycletime >= HalfCycleLen && cycletime <= CycleLen) {
            PathSegTime = cycletime - HalfCycleLen
            var PathPoint = (pathlen - 1.0) + ((PathSegTime * -(pathlen - 1.0)) / (CycleLen - HalfCycleLen))
            calcpath(PathPoint)
            pathprog = PathPoint
        }
        troty = atan2(player -> trans)
        sendevent(EventHit, collider, 100.0)
    }
}

state Mech_Path_Track {
    stateflag 0x5
    statusc 0
    code() {
        trotx = 180deg
        yzapproach = 120deg
        if (id & 1.0) {
            if (spawn == S_MECH_BOB || spawn == S_MECH_PATH_FLOATER) {
                playframe(31.0)
            }
            else if (spawn == S_MECH_FLOATER || spawn == S_MECH_HANGER || spawn == S_MECH_PATH) {
                playframe(31.0)
            }
        }
        do {
            if (spawn == S_MECH_BOB || spawn == S_MECH_PATH_FLOATER) {
                playframes(MECH_BOB, 0.0, 31.0)
            }
            else if (spawn == S_MECH_FLOATER || spawn == S_MECH_HANGER || spawn == S_MECH_PATH) {
                playframes(MECH_FLOATER, 0.0, 31.0)
            }
        } while (1)
    }
    event(e, a) {
        accevcstate(Mech_Fling, spawn == S_MECH_OLD && (e == EventSpinHit || e == EventSlideHit))
        if (e == EventSpinHit || e == EventSlideHit) {
            rejev()
            sendevent(Event24, interrupter, 100.0)
        }
    }
    trans { // MIPS
        if (spawn != S_MECH_OLD) {
            SpawnTrailSmoke()
        }
        var CycleTime = time(CycleLen, CycleOff)
        var PathSegTime = 0
        var PathPoint = 0
        if (TurnDuration > 0 && CycleTime >= 0 && CycleTime <= TurnDuration) {
            PathSegTime = CycleTime
            roty = troty - ((CycleTime * 180deg) / TurnDuration)
            statusb &= ~(FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN)
        }
        else if (CycleTime >= TurnDuration && CycleTime <= TurnDuration + TravelDuration) {
            PathSegTime = CycleTime - TurnDuration
            PathPoint = (PathSegTime * (pathlen - 1.0)) / TravelDuration
            statusb |= FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN
            calcpath(PathPoint)
        }
        else if (TurnDuration > 0 && CycleTime >= TurnDuration + TravelDuration && CycleTime <= (TurnDuration << 1) + TravelDuration) {
            PathSegTime = CycleTime - (TurnDuration + TravelDuration)
            roty = troty - ((PathSegTime * 180deg) / TurnDuration)
            statusb &= ~(FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN)
        }
        else if (CycleTime >= (TurnDuration << 1) + TravelDuration && CycleTime <= CycleLen) {
            PathSegTime = CycleTime - ((TurnDuration << 1) + TravelDuration)
            var ReturnDuration = CycleLen - ((TurnDuration << 1) + TravelDuration)
            PathPoint = (pathlen - 1.0) + ((PathSegTime * -(pathlen - 1.0)) / ReturnDuration)
            statusb |= FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN
            calcpath(PathPoint)
            troty += 180deg
        }

        if (pathdist) {
            var deg_to_player = 0deg
            var pathrot = troty
            save(troty, statusa, statusb, x, y, z, pathprog) {
                statusb = FLAG_PATH_CALCS | FLAG_TRACK_PATH_SIGN
                x = player -> x
                y = player -> y
                z = player -> z
                calcpath(0)
                troty += 90deg
                setvel(MechTrackOffset, vvel)
            }
            x += velx
            z += velz
            if (abs(MechTrackOffset - vecy) > 0.1m) {
                deg_to_player = degdist(troty, atan2(player -> trans))
                if (abs(deg_to_player) < 60deg) {
                    if (deg_to_player < -45deg) {
                        deg_to_player = -45deg
                    }
                    else if (deg_to_player > 45deg) {
                        deg_to_player = 45deg
                    }
                    troty += deg_to_player
                }
            }
            MechTrackOffset = seek(MechTrackOffset, vecy, spd(2m))
            if (MechTrackOffset < -pathdist) {
                troty = pathrot
                MechTrackOffset = -pathdist
            }
            else if (MechTrackOffset > pathdist) {
                troty = pathrot
                MechTrackOffset = pathdist
            }
        }
        sendevent(EventHit, collider, 100.0)
    }
}

state Mech_Path_Old {
    stateflag 0x5
    statusc 0
    code => state Mech_Path_Track
    event => state Mech_Path_Track
    trans {
        once {
            TurnDuration = (pathlen << 1) / (CycleLen + 1)
        }
        if (spawn == S_MECH_BOB) {
            var cycletime = time(CycleLen, CycleOff)
            pathprog = abs((cycletime - (CycleLen >> 1)) * TurnDuration)
            calcpath(pathprog)
            if (cycletime >= CycleLen >> 1) {
                statusa |= 0x4
            }
            troty = atan2(player -> trans)
        }
        else {
            calcpath(time(CycleLen, CycleOff) * (pathlen / CycleLen))
        }
        SpawnTrailSmoke()
        sendevent(EventHit, collider, 100.0)
    }
}

state Mech_Squash {
    stateflag 0x23
    statusc 0x12
    code(h){
        entitysetspawn(0)
        sendevent(EventCombo, player, h)
        spawn(9, 4, 1, getins(SetParticleColor), 1)
        EnemyDieClearFlags()
        playframe()
    }
}

sub SetParticleColor() {
    if (var r = rand(3); r == 0) {
        SetColor1(0x6D, 0x17, 0x00)
    }
    else if (r == 1) {
        SetColor1(0x3F, 0x7F, 0xFF)
    }
    else if (r == 2) {
        SetColor1(0x49, 0x81, 0x88)
    }
}


state Mech_Fling {
    stateflag 0x30
    statusc 0x12
    code(h) {
        EnemyFlingCombo(h)
        EnemyFlingSetDir()
        EnemyFlingSetVel(3m)
        EnemyFlingWaitScale()
    } 
    trans {
        EnemyFlingTrans(2m, EventFling)
    }
}

