#gool Taz3C 44 3

#include "goolstdlib.gooc"

#anim TAZ_INTRO_1         [Tz23V] 71 1
#anim TAZ_INTRO_2         [Tz33V] 83 1
#anim TAZ_INTRO_3         [Tz43V] 42 1
#anim TAZ_JUMP_1          [Tj13V] 33 1
#anim TAZ_JUMP_2          [Tj53V] 4  1
#anim TAZ_FALL_1          [Tf63V] 20 1
#anim TAZ_FALL_2          [Tf73V] 68 1
#anim TAZ_FALL_3          [Tf83V] 15 1
#anim TAZ_FALL_4          [Tfd3V] 4  0
#anim TAZ_RECOVER_1       [Tf93V] 7  1
#anim TAZ_RECOVER_2       [Tfc3V] 1  1
#anim TAZ_ROAR_1          [Tfa3V] 78 1
#anim TAZ_ROAR_2          [Tfb3V] 11 1
#anim TAZ_DEATH           [Tfe3V] 84 1
#anim TAZ_PLATFORM        [Pl13V] 1  1
#anim TAZ_PLATFORM_TIP    [Pl33V] 84 1

#spawn S_TAZ_TIGER        Taz_Intro
#spawn S_PLATFORM         Taz_Death_Platform

#include "C2_ShadC.gooh"

event EventHit => sub Taz_Fall

var TazVar1, TazVar2, TazVar3, TazTargetX, TazTargetY, TazTargetZ, TazCurrentPlat, TazFightPhase, TazNextPhaseHealth, TazDamageCooldown,
    TazJumpCount, TazJumpSequence, PlatTriggerCount, MaxPlatTriggerCount, TazVar15, TazFallFlapTime, TazFallBaseY

sub Taz_Jump(p_id) {
    calcpath(p_id << 8, vvec)
    TazTargetX = vecx
    TazTargetY = vecy
    TazTargetZ = vecz
    TazCurrentPlat = p_id
    TazJumpCount += 1.0
    unless(TazJumpCount % TazJumpSequence) {
        var player_plat_id = (GLOBAL_11 - 100.0) >> 8
        var triggered_plats, plat_id
        var player_x = player_plat_id / 3
        var player_z = player_plat_id % 3
        do (var triggers = 0) {
            do { plat_id = rand(9) } while (1 << plat_id & triggered_plats || abs(player_x - plat_id / 3) > 1 || abs(player_z - plat_id % 3) > 1)
            interrupter = objectget(100.0 + (plat_id << 8))
            sendevent(EventTriggered, interrupter)
            triggered_plats |= 1 << plat_id
            triggers += 1.0
        } while (triggers < PlatTriggerCount)
    }
    playframes(TAZ_JUMP_1, 1.0, 7.0)
    troty = atan2(self, TazTargetX)
    soundpitch((9.6 + rand(3.2)) * 0.205 >> 8)
    sounddecay(10.22s)
    soundplay([jmp0A], 0.2V + rand(0.1V))
    {
        var s_x = x,  s_y = y, s_z = z, t_x = TazTargetX, t_y = TazTargetY, t_z = TazTargetZ
        troty = atan2(self, t_x)
        do (var i = 1.0) {
            x = s_x + (t_x - s_x) * (i >> 8) / 18
            z = s_z + (t_z - s_z) * (i >> 8) / 18
            if (animframe == 16.0) {
                creator = objectget(100.0 + (TazCurrentPlat << 8))
                sendevent(Event15, creator, 10.0)
                if (v0 == 0) {
                    Taz_Fall(0)
                    playanim(0, TAZ_JUMP_1)
                    misc = 1
                    break
                }
            }
            playframe((i - 1.0) * 18 / 18 + 8.0)
            i += 1.0
        } while (i <= 18.0)
    }
    unless(misc) {
        SoundPitchDefault(0.43)
        sounddecay(10.22s)
        soundplay([TLatA], 0.25V)
        playframes(TAZ_JUMP_1, 26.0, 32.0)
        playanim(0, TAZ_JUMP_1)
    }
}

sub UpdateHealth() {
    var Phase = TazFightPhase
    TazNextPhaseHealth = TazFightPhase + 1
}

sub GetNextPathPoint(TazPlat, PlayerPlat) {
    var TazCurrPlatX = TazPlat / 3
    var TazCurrPlatZ = TazPlat % 3
    var player_x = PlayerPlat / 3
    var player_z = PlayerPlat % 3
    TazCurrPlatX = seek(TazCurrPlatX, player_x, 1)
    TazCurrPlatZ = seek(TazCurrPlatZ, player_z, 1)
    misc = TazCurrPlatZ + TazCurrPlatX * 3
}

sub SUB_142(a0) {
    if (var S3 = a0; S3 == 0) misc = 8;
    else if (S3 == 1) misc = 7;
    else if (S3 == 2) misc = 6;
    else if (S3 == 3) misc = 5;
    else if (S3 == 4) misc = 2;
    else if (S3 == 5) misc = 0;
    else if (S3 == 6) misc = 2;
    else if (S3 == 7) misc = 1;
    else if (S3 == 8) misc = 0;
}

state Taz_Intro { // 0
    code() {
        GLOBAL_126 = self
        GLOBAL_11 = 0
        SetColor1(0, 0, 0)
        spawn(ShadC, ShadC_S_SHADOW, 1, 0, 2S, 10)
        zindex = 24
        trotx = 180deg
        statusb = FLAG_ROT_Y | FLAG_COLLIDABLE | FLAG_SOLID_GROUND | FLAG_SOLID_SIDES
        health = 0
        spawn(BosBC, BosBC_S_HEALTH, 1, 3.0, 1)
        TazFightPhase = 0
        TazDamageCooldown = 0
        TazJumpCount = 0
        TazJumpSequence = 8.0
        MaxPlatTriggerCount = 8
        PlatTriggerCount = 1.0
        if (RESPAWNCOUNT == 0) {
            calcpath(9.0)
            playnull()
            v0 = -50.0

            do (var i = 0) {
                playnull()
                i += 1.0
            } while (i < 62.0)

            soundpitch(3.262)
            soundsetup(0, self, 9)
            sounddecay(10.22s)
            soundplay([TGStA], 1V)

            soundpitch(3.262)
            sounddelay(3.35s)
            soundsetup(0, self, 9)
            sounddecay(10.22s)
            soundplay([THutA], 1V)

            soundpitch(3.262)
            sounddelay(5.7s)
            soundsetup(0, self, 9)
            sounddecay(10.22s)
            soundplay([TGrtA], 1V)

            playframes(TAZ_INTRO_1, 0.0, 70.0)
            playframes(TAZ_INTRO_2, 0.0, 82.0)
            playframes(TAZ_INTRO_3, 0.0, 41.0)

            playanim(0, TAZ_JUMP_2)
            playanim(1, TAZ_JUMP_2)
            playanim(2, TAZ_JUMP_2)
            playanim(2, TAZ_JUMP_2)
        }
        else {
            ins72(0, 0x8000)
        }
        changestate(Taz_Init)
    }
    event(e, a) {
        accevcstate(Taz_Init, e == Event67)
    }
    trans {
        once {
            v0 = -1000.0
        }
        v0 += 1.0
    }
}

state Taz_Init { // 1
    code() {
        TazCurrentPlat = 9
        groundy = y
        calcpath(TazCurrentPlat << 8, vvec)
        x = vecx
        z = vecz
        changestate(Taz_Chase)
    }
}

inline sub TazChaseCycle() {
    while (health < TazNextPhaseHealth) {
        if (GLOBAL_11) {
            GetNextPathPoint(TazCurrentPlat, GLOBAL_11 - 100.0 >> 8)
        }
        else {
            misc = 4
        }
        if (TazCurrentPlat == misc) {
            sendeventif(EventHit, player, player -> statusa & FLAG_GROUNDLAND, 100.0)
            playframe(animframe, 0.85s)
        }
        else {
            Taz_Jump(misc)
        }
        if (health >= TazNextPhaseHealth) {
            break
        } 
    }
}

state Taz_Chase { // 2
    statusc 0x10
    trans => sub TazTransCommon
    code() {
        Taz_Jump(1)
        TazJumpSequence = 6.0
        MaxPlatTriggerCount = 8
        PlatTriggerCount = 3.0
        TazChaseCycle()
        TazFightPhase += 1
        UpdateHealth()
        TazJumpSequence = 6.0
        MaxPlatTriggerCount = 8
        PlatTriggerCount = 2.0
        TazChaseCycle()
        TazFightPhase += 1
        UpdateHealth()
        TazJumpSequence = 5.0
        MaxPlatTriggerCount = 8
        PlatTriggerCount = 1.0
        TazChaseCycle()
        Taz_Jump(9)
        troty = 0deg
        statusb &= ~FLAG_COLLIDABLE
        changestate(Taz_Death)
    }
    event(e, a) {
        rejevret(e == EventHit && (!(frametime - TazDamageCooldown >= 1s) || health >= TazNextPhaseHealth))
    }
}

sub TazTransCommon() {
    sendevent(EventHit, collider, 100.0)
    UpdateHealth()
}

sub TazRidePlatform() {
    x = creator -> x
    y = creator -> y
    z = creator -> z
    moda = creator -> moda
}

sub Taz_Fall(a) {
    {
        var v1, plat_id, safe_plats, safe_plat_count, attempts
        do {
            do {
                if (safe_plat_count || attempts > 50.0) {
                    plat_id = rand(9)
                }
                else {
                    plat_id = rand(3)
                }
                attempts += 1.0
                creator = objectget(100.0 + (plat_id << 8))
            } while (plat_id == TazCurrentPlat || !(creator -> stateflag & 0x8) || 1 << plat_id & safe_plats)
            safe_plat_count += 1
            safe_plats |= 1 << plat_id
        } while (safe_plat_count < 3 - health)

        do (var i = 0) {
            unless(1 << (i >> 8) & safe_plats) {
                interrupter = objectget(100.0 + (i >> 8 << 8))
                sendevent(EventTriggered, interrupter)
            }
            i += 1.0
        } while (i < 9.0)
        interrupter = objectget(100.0 + (TazCurrentPlat << 8))
        sendevent(Event14, interrupter, 0)
    }
    health += 1
    creator = interrupter
    sendevent(Event9, creator, 0)
    statusb |= FLAG_ROT_Y
    SoundPitchDefault()
    sounddecay(10.22s)
    soundplay([TFYtA], 1V)
    trotx = abs(degdist(roty, GAMEDIR)) * 3
    if (var fall_type = rand(2); fall_type == 0) {
        playanim(0, TAZ_FALL_1)
        {
            var s_x = x, s_y = y, s_z = z, t_x = TazTargetX, t_y = TazTargetY, t_z = TazTargetZ
            setanim(TAZ_FALL_1)
            do (var i = 1.0) {
                x = s_x + (t_x - s_x) * (i >> 8) / 18
                z = s_z + (t_z - s_z) * (i >> 8) / 18
                if (animframe == 9.0) {
                    misc = ((roty + (180deg + -CAMROTY)) + 22.5deg) & ~0x1FF & 0xFFF
                    if (misc > 90deg && misc <= 180deg) {
                        misc = 180deg - misc
                    }
                    else if (misc > 180deg && misc < 270deg) {
                        misc = 540deg - misc
                    }
                    if (misc <= 180deg) {
                        misc >>= 1
                    }
                    else {
                        misc = 360deg - ((360deg - misc) >> 1)
                    }
                    troty = misc
                }
                playframe((i - 1.0) * 18 / 18 + 1.0)
                i += 1.0
            } while (i <= 18.0)
        }
        playframes(TAZ_FALL_2, 0.0, 67.0)
    }
    else if (fall_type == 1) {
        playanim(0, TAZ_FALL_3)
        {
            var s_x = x, s_y = y, s_z = z, t_x = TazTargetX, t_y = TazTargetY, t_z = TazTargetZ
            setanim(TAZ_FALL_3)
            do (var i = 1.0) {
                x = s_x + (t_x - s_x) * (i >> 8) / 14
                z = s_z + (t_z - s_z) * (i >> 8) / 14
                if (animframe == 9.0) {
                    misc = ((roty + (180deg + -CAMROTY)) + 22.5deg) & ~0x1FF & 0xFFF
                    if (misc > 90deg && misc <= 180deg) {
                        misc = 180deg - misc
                    }
                    else if (misc > 180deg && misc < 270deg) {
                        misc = 540deg - misc
                    }
                    if (misc <= 180deg) {
                        misc >>= 1
                    }
                    else {
                        misc = 360deg - ((360deg - misc) >> 1)
                    }
                    troty = misc
                }
                playframe((i - 1.0) * 14 / 14 + 1.0)
                i += 1.0
            } while (i <= 14.0)
        }
        save(statusb, y, rotx) {
            velx = 0
            vely = -0xA45C
            velz = 0
            rotz = rand(360deg)
            TazFallFlapTime = 0
            TazFallBaseY = y
            statusb &= ~(FLAG_ROT_Y | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND | 0x2000)
            do (var i = 0) {
                if (y < creator -> y) {
                    break
                }
                vely = spd(vely, -10m)
                TazFallBaseY = spd(TazFallBaseY, vely)
                y = TazFallBaseY - sin(loopseek(TazFallFlapTime, 2m, 0.2m), 1.8m)
                roty += 2deg
                rotx += 1deg
                if (animseq != getanim(TAZ_FALL_4)) {
                    setanim(TAZ_FALL_4, -1.0)
                }
                playframe((animframe + 1.0) & 0x3FF)
                i += 1.0
            } while (i < 72.0)
        }
    }
    TazDamageCooldown = frametime
    changestateif(Taz_Death, health >= 3)
    troty = atan2(player -> trans)
    roty = troty
    save(statusb) {
        velx = 0
        velz = 0
        statusb &= ~(FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_SOLID_GROUND)
        do {
            TazRidePlatform()
            if (y < groundy - 3.75m) {
                playanim(0, TAZ_RECOVER_2)
            }
            else {
                if (animseq != getanim(TAZ_RECOVER_1)) {
                    setanim(TAZ_RECOVER_1, -1.0)
                }
                playframe((animframe + 1.0) % 7.0)
            }
        } until(creator -> stateflag & 0x80)
        
        soundpitch(3.262)
        sounddelay(1.05s)
        sounddecay(10.22s)
        soundplay([TGrtA], 1V)

        playframes(TAZ_ROAR_1, 0.0, 77.0)
        playframes(TAZ_ROAR_2, 0.0, 10.0)
    }
    statusb |= FLAG_ROT_Y
    trotx = 180deg
    settrans(TazTransCommon)
}


state Taz_Death { // 3
    stateflag 0x21
    code() {
        entitysetspawn(0)
        GLOBAL_126 = 0
        creator -> statusb |= FLAG_INVISIBLE
        spawn(Taz3C, S_PLATFORM, 1)
        velx = 0
        velz = 0
        statusb &= ~(FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_SOLID_GROUND)
        do {
            TazRidePlatform()
            playanim(0, TAZ_DEATH)
        } until(creator -> stateflag & 0x80)
        sendevent(EventWarp, player, 0)
        playframes(TAZ_DEATH, 0.0, 62.0)
        velx = 0
        vely = -0xA45C
        velz = 0
        statusb = FLAG_PHYSICS_ENGINE | FLAG_GRAVITY
        playframes(TAZ_DEATH, 63.0, 83.0)
        playframe(animframe, 1.7s)
    }
}

state Taz_Death_Platform { // 4
    code() {
        setanim(TAZ_PLATFORM_TIP)
        sleep()
    }
    trans {
        rotx = creator -> rotx
        roty = creator -> roty
        rotz = creator -> rotz
        x = creator -> x
        y = creator -> y
        z = creator -> z
        scalex = creator -> scalex
        scaley = creator -> scaley
        scalez = creator -> scalez
        animframe = creator -> animframe
    }
}
