#gool ABanC 33 3

#include "goolstdlib.gooc"

#anim ASS_BANGER      [AB10V] 59 1
#anim BULLET          [Bu1lV] 1 1
     
#spawn S_ASS_BANGER   Ass_Banger
#spawn S_BULLET       Bullet

event EventJumpedOn      => state Ass_Banger_Squash
event EventHit           => state Ass_Banger_Fling
event EventSpinHit       => state Ass_Banger_Fling
event EventHitInvincible => state Ass_Banger_Squash
event EventFling         => state Ass_Banger_Fling
event EventSlideHit      => state Ass_Banger_Fling
event EventSlamHit       => state Ass_Banger_Squash

state Ass_Banger { // 0
    statusc 0
    code(rot) {
        statusb = FLAG_ROT_INWARDS | FLAG_COLLIDABLE | FLAG_SOLID_ALL
        calcpath(0)
        roty = troty
        zindex = fieldval(ENTITY_FIELD_ZINDEX)
        if (zindex == 0) zindex = 24;
        if (pathlen > 12.0) {
            do (var startpoint = 12.0) {
                spawn(ABanC, S_BULLET, 1, startpoint)
                startpoint += 12.0
            } while (startpoint < pathlen)
        }
        setanim(ASS_BANGER)
        do {
            playframes(ASS_BANGER, 0.0, 7.0)
            spawn(ABanC, S_BULLET, 1, 1.5)
            playframes(ASS_BANGER, 8.0, 58.0)
            playframe(animframe, 0.85s)
        } while (1)
    }
    trans {
        sendevent(EventHit, collider, 100.0)
    }
}

sub SetExplosionColor() {
    if (var r = rand(3); r == 0) {
        SetColor1(0xC4, 0xC4, 0x00)
    }
    else if (r == 1) {
        SetColor1(0xC4, 0x78, 0x00)
    }
    else if (r == 2) {
        SetColor1(0x78, 0xC4, 0x00)
    }
}

state Bullet { // 1
    statusc 0x12
    code(startpoint) {
        CopyCreatorPath()
        SetRot(0)
        v0 = false
        statusb = FLAG_COLLIDABLE
        pathprog = startpoint
        do {
            pathprog = spd(pathprog, 4.0)
            calcpath(pathprog)
            y += 1.1m
            unless(v0) {
                SoundPitchDefault(0.23)
                sounddecay(7.7s)
                soundplay([tnt0A], 1V)
                do (var smokes = 0) {
                    spawn(9, 21, 1, -1.0, -(3m + rand(1m)), 2m, 0m, 2S, 0, 24, 1)
                    smokes += 1.0
                } while (smokes < 4.0)
                v0 = true
            }
            playanim(0, BULLET)
        } until (STATUS_PATH_END)
        statusb = 0
        spawn(9, 40, 1, getins(SetExplosionColor), 0)
        playnull()
    }
    trans {
        sendevent(Event24, collider, 100.0)
        if (eventaccepted) {
            statusb = FLAG_INVISIBLE
            statusa |= FLAG_PATH_END
        }
        roty = GAMEDIR - 90deg
        unless(STATUS_FIRSTFRAME) {
            if (time(2) && FRAMETIME < 36) {
                y += 0.1m
                spawn(9, 21, 1, -1.0, 3m + rand(1m), 0m, 0m, 0.5S, 0, 0, 19)
            }
        }
    }
}

state Ass_Banger_Fling { // 2
    stateflag 0x30
    statusc 0x12
    code(h) {
        EnemyFlingCombo(h)
        EnemyFlingSetDir()
        EnemyFlingSetVel(3m)
        EnemyFlingWaitScale()
    }
    trans {
        EnemyFlingTrans(2.5m, EventFling)
    }
}

state Ass_Banger_Squash { // 3
    stateflag 0x23
    statusc 0x12
    code(h) {
        entitysetspawn(0)
        sendevent(EventCombo, player, h)
        spawn(9, 4, 1, getins(SetParticleColor), 1)
        EnemyDieClearFlags()
        playframe()
    }
}

sub SetParticleColor() {
    if (var r = rand(3); r == 0) {
        SetColor1(0x9A, 0x7A, 0x40)
    }
    else if (r == 1) {
        SetColor1(0xC9, 0x6B, 0x5F)
    }
    else if (r == 2) {
        SetColor1(0x79, 0x80, 0x60)
    }
}
