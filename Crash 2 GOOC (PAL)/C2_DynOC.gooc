#gool DynOC 55 5

#include "goolstdlib.gooc"

#anim PISTON_UP              [Pu1gV] 13 1
#anim PISTON                 [Pi1gV] 21 1
#anim PISTON_MINI            [Pi2gV] 21 1
#anim PAD_RELEASED           [Pa1gV] 6 1
#anim PAD_PRESSED            [Pa2gV] 6 1
#anim SHRINKRAY              [Gu1gV] 11 1
#anim SHRINKRAY_SHOOT        [Gu2gV] 10 1
#anim SHRINKRAY_DOWN         [Gd1gV] 11 1
#anim SHRINKRAY_SHOOT_DOWN   [Gd2gV] 10 1
#anim PROJECTILE             [Gb1gV] 16 1
#anim PROJECTILE_EXPLODE     [Ge1gV] 1 1
#anim ROBOT_WALKER           [Rw1gV] 50 1

#sprite PROJECTILE_PARTICLE[Dy1gT]
#tex 0x505050 0 3 14 5 256 32 64 32
#tex 0x505050 0 3 14 5 320 32 64 32
#tex 0x505050 0 3 14 5 384 96 64 32
#tex 0x505050 0 3 14 5 384 64 64 32
#tex 0x505050 0 3 14 5 384 32 64 32
#tex 0x505050 0 3 14 5 448 96 64 32
#tex 0x505050 0 3 14 5 448 64 64 32
#tex 0x505050 0 3 14 5 448 32 64 32
#tex 0x505050 0 3 14 5 512 96 64 32

#anim BONUS_PLAQUE[Bp1gV] 1 1

#sprite BACKGROUND_COLOR[Cr10T]
#tex 0xFF20FF 0 2 7 10 136 12 4 4

#spawn S_PISTON_UP                Piston_Up
#spawn S_PISTON_DOWN              Piston_Down
#spawn S_PAD                      Pad_Init
#spawn S_SHRINKRAY                ShrinkRay_Init
#spawn S_SHRINKRAY_DOWN           ShrinkRay_Init
#spawn S_ROBOT_WALKER             Robot_Walker
#spawn S_PROJECTILE               Projectile
#spawn S_PROJECTILE_PARTICLES     Projectile_Particle
#spawn S_DYNAMO_BACKGROUND        Dynamo_Background
#spawn S_SHRINKER                 Shrinker
#spawn S_PROJECTILE_EXPLOSION     Projectile_Explosion
#spawn S_BONUS_PLAQUE             Bonus_Plaque

var PistonStatus, ShrinkRayID, ShrinkRayShotCount, PlaqueBaseY

state Piston_Up { // 0
    stateflag 0x80000A01
    code(cyclelen, cycleoff, uplen) {
        cyclelen = cyclelen * 1s / 1.2s
        cycleoff = cycleoff * 1s / 1.2s
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | 0x400000
        var piston_frame, downlen, piston_phase, carry_time, carrying_player, carry_y
        downlen = cyclelen - uplen
        if (downlen < 0) {
            downlen = 0
        }
        setanim(PISTON_UP)
        do {
            piston_frame = time(cyclelen, cycleoff)
            if (piston_frame < uplen) {
                v0 = uplen - 13
                if (piston_frame >= v0) {
                    if (piston_frame == v0) {
                        soundpitch(1.740)
                        soundplay([DSmgA], 0.2V)
                    }
                    piston_phase = 3
                    piston_frame = 12 - (piston_frame - v0)
                }
                else {
                    piston_phase = 0
                    piston_frame = 12
                }
            }
            else {
                piston_frame -= uplen
                v0 = downlen - 13
                if (piston_frame >= v0) {
                    if (piston_frame == v0) {
                        soundpitch(2.903)
                        soundplay([DSmgA], 0.5V)
                    }
                    piston_phase = 1
                    piston_frame -= v0
                }
                else {
                    piston_phase = 2
                    piston_frame = 0
                }
            }
            carrying_player = 0
            if (piston_phase == 1 || piston_phase == 0) {
                if (distance(player, DIST_EXACT | DIST_NO_Y) <= 1.3m) {
                    getvert(vvec, self, 0)
                    carry_y = vecy
                    if (player -> y < carry_y + 0.1m && player -> y > carry_y - 2.5m) {
                        player -> y = carry_y
                        if (player -> vely < 0) {
                            player -> vely = 0
                        }
                        player -> statusa |= FLAG_GROUNDLAND
                        player -> groundtime = player -> frametime
                        if (player -> vely < 0) {
                            player -> groundvel = player -> vely
                        }
                        carrying_player = 1
                        if (piston_phase == 1) {
                            carry_time += 1
                        }
                    }
                }
            }
            playframe(piston_frame << 8)
        } while (1)
    }
}

state Piston_Down { // 1
    code(cyclelen, cycleoff, downlen, size) {
        zindex = 24
        cyclelen = cyclelen * 1s / 1.2s
        cycleoff = cycleoff * 1s / 1.2s
        downlen = downlen * 1s / 1.2s
        PistonStatus = 0
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_SOLID_BOTTOM
        var piston_frame, uplen, piston_phase, can_crush = 1, full_extend
        uplen = cyclelen - downlen
        if (uplen < 0) {
            uplen = 0
        }
        if (size == 0) {
            setanim(PISTON_MINI)
        }
        else {
            setanim(PISTON)
        }
        do {
            full_extend = 0
            piston_frame = time(cyclelen, cycleoff)
            if (piston_frame < downlen) {
                v0 = downlen - 8
                if (piston_frame >= v0) {
                    if (piston_frame == v0) {
                        soundpitch(2.903)
                        soundplay([DSmgA], 0.5V)
                    }
                    piston_phase = 3
                    piston_frame = (piston_frame - v0) + 1
                }
                else {
                    piston_phase = 0
                    piston_frame = 0
                }
            }
            else {
                piston_frame -= downlen
                if (piston_frame == 0) {
                    full_extend = 1
                }
                v0 = uplen - 12
                if (piston_frame >= v0) {
                    if (piston_frame == v0) {
                        soundpitch(1.740)
                        soundplay([DSmgA], 0.2V)
                    }
                    piston_phase = 1
                    piston_frame = (piston_frame - v0) + 9
                }
                else {
                    piston_phase = 2
                    piston_frame = 8
                }
            }
            if (piston_phase == 0) {
                can_crush = 1
            }
            if (!(player -> stateflag & 0x20) && !player -> invincible) {
                if (piston_phase == 0) {
                    PistonStatus = 0
                }
            }
            else {
                if (PistonStatus == 0) {
                    PistonStatus = 1
                }
                if (piston_phase == 0) {
                    PistonStatus = 2
                }
            }
            if (piston_phase == 3 || full_extend) {
                if (PistonStatus == 0
                    && collider
                    && can_crush
                    && y > player -> y
                    && y - player -> y < 14m
                    && distance(player, DIST_EXACT | DIST_NO_Y) <= 1.3m) {
                    sendevent(EventCrush, collider, 100.0)
                    can_crush = 0
                }
            }
            if (PistonStatus == 2) {
                playframe(0)
            }
            else {
                playframe(piston_frame << 8)
                if (full_extend) {
                    unless(SHAKEY) {
                        SHAKEY = 0 > 3.2m / 256 - abs(x - player -> x) / (1m / 256) ? 0 : 3.2m / 256 - abs(x - player -> x) / (1m / 256)
                    }
                }
            }
        } while (1)
    }
}

state Pad_Init { // 2
    stateflag 0x80000A01
    code(obj, yaw) {
        zindex = fieldval(ENTITY_FIELD_ZINDEX)
        ShrinkRayID = obj
        roty = yaw
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_TOP | 0x400000
        changestate(Pad)
    }
}

sub CheckPlayerStep() {
    misc = (abs(player -> x - x) <= 1m && abs(player -> z - z) <= 1m) && (player -> y > y - 2m &&  player -> y < y + 0.2m)
}

state Pad { // 3
    stateflag 0x80000A01
    code() {
        sleepanim(0, PAD_RELEASED)
    }
    trans {
        CheckPlayerStep()
        changestateif(Pad_Pressed, misc)
    }
}

state Pad_Pressed { // 4
    stateflag 0x80000A01
    code() {
        if (ShrinkRayID) {
            interrupter = objectget(ShrinkRayID)
            sendeventif(EventTriggered, interrupter, interrupter)
        }
        soundpitch(3.625)
        soundplay([swb0A], 1V)
        playframes(PAD_PRESSED, 1.0, 5.0)
        playanim(5, PAD_PRESSED, 0.15s)
        changestate(Pad_Hold_Pressed)
    }
}

state Pad_Hold_Pressed { // 5
    stateflag 0x80000A01
    code() {
        sleepanim(5, PAD_RELEASED)
    }
    trans {
        CheckPlayerStep()
        changestateifn(Pad_Released, misc)
    }
}

state Pad_Released { // 6
    stateflag 0x80000A01
    code() {
        playframesback(PAD_RELEASED, 4.0, 0.0)
        changestate(Pad)
    }
}

state ShrinkRay_Init { // 7
    statusc 0x200012
    code(yaw) {
        ShrinkRayShotCount = 0
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        roty = yaw
        rotz = roty
        changestate(ShrinkRay)
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            ShrinkRayShotCount += 1
        }
        if (interrupter == player) {
            rejevret(e == EventJumpedOn || e == EventSlamHit || e == EventSlideHit || e == EventSpinHit)
        }
    }
}

state ShrinkRay { // 8
    statusc 0x200012
    event => state ShrinkRay_Init
    code() {
        if (spawn == S_SHRINKRAY) {
            setanim(SHRINKRAY)
        }
        else if (spawn == S_SHRINKRAY_DOWN) {
            setanim(SHRINKRAY_DOWN)
        }
        sleepframes(0.0, 10.0)
    }
    trans {
        changestateif(ShrinkRay_Shoot, ShrinkRayShotCount)
    }
}

state ShrinkRay_Shoot { // 9
    statusc 0x200012
    event => state ShrinkRay_Init
    code(){
        soundpitch(1.999)
        soundplay([SRMgA], 1V)
        if (spawn == S_SHRINKRAY) {
            setanim(SHRINKRAY_SHOOT)
        }
        else if (spawn == S_SHRINKRAY_DOWN) {
            setanim(SHRINKRAY_SHOOT_DOWN)
        }
        v0 = 0
        if (spawn == S_SHRINKRAY) {
            v0 = roty >= 0deg ? 1 : -1
        }
        spawn(DynOC, S_PROJECTILE, 1, 1.25, pathlen - 1.3, v0)
        ShrinkRayShotCount -= 1
        playframes(0.0, 9.0)
        changestate(ShrinkRay)
    }
}

state Projectile { // 10
    statusc 0x12
    __transargs
    code(startpoint, pathend, pitch) {
        spawn(DynOC, S_PROJECTILE_PARTICLES, 1, 0, 360deg)
        spawn(DynOC, S_PROJECTILE_PARTICLES, 1, 0, -360deg)
        soundpitch(6.892)
        soundplay([SRSgA], 1V)
        sleepframes(PROJECTILE, 0.0, 15.0)
    }
    trans {
        once {
            CopyCreatorPath()
            statusb = FLAG_COLLIDABLE
            density = 0.10m
            pathprog = startpoint
            SetRot(0deg)
        }
        calcpath(pathprog, 0)
        if (pathprog == pathend) {
            cascadeevent(Event14, self)
            spawn(DynOC, S_PROJECTILE_EXPLOSION, 1, pitch)
            changestate(Projectile_Cooldown)
        }
        pathprog = spd(pathprog, 9.0)
        if (pathprog > pathend) {
            pathprog = pathend
        }
        if (collider && !(player -> stateflag & 0x20)) {
            cascadeevent(Event14, self)
            spawn(DynOC, S_SHRINKER, 1, player)
            spawn(DynOC, S_PROJECTILE_EXPLOSION, 1, pitch)
            changestate(Projectile_Cooldown)
        }
    }
}

state Projectile_Cooldown { // 11
    statusc 0x12
    code() {
        WaitChildNull()
    }
}

state Projectile_Explosion { // 12
    statusc 0x12
    __transargs
    code(pitch) {
        rotx = -rotx
        spawn(9, 46, 1, 0, 0.5, 0xFF, 0, 0)
        rotx = -rotx
        unless(rand(2)) {
            sounddecay(3.85s)
            soundpitch((12.8 + rand(6.4)) * 0.43 >> 8)
            soundplay([sp23A], 0.6V + rand(0.1V))
        }
        else {
            sounddecay(3.85s)
            soundpitch((12.8 + rand(6.4)) * 0.43 >> 8)
            soundplay([sp13A], 0.6V + rand(0.1V))
        }
        playanim(0, PROJECTILE_EXPLODE, 0.18s)
        while (child) {
            playnull()
        }
    }
    trans {
        once {
            roty = 90deg
            rotz = 90deg
            if (pitch == 1) {
                rotx = 90deg
            }
            else if (pitch == -1) {
                rotx = -90deg
            }
            else {
                rotx = 0
            }
            vecx = 4.16
            scalex = 0.25S - vecx
            scaley = 1.0S
            scalez = 0.25S - vecx
            vecy = 2.88
            vecz = 16.0 + vecy
        }
        scalex += vecx
        scalez += vecx
        vecz -= vecy
        moda = 16.0 - vecz
    }
}

state Projectile_Particle { // 13
    stateflag 0x80001
    statusc 0x12
    __transargs
    code(vert, rot) {
        SetScale(1.5S, 0.75S, 0.75S)
        zindex = 24
        SetRot(0deg, 0deg, rand(360deg))
        vecz = rot / 25
        v0 = 0
        do {
            unless(rand(5)) {
                statusb = FLAG_INVISIBLE
                playanim(0, PROJECTILE_PARTICLE, 0.1s)
                unless(rand(2)) {
                    sounddecay(3.85s)
                    soundpitch((12.8 + rand(6.4)) * 0.43 >> 8)
                    soundplay([sp23A], 0.5V + rand(0.1V))
                }
                else {
                    sounddecay(3.85s)
                    soundpitch((12.8 + rand(6.4)) * 0.43 >> 8)
                    soundplay([sp13A], 0.5V + rand(0.1V))
                }
            }
            statusb = 0
            playframes(PROJECTILE_PARTICLE, 0.0, 8.0)
        } while (1)
    }
    event(e, a) {
        accevcstate(Kill, e == Event14)
    }
    trans {
        getvert(vtrans, creator, vert)
        unless(STATUS_FIRSTFRAME) {
            rotz = (rotz + vecz) % 360deg
            v0 += vecz
            if (v0 >= 360deg || v0 <= -360deg) {
                v0 = 0deg
                rotz = rand(360deg)
            }
        }
    }
}

inline sub RobotFootstep(anim_time) {
    unless(anim_time % 0.5s) {
        soundpitch((9.6 + rand(3.2)) * 0.23 >> 8)
        sounddecay(3.2s)
        soundplay([fs40A], 0.3V)
    }
}

state Robot_Walker { // 14
    code(cyclelen, cycleoff) {
        cyclelen = cyclelen * 1s / 1.2s
        cycleoff = cycleoff * 1s / 1.2s
        trotx = 720deg
        zindex = 40
        statusb = FLAG_ROT_Y | FLAG_TRACK_PATH_ROT | FLAG_TRACK_PATH_SIGN | FLAG_ROT_INWARDS | FLAG_COLLIDABLE | FLAG_SOLID_ALL
        density = 0.1m
        setanim(ROBOT_WALKER)
        var anim_time, half_cycle, full_cycle, returning
        half_cycle = cyclelen >> 1
        full_cycle = pathlen << 1
        do {
            v0 = time(cyclelen, cycleoff)
            anim_time = v0
            pathprog = ((v0 * full_cycle) / cyclelen)
            returning = 0
            if (anim_time >= half_cycle) {
                anim_time -= half_cycle
                pathprog = -(pathlen - 1) + (pathprog - pathlen)
                returning = 1
            }
            if (pathprog >= pathlen) {
                pathprog = pathlen - 1
            }
            calcpath(abs(pathprog))
            RobotFootstep(anim_time)
            playframe(anim_time << 8)
        } while (1)
    }
    event(e, a) {
        if (interrupter == player) {
            if (e == EventSpinHit || e == EventJumpedOn || e == EventSlamHit) {
                rejev()
                sendevent(Event24, interrupter, 100.0)
            }
        }
        accevcstate(RobotWalker_Fling, e == EventSlideHit || e == EventHitInvincible || e == EventFling)
    }
    trans {
        sendevent(EventHit, collider, 100.0)
    }
}

state RobotWalker_Fling { // 15
    stateflag 0x30
    statusc 0x32
    code(h) {
        EnemyFlingCombo(h)
        EnemyFlingSetDir()
        troty %= 360deg
        if (troty > 65deg && troty <= 90deg) {
            troty = 65deg
        }
        else if (troty > 90deg && troty <= 115deg) {
            troty = 115deg
        }
        else if (troty > 245deg && troty <= 270deg) {
            troty = 245deg
        }
        else if (troty > 270deg && troty <= 295deg) {
            troty = 295deg
        }
        EnemyFlingSetVel(3m)
        EnemyFlingWaitScale()
    } 
    trans {
        EnemyFlingTrans(2m, EventFling)
    }
}

state Dynamo_Background { // 16
    stateflag 0x40001
    statusc 0
    code() {
        vfx = (vfx & 0xFFFFFF00) | 0x6
        SetTrans(0, 0, 0)
        zindex = 2000
        SetScale(0x146E, 0x103A, 0x1000)
        sleepanim(0, BACKGROUND_COLOR)
    }
}

state Shrinker { // 17
    stateflag 0x40001
    statusc 0
    __transargs
    code(target) {
        interrupter = player -> creator
        player -> interrupter = self
        unless(GLOBAL_126 || player -> statusc \ 0x2 || player -> invincible) {
            sendevent(EventHit, interrupter, 100.0)
            if (eventaccepted) {
                if (!player -> invincible) {
                    player -> invincible = 4
                    player -> invincibletime = frametime
                }
            }
            else {
                GLOBAL_126 = self
                movetolist(3.0)
                do {
                    player -> scalex = seek(player -> scalex, 0S, spd(24.0))
                    player -> scaley = seek(player -> scaley, 0S, spd(24.0))
                    player -> scalez = seek(player -> scalez, 0S, spd(24.0))
                    playnull()
                } while (player -> scaley <= 0.5S)
                vecy = 0
                do {
                    vecy = spd(vecy, 3.2)
                    player -> scalex = seek(player -> scalex, 0S, spd(vecy))
                    player -> scaley = seek(player -> scaley, 0S, spd(vecy))
                    player -> scalez = seek(player -> scalez, 0S, spd(vecy))
                    playnull()
                } until(player -> scaley <= 0.05S)
                sendevent(Event12, player, 100.0)
            }
        }
    }
    trans {
        once {
            player = target
        }
        changestateif(Kill, player -> stateflag \ 0x20)
    }
}

state Bonus_Plaque { // 18
    statusc 0
    code() {
        statusb = 0
        zindex = 14
        sleepanim(0, BONUS_PLAQUE)
    }
    trans {
        once {
            PlaqueBaseY = y
        }
        y = PlaqueBaseY + (sin((frametime << 6) & 0xFFF) * 0.1m >> 12)
    }
}

state Kill { // 19
    statusc 0
    code(){ }
}

state Sleep { // 20
    statusc 0
    code() {
        statusb = 0
        playnull()
    }
}

