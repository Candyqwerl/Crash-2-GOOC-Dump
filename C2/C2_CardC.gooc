sub TextTrans() {
    SelectedItem = creator -> SelectedItem
    BlinkItem = creator -> BlinkItem
    HighlightSlot = creator -> HighlightSlot
    if (HighlightSlot) {
        SelectedSlot = creator -> SelectedSlot
        if (DisplayItem - ITEM_SLOT1 == SelectedSlot >> 8) {
            SelectedItem = DisplayItem
        }
    }
    if (BlinkItem == DisplayItem && ((frametime - statetime) % 12 > 6)) {
        statusb |= FLAG_INVISIBLE
    }
    else {
        statusb &= ~FLAG_INVISIBLE
    }
    if (TextMode == 2) {
        if (SelectedItem == DisplayItem) {
            if (frametime & 3) {
                SetTextColor(0x1FF, 0x190, 0x000, 0x1FF, 0x000, 0x000)
            }
            else {
                SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
            }
        }
        else {
            SetTextColor(0xA0, 0x8B, 0x60, 0xA0, 0x60, 0x6)
        }
    }
    else if (TextMode == 1) {
        if (SelectedItem == DisplayItem) {
            if (frametime & 3) {
                SetTextColor(0x1FF, 0x190, 0x000, 0x1FF, 0x000, 0x000)
            }
            else {
                SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
            }
        }
        else if ((frametime & 31) == 15) {
            SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
        }
        else {
            SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
        }
    }
}

