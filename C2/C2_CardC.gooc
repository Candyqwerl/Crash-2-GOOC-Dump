state Card_Check { // 1
    code() {
        cascadeevent(Event1, self)
        miscfunc(0, player, 10, 15)
        playnull()
        playnull()
        playnull()
        playnull()
        ErrorType = 0
        if (GLOBAL_59 & 2) {
            ErrorType = 1
            changestate(Card_Error)
        }
        changestateif(Card_Missing, GLOBAL_59 & 4)
        changestateif(Card_CheckFormat, GLOBAL_59 & 8)
        changestateif(Card_ReadDirectory, GLOBAL_59 & 1)
        OpenCardMenu()
    }
}

state Card_Error { // 2
    code() {
        SelectedItem = ITEM_EXIT
        SetCardTitle(31.0, 32.0, 33.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_CARD_TITLE, 0, 85.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        if (ErrorType == 2) {
            SetTextLanguage2(
                34.0, 35.0,
                36.0, 37.0,
                38.0, 39.0,
                40.0, 41.0,
                42.0, 43.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 14.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
        }
        else if (ErrorType == 3) {
            SetTextLanguage2(
                34.0, 44.0,
                45.0, 46.0,
                38.0, 47.0,
                48.0, 49.0,
                42.0, 50.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 14.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
        }
        else if (ErrorType == 4) {
            SetTextLanguage3(
                51.0, 52.0, 53.0,
                54.0, 55.0, 56.0,
                57.0, 58.0, 59.0,
                60.0, 61.0, 62.0,
                63.0, 64.0, 65.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 24.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -14.0, TextFrame3, 0, 0xA3, 0x103, 0, 0)
        }
        else if (ErrorType == 5) {
            SetTextLanguage2(
                34.0, 66.0,
                67.0, 46.0,
                38.0, 68.0,
                48.0, 69.0,
                42.0, 70.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 14.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
        }
        else {
            SetTextLanguage1(71.0, 72.0, 73.0, 74.0, 75.0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 5.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        }
        SetTextLanguage1(76.0, 77.0, 78.0, 79.0, 80.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_EXIT, 0, -57.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)
        playnull(21)
        do {
            playnull()
            if (buttonpress(PAD_START | PAD_X)) {
                SoundButtonConfirm()
                soundsetup(0, voice, 5)
                break
            }
        } while (1)
        cascadeevent(Event1, self)
        changestate(Card_Exit)
    }
    event(e, a) {
        if (e == Event1 && interrupter != self) {
            accev()
            cascadeevent(Event1, self)
            changestate(Card_Exit)
        }
    }
    trans {
        nofirst {
            if (GLOBAL_59 & 4) {
                cascadeevent(Event1, self)
                changestate(Card_Check)
            }
        }
    }
}

state Card_Corrupt { // 3
    code() {
        SetCardTitle(31.0, 32.0, 33.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_CARD_TITLE, 0, 85.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        SetTextLanguage2(
            81.0, 82.0,
            83.0, 84.0,
            85.0, 0.00,
            86.0, 87.0,
            88.0, 0.00
        )

        if (TextFrame2) {
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 14.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
        }
        else {
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 5.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        }

        SetTextLanguage1(89.0, 90.0, 91.0, 92.0, 93.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_ERASE, 0, -57.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)

        SetTextLanguage1(76.0, 77.0, 78.0, 79.0, 80.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_EXIT, 0, -73.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)

        SelectedItem = ITEM_EXIT
        playnull(5)
        do {
            if (buttonpress(PAD_START | PAD_X)) {
                SoundButtonConfirm()
                soundsetup(0, voice, 5)
                cascadeevent(Event1, self)
                if (SelectedItem == ITEM_ERASE) {
                    SelectedItem = ITEM_SAVE
                    changestate(Card_Main)
                }
                changestate(Card_Exit)
            }
            if (dirpress(PAD_N) || dirpress(PAD_S)) {
                SoundButtonNavigate()
                if (SelectedItem == ITEM_ERASE) {
                    SelectedItem = ITEM_EXIT
                }
                else if (SelectedItem == ITEM_EXIT) {
                    SelectedItem = ITEM_ERASE
                }
            }
            playnull()
        } while (1)
    }
    event(e, a) {
        if (e == Event1 && interrupter != self) {
            accev()
            cascadeevent(Event1, self)
            changestate(Card_Exit)
        }
    }
    trans {
        nofirst {
            CheckCardStatus(1)
        }
    }
}

state Card_Missing { // 4
    code() {
        var prompted
        var started = frametime
        var line1, line2
        SelectedItem = ITEM_EXIT
        SetCardTitle(31.0, 32.0, 33.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_CARD_TITLE, 0, 85.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)

        SetTextLanguage2(
            94.00, 95.00,
            96.00, 97.00,
            98.00, 99.00,
            100.0, 101.0,
            102.0, 103.0
        )
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 14.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        line1 = objectspawned
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
        line2 = objectspawned
        playnull(5)

        SetTextLanguage1(76.0, 77.0, 78.0, 79.0, 80.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_EXIT, 0, -57.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)
        playnull(16)
        do {
            playnull()
            if (buttonpress(PAD_START | PAD_X)) {
                SoundButtonConfirm()
                soundsetup(0, voice, 5)
                cascadeevent(Event1, self)
                changestate(Card_Exit)
            }
            if (!prompted) {
                if (frametime - started > 0x5F) {
                    prompted = 1
                    interrupter = line1
                    sendevent(Event1, interrupter, self)
                    interrupter = line2
                    sendevent(Event1, interrupter, self)

                    SetTextLanguage2(
                        104.0, 105.0,
                        106.0, 107.0,
                        108.0, 109.0,
                        110.0, 111.0,
                        112.0, 113.0
                    )
                    spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, 14.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
                    spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, 0, -5.0, TextFrame2, 0, 0xA3, 0x103, 0, 0)
                }
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event1 && interrupter != self) {
            accev()
            cascadeevent(Event1, self)
            changestate(Card_Exit)
        }
    }
    trans {
        nofirst {
            if (GLOBAL_59 & 2) {
                ErrorType = 1
                cascadeevent(Event1, self)
                changestate(Card_Error)
            }
            unless (GLOBAL_59 & 4) {
                cascadeevent(Event1, self)
                changestateif(Card_CheckFormat, GLOBAL_59 & 8)
                changestateif(Card_ReadDirectory, GLOBAL_59 & 1)
                OpenCardMenu()
            }
        }
    }
}

