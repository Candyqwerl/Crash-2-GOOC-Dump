                    }
                    else {
                        var0 = GLOBAL_94[(slot * 0xA9) + 0x200]
                    }
                    spawn2(CardC, S_CARD_ICON, 1, ITEM_STATIC, (px - 104) << 8, (py - 32) << 8, slot, var0)
                    if (GLOBAL_94[(slot * 0xA9) + 0x100] && !current) {
                        spawn2(CardC, S_MENU_TEXT, 1, item, px << 8, (py - 18) << 8, slot, 2, 0xA3, 0x103, 0, 0)
                    }
                    else {
                        if (current) {
                            var0 = GLOBAL_23
                            if (var0) {
                                misc = 228.0
                            }
                            else {
                                misc = 229.0
                            }
                            spawn2(CardC, S_MENU_TEXT, 1, item, px << 8, py << 8, misc, 2, 0xA3, 0x103, 0, var0)
                        }
                        else {
                            spawn2(CardC, S_MENU_TEXT, 1, item, px << 8, py << 8, slot, 2, 0xA3, 0x103, 0, 0)
                        }
                        if (current) {
                            var0 = -1
                        }
                        else {
                            var0 = slot
                        }
                        GetSaveStats()
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px - 1) << 8, (py - 16) << 8, 230.0, 2, 0xA3, 0x103, -1, var0)
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px - 17) << 8, (py - 32) << 8, 231.0, 2, 0xA3, 0x103, -1, vecy)
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px + 48) << 8, (py - 32) << 8, 231.0, 2, 0xA3, 0x103, -1, vecx)
                        if (current) {
                            var0 = LIFECOUNT >> 8
                        }
                        else {
                            var0 = GLOBAL_94[(slot * 0xA9) + 0xB00]
                        }
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px + 48) << 8, (py - 16) << 8, 231.0, 2, 0xA3, 0x103, -1, var0)
                        spawn2(DispC, DispC_S_INVENTORY, 1, REWARD_CRYSTAL, (px - 8) << 8, (((py - 40) << 8) << 8) / 216, 8)
                        spawn2(DispC, DispC_S_INVENTORY, 1, REWARD_GEM, (px + 62) << 8, (((py - 40) << 8) << 8) / 216, 8)
                        spawn2(DispC, DispC_S_INVENTORY, 1, REWARD_LIFE, (px + 62) << 8, (((py - 23) << 8) << 8) / 216, 8)
                    }
                }
                else {
                    spawn2(CardC, S_CARD_BG, 1, ITEM_STATIC, (px - 31) << 8, (py - 25) << 8)
                }
                slot += 1.0
                if (current || slot >= 4.0) {
                    break
                }
            } while (1)
            if (pass) {
                break
            }
            pass = 1
        } while (1)
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
    trans {
        SelectedItem = creator -> SelectedItem
        BlinkItem = creator -> BlinkItem
        HighlightSlot = creator -> HighlightSlot
        SelectedSlot = creator -> SelectedSlot
        SaveIcon1 = creator -> SaveIcon1
        SaveIcon2 = creator -> SaveIcon2
        SaveIcon3 = creator -> SaveIcon3
        SaveIcon4 = creator -> SaveIcon4
    }
}

state Card_Icon { // 20
    statusc 0
    code(item, px, py, frame, icon) {
        DisplayItem = item
        py = (py << 8) / 216
        SetTrans(px, py, 0)
        SetScale(0x28D, 0x40E, 0x000)
        SetVFX2D()
        zindex = 400
        if (frame == 0) {
            SaveIcon1 = creator -> SaveIcon1
        }
        else if (frame == 1.0) {
            SaveIcon1 = creator -> SaveIcon2
        }
        else if (frame == 2.0) {
            SaveIcon1 = creator -> SaveIcon3
        }
        else if (frame == 3.0) {
            SaveIcon1 = creator -> SaveIcon4
        }
        if (icon >= 17) {
            icon -= 17
        }
        if (SaveIcon1) {
            ins76(SaveIcon1, icon << 8)
            ins77(frame, misc, SaveIcon1, SAVE_ICON)
        }
        setanim(SAVE_ICON)
        sleepframe(frame)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

state Card_Background { // 21
    statusc 0
    code(px, py) {
        py = (py << 8) / 216
        SetTrans(px, py, 0)
        SetScale(0x8B3, 0x35C, 0x000)
        SetVFX2D()
        zindex = -100
        setanim(SAVE_BACKGROUND)
        sleepframe(0)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

state Card_Name { // 22
    statusc 0
    code(px, py) {
        NameWord0 = creator -> NameWord0
        NameWord1 = creator -> NameWord1
        NameWord2 = creator -> NameWord2
        NameWord3 = creator -> NameWord3
        NameWord4 = creator -> NameWord4
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, px, py, 228.0, 0, 0xA3, 0x103, 1, &NameWord0)
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

state Display_Kill { // 23
    statusc 0
    code() {}
}
