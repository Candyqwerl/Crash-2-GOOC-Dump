var PreferLoad, DirectLoad, SelectedItem, BlinkItem, HighlightSlot, DisplayItem, TextMode, ErrorType, SelectedSlot, SaveIcon1,
    SaveIcon2, SaveIcon3, SaveIcon4, NameWord0, NameWord1, NameWord2, NameWord3, NameWord4, GameLoaded,
    SummaryObject, KeyboardColumn, KeyboardRow, KeyboardVar3, KeyboardObject, BackspaceObject, TextFrame1, TextFrame2, TextFrame3

// Menu item IDs
expr ITEM_NONE = 0
expr ITEM_BACKSPACE = 2
expr ITEM_KEYBOARD = 3
expr ITEM_DONE = 7
expr ITEM_CANCEL = 8
expr ITEM_LOAD = 0x66
expr ITEM_SAVE = 0x67
expr ITEM_DELETE = 0x68
expr ITEM_UNFORMAT = 0x69
expr ITEM_EXIT = 0x6A
expr ITEM_ERASE = 0x12F
expr ITEM_SLOT1 = 0x191
expr ITEM_SLOT2 = 0x192
expr ITEM_SLOT3 = 0x193
expr ITEM_SLOT4 = 0x194
expr ITEM_YES = 0x1F6
expr ITEM_NO = 0x1F7
expr ITEM_NAME_TITLE = 1
expr ITEM_MENU_TITLE = 0x65
expr ITEM_CARD_TITLE = 0xC9
expr ITEM_WAIT = 0xCA
expr ITEM_OVERWRITE_TEXT = 0x12E
expr ITEM_DELETE_TEXT = 0x130
expr ITEM_STATIC = 0x1F5

expr REWARD_GEM = 300.0
expr REWARD_CRYSTAL = 200.0
expr REWARD_LIFE = 97.0

expr LANG_DE = 3.0
expr LANG_FR = 2.0
expr LANG_IT = 4.0
expr LANG_ES = 1.0

inline sub SetCardTitle(fr, es, en) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es
    }
    else {
        TextFrame1 = en
    }
}

inline sub SetTextLanguage1(fr, de, it, es, en) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr
    }
    else if (lang == LANG_DE) {
        TextFrame1 = de
    }
    else if (lang == LANG_IT) {
        TextFrame1 = it
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es
    }
    else {
        TextFrame1 = en
    }
}

inline sub SetTextLanguage2(fr1, fr2, de1, de2, it1, it2, es1, es2, en1, en2) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr1
        TextFrame2 = fr2
    }
    else if (lang == LANG_DE) {
        TextFrame1 = de1
        TextFrame2 = de2
    }
    else if (lang == LANG_IT) {
        TextFrame1 = it1
        TextFrame2 = it2
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es1
        TextFrame2 = es2
    }
    else {
        TextFrame1 = en1
        TextFrame2 = en2
    }
}

inline sub SetTextLanguage3(fr1, fr2, fr3, de1, de2, de3, it1, it2, it3, es1, es2, es3, en1, en2, en3) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr1
        TextFrame2 = fr2
        TextFrame3 = fr3
    }
    else if (lang == LANG_DE) {
        TextFrame1 = de1
        TextFrame2 = de2
        TextFrame3 = de3
    }
    else if (lang == LANG_IT) {
        TextFrame1 = it1
        TextFrame2 = it2
        TextFrame3 = it3
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es1
        TextFrame2 = es2
        TextFrame3 = es3
    }
    else {
        TextFrame1 = en1
        TextFrame2 = en2
        TextFrame3 = en3
    }
}

inline sub SelectSaveSlot() {
    if (SelectedItem == ITEM_SLOT1) {
        SelectedSlot = 0
    }
    else if (SelectedItem == ITEM_SLOT2) {
        SelectedSlot = 1.0
    }
    else if (SelectedItem == ITEM_SLOT3) {
        SelectedSlot = 2.0
    }
    else if (SelectedItem == ITEM_SLOT4) {
        SelectedSlot = 3.0
    }
}

inline sub CheckCardStatus(error) {
    if (GLOBAL_59 & 2) {
        ErrorType = error
        cascadeevent(Event1, self)
        changestate(Card_Error)
    }
    if (GLOBAL_59 & 4) {
        cascadeevent(Event1, self)
        changestate(Card_Check)
    }
}

inline sub OpenCardMenu() {
    if (DirectLoad) {
        changestate(Card_Load)
    }
    else {
        if (PreferLoad) {
            SelectedItem = ITEM_LOAD
        }
        else {
            SelectedItem = ITEM_SAVE
        }
        changestate(Card_Main)
    }
}

inline sub SetVFX2D() {
    vfx = (vfx & 0xFFFFFF00) | 0x6
}

inline sub SoundButtonNavigate() {
    save (vfx) {
        SetVFX2D()
        soundpitch(0x7F)
        sounddecay(0xF0)
        soundplay([Mb10A], 0.5V)
    }
}

inline sub SoundButtonConfirm() {
    save (vfx) {
        SetVFX2D()
        soundpitch(4.0)
        sounddecay(0xF0)
        soundplay([tal0A], 0.8V)
    }
}

state Card_Init { // 0
    code(mode) {
        if (GLOBAL_89 != 0x63) {
            CURRENTLEVEL = GLOBAL_89
        }
        DirectLoad = mode
        PreferLoad = mode
        GLOBAL_74 = 0
        BlinkItem = ITEM_NONE
        HighlightSlot = 0
        KeyboardVar3 = 0
        loadfile([ic12D])
        loadfile([ic22D])
        SaveIcon1 = 0
        SaveIcon2 = 0
        SaveIcon3 = 0
        SaveIcon4 = 0
        GameLoaded = 0
        GLOBAL_80 = getanim(TEXT)
        GLOBAL_81 = getanim(CORTEX_ICON)
        loadfile([Car1T])
        loadfile([Car1T])
        SetRot(0deg)
        playnull(21)
        miscfunc(0, player, 10, 15)
        GAMEFLAGS |= 0x200000
        changestate(Card_Check)
    }
}

inline sub AccumulateBits(bits) {
    do (var bit = 0) {
        if ((bits) & (1 << bit)) {
            misc += 1
        }
    } while ({ bit += 1 }; bit < 32)
}

sub GetSaveStats() {
    var slot = var0
    var progress, masked, bosses
    if (slot < 0) {
        var v1 = SAVEDCRYSTALPOOL1
        var v2 = SAVEDCRYSTALPOOL2
        misc = 0
        AccumulateBits(GLOBAL_27)
        AccumulateBits(GLOBAL_28)
        progress = misc
        misc = 0
        AccumulateBits(v1)
        AccumulateBits(v2)
        vecy = misc
        v1 = SAVEDGEMPOOL1
        v2 = SAVEDGEMPOOL2
        misc = 0
        AccumulateBits(v1)
        AccumulateBits(v2)
        vecx = misc
        v2 &= ~0x3FFFFFF
        misc = 0
        AccumulateBits(v2)
        masked = vecx - misc
        misc = 0
        AccumulateBits(GLOBAL_150 & 31)
        bosses = misc
        var0 = (vecy << 1) + (vecx + bosses)
        if (GLOBAL_27 & 0x80) {
            var0 += 3
        }
    }
    else {
        var v1 = GLOBAL_94[(slot * 0xA9) + 0x1100]
        var v2 = GLOBAL_94[(slot * 0xA9) + 0x1200]
        misc = 0
        AccumulateBits(GLOBAL_94[(slot * 0xA9) + 0xF00])
        AccumulateBits(GLOBAL_94[(slot * 0xA9) + 0x1000])
        progress = misc
        misc = 0
        AccumulateBits(v1)
        AccumulateBits(v2)
        vecy = misc
        v1 = GLOBAL_94[(slot * 0xA9) + 0x1300]
        v2 = GLOBAL_94[(slot * 0xA9) + 0x1400]
        misc = 0
        AccumulateBits(v1)
        AccumulateBits(v2)
        vecx = misc
        v2 &= ~0x3FFFFFF
        misc = 0
        AccumulateBits(v2)
        masked = vecx - misc
        misc = 0
        AccumulateBits((GLOBAL_94[(slot * 0xA9) + 0xE00]) & 31)
        bosses = misc
        var0 = (vecy << 1) + (vecx + bosses)
        if ((GLOBAL_94[(slot * 0xA9) + 0xF00]) & 0x80) {
            var0 += 3
        }
    }
}

sub ReadNameByte() {
    var word
    if (var0 < 4) {
        word = NameWord0
    }
    else if (var0 < 8) {
        word = NameWord1
    }
    else if (var0 < 12) {
        word = NameWord2
    }
    else if (var0 < 16) {
        word = NameWord3
    }
    else if (var0 < 20) {
        word = NameWord4
    }
    var0 = word << (-8 * (var0 & 3)) & 0xFF
}

sub WriteNameByte() {
    var mask = 0xFF
    var value = var0
    var shift
    shift = (vecx & 3) << 3
    value <<= shift
    mask = ~(mask << shift)
    if (vecx < 4) {
        NameWord0 = (NameWord0 & mask | value)
    }
    else if (vecx < 8) {
        NameWord1 = (NameWord1 & mask | value)
    }
    else if (vecx < 12) {
        NameWord2 = (NameWord2 & mask | value)
    }
    else if (vecx < 16) {
        NameWord3 = (NameWord3 & mask | value)
    }
    else if (vecx < 20) {
        NameWord4 = (NameWord4 & mask | value)
    }
}

sub GetNameLength() {
    var len
    do {
        var0 = len
        ReadNameByte()
        if (!var0) {
            break
        }
        len += 1
    } while (1)
    var0 = len
}

sub CountNameChars() {
    var count, index
    do {
        var0 = index
        ReadNameByte()
        if (!var0) {
            break
        }
        index += 1
        if (var0 != 0xBC && var0 != 0xBD) {
            count += 1
        }
    } while (1)
    var0 = count
}

sub StoreSaveName() {
    setval(GLOBAL_94, (SelectedSlot * 0xA9) + 0x300, NameWord0)
    setval(GLOBAL_94, (SelectedSlot * 0xA9) + 0x400, NameWord1)
    setval(GLOBAL_94, (SelectedSlot * 0xA9) + 0x500, NameWord2)
    setval(GLOBAL_94, (SelectedSlot * 0xA9) + 0x600, NameWord3)
    setval(GLOBAL_94, (SelectedSlot * 0xA9) + 0x700, NameWord4)
}

sub GenerateSaveID() {
    do {
        var0 = rand(0xF423F)
        if (var0 && (var0 != GLOBAL_159 && var0 != GLOBAL_94[0xA00 + 1 - 1] && var0 != GLOBAL_94[0xB300] && var0 != GLOBAL_94[0x15C00] && var0 != GLOBAL_94[0x20500])) {
            break
        }
    } while (1)
}

sub SpawnSaveStats() {
    {
        var current = var0
        var0 = current
        AllocateIcons()
        spawn2(CardC, S_CARD_INFO, 1, current)
        var0 = misc
    }
    var summaries = var0
    interrupter = child -> sibling
    while (interrupter) {
        if (interrupter -> spawn == S_CARD_INFO) {
            break
        }
        interrupter = interrupter -> sibling
    }
    if (interrupter) {
        player = summaries
        child = player -> sibling
        player -> sibling = interrupter -> sibling
        interrupter -> sibling = player
    }

}

sub GetLevelIcon() {
    var level, table, idx, candidate
    level = var0
    table = LevelSaveIconMap
    do {
        candidate = table[idx]
        misc = !candidate
        if (misc) {
            var0 = 0
            break
        }
        if (candidate == level) {
            var0 = table[idx + 1.0]
            break
        }
        idx += 2.0
    } while (1)
}

sub AllocateIcons() {
    var icon, vido
    var current = var0
    var slot
    ReleaseIcons()
    do {
        if (current) {
            var0 = CURRENTLEVEL
            GetLevelIcon()
            icon = var0
        }
        else {
            icon = GLOBAL_94[(slot * 0xA9) + 0x200]
        }
        vido = [ic12D]
        if (icon >= 17) {
            icon -= 17
            vido = [ic22D]
        }
        if (slot == 0.0) {
            SaveIcon1 = ins74(vido, null)
        }
        else if (slot == 1.0) {
            SaveIcon2 = ins74(vido, null)
        }
        else if (slot == 2.0) {
            SaveIcon3 = ins74(vido, null)
        }
        else if (slot == 3.0) {
            SaveIcon4 = ins74(vido, null)
        }
        slot += 1.0
        if (current || slot >= 4.0) {
            break
        }
    } while (1)
}

sub ReleaseIcons() {
    if (SaveIcon4) {
        ins75(SaveIcon4, null)
        SaveIcon4 = 0
    }
    if (SaveIcon3) {
        ins75(SaveIcon3, null)
        SaveIcon3 = 0
    }
    if (SaveIcon2) {
        ins75(SaveIcon2, null)
        SaveIcon2 = 0
    }
    if (SaveIcon1) {
        ins75(SaveIcon1, null)
        SaveIcon1 = 0
    }
}

