sub NavigateKeyboard() {
    var direction = var0
    var previous = SelectedItem
    var row = KeyboardRow
    var column = KeyboardColumn
    field_61 = KeyboardMap
    ApplyNavigation()
    if (SelectedItem != previous || KeyboardRow != row || KeyboardColumn != column) {
        var0 = 1
    }
    else {
        var0 = 0
    }
}

sub ApplyNavigation() {
    var table = field_61
    var direction = var0
    var offset, item, column, row, match_column, match_row
    do {
        item = (table[offset >> 2] << ((3 - ((offset >> 8) & 3)) << 3)) >> 24
        if (!item) {
            var0 = 1
            break
        }
        column = (table[(offset + 1.0) >> 2] << ((3 - (((offset + 1.0) >> 8) & 3)) << 3)) >> 24
        row = (table[(offset + 2.0) >> 2] << ((3 - (((offset + 2.0) >> 8) & 3)) << 3)) >> 24
        if (column == -1) {
            match_column = KeyboardColumn
        }
        else {
            match_column = column
        }
        if (row == -1) {
            match_row = KeyboardRow
        }
        else {
            match_row = row
        }
        if (SelectedItem == item && KeyboardColumn == match_column && KeyboardRow == match_row) {
            offset += (direction * 3) + 3.0
            SelectedItem = (table[offset >> 2] << ((3 - ((offset >> 8) & 3)) << 3)) >> 24
            var0 = (table[(offset + 1.0) >> 2] << ((3 - (((offset + 1.0) >> 8) & 3)) << 3)) >> 24
            if (var0 >= 0) {
                KeyboardColumn = var0
            }
            var0 = (table[(offset + 2.0) >> 2] << ((3 - (((offset + 2.0) >> 8) & 3)) << 3)) >> 24
            if (var0 >= 0) {
                KeyboardRow = var0
            }
            var0 = 0
            break
        }
        offset += 15.0
    } while (1)
}

