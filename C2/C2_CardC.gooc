state Card_Main { // 11
    code() {
        {
            var can_load = 1
            var can_delete = 1
            var can_unformat = 1
            var buttons = 5
            HighlightSlot = 0
            var0 = 1
            SpawnSaveStats()
            if (GLOBAL_94[1.0] && GLOBAL_94[0xAA00] && GLOBAL_94[0x15300] && GLOBAL_94[0x1FC00]) {
                can_load = 0
                can_delete = 0
                buttons -= 2
                if (SelectedItem == ITEM_LOAD || SelectedItem == ITEM_DELETE) {
                    SelectedItem = ITEM_SAVE
                }
            }
            if (!DEBUG) {
                can_unformat = 0
                buttons -= 1
            }
            unless (SelectedItem == ITEM_LOAD || SelectedItem == ITEM_SAVE || SelectedItem == ITEM_DELETE || SelectedItem == ITEM_EXIT) {
                SelectedItem = ITEM_SAVE
            }
            SetTextLanguage1(174.0, 175.0, 176.0, 177.0, 178.0)

            spawn2(CardC, S_MENU_TEXT, 1, ITEM_MENU_TITLE, 0, 85.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
            vecy = -7.0
            if (can_load) {
                SetTextLanguage1(179.0, 180.0, 181.0, 182.0, 183.0)
                spawn2(CardC, S_MENU_TEXT, 1, ITEM_LOAD, 0, vecy, TextFrame1, 2, 0xA3, 0x103, 0, 0)
                vecy -= 19.0
            }
            SetTextLanguage1(184.0, 185.0, 186.0, 187.0, 188.0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_SAVE, 0, vecy, TextFrame1, 2, 0xA3, 0x103, 0, 0)
            vecy -= 19.0
            if (can_delete) {
                SetTextLanguage1(189.0, 190.0, 191.0, 192.0, 193.0)
                spawn2(CardC, S_MENU_TEXT, 1, ITEM_DELETE, 0, vecy, TextFrame1, 2, 0xA3, 0x103, 0, 0)
                vecy -= 19.0
            }
            if (can_unformat) {
                SetTextLanguage1(194.0, 195.0, 196.0, 197.0, 198.0)
                spawn2(CardC, S_MENU_TEXT, 1, ITEM_UNFORMAT, 0, vecy, TextFrame1, 2, 0xA3, 0x103, 0, 0)
                vecy -= 19.0
            }
            SetTextLanguage1(76.0, 77.0, 78.0, 79.0, 80.0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_EXIT, 0, vecy, TextFrame1, 2, 0xA3, 0x103, 0, 0)
            vecy -= 19.0

            playnull(5)
            do {
                if (dirpress(PAD_N)) {
                    SoundButtonNavigate()
                    if (SelectedItem == ITEM_LOAD) {
                        SelectedItem = ITEM_EXIT
                    }
                    else if (SelectedItem == ITEM_SAVE) {
                        if (can_load) {
                            SelectedItem = ITEM_LOAD
                        }
                        else {
                            SelectedItem = ITEM_EXIT
                        }
                    }
                    else if (SelectedItem == ITEM_DELETE) {
                        SelectedItem = ITEM_SAVE
                    }
                    else if (SelectedItem == ITEM_UNFORMAT) {
                        if (can_delete) {
                            SelectedItem = ITEM_DELETE
                        }
                        else {
                            SelectedItem = ITEM_SAVE
                        }
                    }
                    else if (SelectedItem == ITEM_EXIT) {
                        if (can_unformat) {
                            SelectedItem = ITEM_UNFORMAT
                        }
                        else if (can_delete) {
                            SelectedItem = ITEM_DELETE
                        }
                        else {
                            SelectedItem = ITEM_SAVE
                        }
                    }
                }
                if (dirpress(PAD_S)) {
                    SoundButtonNavigate()
                    if (SelectedItem == ITEM_LOAD) {
                        SelectedItem = ITEM_SAVE
                    }
                    else if (SelectedItem == ITEM_SAVE) {
                        if (can_delete) {
                            SelectedItem = ITEM_DELETE
                        }
                        else if (can_unformat) {
                            SelectedItem = ITEM_UNFORMAT
                        }
                        else {
                            SelectedItem = ITEM_EXIT
                        }
                    }
                    else if (SelectedItem == ITEM_DELETE) {
                        if (can_unformat) {
                            SelectedItem = ITEM_UNFORMAT
                        }
                        else {
                            SelectedItem = ITEM_EXIT
                        }
                    }
                    else if (SelectedItem == ITEM_UNFORMAT) {
                        SelectedItem = ITEM_EXIT
                    }
                    else if (SelectedItem == ITEM_EXIT) {
                        if (can_load) {
                            SelectedItem = ITEM_LOAD
                        }
                        else {
                            SelectedItem = ITEM_SAVE
                        }
                    }
                }
                if (buttonpress(PAD_START | PAD_X)) {
                    SoundButtonConfirm()
                    soundsetup(0, voice, 5)
                    break
                }
                playnull()
            } while (1)
        }
        cascadeevent(Event1, self)
        if (SelectedItem == ITEM_LOAD) {
            changestate(Card_Load)
        }
        else if (SelectedItem == ITEM_SAVE) {
            changestate(Card_Save)
        }
        else if (SelectedItem == ITEM_DELETE) {
            changestate(Card_Delete)
        }
        else if (SelectedItem == ITEM_UNFORMAT) {
            changestate(Card_Unformat)
        }
        else {
            changestateif(Card_Exit, SelectedItem == ITEM_EXIT)
        }
    }
    event(e, a) {
        if (e == Event1 && interrupter != self) {
            accev()
            cascadeevent(Event1, self)
            changestate(Card_Exit)
        }
    }
    trans {
        CheckCardStatus(1)
    }
}

state Card_Save { // 12
    code() {
        if (var slot = GLOBAL_158; slot == 0) {
            SelectedItem = ITEM_SLOT1
        }
        else if (slot == 1.0) {
            SelectedItem = ITEM_SLOT2
        }
        else if (slot == 2.0) {
            SelectedItem = ITEM_SLOT3
        }
        else if (slot == 3.0) {
            SelectedItem = ITEM_SLOT4
        }


        SetTextLanguage1(184.0, 185.0, 186.0, 187.0, 188.0)

        spawn2(CardC, S_MENU_TEXT, 1, ITEM_SAVE, 0, 85.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        HighlightSlot = 0
        var0 = 0
        SpawnSaveStats()
        SummaryObject = var0
        {
            var left = 1
            var footer, button_yes, button_no
            SetTextLanguage1(199.0, 200.0, 201.0, 202.0, 203.0)
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_CANCEL, 0, -65.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)
            footer = objectspawned

            playnull(5)
            do {
                if (buttonpress(PAD_START | PAD_X)) {
                    SoundButtonConfirm()
                    if (SelectedItem == ITEM_CANCEL) {
                        cascadeevent(Event1, self)
                        SelectedItem = ITEM_EXIT
                        changestate(Card_Main)
                    }
                    else if (SelectedItem == ITEM_NO) {
                        HighlightSlot = 0
                        interrupter = footer
                        sendevent(Event1, interrupter, self)
                        interrupter = button_yes
                        sendevent(Event1, interrupter, self)
                        interrupter = button_no
                        sendevent(Event1, interrupter, self)
                        SelectedItem = ITEM_CANCEL

                        SetTextLanguage1(199.0, 200.0, 201.0, 202.0, 203.0)
                        spawn2(CardC, S_MENU_TEXT, 1, ITEM_CANCEL, 0, -65.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)
                        footer = objectspawned
                    }
                    else {
                        if (SelectedItem == ITEM_YES) {
                            break
                        }
                        SelectSaveSlot()
                        HighlightSlot = 1
                        if (GLOBAL_94[(SelectedSlot * 0xA9) + 1.0]) {
                            cascadeevent(Event1, self)
                            changestate(Card_EnterName)
                        }
                        misc = GLOBAL_159
                        if (misc) {
                            misc = GLOBAL_159 == GLOBAL_94[(SelectedSlot * 0xA9) + 0xA00]
                            if (misc) {
                                miscfunc(SelectedSlot >> 8, player, 18, 15)
                            }
                        }
                        if (!misc) {
                            misc = 0
                        }
                        if (misc) {
                            break
                        }
                        interrupter = footer
                        sendevent(Event1, interrupter, self)
                        if (var lang = GLOBAL_151; lang == LANG_FR) {
                            spawn2(CardC, S_MENU_TEXT, 1, ITEM_OVERWRITE_TEXT, -112.0, -65.0, 204.0, 1, 0xA3, 0x103, 0, 0)
                            footer = objectspawned
                        }
                        else if (lang == LANG_DE) {
                            spawn2(CardC, S_MENU_TEXT, 1, ITEM_OVERWRITE_TEXT, -128.0, -65.0, 205.0, 1, 0xA3, 0x103, 0, 0)
                            footer = objectspawned
                        }
                        else if (lang == LANG_IT) {
                            spawn2(CardC, S_MENU_TEXT, 1, ITEM_OVERWRITE_TEXT, -112.0, -65.0, 206.0, 1, 0xA3, 0x103, 0, 0)
                            footer = objectspawned
                        }
                        else if (lang == LANG_ES) {
                            spawn2(CardC, S_MENU_TEXT, 1, ITEM_OVERWRITE_TEXT, -128.0, -65.0, 207.0, 1, 0xA3, 0x103, 0, 0)
                            footer = objectspawned
                        }
                        else {
                            spawn2(CardC, S_MENU_TEXT, 1, ITEM_OVERWRITE_TEXT, -112.0, -65.0, 208.0, 1, 0xA3, 0x103, 0, 0)
                            footer = objectspawned
                        }
                        SetTextLanguage2(
                            138.0, 139.0,
                            140.0, 141.0,
                            142.0, 143.0,
                            142.0, 143.0,
                            144.0, 143.0
                        )
                        spawn2(CardC, S_MENU_TEXT, 1, ITEM_YES, 32.0, -65.0, TextFrame1, 2, 0xA3, 0x103, 0, 0)
                        button_yes = objectspawned
                        spawn2(CardC, S_MENU_TEXT, 1, ITEM_NO, 32.0, -81.0, TextFrame2, 2, 0xA3, 0x103, 0, 0)
                        button_no = objectspawned
                        SelectedItem = ITEM_NO
                        playnull(5)
                    }
                }
                if (dirpress(PAD_N)) {
                    SoundButtonNavigate()
                    if (SelectedItem == ITEM_SLOT1) {
                        SelectedItem = ITEM_CANCEL
                    }
                    else if (SelectedItem == ITEM_SLOT2) {
                        SelectedItem = ITEM_SLOT1
                    }
                    else if (SelectedItem == ITEM_SLOT3) {
                        SelectedItem = ITEM_CANCEL
                    }
                    else if (SelectedItem == ITEM_SLOT4) {
                        SelectedItem = ITEM_SLOT3
                    }
                    else if (SelectedItem == ITEM_CANCEL) {
                        if (left) {
                            SelectedItem = ITEM_SLOT2
                        }
                        else {
                            SelectedItem = ITEM_SLOT4
                        }
                    }
                    else if (SelectedItem == ITEM_YES) {
                        SelectedItem = ITEM_NO
                    }
                    else if (SelectedItem == ITEM_NO) {
                        SelectedItem = ITEM_YES
                    }
                }
                if (dirpress(PAD_S)) {
                    SoundButtonNavigate()
                    if (SelectedItem == ITEM_SLOT1) {
                        SelectedItem = ITEM_SLOT2
                    }
                    else if (SelectedItem == ITEM_SLOT2) {
                        SelectedItem = ITEM_CANCEL
                    }
                    else if (SelectedItem == ITEM_SLOT3) {
                        SelectedItem = ITEM_SLOT4
                    }
                    else if (SelectedItem == ITEM_SLOT4) {
                        SelectedItem = ITEM_CANCEL
                    }
                    else if (SelectedItem == ITEM_CANCEL) {
                        if (left) {
                            SelectedItem = ITEM_SLOT1
                        }
                        else {
                            SelectedItem = ITEM_SLOT3
                        }
                    }
                    else if (SelectedItem == ITEM_YES) {
                        SelectedItem = ITEM_NO
                    }
                    else if (SelectedItem == ITEM_NO) {
                        SelectedItem = ITEM_YES
                    }
                }
                if (dirpress(PAD_W) || dirpress(PAD_E)) {
                    if (SelectedItem == ITEM_SLOT1) {
                        SoundButtonNavigate()
                        SelectedItem = ITEM_SLOT3
                        left = 0
                    }
                    else if (SelectedItem == ITEM_SLOT2) {
                        SoundButtonNavigate()
                        SelectedItem = ITEM_SLOT4
                        left = 0
                    }
                    else if (SelectedItem == ITEM_SLOT3) {
                        SoundButtonNavigate()
                        SelectedItem = ITEM_SLOT1
                        left = 1
                    }
                    else if (SelectedItem == ITEM_SLOT4) {
                        SoundButtonNavigate()
                        left = 1
                        SelectedItem = ITEM_SLOT2
                    }
                }
                playnull()
            } while (1)
