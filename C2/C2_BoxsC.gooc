event Event23 => sub BoxVolley

expr REWARD_ID_WUMPA = 76.0
expr REWARD_ID_1UP = 97.0
expr REWARD_ID_DOCTOR = 102.0

expr BOX_FLAG_INVISIBLE = 0x1
expr BOX_FLAG_GHOST_OLD = 0x2
expr BOX_FLAG_AUTO_COLLECT = 0x4
expr BOX_FLAG_LOW_Z1 = 0x8
expr BOX_FLAG_LOW_Z2 = 0x10
expr BOX_FLAG_NO_GHOST = 0x20
expr BOX_FLAG_GHOST_BREAK = 0x40
expr BOX_FLAG_NO_ABOVE = 0x80
expr BOX_FLAG_NO_TRIGGER = 0x100
expr BOX_FLAG_BONUS_CONTINUE = 0x200
expr BOX_FLAG_LOW_Z3 = 0x400
expr BOX_FLAG_WAVE = 0x800
expr BOX_FLAG_GHOST = 0x1000
expr BOX_FLAG_NO_BOTTOM = 0x2000
expr BOX_FLAG_NO_TOP = 0x8000
expr BOX_FLAG_REFLECTION = 0x10000
expr BOX_FLAG_SPACE = 0x20000
expr BOX_FLAG_NITRO_NO_HOP = 0x40000
expr BOX_FLAG_NO_BELOW = 0x80000
expr BOX_FLAG_NITRO_SOLID = 0x100000
expr BOX_FLAG_NO_HIT = 0x200000

var BoxVar1, BoxVar2, BoxVar3, BoxFrame, BoxVar5,
    BoxBelow, BoxGravityCurve, BoxReward, BoxLastY,
    BoxFruitHits, BoxBreakPoint, BoxFlags, BoxFlashInterval,
    BoxFlashOffset, BoxStackLastSpinHitTime, BoxGhostTargetStart,
    BoxGhostTargetEnd, BoxTransFunc, BoxWaveOriginX, BoxTNTFuse,
    BoxWaveOriginY, BoxWaveOriginZ, BoxPropulsion

inline sub SetBoxAnim(anim, frame) {
    setanim(anim)
    BoxFrame = frame
}

inline sub SetBoxAnim(anim) {
    setanim(anim)
    BoxFrame = 0
}

sub BoxTransWave() { // S-0
    var phase = ((BoxWaveOriginX >> 8) + ((BoxWaveOriginZ >> 8) + GAMETICK)) << 6
    if (((BoxWaveOriginX << 2) + BoxWaveOriginZ) & 0x2000) {
        phase = -phase
    }
    var c, s
    s = sin(phase)
    c = cos(phase)
    x = BoxWaveOriginX + (s << 1)
    rotx = c >> 5
    z = BoxWaveOriginZ + (c << 1)
    y = BoxWaveOriginY - (s << 2)
}

sub BoxTransSpace() { // S-64
    y = groundy + sin(loopseek(BoxWaveOriginX, 0.25m, 3.125), 24800)
    if (player -> stateflag & 0x20000000) {
        statusb &= ~stalltime
    }
    else {
        statusb |= stalltime
    }
    if (collider) {
        changestateif(Box_TNT_Countdown, spawn == S_BOX_TNT && !(stateflag & 0x2))
    }
}

sub BoxTransTNTBearWait() { // S-127
    changestateifn(Box_TNT_Countdown, stateflag & 0x2 || player -> pathprog < BoxBreakPoint)
    changestateif(Box_TNT_Explosion, collider)
}

sub BoxTransCommon() { // S-133
    if (STATUS_GROUNDLAND && vely < 0 && y == groundy) {
        if (BoxBelow) {
            statusb &= ~(FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_SOLID_BOTTOM)
        }
        else {
            statusb &= ~(FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
        }
        vely = 0m
        rotx = 0deg
        if (groundvel) {
            unless (LEVEL == LEVEL_RockIt || LEVEL == LEVEL_PackAttack) {
                SoundPitchDefault(0.23)
                sounddecay(0.25)
                soundplay([ld10A], 0.35V)
            }
            interrupter = BoxBelow
            sendevent(Event14, interrupter, groundvel)
        }
    }
    if (STATUS_GRAVITY) {
        if (!(BoxFlags & BOX_FLAG_REFLECTION)) {
            rotx -= BoxGravityCurve
        }
    }
    if (collider) {
        if (statusa & 0x80000 && player -> stateflag & 0x8000) {
            if (spawn == S_BOX_CONTINUE) {
                changestate(Box_Continue_Opened)
            }
            else {
                changestate(Box_Break_Reward)
            }
        }
        if ((y - BoxLastY > 0m) | (vely > 0m)) {
            if (abs(x - collider -> x) <= 0.5m && abs(z - collider -> z) <= 0.5m && collider -> y > y) {
                var boxabovenexty = spd(y + 1m, vely)
                if (collider -> y < boxabovenexty) {
                    collider -> y = boxabovenexty
                }
            }
        }
        statusb &= ~FLAG_INVISIBLE
        if (BoxFlags & BOX_FLAG_INVISIBLE) {
            entitysetstate(1)
        }
    }
    if (!STATUS_FIRSTFRAME) {
        call(BoxTransFunc)
    }
    BoxLastY = y
}

sub BoxCheckSpinEvent(e, a) { // S-369
    eventaccepted = false
    if (interrupter && frametime - BoxStackLastSpinHitTime >= 1s && e == EventSpinHit) {
        unless (STATUS_GRAVITY && !(abs(player -> speed) & ~0x3)) {
            var playerinrange, s_interrupter
            if (BoxBelow || (STATUS_GRAVITY && !(buttonhold(PAD_SQUARE | PAD_CIRCLE) || buttonbuffer(PAD_SQUARE | PAD_CIRCLE)))) {
                playerinrange = player -> y >= y - 0.2m && player -> y <= y + 1.1m
            }
            else {
                playerinrange = player -> y >= y - 2m && player -> y <= y + 1.1m
            }
            if (playerinrange) {
                if (BoxBelow) {
                    s_interrupter = interrupter
                    interrupter = BoxBelow
                    do {
                        interrupter -> BoxStackLastSpinHitTime = frametime
                        interrupter = getfield(interrupter, offsetof(BoxBelow))
                    } while (interrupter)
                    interrupter = s_interrupter
                }
                eventaccepted = true
            }
            else {
                if (BoxBelow) {
                    s_interrupter = interrupter
                    interrupter = BoxBelow
                    sendevent(EventSpinHit, interrupter, a[0])
                    interrupter = s_interrupter
                }
            }
        }
    }
}

sub BoxTriggerTargets() { // S-427
    do (var obj_id = BoxGhostTargetStart) {
        if (obj_id && !(BoxFlags & BOX_FLAG_NO_GHOST)) {
            interrupter = objectget(obj_id)
            eventaccepted = interrupter
            if (eventaccepted) {
                sendevent(EventTriggered, interrupter)
            }
            if (!eventaccepted) {
                entitysetstate(obj_id, 1)
            }
        }
    } while ({ obj_id += 1.0 }; obj_id <= BoxGhostTargetEnd)
}

sub BoxCheckDDA() { // S-447
    var reward = BoxReward
    if (reward != 100.0) {
        if (reward == REWARD_ID_1UP) {
            var lives = fieldval(ENTITY_FIELD_DDA_LIVES)
            if (entitygetstate(3) || (lives && getfield(player, 65.0) >= lives)) {
                if (spawn == S_BOX_LIFE) {
                    spawn = S_BOX_PICKUP
                    SetBoxAnim(BOX_PICKUP, 0)
                }
                BoxReward = 101.0
            }
        }
        else if (reward == REWARD_ID_DOCTOR) {
            var deaths = fieldval(ENTITY_FIELD_DDA_DEATHS)
            unless (deaths == 0 || SECTIONDEATHCOUNT >= deaths) {
                if (spawn == S_BOX_DOCTOR) {
                    spawn = S_BOX_PICKUP
                    SetBoxAnim(BOX_PICKUP, 0)
                }
                BoxReward = 101.0
            }
        }
    }
}

expr CheckBodyslamStatus = (player -> vely <= -12m || player -> statusa & FLAG_GROUNDLAND) && !creator
expr CheckJumpStatus = !creator && interrupter -> vely <= 0 && interrupter -> y >= y + 0.9m

state Box_Normal_Spawn { // 0
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target) {
        if (spawn == S_BOX_EMPTY) {
            SetBoxAnim(BOX_EMPTY, 0)
            var0 = 100.0
        }
        else if (spawn == S_BOX_PICKUP) {
            SetBoxAnim(BOX_PICKUP, 0)
            var0 = 101.0
        }
        else if (spawn == S_BOX_DOCTOR) {
            flags |= BOX_FLAG_AUTO_COLLECT
            SetBoxAnim(BOX_DOCTOR, 0)
            var0 = REWARD_ID_DOCTOR
        }
        else if (spawn == S_BOX_LIFE) {
            SetBoxAnim(BOX_1UP, 0)
            var0 = REWARD_ID_1UP
        }
        else {
            SetBoxAnim(BOX_EMPTY, 0)
            var0 = 100.0
        }
        BoxInit(var0)
        BoxCheckDDA()
        sleepframe(BoxFrame)
    }
    event(e, a) {
        if (interrupter) {
            accevcstate(Box_Break_Reward, e == EventJumpedOn && CheckJumpStatus)
            accevcstate(Box_Break_Reward, e == EventSlamHit && CheckBodyslamStatus)
        }
        if (e == EventHitInvincible) {
            if (player -> y > y + 0.9m) {
                accevcstate(Box_Break_Reward_Delayed)
            }
            else {
                accevcstate(Box_Break_Reward)
            }
        }
        else if (e == EventFling || (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT))) {
            if (a[0] && e == EventHit) {
                accevcstate(Box_Break)
            }
            else {
                accevcstate(Box_Break_Reward)
            }
        }
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_Break_Reward)
        }
        accevcstate(Box_Break_Reward, e == Event23)
        accevcstate(Box_Break_Reward, e == EventSlideHit)
    }
}

sub BoxSleep() {
    playframe(BoxFrame)
    changestateif(Box_Break_Reward, collider && entitygetstate(2))
    sleepframe(BoxFrame)
}

sub BoxInit(reward, flags, ghost_target) __trans __args(r) { // S-650
    BoxTransFunc = 0
    if (reward) {
        BoxReward = reward
    }
    else {
        BoxReward = r
    }
    BoxFlags = flags
    BoxGhostTargetEnd = ghost_target
    BoxGhostTargetStart = ghost_target
    if (flags & 0x4000) {
        statusb = FLAG_TRACK_PATH_SIGN | FLAG_COLLIDABLE | FLAG_SOLID_GROUND | FLAG_HAS_SHADOW
    }
    else {
        statusb = FLAG_TRACK_PATH_SIGN | FLAG_COLLIDABLE | FLAG_SOLID_GROUND | FLAG_SOLID_SIDES | FLAG_HAS_SHADOW
    }
    calclight()
    zindex = fieldval(ENTITY_FIELD_ZINDEX)
    if (!zindex) {
        zindex = 24
    }
    density = -0.1m
    if (BoxFlags & BOX_FLAG_GHOST) {
        SetBoxAnim(BOX_GHOST, 0)
    }
    if (BoxFlags) {
        if (BoxFlags & BOX_FLAG_INVISIBLE && !entitygetstate(2)) {
            statusb |= FLAG_INVISIBLE
        }
        if (BoxFlags & BOX_FLAG_WAVE) {
            BoxWaveOriginX = x
            BoxWaveOriginY = y
            BoxWaveOriginZ = z
            BoxTransFunc = getins(BoxTransWave)
        }
        if (BoxFlags & BOX_FLAG_SPACE) {
            stalltime = statusb & (FLAG_SOLID_ALL | FLAG_COLLIDABLE)
            BoxWaveOriginX = 0
            BoxTransFunc = getins(BoxTransSpace)
        }
        if (BoxFlags & BOX_FLAG_REFLECTION) {
            if (ZONEFLAGS & 0x800) {
                spawn(9, 28, 1)
            }
            else {
                vfx = (vfx & 0xFFFF00FF) | 0xC00
            }
        }
    }
    creator = 0
    BoxBelow = 0
    BoxLastY = y
    groundy = y
    BoxGravityCurve = 0.5deg + rand(0.2deg)
    BoxStackLastSpinHitTime = 0s
    movetolist(4.0)
    {
        var savedvelx = velx, savedvely = vely
        unless (BoxFlags & (BOX_FLAG_NO_ABOVE | BOX_FLAG_NO_BELOW)) {
            velx = 0
            vely = 0
            playframe(BoxFrame)
            BoxBelow = savedvelx
            creator = savedvely
        }
        unless (creator | (BoxFlags & BOX_FLAG_NO_TOP)) {
            statusb |= FLAG_SOLID_TOP
        }
        unless (BoxBelow | (BoxFlags & BOX_FLAG_NO_BOTTOM)) {
            statusb |= FLAG_SOLID_BOTTOM
        }
        statusa |= 0x80000
    }
    if (BoxFlags & (BOX_FLAG_GHOST | BOX_FLAG_GHOST_OLD)) {
        if (entitygetstate(2)) {
            changestate(Box_Ghost_Appear)
        }
        else {
            changestate(Box_Ghost)
        }
    }
}

sub BoxBreak() { // S-905
    sendevent(EventBoxBreak, player, self)
    movetolist(3.0)
    if (creator) {
        creator -> BoxBelow = BoxBelow
        sendevent(EventBoxStackBreak, creator, 4m)
    }
    else {
        statusb &= ~FLAG_COLLIDABLE
    }
    if (BoxBelow) {
        interrupter = BoxBelow
        interrupter -> creator = creator
        if (BoxBelow && !creator) {
            interrupter = BoxBelow
            interrupter -> statusb |= FLAG_SOLID_TOP
        }
    }
}

state Box_Normal { // 1
    statusc 0x0
    code => sub BoxSleep
    event => state Box_Normal_Spawn
    trans => sub BoxTransCommon
}

state Box_Iron_Spawn { // 2
    stateflag 0x801
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target) {
        SetBoxAnim(BOX_IRON, 0)
        BoxInit(0)
        if (entitygetstate(2)) {
            BoxTriggerTargets()
        }   
        changestate(Box_Iron)
    }
}

state Box_Iron { // 3
    stateflag 0x80000A01
    code => sub BoxSleep
    trans => sub BoxTransCommon
    event(e, a) {
        if (e == EventSpinHit || e == EventSlideHit || e == EventSlamHit) {
            rejev()
            if (frametime - statetime >= 0.8s) {
                SoundPitchDefault(0.23)
                sounddecay(0.625)
                soundplay([iht0A], 0.4V)
                statetime = frametime
            }
        }
    }
}

state Box_Steel_Spawn { // 4
    stateflag 0xA01
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target) {
        SetBoxAnim(BOX_STEEL, 0)
        BoxInit(100.0)
        changestate(Box_Steel)
    }
    event(e, a) {
        accevcstate(Box_Break_Reward, e == EventSlamHit && CheckBodyslamStatus)
        if (interrupter) {
            rejevcstate(Box_Steel_Hit, e == EventJumpedOn && CheckJumpStatus)
        }
        accevcstate(Box_Break_Reward, e == EventHitInvincible && player -> invincible == 5)
        accevcstate(Box_Steel_Hit, (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT)) || e == EventHitInvincible || e == EventFling)
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_Steel_Hit)
        }
        if (STATUS_GRAVITY) {
            accevcstate(Box_Break_Reward, e == Event23)
        }
        else {
            accevcstate(Box_Steel_Hit, e == Event23)
        }
        accevcstate(Box_Steel_Hit, e == EventSlideHit)
    }
}

state Box_Steel { // 5
    stateflag 0xA01
    statusc 0x0
    event => state Box_Steel_Spawn
    trans => sub BoxTransCommon
    code() {
        playframe(BoxFrame)
        changestateif(Box_Break_Reward, collider && entitygetstate(2))
        sleepframe(BoxFrame)
    }
}

state Box_Steel_Hit { // 6
    stateflag 0x201
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        SoundPitchDefault(0.23)
        sounddecay(0.625)
        soundplay([iht0A], 0.2V)
        SoundPitchDefault(0.23)
        soundplay([swb0A], 0.5V)
        playframes(BOX_STEEL, 0.0, 9.0)
        changestate(Box_Steel)
    }
    event(e, a) {
        accevcstate(Box_Break_Reward, e == EventSlamHit && CheckBodyslamStatus)
    }
}

state Box_Ghost_Spawn { // 7
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target) {
        if (entitygetstate(2)) {
            BoxGhostSelectAnim(reward)
        }
        else {
            SetBoxAnim(BOX_GHOST, 0)
        }
        BoxInit(100.0)
        BoxCheckDDA()
        changestateif(Box_Ghost_Appear, entitygetstate(2))
        SetBoxAnim(BOX_GHOST, 0)
        changestate(Box_Ghost)
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            entitysetstate(1)
        }
    }
}

state Box_Ghost { // 8
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        statusb &= ~FLAG_COLLIDABLE
        sleepframe(BoxFrame)
    }
    event(e, a) {
        accevcstate(Box_Ghost_Appear, e == EventTriggered && !(BoxFlags & BOX_FLAG_NO_GHOST))
    }
}

inline sub BoxGhostWaitToActivate() {
    save (statusb) {
        statusb |= FLAG_COLLIDABLE
        statusb &= ~FLAG_SOLID_ALL2
        playframe(BoxFrame)
        while (collider) {
            playframe(BoxFrame)
        }
    }
}

state Box_Ghost_Appear { // 9
    stateflag 0x801
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        #iflev 3efqrstujhijmnpwx
        v0 = entitygetstate(2)
        if (!v0) {
            playframe(BoxFrame, 4)
        }
        entitysetstate(1)
        unless (BoxFlags & BOX_FLAG_NO_TRIGGER) {
            BoxTriggerTargets()
        }
        if (!v0 && (spawn == S_BOX_IRON || spawn == S_BOX_SPRING_IRON || spawn == S_BOX_ACTION || spawn == S_BOX_ACTION_NITRO)) {
            BoxGhostWaitToActivate()
        }
        SoundPitchDefault()
        soundplay([bap0A], 0.4V)
        #else
        SoundPitchDefault()
        soundplay([bap0A], 0.4V)
        if (!entitygetstate(2)) {
            entitysetstate(1)
            playframe(BoxFrame, 4)
            BoxGhostWaitToActivate()
        }
        unless (BoxFlags & BOX_FLAG_NO_TRIGGER) {
            BoxTriggerTargets()
        }
        #endif
        statusb |= FLAG_COLLIDABLE
        statusb &= ~FLAG_INVISIBLE
        BoxCheckDDA()
        BoxGhostSelectAnim(BoxReward)
        if (spawn == S_BOX_SPRING || spawn == S_BOX_SPRING_IRON) {
            changestate(Box_Spring)
        }
        else if (spawn == S_BOX_IRON || spawn == S_BOX_IRON_GHOST) {
            changestate(Box_Iron)
        }
        else if (spawn == S_BOX_FRUIT) {
            changestate(Box_Fruit)
        }
        else if (spawn == S_BOX_TNT) {
            changestate(Box_TNT)
        }
        else if (spawn == S_BOX_NITRO) {
            changestate(Box_Nitro)
        }
        else if (spawn == S_BOX_ACTION || spawn == S_BOX_ACTION_NITRO) {
            changestate(Box_Action)
        }
        else {
            if (BoxFlags & BOX_FLAG_GHOST_BREAK) {
                changestate(Box_Break_Reward)
            }
            else {
                changestate(Box_Normal)
            }
        }
    }
}

sub BoxGhostSelectAnim(reward) { // S-1151
    if (spawn == S_BOX_SPRING) {
        SetBoxAnim(BOX_SPRING, 0)
    }
    else if (spawn == S_BOX_EMPTY) {
        SetBoxAnim(BOX_EMPTY, 0)
    }
    else if (spawn == S_BOX_LIFE) {
        SetBoxAnim(BOX_1UP, 0)
    }
    else if (spawn == S_BOX_DOCTOR) {
        SetBoxAnim(BOX_DOCTOR, 0)
    }
    else if (spawn == S_BOX_FRUIT) {
        SetBoxAnim(BOX_FRUIT, 0)
    }
    else if (spawn == S_BOX_ACTION) {
        SetBoxAnim(BOX_ACTION_1, 0)
    }
    else if (spawn == S_BOX_ACTION_NITRO) {
        SetBoxAnim(BOX_ACTION_NITRO_1, 0)
    }
    else if (spawn == S_BOX_PICKUP) {
        SetBoxAnim(BOX_PICKUP, 0)
    }
    else if (spawn == S_BOX_NITRO) {
        SetBoxAnim(BOX_NITRO, 0)
    }
    else if (spawn == S_BOX_TNT) {
        SetBoxAnim(BOX_TNT, 0)
    }
    else if (spawn == S_BOX_GHOST) {
        if (reward == REWARD_ID_1UP) {
            SetBoxAnim(BOX_1UP, 0)
        }
        else if (reward == REWARD_ID_DOCTOR) {
            SetBoxAnim(BOX_DOCTOR, 0)
        }
        else {
            SetBoxAnim(BOX_EMPTY, 0)
        }
    }
    else if (spawn == S_BOX_IRON_GHOST || spawn == S_BOX_IRON) {
        SetBoxAnim(BOX_IRON, 0)
    }
    else if (spawn == S_BOX_SPRING_IRON) {
        SetBoxAnim(BOX_SPRING_IRON, 0)
    }
}


state Box_Action_Spawn { // 10
    statusc 0x0
    code(reward, flags, ghost_start, ghost_end) {
        if (entitygetstate(2) && (!(flags & 0x1000) || entitygetstate(ghost_start, 2))) {
            spawn = S_BOX_IRON
            changestate(Box_Iron_Spawn, reward, flags, ghost_start)
        }
        if (spawn == S_BOX_ACTION_NITRO) {
            SetBoxAnim(BOX_ACTION_NITRO_1, 0)
        }
        else {
            SetBoxAnim(BOX_ACTION_1, 0)
        }
        BoxInit(100.0)
        if (BoxGhostTargetEnd) {
            BoxGhostTargetEnd = ghost_end
        }
        changestate(Box_Action)
    }
}

state Box_Action { // 11
    stateflag 0x80000201
    statusc 0x0
    code => sub BoxSleep
    trans => sub BoxTransCommon
    event(e, a) {
        if (interrupter) {
            accevcstate(Box_Action_Trigger_1, e == EventJumpedOn && CheckJumpStatus)
        }
        rejevcstate(Box_Action_Trigger_1, e == EventSlamHit || e == EventTriggered)
        accevcstate(Box_Action_Trigger_1, (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT)) || e == EventHitInvincible || e == EventFling)
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_Action_Trigger_2)
        }
        accevcstate(Box_Action_Trigger_1, e == EventTriggered && !(BoxFlags & BOX_FLAG_NO_GHOST))
        accevcstate(Box_Action_Trigger_1, e == Event23)
        accevcstate(Box_Action_Trigger_1, e == EventSlideHit)
    }
}

expr ACTION_MARK_YELLOW = 0.0
expr ACTION_MARK_GREEN = 1.0

sub BoxActionExec() { // S-1292
    entitysetstate(1)
    var mark = ACTION_MARK_YELLOW
    if (spawn == S_BOX_ACTION_NITRO) {
        spawn(9, 43, 1, 0.5m, 0, 0.375, 0, 0, 0)
        mark = ACTION_MARK_GREEN
    }
    spawn(BoxsC, S_ACTION_MARK, 1, mark, 0, 0, 0.5m)
    spawn(BoxsC, S_ACTION_MARK, 1, mark, 0.5m, 0, 0)
    spawn(BoxsC, S_ACTION_MARK, 1, mark, 0, 0, -0.5m)
    spawn(BoxsC, S_ACTION_MARK, 1, mark, -0.5m, 0, 0)
    spawn(BoxsC, S_ACTION_MARK, 1, mark, 0, 1.5m, 0)
    SetBoxAnim(BOX_IRON, 0)
    if (spawn == S_BOX_ACTION_NITRO) {
        GLOBAL_139 |= 0x1
        killvictims()
        unless (LEVEL == LEVEL_HangEight || LEVEL == LEVEL_AirCrash) {
            soundpitch((30.4 + rand(3.2)) * 0.295 >> 8)
            sounddecay(0.75)
            soundplay([nbr0A], 0.4V)
        }
        SoundPitchDefault(0.23)
        sounddecay(0.75)
        soundplay([tnt0A], 1.0V)
        if (!SHAKEY) {
            SHAKEY = 15.0
        }
    }
    changestate(Box_Iron)
}


state Box_Action_Trigger_1 { // 12
    stateflag 0x80000201
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        sendevent(Event15, player, 3.0)
        SoundPitchDefault(0.23)
        soundplay([swb0A], 0.5V)
        if (spawn == S_BOX_ACTION_NITRO) {
            playframes(BOX_ACTION_NITRO_1, 0.0, 9.0)
        }
        else {
            playframes(BOX_ACTION_1, 0.0, 9.0)
        }
        BoxTriggerTargets()
        BoxActionExec()
        changestate(Box_Action)
    }
}

state Box_Action_Trigger_2 { // 13
    stateflag 0x80000201
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        sendevent(Event15, player, 3.0)
        SoundPitchDefault(0.23)
        soundplay([swb0A], 0.5V)
        if (spawn == S_BOX_ACTION_NITRO) {
            playframes(BOX_ACTION_NITRO_2, 0.0, 9.0)
        }
        else {
            playframes(BOX_ACTION_2, 0.0, 9.0)
        }
        BoxTriggerTargets()
        BoxActionExec()
        changestate(Box_Action)
    }
}

state Box_Continue_Spawn { // 14
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target) { 
        {
            var deaths = fieldval(ENTITY_FIELD_DDA_DEATHS)
            var section = fieldval(ENTITY_FIELD_DDA_SECTION)
            unless (deaths == 0 || (SECTIONDEATHCOUNT >= deaths && SECTION == section) || entitygetstate(3)) {
                spawn = S_BOX_PICKUP
                changestate(Box_Normal_Spawn, reward, flags, ghost_target)
            }
        }
        if (entitygetstate(3)) {
            SetBoxAnim(BOX_CONTINUE, 15.0)
        }
        else {
            SetBoxAnim(BOX_CONTINUE, 0)
        }
        BoxInit(100.0)
        changestateif(Box_Continue_Opened, entitygetstate(3) || collider)
        sleepframe(BoxFrame)
    }
    event(e, a) {
        if (interrupter) {
            accevcstate(Box_Continue_Open, e == EventJumpedOn && CheckJumpStatus)
            accevcstate(Box_Continue_Open, e == EventSlamHit && CheckBodyslamStatus)
        }
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_Continue_Open)
        }
        accevcstate(Box_Continue_Open, e == EventHitInvincible)
        accevcstate(Box_Continue_Open, e == Event23)
        accevcstate(Box_Continue_Open, e == EventSlideHit)
    }
}

expr CONTINUE_C = 0.0
expr CONTINUE_H = 1.0
expr CONTINUE_E = 2.0
expr CONTINUE_K = 3.0
expr CONTINUE_P = 4.0
expr CONTINUE_O = 5.0
expr CONTINUE_I = 6.0
expr CONTINUE_N = 7.0
expr CONTINUE_T = 8.0

state Box_Continue_Open { // 15
    stateflag 0x803
    trans => sub BoxTransCommon
    code() {
        CHECKPOINTID = id
        SPAWNTRANSX = x
        SPAWNTRANSY = y
        SPAWNTRANSZ = z
        sendevent(EventBoxBreak, player, self)
        entitysetstate(3)
        savecheckpoint(0)
        if (var section = fieldval(ENTITY_FIELD_DDA_SECTION); section) {
            GLOBAL_140 |= 1 << (section >> 8)
        }
        sendevent(EventBoxStackBreak, creator, 4m)
        if (!creator) {
            statusb &= ~FLAG_COLLIDABLE
        }
        SoundPitchDefault(0.23)
        soundplay([con0A], 0.3V)
        playframes(BOX_CONTINUE, 0.0, 15.0)
        playanim(14, BOX_CONTINUE)
        zindex = 20
        statusb &= ~FLAG_COLLIDABLE
        if (BoxBelow && !creator) {
            interrupter = BoxBelow
            interrupter -> statusb |= FLAG_SOLID_TOP
        }
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_C, -1.2m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_H, -0.6m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_E, 0.0m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_C, 0.6m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_K, 1.2m)
        playanim(15, BOX_CONTINUE, 1.0s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_P, -1.2m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_O, -0.6m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_I, 0.0m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_N, 0.6m)
        playanim(15, BOX_CONTINUE, 0.1s)
        spawn(BoxsC, S_CONTINUE_LETTER, 1, CONTINUE_T, 1.2m)
        sleepanim(15, BOX_CONTINUE)
    }
}

state Box_Continue_Opened { // 16
    stateflag 0x803
    trans => sub BoxTransCommon
    code() {
        statusb &= ~FLAG_COLLIDABLE
        zindex = 20
        playanim(15, BOX_CONTINUE)
        sendevent(EventBoxStackBreak, creator, 4m)
        if (BoxBelow && !creator) {
            interrupter = BoxBelow
            interrupter -> statusb |= FLAG_SOLID_TOP
        }
        sleepanim(15, BOX_CONTINUE)
    }
}

state Action_Mark { // 17
    stateflag 0x3
    code(frame, x_off, y_off, z_off) {
        zindex = 35
        SetScale(0.5S, 1S, 0.5S)
        SetRot(0deg)
        setanim(BOX_ACTION_MARK, frame)
        x += x_off
        y += y_off
        z += z_off
        velx = x_off << 6
        vely = y_off >> 1
        velz = z_off << 6
        statusb = FLAG_PHYSICS_ENGINE
        playframe(animframe, 42)
        if (y_off) {
            statusb = 0
            do (var i = 0) {
                playnull(2)
                setanim(BOX_ACTION_MARK)
                playframe(frame, 2)
            } while ({ i += 1.0 }; i < 8.0)
        }
    }
}

state Continue_Letter { // 18
    stateflag 0x3
    code(frame, offs) {
        vfx = (vfx & 0xFFFF00FF) | 0x300
        SetColor1(0xFF, 0xC8, 0x00)
        moda = 16.0
        zindex = 25
        SetScale(0S)
        setanim(BOX_LETTERS)
        soundpitch((15.36 + rand(1.28)) * 0.205 >> 8)
        sounddecay(0.125)
        soundplay([jmp0A], 0.2V)

        do (var i = 0) {
            x += offs / 5
            scalex += 9.6 / 5
            scaley = scalex
            y += 0.4m
            playframe(frame)
        } while ({ i += 1.0 }; i < 5.0)

        groundy = y
        vely = 0.2m

        do (var start = frametime) {
            y = groundy + (loopseek(vely, 0.2m, 0.6m / 30) - 0.2m)
            playframe()
        } while (frametime - start < 0.7s)

        statusb = FLAG_PHYSICS_ENGINE
        SetVel(-20m, 0m, 0m)
        soundpitch((15.36 + rand(1.28)) * 0.205 >> 8)
        sounddecay(0.25)
        soundplay([jmp0A], 0.3V)

        do (var start = frametime) {
            velx = spd(velx, -40m)
            playframe()
        } while (frametime - start < 1s)
    }
}

state Box_Spring_Spawn { // 19
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target, propulsion) {
        if (spawn == S_BOX_SPRING) {
            SetBoxAnim(BOX_SPRING, 0)
        }
        else {
            SetBoxAnim(BOX_SPRING_IRON, 0)
        }
        BoxPropulsion = propulsion
        BoxInit(100.0)
        changestate(Box_Spring)
    }
}

state Box_Spring { // 20
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        if (spawn == S_BOX_SPRING_IRON) {
            stateflag |= 0x80000A00
        }
        sleepframe(BoxFrame)
    }
    event(e, a) {
        if (player -> y > y + 0.5m && interrupter == player && (e == EventJumpedOn || (spawn == S_BOX_SPRING_IRON && e == EventSlamHit)) && !creator) {
            sendevent(EventBounce, interrupter, BoxPropulsion)
            rejevcstate(Box_Spring_Bounce)
        }
        if (spawn == S_BOX_SPRING) {
            accevcstate(Box_Break_Reward, e == EventSlamHit && CheckBodyslamStatus)
            BoxCheckSpinEvent(e, a)
            if (eventaccepted) {
                accevcstate(Box_Break_Reward)
            }
            if (e == EventHitInvincible) {
                if (player -> y > y + 0.9m) {
                    accevcstate(Box_Break_Reward_Delayed)
                }
                else {
                    accevcstate(Box_Break_Reward)
                }
            }
            else if (e == EventFling || (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT))) {
                if (a[0] && e == EventHit) {
                    accevcstate(Box_Break)
                }
                else {
                    accevcstate(Box_Break_Reward)
                }
            }
            accevcstate(Box_Break_Reward, e == Event23)
            accevcstate(Box_Break_Reward, e == EventSlideHit)
        }
        accevcstate(Box_Spring_Bounce_Box, e == Event14)
    }
}

sub BoxSpringPlayAnim() { // S-1744
    if (spawn == S_BOX_SPRING_IRON) {
        playframes(BOX_SPRING_IRON, 0.0, 9.0)
        playanim(8, BOX_SPRING_IRON)
        playanim(9, BOX_SPRING_IRON)
    }
    else {
        playanim(0, BOX_SPRING)
        playanim(1, BOX_SPRING)
        playanim(2, BOX_SPRING)
        playanim(2, BOX_SPRING)
        playanim(3, BOX_SPRING)
        playanim(4, BOX_SPRING)
        playanim(5, BOX_SPRING)
        playanim(6, BOX_SPRING)
        playanim(6, BOX_SPRING)
        playanim(7, BOX_SPRING)
    }
}

state Box_Spring_Bounce { // 21
    event => state Box_Spring
    trans => sub BoxTransCommon
    code() {
        if (spawn == S_BOX_SPRING_IRON) {
            stateflag |= 0x800
        }
        SoundPitchDefault(0.23)
        sounddecay(0.625)
        soundplay([bnc0A], 0.5V)
        BoxSpringPlayAnim()
        changestate(Box_Spring)
    }
}

state Box_Spring_Bounce_Box { // 22
    trans => sub BoxTransCommon
    code() {
        if (spawn == S_BOX_SPRING_IRON) {
            stateflag |= 0x80000A00
        }
        statusb |= FLAG_SOLID_TOP
        SoundPitchDefault(0.23)
        sounddecay(0.625)
        soundplay([bnc0A], 0.5V)
        sendevent(EventBounce, creator, 17.88854m)
        BoxSpringPlayAnim()
        changestate(Box_Spring)
    }
    event(e, a) {
        if (player -> y > y + 0.75m) {
            rejevcstate(Box_Spring_Bounce, e == EventJumpedOn && STATUS_SOLID_TOP)
        }
        if (spawn == S_BOX_SPRING) {
            BoxCheckSpinEvent(e, a)
            if (eventaccepted) {
                accevcstate(Box_Break_Reward)
            }
            if (e == EventHitInvincible) {
                if (player -> y > y + 0.9m) {
                    accevcstate(Box_Break_Reward_Delayed)
                }
                else {
                    accevcstate(Box_Break_Reward)
                }
            }
            else if (e == EventFling || (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT))) {
                if (a[0] && e == EventHit) {
                    accevcstate(Box_Break)
                }
                else {
                    accevcstate(Box_Break_Reward)
                }
            }
            accevcstate(Box_Break_Reward, e == Event23)
            accevcstate(Box_Break_Reward, e == EventSlideHit)
        }
    }
}

state Box_Fruit_Spawn { // 23
    statusc 0x0
    trans => sub BoxTransCommon
    code(reward, flags, ghost_target) {
        SetBoxAnim(BOX_FRUIT, 0)
        BoxInit(REWARD_ID_WUMPA)
        BoxCheckDDA()
        BoxFruitHits = 0
        changestate(Box_Fruit)
    }
}

state Box_Fruit { // 24
    statusc 0x0
    code => state Box_Spring
    trans => sub BoxTransCommon
    event(e, a) {
        if (player -> y > y + 0.75m) {
            accevcstate(Box_Fruit_Hit, e == EventJumpedOn && STATUS_SOLID_TOP)
        }
        if (e == EventHitInvincible) {
            if (BoxReward == REWARD_ID_WUMPA) {
                BoxReward = 78.0
            }
            accevcstate(Box_Break_Reward)
        }
        accevcstate(Box_Break_Reward, e == EventSlamHit && CheckBodyslamStatus)
        accevcstate(Box_Break, (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT)) || e == EventHitInvincible || e == EventFling)
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_Break)
        }
        accevcstate(Box_Break, e == EventSlideHit)
        if (e == Event23) {
            accevcstate(Box_Break, STATUS_GRAVITY || (collider && player -> stateflag & 0x200000) || player -> statusa & FLAG_GROUNDLAND)
            accevcstate(Box_Fruit_Hit)
        }
    }
}

state Box_Fruit_Hit { // 25
    stateflag 0x1000001
    statusc 0x0
    event => state Box_Fruit
    trans => sub BoxTransCommon
    code() {
        if (BoxFruitHits == 0) {
            if (entitygetstate(2)) {
                BoxBreakPoint = frametime - 7s
            }
            else {
                entitysetstate(1)
                sendevent(Event15, player, 8.0)
                BoxBreakPoint = frametime
            }
        }
        BoxFruitHits += 1.0
        changestateif(Box_Break_Reward, getfield(self, offsetof(BoxFruitHits)) >= 10.0)
        changestateif(Box_Break, frametime - BoxBreakPoint >= 7s)
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, REWARD_ID_WUMPA, 0)
        playanim(0, BOX_FRUIT)
        playanim(1, BOX_FRUIT)
        playanim(2, BOX_FRUIT)
        playanim(2, BOX_FRUIT)
        playanim(3, BOX_FRUIT)
        playanim(4, BOX_FRUIT)
        playanim(5, BOX_FRUIT)
        playanim(6, BOX_FRUIT)
        playanim(6, BOX_FRUIT)
        playanim(7, BOX_FRUIT)
        changestate(Box_Fruit)
    }
}

state Box_Break { // 26
    stateflag 0x803
    code() {
        KillEntity()
        entitysetstate(0)
        if (statusa & 0x80) {
            statusb &= ~FLAG_COLLIDABLE
        }
        BoxBreak()
        epc = 0
        SetColorC2(16.0, 0xE6, 0x69, 0x08)
        SoundPitchDefault(0.23)
        sounddecay(0.625)
        soundplay([brk0A], 0.35V)
        FlipRand()
        playanim(0, BOX_EXPLODE)
        playanim(1, BOX_EXPLODE)
        playanim(2, BOX_EXPLODE)
        statusb &= ~FLAG_COLLIDABLE
        playframes(3.0, 11.0)
    }
    event(e, a) {
        if (e == EventDespawn) {
            accev()
            sendevent(EventBoxBreak, player, self)
            KillEntity()
            epc = 0
        }
    }
}

state Box_Break_Reward { // 27
    stateflag 0x803
    code() {
        KillEntity()
        entitysetstate(0)
        if (statusa & 0x80) {
            statusb &= ~FLAG_COLLIDABLE
        }
        BoxBreak()
        v0 = 0
        if (BoxReward == REWARD_ID_1UP) {
            v0 = id
        }
        else if (BoxReward == REWARD_ID_DOCTOR) {
            v0 = fieldval(ENTITY_FIELD_PARENT_ID)
        }
        interrupter = child
        if (creator || BoxFlags & BOX_FLAG_AUTO_COLLECT || eventreceived == EventHit || eventreceived == EventHitInvincible) {
            if (BoxReward) {
                spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, BoxReward, v0)
            }
        }
        else if (BoxReward) {
            spawn2(FruiC, FruiC_S_FRUIT_HOP, 1, BoxReward, v0)
        }
        if (interrupter == child) {
            BoxForceReward(BoxReward, v0)
        }
        SoundPitchDefault(0.23)
        sounddecay(0.625)
        soundplay([brk0A], 0.35V)
        FlipRand()
        BoxTriggerTargets()
        SetColorC2(16.0, 0xE6, 0x69, 0x08)
        playanim(0, BOX_EXPLODE)
        playanim(1, BOX_EXPLODE)
        playanim(2, BOX_EXPLODE)
        playanim(3, BOX_EXPLODE)
        statusb &= ~FLAG_COLLIDABLE
        playframes(4.0, 11.0)
    }
}

state Box_Break_Reward_Delayed { // 28
    stateflag 0x803
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        WaitFrame(BoxFrame, 12)
        changestate(Box_Break_Reward)
    }
}

sub BoxForceReward(reward, parent_id) {
    if (reward == REWARD_ID_1UP) {
        sendevent(Event5, player, 1.0)
        entitysetstate(parent_id, 5)
    }
    else {
        sendevent(Event2, player, 1.0)
    }
}

inline sub TNTDefaultColor() {
    SetColor1(0xFF, 0xFF, 0xFF)
    SetColor2(0xFF, 0xFF, 0xFF)
    SetColor3(0xFF, 0xFF, 0xFF)
    SetColor4(0xFF, 0xFF, 0xFF)
}

inline sub TNTFlashColor() {
    SetColor1(0x200, 0x96, 0x96)
    SetColor2(0x200, 0x96, 0x96)
    SetColor3(0x200, 0x96, 0x96)
    SetColor4(0x200, 0x96, 0x96)
}

state Box_TNT_Spawn { // 29
    stateflag 0xA01
    statusc 0x0
    code(reward, flags, ghost_target, path_delay, fuse) {
        SetBoxAnim(BOX_TNT, 0)
        BoxFlashInterval = 50
        BoxFlashOffset = rand(50)
        BoxTNTFuse = fuse
        BoxInit(100.0)
        if (LEVEL == LEVEL_BearIt || LEVEL == LEVEL_BearDown || LEVEL == LEVEL_TotallyBear) {
            BoxBreakPoint = path_delay
            if (LEVEL != LEVEL_BearIt) {
                BoxBreakPoint += player -> pathprog
            }
            BoxTransFunc = getins(BoxTransTNTBearWait)
        }
        unless (creator || BoxBelow) {
            stateflag &= ~0x800
        }
        sleepframe(BoxFrame)
    }
    event(e, a) {
        rejevret(!(statusa & 0x80000))
        if (e == Event23) {
            accevcstate(Box_TNT_Explosion, STATUS_GRAVITY)
            accevcstate(Box_TNT_Countdown)
        }
        accevcstate(Box_TNT_Explosion, (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT)) || e == EventHitInvincible || e == EventFling)
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_TNT_Explosion)
        }
        accevcstate(Box_TNT_Explosion, e == EventSlideHit)
        if (interrupter) {
            accevcstate(Box_TNT_Countdown, e == EventJumpedOn && CheckJumpStatus)
            accevcstate(Box_TNT_Explosion, e == EventSlamHit && CheckBodyslamStatus)
        }
        interrupter = BoxBelow
        misc = BoxBelow
        if (misc) {
            misc = interrupter -> spawn == S_BOX_NITRO
        }
        if (!misc) {
            misc = 0
        }
        misc = creator
        if (misc) {
            misc = creator -> spawn == S_BOX_NITRO
        }
        if (!misc) {
            misc = 0
        }
        unless (misc || misc) {
            accevcstate(Box_TNT_Countdown, e == Event14)
        }
        accevcstate(Box_TNT_Countdown, e == EventHitInvincible)
    }
    trans {
        BoxTransCommon()
        if (!STATUS_FIRSTFRAME) {
            if (time(BoxFlashInterval, BoxFlashOffset)) {
                TNTDefaultColor()
            }
            else {
                TNTFlashColor()
            }
        }
    }
}

state Box_TNT { // 30
    stateflag 0x801
    statusc 0x0
    event => state Box_TNT_Spawn
    trans => state Box_TNT_Spawn
    code() {
        sleepframe(BoxFrame)
    }
}

inline sub SetBoxGravity(velocity) {
    if (vely < 0m) {
        vely = velocity
    } 
    vely += velocity
    rotx = 0deg
    statusb |= FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_SOLID_BOTTOM
}

state Box_Nitro_Spawn { // 31
    statusc 0x0
    trans => sub BoxTransNitro
    code(reward, flags, ghost_target) {
        settrans(BoxTransNitro)
        SetBoxAnim(BOX_NITRO, 0)
        BoxInit(100.0)
        density = 0.1m
        sleepframe(BoxFrame)
    }
    event(e, a) {
        sendeventif(EventDidgeridoo, player, (e == EventSpinHit || e == EventSlamHit || e == Event23 || e == EventSlideHit) || (e == EventJumpedOn && !(BoxFlags & BOX_FLAG_NITRO_SOLID)), 100.0)
        accevcstate(Box_TNT_Explosion, e == EventSlamHit && CheckBodyslamStatus)
        if (e == Event23) {
            accevcstate(Box_TNT_Explosion)
        }
        accevcstate(Box_TNT_Explosion, (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT)) || e == EventHitInvincible || e == EventFling)
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_TNT_Explosion)
        }
        accevcstate(Box_TNT_Explosion, e == EventSlideHit)
    }
}

sub BoxTransNitro() {
    BoxTransCommon()
    if (collider && !(BoxFlags & BOX_FLAG_NITRO_SOLID)) {
        sendevent(EventDidgeridoo, collider, 100.0)
        changestate(Box_TNT_Explosion)
    }
    if (!STATUS_FIRSTFRAME && !rand(60) && !STATUS_GRAVITY && !(BoxFlags & (BOX_FLAG_NITRO_NO_HOP | BOX_FLAG_SPACE))) {
        unless (LEVEL == LEVEL_HangEight || LEVEL == LEVEL_AirCrash) {
            SoundPitchDefault()
            sounddecay(0.3125)
            soundplay([nbu0A], 0.4V)
        }
        SetBoxGravity(3.46411m)
        sendevent(EventBounce, creator, 5.65685m)
    }
}

state Box_Nitro { // 32
    stateflag 0x801
    statusc 0x0
    event => state Box_Nitro_Spawn
    trans => state Box_Nitro_Spawn
    code() {
        sleepframe(BoxFrame)
    }
}

inline sub TNTBeep() {
    if (LEVEL == LEVEL_PlantFood) {
        soundpitch(3.265)
        soundplay([Ttb0A], 0.4V)
    }
    else {
        soundpitch(3.265)
        soundplay([Ttb0A], 0.8V)
    }
}

state Box_TNT_Countdown { // 33
    stateflag 0xA03
    statusc 0x0
    trans => sub BoxTransCommon
    code() {
        if (BoxTNTFuse >= 3.0) {
            TNTFlashColor()
            TNTBeep()
            playanim(0, BOX_TNT_3, 4)
            TNTDefaultColor()
            playanim(0, BOX_TNT_3, 25)
        }
        if (BoxTNTFuse >= 2.0) {
            TNTFlashColor()
            TNTBeep()
            playanim(0, BOX_TNT_2, 4)
            TNTDefaultColor()
            playanim(0, BOX_TNT_2, 10)
            TNTBeep()
            playanim(0, BOX_TNT_2, 15)
        }
        TNTFlashColor()
        TNTBeep()
        playanim(0, BOX_TNT_1, 4)
        TNTDefaultColor()
        playanim(0, BOX_TNT_1, 3)
        TNTBeep()
        if (BoxTNTFuse >= 1.0) {
            playanim(0, BOX_TNT_1, 7)
            TNTBeep()
            playanim(0, BOX_TNT_1, 7)
            TNTBeep()
            playanim(0, BOX_TNT_1, 7)
        }
        statusc &= ~0x2
        changestate(Box_TNT_Explosion)
    }
    event(e, a) {
        accevcstate(Box_TNT_Explosion, (e == EventHit && !(BoxFlags & BOX_FLAG_NO_HIT)) || e == EventHitInvincible || e == EventFling)
        BoxCheckSpinEvent(e, a)
        if (eventaccepted) {
            accevcstate(Box_TNT_Explosion)
        }
        accevcstate(Box_TNT_Explosion, e == EventSlideHit)
        accevcstate(Box_TNT_Explosion, e == EventSlamHit && CheckBodyslamStatus)
        accevcstate(Box_TNT_Explosion, e == Event73)
        if (STATUS_GRAVITY) {
            accevcstate(Box_TNT_Explosion, e == Event23)
        }
        if (e == EventDespawn) {
            statusc |= 0x22
            SoundPitchDefault(0.23)
            sounddecay(0.75)
            soundplay([tnt0A], 1.0V)
            soundsetup(0, voice, 5)
            sendevent(EventBoxBreak, player, self)
            killvictims()
            KillEntity()
        }
    }
}

state Box_TNT_Explosion { // 34
    stateflag 0x3
    trans => sub BoxTransExplosion
    code() {
        statusb &= ~FLAG_COLLIDABLE
        KillEntity()
        entitysetstate(0)
        if (statusa & 0x80) {
            statusb &= ~FLAG_COLLIDABLE
        }
        BoxBreak()
        epc = getins(BoxTNTExplosionDespawnedEvent)
        if (spawn == S_BOX_NITRO) {
            unless (LEVEL == LEVEL_HangEight || LEVEL == LEVEL_AirCrash) {
                soundpitch((30.4 + rand(3.2)) * 0.295 >> 8)
                sounddecay(0.75)
                soundplay([nbr0A], 0.4V)
            }
        }
        SoundPitchDefault(0.23)
        sounddecay(0.75)
        soundplay([tnt0A], 1.0V)
        soundsetup(0, voice, 5)
        statusb &= ~FLAG_SOLID_ALL2
        statusb |= FLAG_COLLIDABLE
        FlipRand()
        moda = 16.0
        if (spawn == S_BOX_NITRO) {
            field_61 = Event63
            spawn(9, 4, 1, getins(BoxSelectExplosionColor), 0)
            SetColor1(0x51, 0xA9, 0x00)
            spawn(9, 43, 1, 0.5m, 0, 0x60, 0, 0, 0)
            spawn(9, 46, 1, 20, 45, 2, 0, 0)
        }
        else {
            field_61 = Event30
            spawn(9, 4, 1, 0, 0)
            SetColor1(0xE6, 0x23, 0x04)
            spawn(9, 43, 1, 0.5m, 0x60, 38, 0, 0, 0)
            spawn(9, 46, 1, 51, 51, 3, 0, 0)
        }
        playframes(BOX_EXPLODE, 0.0, 11.0)
    }
    event(e, a) {
        if (e == EventDespawn) {
            statusc |= 0x22
            SoundPitchDefault(0.23)
            sounddecay(0.75)
            soundplay([tnt0A], 1.0V)
            soundsetup(0, voice, 5)
            sendevent(EventBoxBreak, player, self)
            killvictims()
            KillEntity()
            epc = getins(BoxTNTExplosionDespawnedEvent)
        }
        if (e == Event28) {
            statusb |= 0x2000000
            cascadeevent(Event28, self, 0)
            accevcstate(Box_Explode)
        }
    }
}

sub BoxTNTExplosionDespawnedEvent(e, a) { // S-2580
    if (e == Event28) {
        statusb |= 0x2000000
        cascadeevent(Event28, self, 0)
        accevcstate(Box_Explode)
    }
}

sub BoxTransExplosion() __trans {
    nofirst {
        sendevent(Event15, interrupter, 4.0)
        sendeventif(field_61, collider, var0 <= 2.0, 100.0)
        broadcastevent(EventHit, 4, 1)
    }
}

sub BoxSelectExplosionColor() { // S-2599
    if (var r = rand(5); r == 0) {
        SetColor1(0x4B, 0x4B, 0x00)
    }
    else if (r == 1) {
        SetColor1(0x00, 0x4B, 0x00)
    }
    else if (r == 2) {
        SetColor1(0x19, 0x2F, 0x06)
    }
    else if (r == 3) {
        SetColor1(0x4B, 0x33, 0x00)
    }
    else if (r == 4) {
        SetColor1(0x00, 0x4B, 0x2C)
    }
    SetScale(2.5S)
}

state Box_Explode { // 35
    code() {
        playanim(2, BOX_EXPLODE, 1)
        playanim(3, BOX_EXPLODE, 2)
        playanim(3, BOX_EXPLODE, 2)
        playframesdur(4.0, 7.0, 2)
        playframesdur(8.0, 11.0, 2)
        tpc = 0
        statusb = FLAG_INVISIBLE
        sleep()
    }
    trans {
        nofirst {
            broadcastevent(EventHit, 4, 1)
        }
    }
}

sub BoxRecalcStack(a) { // S-2662
    if (interrupter) {
        if (a == 1.0) {
            if (abs((y - 1m) - interrupter -> y) < 0.1m && abs(x - interrupter -> x) < 0.1m && abs(z - interrupter -> z) < 0.1m) {
                interrupter -> v0 = 1.0
            }
            else {
                interrupter -> v0 = 0
            }
        }
        else if (a == 2.0) {
            BoxBelow = interrupter
        }
    }
}

sub BoxBreakRecalc(p) { // S-2688
    groundy -= 1m
    SetBoxGravity(p)
    sendevent(EventBoxStackBreak, creator, p)
}

sub BoxBounce(p) { // S-2701
    SetBoxGravity(p)
    sendevent(EventBounce, creator, p)
}

sub BoxTrack(a) { // S-2712
    if (interrupter) {
        x = interrupter -> x
        z = interrupter -> z
    }
    sendevent(Event18, creator, a)
}

sub BoxVolley() { // S-2718
    if (interrupter) {
        if (spawn == S_BOX_IRON || spawn == S_BOX_ACTION) {
            if (STATUS_GRAVITY && vely < 0) {
                interrupter = DOCTOR
                sendevent(Event15, interrupter, 4.0)
                if (v0) {
                    sendevent(EventHit, interrupter, 100.0)
                }
                else {
                    sendevent(EventHit, player, 100.0)
                }
                if (!(player -> stateflag & 0x20)) {
                    SoundPitchDefault(0.23)
                    sounddecay(0.25)
                    soundplay([ld10A], 0.7V)
                    SoundPitchDefault(0.23)
                    sounddecay(0.625)
                    soundplay([bnc0A], 0.5V)
                    y = player -> y + 2m
                    SetBoxGravity(15.49194m)
                }
            }
        }
    }
}