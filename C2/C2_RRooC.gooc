    RooDoHop(32.0, ROO_HOP_NITRO_E, 11, 0, 4, 11, 0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(48.0, ROO_HOP_NITRO_F, 11, 0, 6, 12, 0, 12, 12.0)
    RooHopFrame = 0
    RooDoFinalHopNitro(42.0, ROO_HOP_NITRO_G, 2, 5, 13, 0)
}

inline sub SoundRooIntroTrans() {
    soundpitch(3.262)
    sounddelay(1.85s)
    sounddecay(10s)
    soundplay([RRe6A], 2V)

    soundpitch(6.892)
    sounddelay(2.15s)
    sounddecay(10s)
    soundplay([RBF6A], 1V)

    soundpitch(6.892)
    sounddelay(63)
    sounddecay(10s)
    soundplay([RRG6A], 2V)
}

state Roo_Intro { // 0
    code() {
        soundpitch(3.625)
        soundsetup(GLOBAL_6, self, 5)
        soundsetup(0, self, 9)
        sounddecay(10.2s)
        soundplay([WflfA], 0.3V)
        statusb = FLAG_ROT_Y | FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        zindex = 68
        health = 3
        spawn(BosBC, BosBC_S_HEALTH, 1, 3.0, 3)
        calcpath(0, vvec)
        calcpath(9.0)
        TileHalfX = abs(vecx - x) >> 1
        TileHalfZ = abs(vecz - z) >> 1
        BoxExplosionHalfX = 3 * TileHalfX
        BoxExplosionHalfZ = 3 * TileHalfZ
        calcpath(64.0)
        if (!RESPAWNCOUNT) {
            playanim(0, ROO_INTRO_1)
            playanim(0, ROO_INTRO_1)
            WaitFrame(0, ROO_INTRO_1, 1s)
            playframes(ROO_INTRO_1, 0.0, 78.0)
            SoundRooIntroTrans()
            playframes(ROO_INTRO_2, 0.0, 78.0)
            playframes(ROO_INTRO_3, 0.0, 33.0)
            playframes(ROO_INTRO_4, 0.0, 20.0)
        }
        else {
            ins72(0, 0x8000)
        }
        changestate(Ripper_Roo)
    }
    event(e, a) {
        accevcstate(Ripper_Roo, e == Event67)
    }
}

inline sub RooDazed() {
    setanim(ROO_DAZED_1, -1.0)
    do {
        animframe += 1.0
        if (RooDamageTaken) {
            break
        }
        if (animframe == 32.0) {
            soundpitch(6.892)
            sounddecay(10s)
            soundplay([RBT6A], 1V)
            RooCanTakeDamage = true
        }
        playframe()
    } while (animframe + 1.0 <= 82.0)

    if (!RooDamageTaken) {
        setanim(ROO_DAZED_2, -1.0)
        do {
            animframe += 1.0
            if (RooDamageTaken) {
                break
            }
            playframe()
        } while (animframe + 1.0 <= 41.0)
    }

    if (!RooDamageTaken) {
        setanim(ROO_RECOVER, -1.0)
        do {
            animframe += 1.0
            if (RooDamageTaken) {
                break
            }
            if (animframe == 2.0 || animframe == 7.0 || animframe == 11.0) {
                soundpitch(3.625)
                sounddecay(9.6s)
                soundplay([brk0A], 0.8V)
            }
            if (animframe == 20.0) {
                RooCanTakeDamage = false
            }
            playframe()
        } while (animframe + 1.0 <= 49.0)
    }
}

inline sub RooAttacked() {
    RooCanTakeDamage = false
    save (vfx) {
        vfx = (vfx & 0xFFFFFF00) | 0x6
        sounddecay(10.2s)
        SoundPitchDefault()
        soundplay([RRe6A], 1V)
    }
    health -= 1
    changestateif(Roo_Defeated, health <= 0)
    playframes(ROO_ATTACKED, 0.0, 42.0)
    break
}

inline sub SoundRooNitroPhaseTrans() {
    soundpitch(6.892)
    sounddecay(10s)
    soundplay([RCS6A], 1V)

    soundpitch(3.263)
    sounddelay(1.95s)
    soundplay([RJm6A], 1V)

    soundpitch(3.263)
    sounddelay(2.5s)
    soundplay([RJm6A], 1V)
}

state Ripper_Roo { // 1
    code() {
        SetColor1(0xFF, 0xFF, 0xFF)
        RooTNTPhase1()
        var0 = false
        do {
            if (var0) {
                RooTNTPhase1Repeat()
            }
            var0 = true
            playframes(ROO_HOP_WAIT_FOR_TNT, 0.0, 43.0)
            until (BoxesExploded) {
                playframe()
            }
            SoundRooNitroPhaseTrans()
            playframes(ROO_HOP_NITRO_1, 0.0, 64.0)
            playframes(ROO_HOP_NITRO_2, 0.0, 12.0)
            RooNitroPhase1()
            playframes(ROO_EXPLODE_NITRO, 0.0, 37.0)
            RooDazed()
            if (RooDamageTaken) { 
                RooAttacked()
            }
            soundpitch(6.892)
            sounddecay(10s)
            soundplay([RRG6A], 1V)
            playframes(ROO_PHASE_TRANS, 0.0, 14.0)
        } while (1)
        statusb |= FLAG_INVISIBLE
        playframe(animframe, 0.85s)
        statusb &= ~FLAG_INVISIBLE
        playframes(ROO_PHASE_TRANS, 0.0, 14.0)
        do {
            RooTNTPhase2()
            playframes(ROO_HOP_WAIT_FOR_TNT, 0.0, 43.0)
            until (BoxesExploded) {
                playframe()
            }
            SoundRooNitroPhaseTrans()
            playframes(ROO_HOP_NITRO_1, 0.0, 64.0)
            playframes(ROO_HOP_NITRO_2, 0.0, 12.0)
            RooNitroPhase2()
            playframes(ROO_EXPLODE_NITRO, 0.0, 37.0)
            RooDazed()
            if (RooDamageTaken) { 
                RooAttacked()
            }
            playframes(ROO_PHASE_TRANS, 0.0, 14.0)
        } while (1)
        statusb |= FLAG_INVISIBLE
        playframe(animframe, 0.85s)
        statusb &= ~FLAG_INVISIBLE
        playframes(ROO_PHASE_TRANS, 0.0, 14.0)
        do {
            RooTNTPhase3()
            playframes(ROO_HOP_WAIT_FOR_TNT, 0.0, 43.0)
            until (BoxesExploded) {
                playframe()
            }
            SoundRooNitroPhaseTrans()
            playframes(ROO_HOP_NITRO_1, 0.0, 64.0)
            playframes(ROO_HOP_NITRO_2, 0.0, 12.0)
            RooNitroPhase3()
            playframes(ROO_EXPLODE_NITRO, 0.0, 37.0)
            RooDazed()
            if (RooDamageTaken) { 
                RooAttacked()
            }
            playframes(ROO_PHASE_TRANS, 0.0, 14.0)
        } while (1)
        statusb |= FLAG_INVISIBLE
        playframe(animframe, 0.85s)
        statusb &= ~FLAG_INVISIBLE
        playframes(ROO_PHASE_TRANS, 0.0, 14.0)
    }
    event(e, a) {
        if (RooCanTakeDamage) {
            if (RooDamageTaken) {
                rejevret(e == EventJumpedOn || e == EventSpinHit || e == EventSlideHit || e == EventSlamHit)
            }
            else if (e == EventJumpedOn || e == EventSpinHit || e == EventSlideHit || e == EventSlamHit) {
                accev()
                RooDamageTaken = true
            }
            if (interrupter == player && (e == EventJumpedOn || e == EventSlamHit)) {
                rejev()
                sounddecay(6.4s)
                SoundPitchDefault(0.23)
                soundplay([bnk0A], 0.4V)
                sendevent(EventBounce, interrupter, 12.649m)
            }
            if ((e == EventHit || e == EventHitInvincible || e == EventSpinHit || e == EventSlideHit) && interrupter == player && player -> statusb & 0x80) {
                save (velx, vely, velz, troty) {
                    troty = atan2(player -> trans)
                    interrupter -> speed = 10m
                    interrupter -> troty = atan2(player -> trans)
                    setvel(10m, vvel)
                    interrupter -> velx = velx
                    interrupter -> vely = vely
                    interrupter -> velz = velz
                    interrupter -> statusb &= ~FLAG_DPAD_CONTROL
                }
            }
        }
        else {
            if ((e == EventSpinHit || e == EventSlideHit) && interrupter == player && frametime - RooLastHitTime > 0.1s) {
                sounddecay(6.4s)
                SoundPitchDefault(0.23)
                soundplay([sht0A], 0.4V)
                RooLastHitTime = frametime
            }
            if (interrupter == player && (e == EventJumpedOn || e == EventSlamHit)) {
                rejev()
                sounddecay(6.4s)
                SoundPitchDefault(0.23)
                soundplay([bnk0A], 0.4V)
                sendevent(EventBounce, interrupter, 12.649m)
            }
            if (e == EventSpinHit && interrupter == player && player -> statusb & 0x80) {
                save (velx, vely, velz, troty) {
                    troty = atan2(player -> trans)
                    interrupter -> speed = 10m
                    interrupter -> troty = atan2(player -> trans)
                    setvel(10m, vvel)
                    interrupter -> velx = velx
                    interrupter -> vely = vely
                    interrupter -> velz = velz
                    interrupter -> statusb &= ~FLAG_DPAD_CONTROL
                }
            }
        }
    }
    trans {
        if (RooCanTakeDamage && !time(0.2s)) {
            moda = 32.0
        }
        else {
            moda = 0
        }
    }
}

state Roo_Defeated { // 2
    stateflag 0x21
    trans => state Ripper_Roo
    code() {
        playframes(ROO_DEATH_1, 0.0, 38.0)
        soundpitch(2.903)
        sounddelay(0.9s)
        soundplay([RFH6A], 10V)
        playframes(ROO_DEATH_2, 0.0, 37.0)
        entitysetspawn(0)
        sendevent(EventWarp, player, 0)
        sleep()
    }
}

state Nitro_Trigger_Timer { // 3
    code(tile_x, tile_z, dur) {
        parent -> BoxNitroExplosionTileX = -1
        parent -> BoxNitroExplosionTileZ = -1
        do (var start = frametime) {
            if (parent -> BoxNitroExplosionTileX >= 0) {
                return
            }
            playframe()
        } while (frametime - start < dur)
        parent -> BoxNitroExplosionTileX = tile_x
        parent -> BoxNitroExplosionTileZ = tile_z
    }
}

inline sub TNT_Countdown(anim, t) {
    if (BoxIndex == 0) {
        soundpitch(3.263)
        soundplay([Ttb0A], 0.8V)
    }
    if (BoxIndex == 1) {
        soundpitch(3.263)
        soundplay([Ttb0A], 0.4V)
    }
    playanim(0, anim, t)
}

state Box_TNT { // 4
    code(pos_x, pos_y, pos_z, tile_x, tile_z, index) {
        BoxIndex = index
        BoxTileX = tile_x
        BoxTileZ = tile_z
        if (!BoxIndex) {
            parent -> TNTChainStart = 0
        }
        TNTFuse = (BoxIndex << 2) * 1s / 1.2s
        zindex = 64
        SetRot(0deg)
        SetTrans(pos_x, pos_y, pos_z)
        TNT_Countdown(BOX_TNT_0, 1s)
        TNT_Countdown(BOX_TNT_6, 1s)
        TNT_Countdown(BOX_TNT_5, 1s)
        TNT_Countdown(BOX_TNT_4, 1s)
        TNT_Countdown(BOX_TNT_3, 1s)
        TNT_Countdown(BOX_TNT_2, 1s)
        TNT_Countdown(BOX_TNT_1, 1s)
        if (BoxIndex == 0) {
            parent -> TNTChainStart = frametime
            changestate(Box_TNT_Explode)
        }
    }
    trans {
        nofirst {
            unless (!parent -> TNTChainStart) {
                changestateif(Box_TNT_Explode, frametime - parent -> TNTChainStart >= TNTFuse)
            }
        }
    }
}

state Box_TNT_Explode { // 5
    code() {
        statusb |= FLAG_INVISIBLE
        spawn(9, 40, 1, 0, 7)
        if (parent -> x > x - parent -> TileHalfX
            && parent -> x < x + parent -> TileHalfX
            && parent -> z > z - parent -> TileHalfZ
            && parent -> z < z + parent -> TileHalfZ) {
                parent -> BoxesExploded = true
            }
        WaitChildNull()
    }
    trans {
        nofirst {
            sendeventif(EventHit, player,
                player -> x > x - parent -> BoxExplosionHalfX
                && player -> x < x + parent -> BoxExplosionHalfX
                && player -> z > z - parent -> BoxExplosionHalfZ
                && player -> z < z + parent -> BoxExplosionHalfZ, 100.0)
        }
    }
}

state Box_Nitro { // 6
    code(pos_x, pos_y, pos_z, tile_x, tile_z, index) {
        SoundPitchDefault()
        sounddecay(4.8s)
        soundplay([nbu0A], 0.8V)
        BoxIndex = index
        BoxTileX = tile_x
        BoxTileZ = tile_z
        zindex = 64
        SetRot(0deg)
        SetTrans(pos_x, pos_y, pos_z)
        do {
            playanim(0, BOX_NITRO)
            if (!rand(60)) {
                SoundPitchDefault()
                sounddecay(3.2s)
                soundplay([nbu0A], 0.4V)

            }
        } while (1)
    }
    trans {
        nofirst {
            if (player -> statusa & FLAG_GROUNDLAND
                && player -> x > x - parent -> TileHalfX
                && player -> x < x + parent -> TileHalfX
                && player -> z > z - parent -> TileHalfZ
                && player -> z < z + parent -> TileHalfZ) {
                    parent -> BoxNitroExplosionTileX = BoxTileX
                    parent -> BoxNitroExplosionTileZ = BoxTileZ
                }
            changestateif(Box_Nitro_Explode, parent -> BoxNitroExplosionTileX >= 0, parent -> BoxNitroExplosionTileX, parent -> BoxNitroExplosionTileZ)
        }
    }
}

sub SpawnExplosionParticle(mode) {
    moda = 16.0
    if (mode < 2) {
        soundpitch((30.4 + rand(3.2)) * 0.295 >> 8)
        sounddecay(7.7s)
        soundplay([nbr0A], 0.6V)
        soundsetup(0, voice, 5)
        spawn(9, 40, 1, getins(SetNitroExplosionColor2), 7)
    }
    else {
        spawn(9, 4, 1, getins(SetNitroExplosionColor1), 7)
    }
}

sub SetNitroExplosionColor1() {
    if (var r = rand(5); r == 0) {
        SetColor1(0x4B, 0x4B, 0x00)
    }
    else if (r == 1) {
        SetColor1(0x00, 0x4B, 0x00)
    }
    else if (r == 2) {
        SetColor1(0x19, 0x2F, 0x06)
    }
    else if (r == 3) {
        SetColor1(0x4B, 0x33, 0x00)
    }
    else if (r == 4) {
        SetColor1(0x00, 0x4B, 0x2c)
    }
    SetScale(2.5S)
}

sub SetNitroExplosionColor2() {
    if (var r = rand(5); r == 0) {
        SetColor1(0x4B, 0x4B, 0x00)
    }
    else if (r == 1) {
        SetColor1(0x00, 0x4B, 0x00)
    }
    else if (r == 2) {
        SetColor1(0x19, 0x2F, 0x06)
    }
    else if (r == 3) {
        SetColor1(0x4B, 0x33, 0x00)
    }
    else if (r == 4) {
        SetColor1(0x00, 0x4B, 0x2C)
    }
    SetScale(2.5S)
}

state Box_Nitro_Explode { // 7
    code(ox, oz) {
        {
            var dist = abs(ox - BoxTileX) + abs(oz - BoxTileZ)
            WaitFrame(dist * 3)
        }
        statusb |= FLAG_INVISIBLE
        SpawnExplosionParticle(0)
        sendeventif(EventDidgeridoo, player,
            player -> x > x - parent -> BoxExplosionHalfX
            && player -> x < x + parent -> BoxExplosionHalfX
            && player -> z > z - parent -> BoxExplosionHalfZ
            && player -> z < z + parent -> BoxExplosionHalfZ, 100.0)

        if (parent -> x > x - parent -> TileHalfX
            && parent -> x < x + parent -> TileHalfX
            && parent -> z > z - parent -> TileHalfZ
            && parent -> z < z + parent -> TileHalfZ) {
                parent -> BoxesExploded = true
            }
        WaitChildNull()
    }
}
