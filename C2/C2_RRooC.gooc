var RooDamageTaken, RooCanTakeDamage, BoxesExploded, BoxNitroExplosionTileX, BoxNitroExplosionTileZ, TNTChainStart, TNTFuse, TileHalfX, TileHalfZ, BoxExplosionHalfX,
    BoxExplosionHalfZ, RooHopFrame, RooYawInc, BoxIndex, BoxTileX, BoxTileZ, RooLastHitTime, RooVar18

expr ROO_BOX_NITRO = 0.0
expr ROO_BOX_TNT = 1.0

sub SpawnRooBox(pos_x, pos_y, pos_z, tile_x, tile_z, index, box) {
    if (box == ROO_BOX_NITRO) {
        spawn(RRooC, S_NITRO, 1, pos_x, pos_y, pos_z, tile_x, tile_z, index)
    }
    else if (box == ROO_BOX_TNT) {
        spawn(RRooC, S_TNT, 1, pos_x, pos_y, pos_z, tile_x, tile_z, index)
    }
}

inline sub SoundRooHop() {
    soundpitch(3.263)
    soundplay([RJm6A], 1V)
}

inline sub ResetPhaseFlags() {
    BoxesExploded = false
    RooCanTakeDamage = false
    RooDamageTaken = false
    RooLastHitTime = 0s
}

inline sub RooDoHop(point, anim, drop, tile_x, tile_z, index, box, steps, frames) {
    calcpath(point, vvec)
    SoundRooHop()
    var s_x = x
    var s_y = y
    var s_z = z
    var t_x = vecx
    var t_y = vecy
    var t_z = vecz
    troty = atan2(t_x)
    setanim(anim)
    do (var f = 1.0) {
        x = s_x + ((t_x - s_x) * (f >> 8)) / steps
        y = s_y + ((t_y - s_y) * (f >> 8)) / steps
        z = s_z + ((t_z - s_z) * (f >> 8)) / steps
        if (RooHopFrame == drop) {
            SpawnRooBox(vecx, vecy, vecz, tile_x, tile_z, index, box)
        }
        RooHopFrame += 1
        playframe((f - 1.0) * steps / steps)
        f += 1.0
    } while (f <= frames)
}

inline sub RooDoFinalHopTNT(anim, tile_x, tile_z, index, box) {
    var s_x = x
    var s_y = y
    var s_z = z
    var t_x = vecx
    var t_y = vecy
    var t_z = vecz
    troty = atan2(player -> trans)
    setanim(anim)
    do (var f = 1.0) {
        x = s_x + ((t_x - s_x) * (f >> 8)) >> 4
        y = s_y + ((t_y - s_y) * (f >> 8)) >> 4
        z = s_z + ((t_z - s_z) * (f >> 8)) >> 4
        if (RooHopFrame >= 4) {
            roty += RooYawInc
        }
        if (RooHopFrame == 15) {
            SpawnRooBox(vecx, vecy, vecz, tile_x, tile_z, index, box)
        }
        RooHopFrame += 1
        playframe((f - 1.0) << 4 >> 4)
        f += 1.0
    } while (f <= 16.0)
}

inline sub RooDoFinalHopNitro(point, anim, tile_x, tile_z, index, box) {
    trotx = 0deg
    calcpath(point, vvec)
    RooYawInc = degdist(roty, 180deg + atan2(player, vecx))
    RooYawInc >>= 3
    SoundRooHop()
    var s_x = x
    var s_y = y
    var s_z = z
    var t_x = vecx
    var t_y = vecy
    var t_z = vecz
    troty = atan2(player -> trans)
    setanim(anim)
    do (var f = 1.0) {
        x = s_x + ((t_x - s_x) * (f >> 8)) / 12
        y = s_y + ((t_y - s_y) * (f >> 8)) / 12
        z = s_z + ((t_z - s_z) * (f >> 8)) / 12
        if (RooHopFrame >= 4) {
            roty += RooYawInc
        }
        if (RooHopFrame == 11) {
            SpawnRooBox(vecx, vecy, vecz, tile_x, tile_z, index, box)
        }
        RooHopFrame += 1
        playframe((f - 1.0) * 12 / 12)
        f += 1.0
    } while (f <= 12.0)
}

sub RooTNTPhase1() {
    ResetPhaseFlags()
    spawn(RRooC, S_NITRO_TRIGGER, 1, 0, 0, 9.5s)
    RooHopFrame = 0
    trotx = 360deg
    RooDoHop(28.0, ROO_HOP_TNT_1, 26, 4, 3, 0, 1.0, 27, 27.0)
    RooHopFrame = 0
    RooDoHop(34.0, ROO_HOP_TNT_2, 11, 2, 4, 1, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(32.0, ROO_HOP_TNT_3, 11, 0, 4, 2, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(18.0, ROO_HOP_TNT_4, 11, 2, 2, 3, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(16.0, ROO_HOP_TNT_5, 11, 0, 2, 4, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(1.00, ROO_HOP_TNT_6, 11, 1, 0, 5, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(3.00, ROO_HOP_TNT_7, 11, 3, 0, 6, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(5.00, ROO_HOP_TNT_8, 11, 5, 0, 7, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(15.0, ROO_HOP_TNT_9, 11, 7, 1, 8, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(30.0, ROO_HOP_TNT_A, 11, 6, 3, 9, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(46.0, ROO_HOP_TNT_B, 11, 6, 5, 10, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(62.0, ROO_HOP_TNT_C, 11, 6, 7, 11, 1.0, 12, 12.0)
    RooHopFrame = 0
    RooDoHop(60.0, ROO_HOP_TNT_D, 13, 4, 7, 12, 1.0, 14, 14.0)
    RooHopFrame = 0
    trotx = 0deg
    calcpath(44.0, vvec)
    RooYawInc = degdist(roty, 180deg + atan2(player, vecx))
    if (RooYawInc < 0deg) {
        RooYawInc = 360deg + RooYawInc
    }
    RooYawInc /= 12
    SoundRooHop()
    RooDoFinalHopTNT(ROO_HOP_TNT_E, 4, 5, 13, 1.0)
}

