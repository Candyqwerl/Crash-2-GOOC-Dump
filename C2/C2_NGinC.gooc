inline sub DetachRobotPart(part, vx, vy, vz) {
    interrupter = part
    interrupter -> stateflag |= 0x100
    interrupter -> DetachVelX = vx
    interrupter -> DetachVelY = vy
    interrupter -> DetachVelZ = vz
}

inline sub FollowParentUnlessDetached() {
    unless(stateflag & 0x100) {
        x = parent -> x
        y = parent -> y
        z = parent -> z
    }
}

inline sub UpdateBossPathPosition() {
    if ((pathprog & 0xFF) == 0.5) {
        calcpath(pathprog + 0.5, vvec)
        x = vecx + velx >> 1
        y = vecy + vely >> 1
        z = vecz + velz >> 1
    }
    else {
        calcpath(pathprog, vvel)
        x = velx
        y = vely
        z = velz
    }
}

inline sub DebugPathScrub(start) {
    do (var prog = start) {
        UpdateBossPathPosition()
        playframe()
        if (buttonhold(PAD_R1)) {
            pathprog = start
        }
        else {
            pathprog = prog
        }
        if (buttonhold(PAD_L1)) {
            nop()
        }
        if (buttonhold(PAD_CIRCLE)) {
            prog += 1.0
        }
        if (buttonhold(PAD_TRIANGLE)) {
            prog += 25.0
        }
        if (buttonhold(PAD_SQUARE)) {
            prog -= 1.0
        }
        if (buttonhold(PAD_X)) {
            prog -= 25.0
        }
    } while (1)
}


inline sub SoundRobotBreak() {
    save(vfx) {
        vfx = (vfx & 0xFFFFFF00) | 0x6
        soundpitch(3.263)
        sounddecay(7.7s)
        soundplay([NAb9A], 10V)
    }
}

