sub CheckRobotDamage_S2(){
    if (pathprog == 601.0 || pathprog == 658.0 || pathprog == 811.0 || pathprog == 929.0) {
        changestateif(S2_Break_Both, LeftDamage >= 5 && RightDamage >= 5 && !(S2_LEFT_SHOULDER_BROKEN) && !(S2_RIGHT_SHOULDER_BROKEN))
        if (LeftDamage >= 5 && !(S2_LEFT_SHOULDER_BROKEN)) {
            RightDamage >>= 1
            changestate(S2_Break_Left, S2_RIGHT_SHOULDER_BROKEN)
        }
        if (RightDamage >= 5 && !(S2_RIGHT_SHOULDER_BROKEN)) {
            LeftDamage >>= 1
            changestate(S2_Break_Right, S2_LEFT_SHOULDER_BROKEN)
        }
    }
}

state S2_Loop { // 16
    statusc 0x20
    trans => state S1_Setup
    code(startpoint) {
        cascadeevent(Event12, self, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_2, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_2, 0, 0, 0, 0, 0)
        unless(S2_LEFT_SHOULDER_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_LEFT_2, 4, 0, getins(RegisterDamage_Left_S2), 0, 0)
        }
        LeftShoulderOBJ = objectspawned
        unless(S2_LEFT_SHOULDER_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_LEFT_1, 8, 0, 0, 0, 0)
        }
        unless(S2_LEFT_SHOULDER_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 0, -16, ROCKET_LAUNCHER_0, 0, 0, 0, 0, getins(VulnerablePartFlashRed))
        }
        unless(S2_RIGHT_SHOULDER_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_RIGHT_2, 16, 0, getins(RegisterDamage_Right_S2), 0, 0)
        }
        RightShoulderOBJ = objectspawned
        unless(S2_RIGHT_SHOULDER_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_RIGHT_1, 8, 0, 0, 0, 0)
        }
        unless(S2_RIGHT_SHOULDER_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 0, -16, ROCKET_LAUNCHER_1, 0, 0, 0, 0, getins(VulnerablePartFlashRed))
        }
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_PAD_RIGHT_2, 0, 0, 0, 0, 0)
        pathprog = startpoint
        DebugPhaseID = 13.0
        setanim(ROBOT_MAIN_2)
        FaceForward = false
        trotx = 90deg
        PartsVulnerable = false
        animframe = 29.0
        ShoulderMotion = 2
        do {
            UpdateBossPathPosition()
            if (pathprog == 600.0) {
                AttackCycle += 1
                if (AttackCycle > 2) {
                    AttackCycle = 0
                }
            }
            else if (pathprog == 614.0 || pathprog == 674.0) {
                ShoulderMotion = 1
            }
            else if (pathprog == 644.0 || pathprog == 704.0) {
                ShoulderMotion = 2
            }
            playframe()
            CheckRobotDamage_S2()
            if ((S2_LEFT_SHOULDER_BROKEN) || (S2_RIGHT_SHOULDER_BROKEN)) {
                changestateif(S2_Rocket_Right, AttackCycle == 1 && pathprog == 629.0)
                if (AttackCycle == 2 && pathprog == 689.0) {
                    AttackCycle += 1
                    changestate(S2_Rocket_Left)
                }
            }
            else {
                changestateif(S2_Rocket_Barrage_Left, AttackCycle == 1 && pathprog == 629.0)
                if (AttackCycle == 2 && pathprog == 689.0) {
                    AttackCycle += 1
                    changestate(S2_Rocket_Barrage_Right)
                }
            }
            if (animframe == 43.0) {
                soundpitch(0x6AC)
                soundplay([sv16A], 1V)
            }
            else if (animframe == 71.0) {
                soundpitch(0x6AC)
                soundplay([sv16A], 1V)
            }
            if (animframe >= 29.0 && animframe <= 43.0 && ShoulderMotion == 1) {
                animframe += 1.0
            }
            else if (animframe >= 30.0 && animframe <= 44.0 && ShoulderMotion == 2) {
                animframe -= 1.0
            }
            if (animframe >= 41.0 && animframe <= 73.0) {
                PartsVulnerable = true
            }
            else {
                PartsVulnerable = false
            }
            pathprog += 1.0
            if (pathprog > 719.0) {
                pathprog = 600.0
            }
        } while (1)
    }
}

sub RegisterDamage_Right_S2(){
    if (!Initializing) {
        RobotDamageFlash()
        parent -> RightDamage += 1
    }
    if (!SparksSpawned && parent -> RightDamage >= 5) {
        SparksSpawned = true
        spawn(NGinC, S_SPARKS, 1, 53.0, 0)
        spawn(NGinC, S_SPARKS, 1, 54.0, 1)
        spawn(NGinC, S_SPARKS, 1, 55.0, 2)
        spawn(NGinC, S_SPARKS, 1, 56.0, 3)
        spawn(NGinC, S_SPARKS, 1, 57.0, 0)
    }
}

sub RegisterDamage_Left_S2(){
    if (!Initializing) {
