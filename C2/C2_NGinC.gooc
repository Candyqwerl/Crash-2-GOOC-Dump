state S2_Setup { // 13
    statusc 0x22
    code() {
        LoadAnimSet(5.0)
        if (AnimLoadState == 9.0) {
            DeloadAnimSet(2.0)
        }
        if (AnimLoadState == 10.0) {
            DeloadAnimSet(3.0)
        }
        DeloadAnimSet(1.0)
        AnimLoadState = 11.0
        LeftDamage = 0
        RightDamage = 0
        changestate(S2_Build)
    }
}

