        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_6, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_5, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_LEFT_BREAK_0, 4, 0, 0, 0, getins(SyncParentFrameT2))
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_LEFT_BREAK_1, 4, 0, 0, getins(SyncShoulderParent), getins(SyncParentFrameT1))
        DetachedShoulderOBJ = objectspawned
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_LEFT_4, 8, 0, 0, getins(SyncShoulderParent), 0)
        DetachedArmOBJ = objectspawned
        if (!(S2_RIGHT_SHOULDER_BROKEN)) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_RIGHT_5, 16, 0, getins(SUB_6947), 0, 0)
        }
        if (!(S2_RIGHT_SHOULDER_BROKEN)) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_RIGHT_4, 8, 0, 0, 0, 0)
        }
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_PAD_RIGHT_5, 0, 0, 0, 0, 0)
        SoundRobotBreak()
        DetachRobotPart(DetachedShoulderOBJ, 8m, 8m, 2m)
        DetachRobotPart(DetachedArmOBJ, 8m, -8m, 0m)
        DebugPhaseID = 18.0
        setanim(ROBOT_MAIN_5, 0)
        FaceForward = 1
        trotx = 90deg
        if (otherbroken) {
            pathprog = 2840.0
            do (var start = frametime) {
                UpdateBossPathPosition()
                playframe()
                animframe += 1.0
            } while (frametime - start < 0.5s)
        }
        else {
            pathprog = 1200.0
        }
        do {
            UpdateBossPathPosition()
            playframe()
            if (animseq == getanim(ROBOT_MAIN_5) && animframe == 33.0) {
                health += 1
                animframe = 69.0
                interrupter = DetachedArmOBJ
                sendevent(EventTriggered, interrupter)
            }
            else if (animseq == getanim(ROBOT_MAIN_5) && animframe >= 0 && animframe <= 127.0) {
                animframe += 1.0
            }
            pathprog += 1.0
        } while ((!otherbroken && pathprog <= 1292.0) || (otherbroken && pathprog <= 2899.0))
        DestroyedParts |= 4
        if (otherbroken) {
            changestate(S4_Setup)
        }
        else {
            changestate(S2_Loop, 600.0)
        }
    }
}

