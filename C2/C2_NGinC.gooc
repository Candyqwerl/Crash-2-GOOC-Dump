state S1_Break_Left { // 10
    statusc 0x20
    trans => state S1_Setup
    code(otherbroken) {
        cascadeevent(Event12, self, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_4, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_3, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_LEFT_3, 4, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 16, ROBOT_HAND_LEFT_2, 12, 0, 0, getins(SyncLeftArmParent), 0)
        DetachedHandOBJ = objectspawned
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_LEFT_2, 8, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_RIGHT_3, 16, 0, 0, 0, 0)
        if (!(S1_RIGHT_ARM_BROKEN)) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_RIGHT_2, 20, 0, 0, 0, 0)
        }
        else {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_RIGHT_2, 20, 0, 0, 0, 0)
        }
        if (!(S1_RIGHT_ARM_BROKEN)) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 16, ROBOT_HAND_RIGHT_2, 24, 0, getins(RegisterDamage_Right_S1), 0, 0)
        }
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_PAD_RIGHT_3, 0, 0, 0, 0, 0)
        if (otherbroken) {
            DebugPhaseID = 6.0
        }
        else {
            DebugPhaseID = 7.0
        }
        setanim(ROBOT_MAIN_3, 0)
        FaceForward = false
        trotx = 90deg

        if (otherbroken) {
            pathprog = 480.0
            setanim(ROBOT_MAIN_3, -1.0)
            do {
                animframe += 1.0
                UpdateBossPathPosition()
                if (animseq == getanim(ROBOT_MAIN_3) && animframe == 1.0) {
                    SoundRobotBreak()
                    DetachRobotPart(DetachedHandOBJ, 8m, -8m, 2m)
                }
                playframe()
            } while (animframe + 1.0 <= 28.0)
        }
        else {
            pathprog = 360.0
            setanim(ROBOT_MAIN_3, -1.0)
            do {
                animframe += 1.0
                UpdateBossPathPosition()
                if (animseq == getanim(ROBOT_MAIN_3) && animframe == 1.0) {
                    SoundRobotBreak()
                    DetachRobotPart(DetachedHandOBJ, 8m, -8m, 2m)
                }
                playframe()
            } while (animframe + 1.0 <= 13.0)
        }

        if (otherbroken) {
            pathprog = 481.0
        }
        else {
            pathprog = 361.0
        }
        do {
            UpdateBossPathPosition()
            playframe()
            animframe += 1.0
            if (animseq == getanim(ROBOT_MAIN_3) && animframe >= 119.0) {
                animframe -= 1.0
            }
            if (animseq == getanim(ROBOT_MAIN_3) && animframe == 29.0) {
                health += 1
                interrupter = DetachedHandOBJ
                sendevent(EventTriggered, interrupter)
            }
            pathprog += 1.0
        } while ((!otherbroken && pathprog < 479.0) || (otherbroken && pathprog <= 569.0))
        DestroyedParts |= 1
        if (AnimLoadState == 8.0) {
            LoadAnimSet(4.0)
            DeloadAnimSet(2.0)
            AnimLoadState = 10.0
        }
        changestateifn(S1_Build, otherbroken, 0.5)
        changestate(S2_Setup)
    }
}

