sub DeloadCurrentAnimSet(){
    if (spawn == S_NGIN_BOSS) {
        if (var set = AnimLoadState; set == 6.0) {
            DeloadAnimSet(0.0)
        }
        else if (set == 7.0) {
            DeloadAnimSet(0.0)
            DeloadAnimSet(1.0)
            DeloadAnimSet(2.0)
            DeloadAnimSet(3.0)
        }
        else if (set == 8.0) {
            DeloadAnimSet(1.0)
            DeloadAnimSet(2.0)
            DeloadAnimSet(3.0)
        }
        else if (set == 9.0) {
            DeloadAnimSet(1.0)
            DeloadAnimSet(2.0)
            DeloadAnimSet(4.0)
        }
        else if (set == 10.0) {
            DeloadAnimSet(1.0)
            DeloadAnimSet(3.0)
            DeloadAnimSet(4.0)
        }
        else if (set == 12.0) {
            DeloadAnimSet(4.0)
        }
        else if (set == 11.0) {
            DeloadAnimSet(4.0)
            DeloadAnimSet(5.0)
        }
    }
}

state Debug_Text { // 0
    stateflag 0x60001
    statusc 0x20
    code(x_pos, y_pos, anim, frame, scax, scay, shadow, framefn, valuefn) {
        SetTrans(x_pos, y_pos, 0)
        SetScale(scax, scay, 0S)
        TextDefaultColor()
        vfx = (vfx & 0xFFFFFF00) | 0x6
        setanim(anim)
        if (shadow) {
            statusb |= FLAG_HAS_SHADOW
        }
        do (var vl, vh) {
            if (valuefn) {
                call(valuefn)
                vh = var0
                vl = field_61
            }
            if (framefn) {
                call(framefn)
                frame = var0
            }
            playframe(frame)
        } while (1)
    }
}

state Robot { // 1
    statusc 0
    __transargs
    code(useverts, zdx, anim, vert, ignorekill, hitfn, posfn, animfn) {
        var v1 = (vert + 1) << 8
        var v2 = (vert + 2) << 8
        var v3 = (vert + 3) << 8
        Initializing = true
        SparksSpawned = 0
        if (hitfn) {
            call(hitfn)
        }
        Initializing = false
        zindex = zdx
        vert <<= 8
        statusb = FLAG_NO_CAMERA_CLIP
        FlashStart = 0
        ColorStart = false
        if (useverts) {
            vfx = (vfx & 0xFF00FF00) | 0x5000A
            moda = 4.0
            SetColor2(-0x6D2, -0x6D7, 0xCC1)
            SetColor1(0x80, 0x80, 0x80)
        }
        setanim(anim)
        do {
            var0 = false
            if (posfn) {
                call(posfn)
            }
            else {
                x = parent -> x
                y = parent -> y
                z = parent -> z
            }
            if (animfn) {
                call(animfn)
            }
            else {
                animframe = parent -> animframe
            }
            if (FlashStart && frametime - FlashStart >= 4) {
                FlashStart = 0
                if (useverts) {
                    vfx = (vfx & 0xFF00FFFF) | 0x50000
                    moda = 4.0
                    SetColor2(-0x6D2, -0x6D7, 0xCC1)
                    SetColor1(0x80, 0x80, 0x80)
                }
                else {
                    SetColor1(0x80, 0x80, 0x80)
                    moda = 0
                }
            }
            if (useverts) {
                if (!var0) {
                    miscfunc(null, player, 21, 12)
                    var0 = true
                }
                if (ColorStart && frametime - ColorStart < 5) {
                    colr1 += ColorStepR
                    colg1 += ColorStepG
                    colb1 += ColorStepB
                    if (frametime - ColorStart >= 4) {
                        if (ColorStepR == 6) {
                            SetColor1(0x9E, 0xFF, 0x40)
                        }
                        else {
                            SetColor1(0x80, 0x80, 0x80)
                        }
                        ColorStart = 0
                    }
                }
                var old_rotx = rotx
                var old_roty = roty
                var old_rotz = rotz
                getvert(vtrot, self, v1)
                getvert(vvec, self, v2)
                getvert(vvel, self, v3)
                getvert(vrot, self, vert)
                trotx -= rotx
                vecx -= rotx
                velx -= rotx
                troty -= roty
                vecy -= roty
                vely -= roty
                trotz -= rotz
                vecz -= rotz
                velz -= rotz
                rotx = old_rotx
                roty = old_roty
                rotz = old_rotz
            }
            playframe()
        } while (1)
    }
    event(e, a) {
        if (e == EventHit) {
            accev()
            if (hitfn && parent -> PartsVulnerable) {
                call(hitfn)
            }
            else {
                sendevent(Event53, interrupter)
            }
        }
        if (e == EventExplode) {
            accev()
            setanim(a[0])
        }
        if (e == EventTriggered) {
            accev()
            statusb |= FLAG_INVISIBLE
        }
        if (e == Event53) {
            accev()
            if (useverts) {
                ColorStart = frametime
                ColorStepR = 6
                ColorStepG = 25
                ColorStepB = -13
            }
        }
        if (e == Event51) {
            accev()
            if (useverts) {
                ColorStart = frametime
                ColorStepR = -6
                ColorStepG = -25
                ColorStepB = 13
            }
        }
        if (e == Event12) {
            unless(ignorekill) {
                accevcstate(Kill)
            }
        }
    }
    trans {
        roty = parent -> roty
        if (stateflag & 0x100) {
            x = spd(x, DetachVelX)
            y = spd(y, DetachVelY)
            z = spd(z, DetachVelZ)
        }
    }
}

sub RobotDamageFlash(){
    FlashStart = frametime
    vfx &= 0xFF00FFFF
    SetColor1(0xFF, 0xFF, 0xFF)
    moda = 16.0
    sendevent(EventTriggered, interrupter)
}

state Boss_Intro { // 2
    statusc 0x22
    code() {
        AnimLoadState = -1
        GLOBAL_3 = -1
        health = 0
        spawn(BosBC, BosBC_S_HEALTH, 1, 5.0, 1)
        DebugPhaseID = 0
        if (DEBUG) {
            spawn(NGinC, S_DEBUG_TEXT, 1, -0xE000, 0x7DA1, TEXT, 0, 0xA3, 0x103, 0x100, getins(DebugR2), getins(DebugR1))
        }
        statusb |= (FLAG_ROT_Y | FLAG_INVISIBLE)
        DestroyedParts = 0
        FaceForward = 1
        trotx = 90deg
        if (RESPAWNCOUNT == 0) {
            AnimLoadState = 6.0
            LoadAnimSet(0.0)
            if (var lang = GLOBAL_151; lang == LANG_FR) {
                spawn(9, 44, 1, [Ni0FO], [Ni1FO], 2.0, 1000s, 4.0)
                IntroVoiceOBJ = objectspawned
            }
            else if (lang == LANG_DE) {
                spawn(9, 44, 1, [Ni0GO], [Ni1GO], 2.0, 1000s, 4.0)
                IntroVoiceOBJ = objectspawned
            }
            else if (lang == LANG_ES) {
                spawn(9, 44, 1, [Ni0SO], [Ni1SO], 2.0, 1000s, 4.0)
                IntroVoiceOBJ = objectspawned
            }
            else if (lang == LANG_IT) {
                spawn(9, 44, 1, [Ni0IO], [Ni1IO], 2.0, 1000s, 4.0)
                IntroVoiceOBJ = objectspawned
            }
            else {
                spawn(9, 44, 1, [Ni0EO], [Ni1EO], 2.0, 1000s, 4.0)
                IntroVoiceOBJ = objectspawned
            }
            spawn(NGinC, S_NGIN_ROBOT, 1, 0, 110, NGIN_BOSS_0, 0, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_MAIN_0, 0, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_SHOULDER_LEFT_0, 4, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_ARM_LEFT_0, 8, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_HAND_LEFT_0, 12, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_SHOULDER_RIGHT_0, 16, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_ARM_RIGHT_0, 20, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_HAND_RIGHT_0, 24, 0, 0, 0, 0)
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 110, ROBOT_SHOULDER_PAD_RIGHT_0, 0, 0, 0, 0, 0)
            setanim(ROBOT_MAIN_0)
            pathprog = 2400.0
            do (var i = 0) {
                pathprog += 1.0
                calcpath(pathprog)
                playframe(0)
                i += 1.0
            } while (i < 120.0)
            interrupter = IntroVoiceOBJ
            sendevent(EventTriggered, interrupter)
            do (var i = 0) {
                if (i >= 60.0 && AnimLoadState == 6.0) {
                    LoadAnimSet(1.0)
                    LoadAnimSet(2.0)
                    LoadAnimSet(3.0)
                    AnimLoadState = 7.0
                }
                pathprog += 1.0
                if (pathprog >= pathlen) {
                    pathprog = pathlen - 1
                }
                calcpath(pathprog)
                animframe += 1.0
                if (animframe >= 176.0) {
                    animframe -= 1.0
                }
                playframe()
                i += 1.0
            } while (i < 240.0)
            interrupter = objectget(OBJ_PLAT_L)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_M)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_R)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_M)
            spawn(NGinC, S_PLATFORM_INTRO, 1)
            child = objectspawned
            child -> x = interrupter -> x
            child -> y = interrupter -> y
            child -> z = interrupter -> z
        }
        else {
            ins72(0, 0x8000)
        }
        changestate(S1_Setup)
    }
    event(e, a) {
        if (e == Event67) {
            interrupter = objectget(OBJ_PLAT_L)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_M)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_R)
            sendevent(Event53, interrupter)
            accevcstate(S1_Setup)
        }
    }
    trans {
        once {
            IntroPhase = 0
        }
        if (pathprog >= 2490.0 && IntroPhase < 1) {
            IntroPhase += 1
            interrupter = objectget(OBJ_PLAT_L)
            sendevent(EventTriggered, interrupter)
            interrupter = objectget(OBJ_PLAT_M)
            sendevent(EventTriggered, interrupter)
            interrupter = objectget(OBJ_PLAT_R)
            sendevent(EventTriggered, interrupter)
        }
        if (pathprog >= 2700.0 && IntroPhase < 2) {
            IntroPhase += 1
            interrupter = objectget(OBJ_PLAT_L)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_M)
            sendevent(Event53, interrupter)
            interrupter = objectget(OBJ_PLAT_R)
            sendevent(Event53, interrupter)
        }
    }
}

sub DebugR1(){
    var0 = parent -> pathprog >> 8
    field_61 = parent -> pathprog & 0xFF
}

sub DebugR2(){
    var0 = parent -> DebugPhaseID
}

sub FacePlayer(){
    if (!FaceForward) {
        troty = atan2(player -> trans)
    }
    else {
        troty = 0deg
    }
}

state S1_Setup { // 3
    statusc 0x22
    code() {
        cascadeevent(Event12, self, 0)
        playnull()
        unless(AnimLoadState == 8.0 || AnimLoadState == 7.0) {
            LoadAnimSet(1.0)
            LoadAnimSet(2.0)
            LoadAnimSet(3.0)
        }
        if (AnimLoadState == 6.0 || AnimLoadState == 7.0) {
            DeloadAnimSet(0.0)
        }
        AnimLoadState = 8.0
        LeftDamage = 0
        RightDamage = 0
        calcpath(1.0, vvec)
        BossBaseY = vecy
        playnull(0.85s)
        playnull(0.85s)
        playnull(0.85s)
        if (GLOBAL_105 == 2 || GLOBAL_105 == 1) {
            playnull(0.85s)
            playnull(0.85s)
        }
        changestate(S1_Intro)
    }
    trans {
        FacePlayer()
    }
}

state S1_Intro { // 4
    statusc 0x22
    code() {
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_1, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_1, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_LEFT_1, 4, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_LEFT_1, 8, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, ROBOT_ARM_RIGHT_4, 0, 0, 0, 0, getins(VulnerablePartFlashRed))
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 16, ROBOT_HAND_LEFT_1, 12, 0, getins(RegisterDamage_Left_S1), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_RIGHT_1, 16, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_RIGHT_1, 20, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, ROBOT_HAND_RIGHT_4, 0, 0, 0, 0, getins(VulnerablePartFlashRed))
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 16, ROBOT_HAND_RIGHT_1, 24, 0, getins(RegisterDamage_Right_S1), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_PAD_RIGHT_1, 0, 0, 0, 0, 0)
        pathprog = 2770.0
        DebugPhaseID = 1.0
        setanim(ROBOT_MAIN_1)
        FaceForward = 1
        trotx = 90deg
        PartsVulnerable = false
        animframe = 0
        while (pathprog <= 2839.0) {
            UpdateBossPathPosition()
            playframe()
            pathprog += 1.0
        }
        changestate(S1_Build, 0.5)
    }
}

