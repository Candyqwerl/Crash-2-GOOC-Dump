state S4_Hide { // 26
    statusc 0x20
    trans => state S1_Setup
    code() {
        PartsVulnerable = true
        PlatformSequence += 1
        if (PlatformSequence > 9) {
            PlatformSequence = 1
        }
        if (PlatformSequence == 1 || PlatformSequence == 4 || PlatformSequence == 7) {
            playframe(animframe, 0.85s)
            playframe(animframe, 0.85s)
            RestorePlatforms()
            playframe(animframe, 1.25s)
        }
        if (PlatformSequence == 1) {
            changestate(S4_Middle)
        }
        else if (PlatformSequence == 2) {
            changestate(S4_Right)
        }
        else if (PlatformSequence == 3) {
            changestate(S4_Left)
        }
        else if (PlatformSequence == 4) {
            changestate(S4_Left)
        }
        else if (PlatformSequence == 5) {
            changestate(S4_Middle)
        }
        else if (PlatformSequence == 6) {
            changestate(S4_Right)
        }
        else if (PlatformSequence == 7) {
            changestate(S4_Right)
        }
        else if (PlatformSequence == 8) {
            changestate(S4_Left)
        }
        changestateif(S4_Middle, PlatformSequence == 9)
    }
}

state S4_Left { // 27
    statusc 0
    code() {
        DebugPhaseID = 21.0
        changestate(S4_Fire, 2340.0, 2398.0, objectget(OBJ_PLAT_L))
    }
}

state S4_Middle { // 28
    statusc 0
    code() {
        DebugPhaseID = 22.0
        changestate(S4_Fire, 2220.0, 2278.0, objectget(OBJ_PLAT_M))
    }
}

state S4_Right { // 29
    statusc 0
    code() {
        DebugPhaseID = 23.0
        changestate(S4_Fire, 2280.0, 2338.0, objectget(OBJ_PLAT_R))
    }
}

state S4_Fire { // 30
    statusc 0x20
    trans => state S1_Setup
    code(startpoint, endpoint, platform_id) {
        setanim(ANIM_0xCC00)
        FaceForward = 1
        trotx = 90deg
        pathprog = startpoint
        animframe = 0
        spawn(NGinC, S_LAZER_GREEN, 1, platform_id, 0)
        child = objectspawned
        do {
            UpdateBossPathPosition()
            playframe()
            if (CoreDamage >= 5 && animframe < 59.0) {
                sendevent(Event12, child, 0)
                changestate(Boss_Death)
            }
            if (animframe == 60.0) {
                interrupter = NGinModelOBJ
                sendevent(EventExplode, interrupter, -40.0)
            }
            if (animframe == 55.0) {
                cascadeevent(Event53, self)
            }
            animframe += 1.0
            pathprog += 1.0
        } while (pathprog <= endpoint)
        do {
            UpdateBossPathPosition()
            playframe()
            animframe += 1.0
        } while (animframe != 99.0)
        interrupter = NGinModelOBJ
        sendevent(EventExplode, interrupter, 9.0)
        cascadeevent(Event51, self)
        do {
            UpdateBossPathPosition()
            playframe()
            if (pathprog == startpoint + 24.0) {
                soundpitch((4.8 + rand(3.2)) * 0.203 >> 8)
                sounddecay(7.7s)
                soundplay([jmp0A], 3V)
            }
            if (animframe != 129.0) {
                animframe += 1.0
            }
            pathprog -= 1.0
        } while (pathprog >= startpoint)
        changestate(S4_Hide)
    }
}

state Boss_Death { // 31
    statusc 0x20
    code() {
        spawn(NGinC, S_OUTRO_VOICE, 1)
        DebugPhaseID = 24.0
        cascadeevent(Event12, self, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_7, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ANIM_0xCF00, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ANIM_0xC300, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ANIM_0xC900, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_9, 0, 0, 0, 0, 0)
        calcpath(0, vvec)
        save(vfx) {
            vfx = (vfx & 0xFFFFFF00) | 0x6
            soundpitch(0x343)
            sounddecay(7.7s)
            soundplay([NRE9A], 10V)
        }
        setanim(NGIN_BOSS_7)
        do (var s_x = x, s_y = y, s_z = z, t_x = vecx, t_y = vecy, t_z = vecz, f = 1.0) {
            x = s_x + ((t_x - s_x) * (f >> 8)) / 30
            y = s_y + ((t_y - s_y) * (f >> 8)) / 30
            z = s_z + ((t_z - s_z) * (f >> 8)) / 30
            playframe(f - 1.0)
            f += 1.0
        } while (f < 30.0)
        DebugPhaseID = 25.0
        cascadeevent(Event12, self, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 1.0, NGIN_BOSS_11, 0, 0, getins(SpawnExplosionT2), getins(SyncNGinBoss), getins(ShrinkNGinBoss))
        NGinModelOBJ = objectspawned
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_0, 0, 0, getins(SpawnExplosionT1), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_1, 4, 0, getins(SpawnExplosionT2), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_2, 8, 0, getins(SpawnExplosionT1), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_3, 12, 0, getins(SpawnExplosionT2), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_4, 16, 0, getins(SpawnExplosionT1), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_5, 20, 0, getins(SpawnExplosionT2), 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_BREAK_6, 24, 0, getins(SpawnExplosionT1), 0, 0)
        DetachRobotPart(NGinModelOBJ, 0m, 0m, -1m)
        playframes(ROBOT_MAIN_BREAK_0, 0.0, 29.0)
        cascadeevent(Event12, self, 0)
        health += 1
        sendevent(EventWarp, player, 0)
        DeloadCurrentAnimSet()
        AnimLoadState = -1
        sleepnull()
    }
}

sub SpawnExplosionT1(){
    if (Initializing) {
        save(x, y, z) {
            x += randi(-6m, 6m)
            y += randi(-6m, 6m)
            z += randi(-6m, 6m)
            spawn(9, 4, 1, 0, 4)
            child = objectspawned
        }
    }
}

sub ShrinkNGinBoss(){
    if (scalex > 0S) {
        scalex -= 5
        scaley -= 5
        scalez -= 5
    }
    animframe = (animframe + 1.0) % 20.0
}

sub SyncNGinBoss(){
    x = parent -> x
    y = parent -> y + 2.5m
}

sub SpawnExplosionT2(){
    if (Initializing) {
        save(x, y, z) {
            x += randi(-6m, 6m)
            y += randi(-6m, 6m)
            z += randi(-6m, 6m)
            spawn(9, 40, 1, 0, 4)
            child = objectspawned
        }
    }
}

sub SetPlatformAnim(){
    if (spawn == S_PLATFORM_L) {
        setanim(PLATFORM_RIGHT)
    }
    else if (spawn == S_PLATFORM_M) {
        setanim(PLATFORM_MIDDLE)
    }
    else if (spawn == S_PLATFORM_R) {
        setanim(PLATFORM_LEFT)
    }
    else if (spawn == S_PLATFORM_INTRO) {
        setanim(PLATFORM_INTRO)
    }
    animframe = 0
}

sub RestorePlatforms(){
    interrupter = objectget(OBJ_PLAT_L)
    sendevent(Event14, interrupter, 0)
    interrupter = objectget(OBJ_PLAT_M)
    sendevent(Event14, interrupter, 0)
    interrupter = objectget(OBJ_PLAT_R)
    sendevent(Event14, interrupter, 0)
}

state Platform { // 32
    statusc 0x20
    code() {
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        SetPlatformAnim()
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_TOP | FLAG_NO_CAMERA_CLIP
        sleep()
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            statusb |= FLAG_INVISIBLE
        }
        if (e == Event53) {
            statusb &= ~FLAG_INVISIBLE
        }
        accevcstate(Platform_Break, e == Event30)
    }
}

state Platform_Break { // 33
    statusc 0
    code() {
        vecx = false
        playframes(PLATFORM_BREAK, 0.0, 39.0)
        statusb |= FLAG_INVISIBLE
        var0 = frametime
        do {
            playframe()
        } until(vecx || frametime - var0 >= 7.1s)
        statusb &= ~FLAG_INVISIBLE
        SetPlatformAnim()
        vecy = y
        y -= 15m
        do {
            playframe()
            y += 0.5m
        } until(vecy == y)
        changestate(Platform)
    }
    event(e, a) {
        if (e == Event14) {
            accev()
            vecx = true
        }
    }
}

state Fruit_Projectile { // 34
    code(vert) {
        creator = objectget(OBJ_NGIN)
        SetRot(0deg)
        statusb = FLAG_PHYSICS_ENGINE
        getvert(vtrans, player, vert)
        if (GLOBAL_3 == -1) {
            var0 = 0
        }
        else {
            var0 = (creator -> y - creator -> BossBaseY) >> 2
        }
        y = player -> y + 1.5m + var0
        SetRot(0deg, 0deg, rand(360deg))
        velx = 0
        if (GLOBAL_3 == -1) {
            vely = 0m
        }
        else {
            vely = GLOBAL_3
        }
        velz = -45m
        setanim(FRUIT_PROJECTILE, rand(32.0))
        do {
            if (z < creator -> z + 5m && z > creator -> z - 2m) {
                broadcastevent(EventHit, 4, 1)
            }
            animframe = (animframe + 1.0) & 0x1FFF
            playframe()
        } while (frametime - statetime < 3s)
    }
    event(e, a) {
        accevcstate(Fruit_Projectile_Hit, e == EventTriggered)
        accevcstate(Fruit_Projectile_Miss, e == Event53)
    }
}

state Fruit_Projectile_Miss { // 35
    code() {
        soundpitch(2.903)
        soundplay([NBB9A], 2.5V)
        zindex = 64
        statusb = FLAG_SOLID_GROUND | FLAG_PHYSICS_ENGINE | FLAG_GRAVITY
        SetVel(randi(-0.5m, 0.5m), 0m, 0.2m + rand(0.2m))
        groundy = player -> y - 10m
        do {
            animframe = (animframe + 1.0) % 32.0
            playframe()
        } until(STATUS_GROUNDLAND)
    }
}

state Fruit_Projectile_Hit { // 36
    code() {
        soundpitch(2.903)
        soundplay([NBH9A], 2.5V)
        SetScale(4S)
        zindex = 84
        statusb &= ~FLAG_PHYSICS_ENGINE
        playanim(0, FRUIT_PROJECTILE_HIT_0)
        playanim(1, FRUIT_PROJECTILE_HIT_0)
        playanim(2, FRUIT_PROJECTILE_HIT_0)
        playanim(3, FRUIT_PROJECTILE_HIT_0)
        playanim(4, FRUIT_PROJECTILE_HIT_0)
        playanim(5, FRUIT_PROJECTILE_HIT_0)
        playanim(6, FRUIT_PROJECTILE_HIT_0)
        playanim(7, FRUIT_PROJECTILE_HIT_0)
        playanim(0, FRUIT_PROJECTILE_HIT_1)
        playanim(1, FRUIT_PROJECTILE_HIT_1)
        playanim(2, FRUIT_PROJECTILE_HIT_1)
        playanim(3, FRUIT_PROJECTILE_HIT_1)
        playanim(4, FRUIT_PROJECTILE_HIT_1)
        playanim(5, FRUIT_PROJECTILE_HIT_1)
        playanim(6, FRUIT_PROJECTILE_HIT_1)
        playanim(7, FRUIT_PROJECTILE_HIT_1)
    }
}

state None { // 37
    code() { }
}

state Lazer_Spawner { // 38
    __transargs
    code(vert) {
        SetRot(0deg)
        var0 = false
        vfx = (vfx & 0xFF00FFFF) | 0x10000
        vecx = x
        velx = x
        vecy = y
        vely = y
        vecz = z
        velz = z
        spawn(NGinC, S_LAZER_RED, 1, LAZER_RED_0, 24, 1.0, getins(SyncLazerAnimT4))
        spawn(NGinC, S_LAZER_RED, 1, LAZER_RED_1, 0, 0, getins(SyncLazerAnimT3))
        spawn(NGinC, S_LAZER_RED, 1, LAZER_RED_1, 0, 0, getins(SyncLazerAnimT2))
        spawn(NGinC, S_LAZER_RED, 1, LAZER_RED_2, 0, 0, getins(SyncLazerAnimT1))
        spawn(NGinC, S_LAZER_RED, 1, LAZER_RED_2, 0, 0, getins(SyncLazerAnimT0))
        child = objectspawned
        WaitChildNull()
    }
    event(e, a) {
        if (e == Event12) {
            accev()
            var0 = true
        }
    }
    trans {
        velx = vecx
        vecx = x
        vely = vecy
        vecy = y
        velz = vecz
        vecz = z
        getvert(vtrans, parent, vert)
    }
}

sub SyncLazerAnimT0(){
    x = parent -> velx
    y = parent -> vely
    z = parent -> velz
}

sub SyncLazerAnimT1(){
    x = parent -> vecx + parent -> velx >> 1
    y = parent -> vecy + parent -> vely >> 1
    z = parent -> vecz + parent -> velz >> 1
}

sub SyncLazerAnimT2(){
    x = parent -> vecx
    y = parent -> vecy
    z = parent -> vecz
}

sub SyncLazerAnimT3(){
    x = parent -> x + parent -> vecx >> 1
    y = parent -> y + parent -> vecy >> 1
    z = parent -> z + parent -> vecz >> 1
}

sub SyncLazerAnimT4(){
    x = parent -> x
    y = parent -> y
    z = parent -> z
}

state Lazer_Red { // 39
    statusc 0
    trans => sub LazerRedTrans
    __transargs
    code(anim, zdx, burn, posfn) {
        if (burn) {
            soundpitch(4.353)
            sounddecay(7.7s)
            soundplay([RRSEA], 2.5V)
            settrans(LazerGreenTrans)
        }
        else {
            settrans(LazerRedTrans)
        }
        zindex = zdx
        vfx = (vfx & 0xFF00FFFF) | 0x10000
        playframes(anim, 0.0, 4.0)
        do {
            playframes(5.0, 8.0)
        } until(var0)
        if (burn) {
            soundfadet(0.18s, voice)
            soundfadev(0V, voice, 3)
        }
        playframes(9.0, 13.0)
    }
}

sub LazerRedTrans(anim, zdx, burn, posfn) __trans {
    var0 = parent -> var0
    call(posfn)
}

sub LazerGreenTrans(anim, zdx, burn, posfn) __trans {
    var0 = parent -> var0
    call(posfn)
    sendeventif(EventBurn, player, player -> x >= x - 0.5m && player -> x <= x + 0.5m && y <= player -> y + 1.5m && y >= player -> y, 100.0)
}

state Rocket_Spawner { // 40
    statusc 0
    code() {
        SetRot(0deg)
        trotx = 360deg
        yzapproach = 180deg
        statusb = FLAG_INVISIBLE
        sleepnull()
    }
    event(e, a) {
        if (e == EventTriggerRocket) {
            vecx = a[0]
            vecy = a[1.0]
            accevcstate(Rocket)
        }
    }
}

state Rocket { // 41
    statusc 0
    code() {
        statusb = FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | FLAG_COLLIDABLE | 0x800 | 0x2000
        setanim(ROCKET, 0)
        child = 0
        soundpitch(0x343)
        soundplay([JstTA], 0V)
        soundfadet(0.1s, voice)
        soundfadev(2V, voice, 2)
        pathprog = 0
        do {
            calcpath(pathprog)
            if (vecx >= 0 && pathprog >= vecx) {
                soundsetup(0, voice, 0, 15)
                changestate(Rocket_Spawner)
            }
            if (vecy && pathprog >= 40.0) {
                vecy = 0
                spawn(NGinC, S_ROCKET_SHADOW, 1, x, 0, z)
                child = objectspawned
            }
            animframe = (animframe + 1.0) % 9.0
            playframe()
            pathprog += 0.5
        } while (pathprog <= pathlen - 1.0)
        soundsetup(0, voice, 0, 15)
        sendevent(Event12, child, 0)
        spawn(NGinC, S_ROCKET_EXPLOSION, 1)
        child = objectspawned
        WaitChildNull()
        changestate(Rocket_Spawner)
    }
    trans {
        sendevent(EventBurn, collider, 100.0)
    }
}

state Rocket_Explosion { // 42
    statusc 0
    code() {
        soundpitch(0x3A0)
        soundplay([tnt0A], 1.28V)
        soundsetup(0, voice, 5)
        SetScale(2S)
        if (!rand(2)) {
            scalex = -scalex
        }
        setanim(EXPLOSION_SMOKE)
        zindex = 50
        SetRot(0deg, 0deg, rand(360deg))
        animframe = rand(3)
        do {
            playframe()
            animframe += 1.0
            sendeventif(EventBurn, player, player -> x > x - 1.35m && player -> x < x + 1.35m, 100.0)
        } while (animframe < 15.0)
    }
}

state Rocket_Shadow { // 43
    statusc 0
    __transargs
    code(x_pos, y_pos, z_pos) {
        SetTrans(x_pos, y_pos, z_pos)
        SetRot(0deg)
        zindex = 32
        sleepanim(0, ROCKET_SHADOW)
    }
    trans {
        var0 = 2S - (3.75S - parent -> pathprog)
        SetScale(var0)
    }
}

state Lazer_Green { // 44
    code(platform_id, frame) {
        SetRot(0deg)
        zindex = 128
        setanim(LAZER_GREEN, frame - 1.0)
        do {
            animframe += 1.0
            x = parent -> x
            y = parent -> y
            z = parent -> z
            if (animframe == 24.0) {
                soundpitch((4.8 + rand(3.2)) * 0.205 >> 8)
                sounddecay(7.7s)
                soundplay([jmp0A], 3V)
            }
            if (animframe == 39.0) {
                soundpitch(2.903)
                sounddecay(7.7s)
                soundplay([NLS9A], 3V)
            }
            sendeventif(EventBurn, player, (animframe >= 60.0 && animframe <= 99.0) && player -> x > x - 1.75m && player -> x < x + 1.75m, 100.0)
            if (animframe == 60.0) {
                interrupter = platform_id
                sendevent(EventExplode, interrupter, 100.0)
            }
            playframe()
        } while (animframe + 1.0 <= 99.0)
    }
}

state Electricity_Sparks { // 45
    statusc 0
    __transargs
    code(vert, t) {
        getvert(vtrans, creator, vert)
        vecx = false
        SetScale(1.5S, 0.75S, 0.75S)
        zindex = 0x100
        do {
            if (!rand(5)) {
                statusb = FLAG_INVISIBLE
                playanim(0, ELECTRICITY_SPARKS, 2)
                sounddecay(7.7s)
                soundpitch((12.8 + rand(6.4)) * 0.43 >> 8)
                if (!rand(2)) {
                    soundplay([sp23A], 2.5V + rand(0.4V))
                }
                else {
                    soundplay([sp13A], 2.5V + rand(0.4V))
                }
            }
            statusb = 0
            rotz = rand(360deg)
            playframes(ELECTRICITY_SPARKS, 0.0, 8.0)
        } while (!vecx)
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            vecx = true
        }
    }
    trans {
        if (t == ((frametime - statetime) & 3)) {
            getvert(vtrans, creator, vert)
            SparkOffsetX = parent -> x - x
            SparkOffsetY = parent -> y - y
            SparkOffsetZ = parent -> z - z
        }
        else {
            x = parent -> x - SparkOffsetX
            y = parent -> y - SparkOffsetY
            z = parent -> z - SparkOffsetZ
        }
    }
}

state Kill { // 46
    stateflag 0x20
    statusc 0
    code() { }
}

state Outro_Voice { // 47
    statusc 0x20
    code() {
        movetolist(3.0)
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            spawn(9, 44, 1, [NI0FO], [NI1FO], 2.0, 4s, 4.0)
        }
        else if (lang == LANG_DE) {
            spawn(9, 44, 1, [NI0GO], [NI1GO], 2.0, 4s, 4.0)
        }
        else if (lang == LANG_ES) {
            spawn(9, 44, 1, [NI0SO], [NI1SO], 2.0, 4s, 4.0)
        }
        else if (lang == LANG_IT) {
            spawn(9, 44, 1, [NI0IO], [NI1IO], 2.0, 4s, 4.0)
        }
        else {
            spawn(9, 44, 1, [NI0EO], [NI1EO], 2.0, 4s, 4.0)
        }
        sleepnull()
    }
}