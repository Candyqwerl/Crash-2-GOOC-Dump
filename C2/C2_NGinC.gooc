state S1_Build { // 6
    statusc 0x22
    code(startpoint) {
        GLOBAL_3 = 0
        AttackCycle = 0
        cascadeevent(Event12, self, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, NGIN_BOSS_1, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_MAIN_1, 0, 0, 0, 0, 0)
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_LEFT_1, 4, 0, 0, 0, 0)
        unless(S1_LEFT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_LEFT_1, 8, 0, 0, 0, 0)
        }
        if (S1_LEFT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_LEFT_0, 8, 0, 0, 0, 0)
        }
        unless(S1_LEFT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, ROBOT_ARM_RIGHT_4, 0, 0, 0, 0, getins(VulnerablePartFlashRed))
        }
        unless(S1_LEFT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 16, ROBOT_HAND_LEFT_1, 12, 0, getins(RegisterDamage_Left_S1), 0, 0)
            LeftHandOBJ = objectspawned
        }
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_RIGHT_1, 16, 0, 0, 0, 0)
        unless(S1_RIGHT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_RIGHT_1, 20, 0, 0, 0, 0)
        }
        if (S1_RIGHT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_ARM_BROKEN_RIGHT_0, 8, 0, 0, 0, 0)
        }
        unless(S1_RIGHT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 0, 0, ROBOT_HAND_RIGHT_4, 0, 0, 0, 0, getins(VulnerablePartFlashRed))
        }
        unless(S1_RIGHT_ARM_BROKEN) {
            spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 16, ROBOT_HAND_RIGHT_1, 24, 0, getins(RegisterDamage_Right_S1), 0, 0)
            RightHandOBJ = objectspawned
        }
        spawn(NGinC, S_NGIN_ROBOT, 1, 1.0, 0, ROBOT_SHOULDER_PAD_RIGHT_1, 0, 0, 0, 0, 0)
        changestate(S1_Loop, startpoint)
    }
}

sub RegisterDamage_Right_S1(){
    if (!Initializing) {
        RobotDamageFlash()
        parent -> RightDamage += 1
    }
    if (!SparksSpawned && parent -> RightDamage >= 10) {
        SparksSpawned = true
        spawn(NGinC, S_SPARKS, 1, 40.0, 0)
        spawn(NGinC, S_SPARKS, 1, 41.0, 1)
        spawn(NGinC, S_SPARKS, 1, 42.0, 2)
        spawn(NGinC, S_SPARKS, 1, 43.0, 3)
        spawn(NGinC, S_SPARKS, 1, 44.0, 0)
        spawn(NGinC, S_SPARKS, 1, 45.0, 1)
        spawn(NGinC, S_SPARKS, 1, 46.0, 2)
        spawn(NGinC, S_SPARKS, 1, 47.0, 3)
    }
}

sub RegisterDamage_Left_S1(){
    if (!Initializing) {
        RobotDamageFlash()
        parent -> LeftDamage += 1
    }
    if (!SparksSpawned && parent -> LeftDamage >= 10) {
        SparksSpawned = true
        spawn(NGinC, S_SPARKS, 1, 32.0, 0)
        spawn(NGinC, S_SPARKS, 1, 33.0, 1)
        spawn(NGinC, S_SPARKS, 1, 34.0, 2)
        spawn(NGinC, S_SPARKS, 1, 35.0, 3)
        spawn(NGinC, S_SPARKS, 1, 36.0, 0)
        spawn(NGinC, S_SPARKS, 1, 37.0, 1)
        spawn(NGinC, S_SPARKS, 1, 38.0, 2)
        spawn(NGinC, S_SPARKS, 1, 39.0, 3)
    }
}

sub VulnerablePartFlashRed(){
    animframe = parent -> animframe
    SetColor1(0xFF, 0x00, 0x00)
    if (parent -> PartsVulnerable) {
        moda = time(0.2s) << 8 >> 2 << 4
    }
    else {
        moda = 0
    }
}

state S1_Loop { // 7
    statusc 0x20
    trans => state S1_Setup
    code(startpoint) {
        pathprog = startpoint
        DebugPhaseID = 3.0
        setanim(ROBOT_MAIN_1, 0)
        FaceForward = false
        trotx = 90deg
        PartsVulnerable = false
        do {
            UpdateBossPathPosition()
            if (pathprog == 1.0) {
                AttackCycle += 1
                if (AttackCycle > 2) {
                    AttackCycle = 0
                }
            }
            else if (pathprog == 13.5 || pathprog == 38.5 || pathprog == 73.5 || pathprog == 98.5) {
                animframe = 1.0
            }
            else if (pathprog == 25.5 || pathprog == 51.5 || pathprog == 85.5 || pathprog == 111.5) {
                animframe = 15.0
            }
            playframe()
            if (pathprog == 0.5 || pathprog == 60.0 || pathprog == 120.0) {
                changestateif(S1_Break_Both, LeftDamage >= 10 && RightDamage >= 10 && !(S1_LEFT_ARM_BROKEN) && !(S1_RIGHT_ARM_BROKEN))
                if (!(S1_LEFT_ARM_BROKEN) && LeftDamage >= 10) {
                    RightDamage >>= 1
                    changestate(S1_Break_Left, S1_RIGHT_ARM_BROKEN)
                }
                if (!(S1_RIGHT_ARM_BROKEN) && RightDamage >= 10) {
                    LeftDamage >>= 1
                    changestate(S1_Break_Right, S1_LEFT_ARM_BROKEN)
                }
                if (S1_RIGHT_ARM_BROKEN) {
                    if (AttackCycle > 0) {
                        changestateif(S1_Fire_Left, pathprog == 120.0)
                    }
                }
                else if (S1_LEFT_ARM_BROKEN) {
                    if (AttackCycle > 0 && pathprog == 60.0) {
                        AttackCycle = 0
                        changestate(S1_Fire_Right)
                    }
                }
                else {
                    changestateif(S1_Fire_Left, AttackCycle == 1 && !(S1_LEFT_ARM_BROKEN) && pathprog == 120.0)
                    if (AttackCycle == 2 && !(S1_RIGHT_ARM_BROKEN) && pathprog == 60.0) {
                        AttackCycle = 1
                        changestate(S1_Fire_Right)
                    }
                }
            }
            if (animframe == 6.0) {
                soundpitch(0x6AC)
                soundplay([sv16A], 1V)
            }
            else if (animframe == 20.0) {
                soundpitch(0x6AC)
                soundplay([sv16A], 1V)
            }
            if ((animframe >= 1.0 && animframe <= 13.0) || (animframe >= 15.0 && animframe <= 27.0)) {
                animframe += 1.0
            }
            else if (animframe >= 28.0 || animframe < 1.0) {
                animframe = 0
            }
            if (animframe >= 1.0 && animframe <= 27.0) {
                PartsVulnerable = true
            }
            else {
                PartsVulnerable = false
            }
            pathprog += 0.5
            if (pathprog > 120.0) {
                pathprog = 0.5
            }
        } while (1)
    }
}

state S1_Fire_Left { // 8
    statusc 0x20
    trans => state S1_Setup
    code() {
        DebugPhaseID = 4.0
        setanim(ROBOT_MAIN_1, 0)
        FaceForward = 1
        trotx = 90deg
        PartsVulnerable = false
        LazerAnimPhase = 0
        pathprog = 120.5
        do {
            UpdateBossPathPosition()
            if (pathprog == 132.5) {
                animframe = 40.0
            }
            if (pathprog == 147.5) {
                spawn(NGinC, S_LAZER_SPAWNER, 1, 30.0)
                child = objectspawned
            }
            sendeventif(Event12, child, pathprog == 187.5, 0)
            playframe()
            if (LazerAnimPhase < 1 && animframe == 114.0) {
                animframe -= 1.0
                LazerAnimPhase = 1.0
            }
            else if (LazerAnimPhase < 1 && animframe >= 40.0 && animframe <= 113.0) {
                animframe += 1.0
            }
            else if (LazerAnimPhase == 1.0 && animframe == 94.0) {
                animframe += 1.0
                LazerAnimPhase = 2.0
            }
            else if (LazerAnimPhase == 1.0) {
                animframe -= 1.0
            }
            else if (LazerAnimPhase == 2.0 && animframe >= 95.0 && animframe <= 142.0) {
                animframe += 1.0
            }
            else if (animframe >= 143.0 || animframe < 1.0) {
                animframe = 0
            }
            if (animframe == 66.0) {
                soundpitch(0xC04)
                soundplay([sv16A], 1V)
            }
            else if (animframe == 114.0) {
                soundpitch(0x602)
                soundplay([sv16A], 1V)
            }
            if (animframe >= 66.0 && animframe <= 122.0) {
                PartsVulnerable = true
            }
            else {
                PartsVulnerable = false
            }
            pathprog += 0.5
        } while (pathprog <= 240.0)
        changestate(S1_Loop, 0.5)
    }
}

