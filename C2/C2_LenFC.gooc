#gool LenFC 37 2

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 2 -r pal "C2\C2_LenFC.gooc" "C2\Out\C2_LenFC.nsentry"

#sprite FLARES [CrtxT]
#tex 0xC0C0C0 0 3 9 5 512 16 16 16
#tex 0x808080 0 3 9 5 512 16 16 16
#tex 0xC0C0C0 1 3 0 4 000 64 64 64
#tex 0x808080 0 3 10 5 768 96 32 32
#tex 0xD0D0D0 0 3 10 5 768 96 32 32
#tex 0xC0C0C0 0 3 11 5 336 8 8 8
#tex 0xC0C0C0 0 3 12 5 528 16 16 16
#tex 0xC0C0C0 0 3 13 5 128 64 64 64
#tex 0xC0C0C0 0 3 14 5 768 32 32 32

#spawn S_FLARE_MASTER  Flare_Master
#spawn S_FLARE_SLAVE   Flare_Slave

var LensVar1, LensVar2, LensVar3, LensVar4, LensVar5, LensVar6, LensVar7, LensVar8,
    LensVar9, LensVar10, FlareAlpha, FlarePitchAngle, FlareYawAngle, FlareScreenAngle, RotateFlare, HasTriggeredWhiteFade

state Flare_Master {
    code() {
        vfx = (vfx & 0xFFFFFF00) | 0x6
        SetScale(0xA3, 0xA2, 0x1000)
        spawn(LenFC, S_FLARE_SLAVE, 1, 1.0, -3.0, 0.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 2.0, -2.0, 1.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 3.0, 2.0, 3.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 4.0, 2.2, 4.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 5.0, 6.0, 5.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 6.0, 8.0, 6.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 7.0, 11.0, 7.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 8.0, 12.0, 8.0)
        spawn(LenFC, S_FLARE_SLAVE, 1, 0.0, 0.0, 2.0)
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            HasTriggeredWhiteFade = 0
        }
        FlareAlpha = 0
        rotx = creator -> rotx
        roty = creator -> roty
        rotz = creator -> rotz
        FlareYawAngle = abs(((rotz << 20) - (CAMROTY << 20)) >> 20)
        FlarePitchAngle = abs((((90deg - rotx) << 20) - ((-CAMROTX) << 20)) >> 20) << 1
        if (FlarePitchAngle > 90deg) {
            FlarePitchAngle = 90deg
        }
        if (FlarePitchAngle < 90deg && FlareYawAngle < 90deg) {
            FlareAlpha = (cos(FlarePitchAngle) * cos(FlareYawAngle)) >> 12
            if (FlareAlpha >= 15.0) {
                var0 = (FlareAlpha - 15.0) >> 1
                if (var0 > 1.0) {
                    var0 = 1.0
                }
                if (var0 < 0) {
                    var0 = 0
                }
                var0 += 32
                GAMEFLAGS |= GFLAG_WHITE_FADE
                FADECONTROL = var0
                HasTriggeredWhiteFade = 1
            }
            else if (HasTriggeredWhiteFade) {
                FADECONTROL = 0
            }
        }
        SetRot(0deg)
        if (FlareAlpha) {
            getvert(vtrans, creator, 0.0)
            moveto2d(null, 0, 0)
            FlareScreenAngle = atan(y, x)
            velx = (((-x) << 1) + (((-x) << 1) >> 2)) / 12
            vely = (((-y) << 1) + (((-y) << 1) >> 2)) / 12
        }
    }
}

state Flare_Slave {
    __transargs
    code(type, offset, frame) {
        do {
            if (!!FlareAlpha) {
                statusb &= ~FLAG_INVISIBLE
            }
            else {
                statusb |= FLAG_INVISIBLE
            }
            playframe(frame)
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            zindex = 4000
            setanim(FLARES)
            vfx = (vfx & 0xFFFFFF00) | 0x6
            RotateFlare = 0
            if (type == 0) {
                scalex = 0x40E
                scaley = 0x40E
            }
            else if (type == 1.0) {
                scalex = 0x103
                scaley = 0x103
                RotateFlare = 1
            }
            else if (type == 2.0) {
                scalex = 0x103
                scaley = 0x103
                RotateFlare = 1
            }
            else if (type == 3.0) {
                scalex = 0x207
                scaley = 0x207
            }
            else if (type == 4.0) {
                scalex = 0x103
                scaley = 0x103
            }
            else if (type == 5.0) {
                scalex = 0x81
                scaley = 0x81
            }
            else if (type == 6.0) {
                scalex = 0x103
                scaley = 0x103
            }
            else if (type == 7.0) {
                scalex = 0x40E
                scaley = 0x40E
            }
            else if (type == 8.0) {
                scalex = 0x207
                scaley = 0x207
            }
        }
        x = creator -> x
        y = creator -> y
        z = creator -> z
        velx = creator -> velx
        vely = creator -> vely
        velz = creator -> velz
        FlareAlpha = creator -> FlareAlpha
        FlareScreenAngle = creator -> FlareScreenAngle
        if (FlareAlpha) {
            x += (velx * offset) >> 8
            y += (vely * offset) >> 8
            if (RotateFlare) {
                rotz = FlareScreenAngle + 45deg
            }
            moda = 16.0 - FlareAlpha
        }
    }
}
