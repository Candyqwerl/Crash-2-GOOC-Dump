state Monty_Hall_Init { // 0
    code(floor) {
        FloorIndex = floor
        GLOBAL_131 = 0
        ResetCheatStep = 0
        UnlockCheatStep = 0
        CutsceneCheatStep = 0
        WarpHasMovedSinceLoadSave = 1
        CameraTarget = 0
        FacingTarget = 0
        PlayerWasWarping = 0
        WarpCutsceneIndex = 0
        DebugCutsceneIndex = 1
        RoomDimmerOBJ = 0
        ProjectorOBJ = 0
        WarpLiftOBJ = objectget(OBJ_WARP_LIFT)
        if (FloorIndex == 0) {
            DoorTable = WarpRoomDoorTable0
        }
        else if (FloorIndex == 1) {
            DoorTable = WarpRoomDoorTable1
        }
        else if (FloorIndex == 2) {
            DoorTable = WarpRoomDoorTable2
        }
        else if (FloorIndex == 3) {
            DoorTable = WarpRoomDoorTable3
        }
        else if (FloorIndex == 4) {
            DoorTable = WarpRoomDoorTable4
        }
        else {
            DoorTable = WarpRoomDoorTable5
        }

        if (FloorIndex == 5) {
            CutsceneOBJ = 0
            WarpActiveAntennaCount = 0
            if ((GLOBAL_150 & 4) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 1)
            }
            if ((GLOBAL_150 & 2) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 2)
            }
            if ((GLOBAL_150 & 1) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 3)
            }
            if ((GLOBAL_150 & 16) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 4)
            }
            if ((GLOBAL_150 & 8) || (GLOBAL_21 & 1)) {
                spawn(CHeOC, S_SECRET_DOOR, 1, 5)
            }
        }
        else {
            spawn(CHeOC, S_CUTSCENE, 1)
            CutsceneOBJ = objectspawned
        }
        spawn(CHeOC, S_PORTAL_FX, 1)
        PortalFXOBJ = objectspawned
        changestate(WarpRoom_Idle)
    }
}

sub UpdateFacingTarget() {
    PlayerAngle = atan(-player -> x, -player -> z) & 0xFFF
    FacingTarget = 0
    if (PlayerAngle < 20.05deg || PlayerAngle >= 340deg) {
        FacingTarget = 1
    }
    else if (PlayerAngle >= 160deg) {
        if (PlayerAngle < 200.05deg) {
            FacingTarget = 4
        }
        else if (PlayerAngle >= 220deg && PlayerAngle < 260.1deg) {
            FacingTarget = 5
        }
        else if (PlayerAngle >= 280deg && PlayerAngle < 320.05deg) {
            FacingTarget = 6
        }
    }
    else {
        if (PlayerAngle >= 40deg && PlayerAngle < 80.1deg) {
            FacingTarget = 2
        }
        else if (PlayerAngle >= 100deg && PlayerAngle < 140.05deg) {
            FacingTarget = 3
        }
    }
    PlayerDistance = distance(player, DIST_NO_Y)
}

sub ApplyCameraFocusTarget() {
    var S3 = 0, S4 = 1, zoom = -1
    var S6 = 0, S7 = 22, target_yaw = 0
    if (var target = var0; target == 1) {
        S7 = 0
        target_yaw = 0deg
        zoom = 7m
    }
    else if (target == 2) {
        target_yaw = 60deg
    }
    else if (target == 3) {
        target_yaw = 120deg
    }
    else if (target == 4) {
        target_yaw = 180deg
    }
    else if (target == 5) {
        target_yaw = 240deg
    }
    else if (target == 6) {
        target_yaw = 300deg
    }
    ins72(0x500, S6)
    ins72(0x600, S3)
}

sub CapturePlayerPosition() {
    rotx = player -> x
    roty = player -> y
    rotz = player -> z
}

sub FilterCameraTarget() {
    if (var0 < 1) {
        var0 = 0
    }
    else if (var0 == 1) {
        if (PlayerDistance < 4.5m) {
            var0 = 0
        }
    }
    else if (PlayerDistance < 2.5m) {
        var0 = 0
    }
}

sub ResolveFacingDoorLevel() {
    var0 -= 2
    if (var0 >= 0) {
        var level = -1
        var min_dist = 80m
        var pointer = 0
        var unlock_masks = 0
        var unlock_mask = 0
        if (var0 < 5) {
            unlock_masks = SecretDoorUnlockMasks
            unlock_mask = unlock_masks[var0 << 8]
        }
        pointer = (var0 << 1) << 8
        level = WarpRoomTable[pointer]
        min_dist = WarpRoomTable[pointer + 1.0]
        if (PlayerDistance < min_dist || (FloorIndex == 5 && !(GLOBAL_21 & 1) && !(GLOBAL_150 & unlock_mask))) {
            level = -1
        }
        var0 = level
    }
    else {
        var0 = -1
    }
}

inline sub CountPoolBits(global) {
    do (var bit = 0) {
        if (global & (1 << bit)) {
            misc += 1
        }
    } while ({ bit += 1 }; bit < 32)
}

sub SetCutsceneIndex() {
    WarpCutsceneIndex = 0
    if (FloorIndex != 5) {
        var gem_count, crystal_count
        misc = 0
        CountPoolBits(SAVEDGEMPOOL1)
        CountPoolBits(SAVEDGEMPOOL2)
        gem_count = misc
        misc = 0
        CountPoolBits(SAVEDCRYSTALPOOL1)
        CountPoolBits(SAVEDCRYSTALPOOL2)
        crystal_count = misc
        if (!(2 & PREVBOXCOUNT)) {
            WarpCutsceneIndex = 1
        }
        else if (!(4 & PREVBOXCOUNT)) {
            if (crystal_count >= 1) {
                WarpCutsceneIndex = 2
            }
            else {
                if (!(0x4000 & PREVBOXCOUNT)) {
                    WarpCutsceneIndex = 14
                }
                else if (!(0x8000 & PREVBOXCOUNT)) {
                    WarpCutsceneIndex = 15
                }
                else if (!(0x10000 & PREVBOXCOUNT)) {
                    WarpCutsceneIndex = 16
                }
            }
        }
        else if (!(8 & PREVBOXCOUNT) && crystal_count >= 3) {
            WarpCutsceneIndex = 3
        }
        else if (!(16 & PREVBOXCOUNT) && crystal_count >= 5) {
            WarpCutsceneIndex = 4
        }
        else if (!(32 & PREVBOXCOUNT) && 64 & GLOBAL_27) {
            WarpCutsceneIndex = 5
        }
        else if (!(64 & PREVBOXCOUNT) && crystal_count >= 10) {
            WarpCutsceneIndex = 6
        }
        else if (!(0x80 & PREVBOXCOUNT) && 0x100 & GLOBAL_27) {
            WarpCutsceneIndex = 7
        }
        else if (!(0x100 & PREVBOXCOUNT) && crystal_count >= 12) {
            WarpCutsceneIndex = 8
        }
        else if (!(0x200 & PREVBOXCOUNT) && crystal_count >= 15) {
            WarpCutsceneIndex = 9
        }
        else if (!(0x400 & PREVBOXCOUNT) && crystal_count >= 17) {
            WarpCutsceneIndex = 10
        }
        else if (!(0x800 & PREVBOXCOUNT) && crystal_count >= 20) {
            WarpCutsceneIndex = 11
        }
        else if (!(0x1000 & PREVBOXCOUNT) && 0x200 & GLOBAL_27) {
            WarpCutsceneIndex = 12
        }
        else if (!(0x80 & GLOBAL_27) && !(0x2000 & PREVBOXCOUNT) && crystal_count >= 25) {
            WarpCutsceneIndex = 13
        }
        else if (!(0x20000 & PREVBOXCOUNT) && gem_count >= 1) {
            WarpCutsceneIndex = 17
        }
        else if (!(0x40000 & PREVBOXCOUNT) && gem_count >= 42 && (0x80 & GLOBAL_27)) {
            WarpCutsceneIndex = 18
        }
        if (WarpCutsceneIndex) {
            PREVBOXCOUNT += 1 << WarpCutsceneIndex
        }
    }
}

sub DebugCheats() {
    if (DEBUG) {
        if (dirpress(PAD_N) || dirpress(PAD_S) || dirpress(PAD_W) || dirpress(PAD_E) || buttonpress(0x9FF)) {
            if (var step = ResetCheatStep; step == 0) {
                if (dirpress(PAD_E)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 1.0) {
                if (dirpress(PAD_S)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 2.0) {
                if (dirpress(PAD_S)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 3.0) {
                if (dirpress(PAD_W)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 4.0) {
                if (dirpress(PAD_S)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 5.0) {
                if (buttonpress(PAD_CIRCLE)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 6.0) {
                if (buttonpress(PAD_TRIANGLE)) {
                    ResetCheatStep += 1.0
                }
                else {
                    ResetCheatStep = 0
                }
            }
            else if (step == 7.0) {
                if (buttonpress(PAD_CIRCLE)) {
                    soundpitch(3.625)
                    soundsetup(0, 11)
                    sounddecay(9.6s)
                    soundplay([1up0A], 0.5V)
                    GLOBAL_21 = 0
                    SAVEDGEMPOOL1 = 0
                    SAVEDGEMPOOL2 = 0
                    ResetCheatStep = 0
                }
                else {
                    ResetCheatStep = 0
                }
            }
        }

        if (dirpress(PAD_N) || dirpress(PAD_S) || dirpress(PAD_W) || dirpress(PAD_E) || buttonpress(0x9FF)) {
            if (var step = UnlockCheatStep; step == 0) {
                if (dirpress(PAD_E)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 1.0) {
                if (dirpress(PAD_S)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 2.0) {
                if (dirpress(PAD_S)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 3.0) {
                if (dirpress(PAD_W)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 4.0) {
                if (dirpress(PAD_S)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 5.0) {
                if (buttonpress(PAD_CIRCLE)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 6.0) {
                if (buttonpress(PAD_SQUARE)) {
                    UnlockCheatStep += 1.0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
            else if (step == 7.0) {
                if (buttonpress(PAD_TRIANGLE)) {
                    soundpitch(3.625)
                    soundsetup(0, 11)
                    sounddecay(9.6s)
                    soundplay([1up0A], 0.5V)
                    GLOBAL_21 ^= 1
                    SAVEDGEMPOOL2 |= 0x7C000000
                    UnlockCheatStep = 0
                }
                else {
                    UnlockCheatStep = 0
                }
            }
        }

        if (dirpress(PAD_N) || dirpress(PAD_S) || dirpress(PAD_W) || dirpress(PAD_E) || buttonpress(0x9FF)) {
            if (var step = CutsceneCheatStep; step == 0) {
                if (dirpress(PAD_E)) {
                    CutsceneCheatStep += 1.0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
            else if (step == 1.0) {
                if (dirpress(PAD_S)) {
                    CutsceneCheatStep += 1.0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
            else if (step == 2.0) {
                if (dirpress(PAD_S)) {
                    CutsceneCheatStep += 1.0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
            else if (step == 3.0) {
                if (dirpress(PAD_W)) {
                    CutsceneCheatStep += 1.0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
            else if (step == 4.0) {
                if (buttonpress(PAD_X)) {
                    CutsceneCheatStep += 1.0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
            else if (step == 5.0) {
                if (buttonpress(PAD_CIRCLE)) {
                    CutsceneCheatStep += 1.0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
            else if (step == 6.0) {
                if (buttonpress(PAD_CIRCLE)) {
                    soundpitch(3.625)
                    soundsetup(0, 11)
                    sounddecay(9.6s)
                    soundplay([1up0A], 0.5V)
                    GLOBAL_21 ^= 2
                    CutsceneCheatStep = 0
                }
                else {
                    CutsceneCheatStep = 0
                }
            }
        }
    }
}

state WarpRoom_Idle { // 1
    statusc 0
    code() {
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            IdleTimer = 0
            CameraTargetChanged = 0
            CapturePlayerPosition()
        }
        DebugCheats()
        UpdateFacingTarget()
        if (player -> stateflag & 0x8000) {
            PlayerWasWarping = 1
            player -> troty = CAMROTY
            player -> roty = CAMROTY
        }
        else if (PlayerWasWarping) {
            PlayerWasWarping = 0
            if (FacingTarget == 1) {
                CameraTarget = FacingTarget
                changestate(LoadSave_Triggered, 1)
            }
            else {
                SetCutsceneIndex()
                changestateif(Cutscene_Triggered, getfield(self, offsetof(WarpCutsceneIndex)))
            }
        }
        misc = GLOBAL_21 & 2
        if (misc) {
            misc = buttonhold(PAD_E)
            if (misc) {
                misc = FloorIndex != 5
            }
        }
        if (misc) {
            WarpCutsceneIndex = DebugCutsceneIndex
            DebugCutsceneIndex += 1
            if (DebugCutsceneIndex > 18) {
                DebugCutsceneIndex = 1
            }
            changestate(Cutscene_Triggered)
        }
        var0 = FacingTarget
        ResolveFacingDoorLevel()
        changestateif(WarpDoor_LoadLevel, var0 >= 0)
        var0 = FacingTarget
        FilterCameraTarget()
        if (CameraTarget != var0) {
            CameraTarget = var0
            CameraTargetChanged = 1
        }
        IdleTimer += 1.0
        if (player -> x != rotx) {
            IdleTimer = 0
            WarpHasMovedSinceLoadSave = 1
        }
        if (player -> y != roty) {
            IdleTimer = 0
            WarpHasMovedSinceLoadSave = 1
        }
        if (player -> z != rotz) {
            IdleTimer = 0
            WarpHasMovedSinceLoadSave = 1
        }
        if (!CameraTarget) {
            IdleTimer = 0
        }
        if (!WarpHasMovedSinceLoadSave) {
            IdleTimer = 0
        }
        CapturePlayerPosition()
        if (CameraTargetChanged) {
            var0 = 0xF00
        }
        else {
            var0 = 0x2F00
        }
        if (!(player -> stateflag & 0x8000) && IdleTimer >= var0) {
            if (CameraTarget == 1) {
                changestate(LoadSave_Triggered, 0)
            }
            else {
                changestate(WarpRoom_CameraFocus)
            }
        }
    }
}

state WarpRoom_CameraFocus { // 2
    statusc 0
    code() {
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            var0 = CameraTarget
            ApplyCameraFocusTarget()
            CapturePlayerPosition()
        }
        DebugCheats()
        UpdateFacingTarget()
        var0 = FacingTarget
        ResolveFacingDoorLevel()
        changestateif(WarpDoor_LoadLevel, var0 >= 0)
        var0 = 0
        if (player -> x != rotx) {
            var0 = 1
        }
        if (player -> y != roty) {
            var0 = 1
        }
        if (player -> z != rotz) {
            var0 = 1
        }
        CapturePlayerPosition()
        if (CameraTarget != FacingTarget || var0) {
            var S3 = 0
            var S4 = 0
            var S5 = -1
            ins72(0x600, S3)
            changestate(WarpRoom_Idle)
        }
    }
}

state WarpDoor_LoadLevel { // 3
    statusc 0
    code() {
        var level = var0
        if (FloorIndex == 5) {
            if (level == LEVEL_SnowGo || level == LEVEL_AirCrash || level == LEVEL_RoadToRuin) {
                GLOBAL_131 = 1
            }
        }
        miscfunc(level, player, 10, 12)
        sendevent(EventWarpIn, player, CAMROTY + 180deg)
        if (level == LEVEL_TurtleWoods) {
            loadfile([Ju1bT])
            loadfile([Ju2bT])
        }
        else if (level == LEVEL_SnowGo || level == LEVEL_SnowBiz || level == LEVEL_ColdHardCrash) {
            loadfile([Sn1eT])
            loadfile([Sn4eT])
        }
        else if (level == LEVEL_HangEight || level == LEVEL_AirCrash || level == LEVEL_PlantFood) {
            loadfile([Ri1pT])
            loadfile([Ri3pT])
        }
        else if (level == LEVEL_ThePits) {
            loadfile([Ju1bT])
            loadfile([Ju2bT])
        }
        else if (level == LEVEL_CrashDash || level == LEVEL_CrashCrush || level == LEVEL_Unbearable || level == LEVEL_DigginIt || level == LEVEL_BeeHaving) {
            loadfile([Al1lT])
            loadfile([Al3lT])
        }
        else if (level == LEVEL_RoadToRuin || level == LEVEL_Ruination) {
            loadfile([Ns1fT])
            loadfile([Ns2fT])
        }
        else if (level == LEVEL_BearIt || level == LEVEL_BearDown || level == LEVEL_TotallyBear) {
            loadfile([Sn1tT])
            loadfile([Sn2tT])
        }
        else if (level == LEVEL_TheEelDeal || level == LEVEL_SewerOrLater || level == LEVEL_HanginOut) {
            loadfile([Se1aT])
            loadfile([Se2aT])
        }
        else if (level == LEVEL_PistonItAway || level == LEVEL_SpacedOut) {
            loadfile([Dy1gT])
            loadfile([Dy2gT])
        }
        else if (level == LEVEL_RockIt || level == LEVEL_PackAttack) {
            loadfile([Sp2iT])
            loadfile([Sp3iT])
        }
        else if (level == LEVEL_NightFight || level == LEVEL_TotallyFly) {
            loadfile([Nj1cT])
            loadfile([Nj2cT])
        }
        playnull(1s)
        GAMEFLAGS |= 0x800000
        FadeToBlack()
        WaitFadeNull()
        CURRENTLEVEL = level
        loadlevel(level)
    }
}

state WarpLift_Load_Boss { // 4
    statusc 0
    code() {
        var level = var0
        GAMEFLAGS |= 0x800000
        FadeToBlack()
        WaitFadeNull()
        loadlevel(level)
    }
}

state LoadSave_Triggered { // 5
    statusc 0
    code(auto) {
        var0 = CameraTarget
        ApplyCameraFocusTarget()
        sendevent(Event34, player, 0)
        WarpCutsceneIndex = 1
        spawn(17, 1, 1, auto) // CardC-1
        LoadSaveOBJ = objectspawned
        sleepnull()
    }
    event(e, a) {
        accevcstate(LoadSave_End, e == Event14)
    }
}

state LoadSave_End { // 6
    statusc 0
    code() {
        var S3, S4
        var S5 = -1
        ins72(0x600, S3)
        sendevent(Event21, player, 0)
        WarpHasMovedSinceLoadSave = 0
        changestate(WarpRoom_Idle)
    }
}

state Cutscene_Triggered { // 7
    statusc 0
    code() {
        sendevent(Event76, player, 0)
        player -> troty = atan2(player, x)
        CutsceneFlags += 4
        playnull()
        if (PortalFXOBJ) {
            interrupter = PortalFXOBJ
            sendevent(Event14, interrupter, self)
            PortalFXOBJ = 0
            ProjectorOBJ = 0
        }
        playnull(0.85s)
        spawn(CHeOC, S_CUTSCENE_DIMMER, 1)
        RoomDimmerOBJ = objectspawned
        interrupter = WarpLiftOBJ
        sendevent(EventTriggered, interrupter, self)
        CutsceneFlags += 16
        playnull(0.58s)
        vecx = 10deg
        vecy = 153.8deg
        ins72(0x700, vecx)
        CutsceneFlags += 2
        spawn(CHeOC, S_PROJECTOR, 1, 30deg)
        ProjectorOBJ = objectspawned
        playnull(0.4s)
        CutsceneFlags += 32
        playnull(0.85s)
        CutsceneFlags ^= 32
        interrupter = CutsceneOBJ
        sendevent(EventTriggered, interrupter, self)
        CutsceneFlags += 8
        playnull()
        sleepnull()
    }
    event(e, a) {
        accevcstate(Cutscene_End, e == Event14)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            GLOBAL_54 = 0
            GLOBAL_120 = 0
            GLOBAL_55 = 0
            CutsceneFlags = 0
            RoomDimmerOBJ = 0
            PlayerDistance = distance(player, DIST_NO_Y)
            var0 = 1350.0 / (PlayerDistance >> 8)
            rotx = player -> x * var0 >> 8
            rotz = player -> z * var0 >> 8
        }
        if (CutsceneFlags & 0x20) {
            player -> x += (rotx - player -> x) >> 3
            player -> z += (rotz - player -> z) >> 3
        }
        if (frametime - statetime >= 0.5s && buttonpress(PAD_TRIANGLE)) {
            if (CutsceneFlags & 8) {
                interrupter = CutsceneOBJ
                sendevent(Event14, interrupter, self)
                changestate(Cutscene_End)
            }
            interrupter = WarpLiftOBJ
            changestateif(Cutscene_End, interrupter -> stateflag & 0x4000000)
        }
    }
}

state Cutscene_End { // 8
    statusc 0
    code() {
        if (ProjectorOBJ) {
            interrupter = ProjectorOBJ
            sendevent(Event14, interrupter, self)
            ProjectorOBJ = 0
        }
        if (RoomDimmerOBJ) {
            interrupter = RoomDimmerOBJ
            sendevent(Event14, interrupter, self)
            RoomDimmerOBJ = 0
        }
        if (CutsceneFlags & 2) {
            ins72(0x800, 0x100)
            until (frametime - statetime >= 0.8s) {
                playnull()
            }
        }
        sendeventif(Event21, player, CutsceneFlags & 4, 0)
        until (frametime - statetime >= 1s) {
            playnull()
        }
        if (!PortalFXOBJ) {
            spawn(CHeOC, S_PORTAL_FX, 1)
            PortalFXOBJ = objectspawned
        }
        if (CutsceneFlags & 16) {
            interrupter = objectget(OBJ_WARP_LIFT)
            sendevent(Event14, interrupter, self)
        }
        changestate(WarpRoom_Idle)
    }
}

state Cutscene_Init { // 9
    code() {
        FloorIndex = (player -> y + 40m) / 100m
        if (FloorIndex < 0) {
            FloorIndex = 0
        }
        if (FloorIndex >= 6) {
            FloorIndex = 5
        }
        DistortionLevel = 0
        ScanOffset = 0
        ScanVelocity = 0
        Flicker = 0
        TargetFlicker = 0
        vecy = 1
        Visibility = 0.5
        TargetVisibility = 0.5
        statusb = 0x80000000 | 0x100000
        FloorY = FloorIndex * 100m
        y -= 0.5m
        SetScale(0.9S)
        changestate(Cutscene_Sleep)
    }
}

state Cutscene_Sleep { // 10
    code() {
        do (var0 = 0) {
            if (var0) {
                break
            }
            playnull()
        } while (1)
        changestate(Cutscene_Play)
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            var0 = 1
        }
        accevcstate(Cutscene_Sleep, e == Event14)
    }
}

inline sub PlayCutsceneIntro(setup, model, clip) {
    do {
        animframe += 1.0
        if (field_63) {
            DeloadAnim(setup, model)
            DeloadAnim(clip, model)
            goto exit;
        }
        playframe()
    } while (animframe + 1.0 <= 17.0)
}

inline sub PlayCutsceneSegment(prev, model, next, anim, start, end) {
    LoadAnim(next, model)
    setanim(anim)
    do {
        if (field_63) {
            DeloadAnim(prev, model)
            DeloadAnim(next, model)
            goto exit;
        }
        animframe = (creator -> pathprog - start) << 8
        if (animframe > end) {
            break
        }
        else {
            playframe()
        }
    } while (1)
    animframe = end
    DeloadAnim(prev, model)
}

