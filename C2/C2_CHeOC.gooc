sub UpdateHologramFX() {
    if (!DistortionLevel) {
        if (!rand(30)) {
            ScanVelocity <<= 1
            TargetDistortionLevel = (3 + rand(5)) << 2
            DistortionLevel += 1
        }
    }
    else if (DistortionLevel == TargetDistortionLevel) {
        if (!rand(40)) {
            TargetDistortionLevel = 0
            DistortionLevel -= 1
            if (ScanVelocity > 0x2710) {
                ScanVelocity >>= 1
            }
        }
    }
    else {
        DistortionLevel = seek(DistortionLevel, TargetDistortionLevel, 1)
    }

    if (!rand(60)) {
        if (!rand(2)) {
            ScanVelocity = 0x1047 + rand(0x411B)
        }
        else {
            ScanVelocity = -(0x1047 + rand(0x411B))
        }
    }
    if (!ScanOffset) {
        if (!rand(2)) {
            vecy = -vecy
            ScanOffset = 0x57E3F
        }
    }
    stalltime = (DistortionLevel & -4) | (GAMETICK & 3)
    if (ScanOffset + ScanVelocity >= 0x57E40 || ScanOffset + ScanVelocity < 0) {
        vecy = -vecy
    }
    ScanOffset = (ScanOffset + (ScanVelocity + 0x57E40)) % 0x57E40
    vecx = (0x2BF20 + ScanOffset) + FloorY
    if (!rand(15)) {
        TargetFlicker = rand(0x333)
    }
    Flicker = seek(Flicker, TargetFlicker, 0xCC)
    var0 = Flicker + (time(0.1s) * 0x199)
    var0 = 16.0 - var0
    var0 = var0 * Visibility >> 8
    moda = 16.0 - var0
}


state Projector_Robot { // 12
    code(yawspd) {
        soundpitch(16.0)
        soundplay([PSt2A], 0.06V)
        ProjectorOrbitYawSpeed = yawspd
        var0 = atan(-player -> x, -player -> z) % 360deg
        troty = (var0 - 45deg) % 360deg
        trotx = -90.1deg
        ProjectorTargetOrbitPitch = -22deg
        spawn(37, 0, 1) // LenFC-0
        GLOBAL_54 = 0
        GLOBAL_120 = 0
        spawn(CHeOC, S_PROJECTOR_LIGHT, 1, 1)
        spawn(CHeOC, S_PROJECTOR_LIGHT, 1, 2)
        zindex = 24
        statusb = 0
        troty = 0
        trotz = 0
        ProjectorOrbitRadius = 2.7m
        ProjectorTargetOrbitRadius = 2.7m
        ProjectorNextRadiusChange = frametime + rand(4s) + 0.5s
        ProjectorAnimFrame = 0
        ProjectorTargetAnimFrame = 0
        ProjectorAnimAlternation = 0
        ProjectorNextAnimChange = frametime + rand(4s) + 2s
        SetVec(x, y, z)
        do {
            if (frametime >= ProjectorNextAnimChange) {
                ProjectorNextAnimChange = frametime + rand(4s) + 2s
                if (trotx != -90deg) {
                    if (!rand(4)) {
                        sounddecay(2.58s)
                        soundpitch((13.12 + rand(5.28)) * 0.36 >> 8)
                        soundplay([sv16A], 0.2V + rand(0.03V))
                    }
                    else {
                        sounddecay(2.58s)
                        soundpitch((13.12 + rand(5.28)) * 0.36 >> 8)
                        soundplay([sv26A], 0.2V + rand(0.03V))
                    }
                }
                if (ProjectorAnimFrame == 0) {
                    ProjectorTargetAnimFrame = 7.0
                }
                else {
                    ProjectorTargetAnimFrame = ((ProjectorOrbitRadius - 2.7m) * 6 / 2.5m) << 8
                }
            }
            ProjectorAnimFrame = seek(ProjectorAnimFrame, ProjectorTargetAnimFrame, 1.0)
            if (trotx == -90deg) {
                break
            }
            playframe(ProjectorAnimFrame)
            if (ProjectorAnimAlternation & 1) {
                setanim(PROJECTOR_ROBOT_1)
            }
            else {
                setanim(PROJECTOR_ROBOT_2)
            }
            ProjectorAnimAlternation += 1
        } while (1)
    }
    event(e, a) {
        if (e == Event14) {
            ProjectorTargetOrbitPitch = -90deg
        }
    }
    trans {
        unless (STATUS_FIRSTFRAME) {
            if (creator) {
                vecx = creator -> x
                vecy = creator -> y
                vecz = creator -> z
            }
            if (frametime >= ProjectorNextRadiusChange) {
                ProjectorNextRadiusChange = (frametime + rand(3s)) + 0.5s
                if (trotx != -22deg) {
                    ProjectorTargetOrbitRadius = 5.2m
                }
                else {
                    ProjectorTargetOrbitRadius = 2.7m + rand(2.5m)
                }
            }
            ProjectorOrbitRadius = seek(ProjectorOrbitRadius, ProjectorTargetOrbitRadius, 360deg)
            var0 = ProjectorTargetOrbitPitch - trotx
            if (var0 > 0) {
                var0 = var0 >> 3
                if (!var0) {
                    var0 = 1
                }
                if (var0 > 8) {
                    var0 = 8
                }
            }
            else if (var0 < 0) {
                var0 = var0 >> 3
                if (!var0) {
                    var0 = -1
                }
                if (var0 < -8) {
                    var0 = -8
                }
            }
            trotx += var0
            troty = spd(troty, ProjectorOrbitYawSpeed)
            trotz = troty
            vectransf2(vvec, vtrans, ProjectorOrbitRadius, 0, 0)
            UpdateProjectorAngle()
            sendevent(EventHit, collider, 100.0)
        }
    }
}

sub UpdateProjectorAngle() {
    save (vecx, vecy, vecz) {
        vecx = creator -> x
        vecy = creator -> y
        vecz = creator -> z
        roty = spd(roty, 360deg)
        rotx = degseek(rotx, atan2_3d(self, vecx) + 90deg, 90deg)
        rotz = degseek(rotz, atan2(creator -> trans), 180deg)
    }
}

state Cutscene_Room_Dimmer { // 13
    code() {
        while (rotx) {
            playnull()
        }
        ins72(0x100, 0x100)
    }
    event(e, a) {
        if (e == Event14) {
            accev()
            roty = 0deg
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            rotx = 0deg
            roty = 22.5deg
            ins72(0x100, 0x200)
            GLOBAL_50 = 0xFFFFFF
            GLOBAL_51 = 0xFFFFFF
        }
        if (rotx != roty) {
            var0 = roty - rotx
            if (var0 < -16) {
                var0 = -16
            }
            else if (var0 > 16) {
                var0 = 16
            }
            rotx += var0
            GLOBAL_50 = (0xFF + ((-0x9B * rotx) >> 8)) | (((0xFF + ((-0xB9 * rotx) >> 8)) << 8) | ((0xFF + ((-0xD7 * rotx) >> 8)) << 16))
            GLOBAL_51 = (0xFF + ((0 * rotx) >> 8)) | (((0xFF + ((0 * rotx) >> 8)) << 8) | ((0xFF + ((0 * rotx) >> 8)) << 16))
        }
    }
}

state Projector_Robot_Light { // 14
    __transargs
    code(mode) {
        sleepnull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            scalex = mode
            if (scalex == 1) {
                GLOBAL_54 = self
                GLOBAL_55 = 2.0
            }
            else {
                GLOBAL_120 = self
            }
        }
        if (scalex == 1) {
            x = creator -> x
            y = creator -> y
            z = creator -> z
            vecx = creator -> vecx
            vecy = creator -> vecy
            vecz = creator -> vecz
            trotx = -creator -> trotx
            troty = creator -> troty + 180deg
            trotz = troty
            vectransf2(vvec, vtrans, 8m, 0, 0)
        }
        else if (scalex == 2) {
            x = creator -> x
            y = creator -> y
            z = creator -> z
        }
    }
}

state Portal_FX_Init { // 15
    code() {
        PortalVIDOLoaded = 0
        PortalVisibility = 0
        PortalTargetVisibility = 0
        FloorIndex = creator -> FloorIndex
        PortalAIndex = -1.0
        PortalBIndex = -1.0
        GLOBAL_137 = 0
        if (FloorIndex == 0) {
            PortalTable = WarpRoomPortalTable0
        }
        else if (FloorIndex == 1) {
            PortalTable = WarpRoomPortalTable1
        }
        else if (FloorIndex == 2) {
            PortalTable = WarpRoomPortalTable2
        }
        else if (FloorIndex == 3) {
            PortalTable = WarpRoomPortalTable3
        }
        else if (FloorIndex == 4) {
            PortalTable = WarpRoomPortalTable4
        }
        else {
            PortalTable = WarpRoomPortalTable5
        }
        changestate(Portal_FX_Load_VIDO)
    }
}

sub DeloadPortalVIDO() {
    if (GLOBAL_126) {
        ins75(GLOBAL_126, null)
        GLOBAL_126 = 0
    }
    if (PortalVIDOLoaded) {
        PortalVIDOLoaded = 0
        deloadfile([Car1T])
        deloadfile([wdr0D])
    }
}

state Portal_FX_Load_VIDO { // 16
    code() {
        if (!PortalVIDOLoaded) {
            do {
                playnull()
            } until (getpayload(& [Car1T]) <= getfreepages())
            loadfile([Car1T])
            loadfile([wdr0D])
            PortalVIDOLoaded = 1
        }
        until (isloaded([Car1T]) && isloaded([wdr0D])) {
            playnull()
        }
        if (GLOBAL_126 == 0) {
            GLOBAL_126 = ins74([wdr0D], null)
        }
        PortalTargetVisibility = 1.0
        changestate(Portal_FX_Active)
    }
    event(e, a) {
        if (e == Event41 || e == Event26) {
            DeloadPortalVIDO()
        }
        accevcstate(Portal_FX_Kill, e == Event14)
    }
}

state Portal_FX_Active { // 17
    code() {
        spawn(CHeOC, S_PORTAL_BG, 1, 1)
        spawn(CHeOC, S_PORTAL_BG, 1, 0)

        do (var index = 0) {
            spawn(CHeOC, S_PORTAL_SWIRL, 1, index, 1)
            spawn(CHeOC, S_PORTAL_SWIRL, 1, index, 0) 
        } while ({ index += 1.0 }; index < 5.0)

        if (FloorIndex != 5) {
            spawn(CHeOC, S_PORTAL_PARTICLES, 1, 1)
            spawn(CHeOC, S_PORTAL_PARTICLES, 1, 0)
        }
        do {
            do (var i = 0) {
                if (GLOBAL_126) {
                    ins76(GLOBAL_126, i) // params: entry, frame
                    ins77(0, misc, GLOBAL_126, WARP_PORTAL_SWIRL) // fucker
                }
                var0 = (GLOBAL_126[1.0] + 1.0) >> 1
                vecx = i - var0
                if (vecx < 0) {
                    vecx = -vecx
                }
                var S5 = vecx / (var0 >> 8)
                var S6 = 1.0 - S5
                vecx = ((S5 * 0x9F) >> 8) + 0x60
                vecy = ((S6 * 0x9F) >> 8) + 0x60
                GLOBAL_136 = 0x6000 | (vecx << 16) | vecy
                GLOBAL_137 = (16.0 * PortalVisibility) >> 8
                playnull()
            } while ({ i += 1.0 }; i < GLOBAL_126[1.0])
        } while (1)
    }
    event(e, a) {
        if (e == Event41 || e == Event26) {
            DeloadPortalVIDO()
        }
        if (e == Event14) {
            accev()
            PortalTargetVisibility = 0
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            PortalFloorY = FloorIndex * 100m
        }
        PortalAIndex = -1.0
        PortalBIndex = -1.0
        var v1 = 0
        do (var table = PortalSlotTable) {
            if (CAMROTY < table[v1]) {
                PortalAIndex = table[v1 + 1.0]
                PortalBIndex = table[v1 + 2.0]
                break
            }
            v1 += 3.0
        } while (1)
        if (FloorIndex == 5) {
            var unlock_masks = SecretDoorUnlockMasks
            if (PortalAIndex >= 0) {
                var v3 = unlock_masks[PortalAIndex]
                if (!(GLOBAL_150 & v3) && !(GLOBAL_21 & 1)) {
                    PortalAIndex = -1
                }
            }
            if (PortalBIndex >= 0) {
                var v4 = unlock_masks[PortalBIndex]
                if (!(GLOBAL_150 & v4) && !(GLOBAL_21 & 1)) {
                    PortalBIndex = -1
                }
            }
        }
        if (PortalAIndex >= 0) {
            v1 = PortalAIndex << 1
            PortalAYaw = WarpRoomTable[v1]
            PortalAY = WarpRoomTable[v1 + 1.0] + PortalFloorY
            PortalAYawSin = sin(PortalAYaw)
            PortalAYawCos = cos(PortalAYaw)
            if (PortalAIndex & 1) {
                var0 = 0
            }
            else {
                var0 = 6
            }
            PortalASwirlOffset = (((time(0.5s, var0) << 8) / 12) * 4m) >> 8
        }
        else {
            PortalAYaw = 0
        }
        if (PortalBIndex >= 0) {
            v1 = PortalBIndex << 1
            PortalBYaw = WarpRoomTable[v1]
            PortalBY = WarpRoomTable[v1 + 1.0] + PortalFloorY
            PortalBYawSin = sin(PortalBYaw)
            PortalBYawCos = cos(PortalBYaw)
            if (PortalBIndex & 1) {
                var0 = 0
            }
            else {
                var0 = 6
            }
            PortalBSwirlOffset = (((time(0.5s, var0) << 8) / 12) * 4m) >> 8
        }
        else {
            PortalBYaw = 0
        }
        if (PortalVisibility != PortalTargetVisibility) {
            PortalVisibility = seek(PortalVisibility, PortalTargetVisibility, 10)
        }
        changestateifn(Portal_FX_Kill, getfield(self, offsetof(PortalVisibility)))
    }
}

state Portal_FX_Kill { // 18
    code() {
        DeloadPortalVIDO()
        playnull()
    }
    event(e, a) {
        if (e == Event41 || e == Event26) {
            DeloadPortalVIDO()
        }
    }
}

state Portal_Swirl_Init { // 19
    code(index, slot) {
        PortalSwirlIndex = index
        PortalFXUseSlotA = slot
        FloorIndex = creator -> FloorIndex
        vfx = (vfx & 0xFFFFFF00) | 0x3
        if (index == 0.0) {
            zindex = -400
        }
        else if (index == 1.0) {
            zindex = -250
        }
        else if (index == 2.0) {
            zindex = -100
        }
        else if (index == 3.0) {
            zindex = 160
        }
        else if (index == 4.0) {
            zindex = 220
        }
        if (FloorIndex == 1) {
            zindex -= 30
        }
        changestate(Portal_Swirl)
    }
}

state Portal_Swirl { // 20
    code() {
        do {
            if (PortalFXYaw) {
                playanim(0, WARP_PORTAL_SWIRL)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (PortalFXUseSlotA) {
            PortalFXVisibility = creator -> PortalVisibility
            PortalFXYaw = creator -> PortalAYaw
            PortalFXDoorIndex = creator -> PortalAIndex
            PortalSwirlOffset = creator -> PortalASwirlOffset
            PortalFXYawSin = creator -> PortalAYawSin
            PortalFXYawCos = creator -> PortalAYawCos
            y = parent -> PortalAY
        }
        else {
            PortalFXVisibility = creator -> PortalVisibility
            y = parent -> PortalBY
            PortalFXYaw = parent -> PortalBYaw
            PortalFXDoorIndex = parent -> PortalBIndex
            PortalSwirlOffset = parent -> PortalBSwirlOffset
            PortalFXYawSin = parent -> PortalBYawSin
            PortalFXYawCos = parent -> PortalBYawCos
        }
        if (PortalFXYaw) {
            var phase = PortalSwirlOffset + (4m * (PortalSwirlIndex >> 8))
            var S4 = ((phase >> 8) << 8) / 0x1F40
            var radius = -(phase + 7.5m) >> 8
            moda = 16.0 - (((S4 << 4) * PortalFXVisibility) >> 8)
            x = (radius * PortalFXYawSin) >> 4
            z = (radius * PortalFXYawCos) >> 4
            rotx = S4 << 2
            roty = PortalFXYaw
            rotz = (PortalFXYaw + 90deg) % 360deg
            scalex = 6S - ((S4 * 5.5S) >> 8)
            scaley = scalex
            scalez = scalex
            var0 = radius
        }
    }
}

state Portal_Background_Init { // 21
    code(slot) {
        FloorIndex = creator -> FloorIndex
        PortalFXUseSlotA = slot
        vfx = (vfx & 0xFFFFFF00) | 0x3
        if (FloorIndex == 5) {
            zindex = 200
            SetScale(6S)
        }
        else {
            zindex = 0
        }
        FloorIndex = creator -> FloorIndex
        changestate(Portal_Background)
    }
}

state Portal_Background { // 22
    code() {
        do {
            if (PortalFXYaw) {
                if (FloorIndex == 5) {
                    playanim(0, GLOW)
                }
                else {
                    playanim(0, WARP_PORTAL_BG)
                }
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        if (PortalFXUseSlotA) {
            PortalFXVisibility = creator -> PortalVisibility
            PortalFXYaw = creator -> PortalAYaw
            PortalFXYawSin = creator -> PortalAYawSin
            PortalFXYawCos = creator -> PortalAYawCos
            y = parent -> PortalAY
        }
        else {
            PortalFXVisibility = creator -> PortalVisibility
            PortalFXYaw = parent -> PortalBYaw
            y = parent -> PortalBY
            PortalFXYawSin = parent -> PortalBYawSin
            PortalFXYawCos = parent -> PortalBYawCos
        }
        if (PortalFXYaw) {
            var0 = -0x2AF8
            x = (var0 * PortalFXYawSin) >> 4
            z = (var0 * PortalFXYawCos) >> 4
            rotx = spd(rotx, -90deg)
            roty = PortalFXYaw
            rotz = (PortalFXYaw + 90deg) % 360deg
            moda = 16.0 - ((16.0 * PortalFXVisibility) >> 8)
        }
        else {
            moda = 16.0
        }
    }
}

state Portal_Particles_Init { // 23
    code(slot) {
        PortalFXUseSlotA = slot
        changestate(Portal_Particles)
    }
}

state Portal_Particles { // 24
    code() {
        do (var frame = 0) {
            if (PortalFXYaw) {
                setanim(WARP_PARTICLES)
                playframe(frame)
            }
            else {
                playnull()
            }
            frame += 1.0
            if (frame >= 120.0) {
                frame = 0
            }
        } while (1)
    }
    trans {
        if (PortalFXUseSlotA) {
            PortalFXVisibility = creator -> PortalVisibility
            PortalFXYaw = creator -> PortalAYaw
            PortalFXYawSin = creator -> PortalAYawSin
            PortalFXYawCos = creator -> PortalAYawCos
            y = parent -> PortalAY
        }
        else {
            PortalFXVisibility = creator -> PortalVisibility
            PortalFXYaw = parent -> PortalBYaw
            y = parent -> PortalBY
            PortalFXYawSin = parent -> PortalBYawSin
            PortalFXYawCos = parent -> PortalBYawCos
        }
        if (PortalFXYaw) {
            var0 = -0x12C0
            x = (var0 * PortalFXYawSin) >> 4
            z = (var0 * PortalFXYawCos) >> 4
            roty = PortalFXYaw
            rotz = (PortalFXYaw + 90deg) % 360deg
            rotx = spd(rotx, -30deg)
            moda = 16.0 - ((0xCCD * PortalFXVisibility) >> 8)
        }
        else {
            moda = 16.0
        }
    }
}

state Secret_Door_Init { // 25
    code(index) {
        zindex = -26
        rotx = 0deg
        rotz = 0deg
        if (index == 1) {
            setanim(SECRET_DOOR_1)
            SetTrans(-4122.0, 200000.0, -2383.2)
            roty = 60deg
        }
        else if (index == 2) {
            setanim(SECRET_DOOR_2)
            SetTrans(-4122.0, 200000.0, 2383.2)
            roty = 120deg
        }
        else if (index == 3) {
            setanim(SECRET_DOOR_3)
            SetTrans(6.0, 200000.0, 4766.8)
            roty = 90deg
        }
        else if (index == 4) {
            setanim(SECRET_DOOR_4)
            SetTrans(4134.0, 200000.0, 2383.2)
            roty = 240deg
        }
        else if (index == 5) {
            setanim(SECRET_DOOR_5)
            SetTrans(4134.0, 200000.0, -2383.2)
            roty = 300deg
        }
        SecretDoorBaseY = y
        SecretDoorBobOffset = 0
        SecretDoorBobVelocity = 0
        SecretDoorWaveOffset = 0
        SecretDoorNextBobTime = frametime + rand(4s)
        SecretDoorAntennaActive = 0
        changestate(Secret_Door_Active)
    }
}

state Secret_Door_Active { // 26
    code() {
        sleepframe(0)
    }
    trans {
        if (SecretDoorAntennaActive && !child) {
            SecretDoorAntennaActive = 0
            parent -> WarpActiveAntennaCount = parent -> WarpActiveAntennaCount - 1
        }
        if (frametime >= SecretDoorNextBobTime) {
            SecretDoorBobVelocity += (rand(0.25m) + 0.25m) / 25
            SecretDoorNextBobTime = frametime + rand(8s) + 4s
            if (abs(degdist(CAMROTY, roty)) < 60.05deg && parent -> WarpActiveAntennaCount == 0) {
                parent -> WarpActiveAntennaCount = parent -> WarpActiveAntennaCount + 1
                SecretDoorAntennaActive = 1
                spawn(CHeOC, S_ANTENNA_GLOW, 1, 0, 2s)
                spawn(CHeOC, S_ANTENNA_GLOW, 1, 1.0, 2s)
            }
        }
        var old_offs = SecretDoorBobOffset
        if (SecretDoorBobOffset == 0 || SecretDoorBobVelocity) {
            var next_vel = SecretDoorBobVelocity - (SecretDoorBobOffset / 25)
            var next_offs = SecretDoorBobOffset + next_vel
            SecretDoorBobOffset = next_offs
            SecretDoorBobVelocity = next_vel
            if (old_offs >= 0) {
                if (next_offs < 1) {
                    SecretDoorBobVelocity -= SecretDoorBobVelocity >> 2
                }
            }
            else if (next_offs >= 0) {
                SecretDoorBobVelocity -= SecretDoorBobVelocity >> 2
            }
        }
        SecretDoorWaveOffset = (sin((frametime << 5) & 0xFFF) * 0.075m) >> 12
        y = SecretDoorBaseY + SecretDoorBobOffset + SecretDoorWaveOffset
    }
}

state Antenna_Glow { // 27
    __transargs
    code(vert, t) {
        do {
            playanim(0, GLOW)
            if (frametime > AntennaGlowEndTime) {
                break
            }
        } while (1)
        tpc = 0
        do {
            if (!child) {
                break
            }
            playnull()
        } while (1)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            vecy = parent -> roty
            AntennaGlowEndTime = frametime + t
            SetRot(0deg)
        }
        if (vert != -1.0) {
            getvert(vtrans, creator, vert)
        }
        SetScale(rand(0.6S) + 0.4S)
        if ((frametime & 15) < 1 && FRAMETIME < 36 && abs(degdist(CAMROTY, vecy)) < 60.05deg) {
            spawn(9, 24, 1, vert)
        }
    }
}

state WarpLift_Init { // 28
    statusc 0x200002
    code() {
        FloorIndex = player -> y / 100m
        if (FloorIndex < 0) {
            FloorIndex = 0
        }
        if (FloorIndex >= 6) {
            FloorIndex = 5
        }
        LiftBarrierFloor = FloorIndex
        spawn(CHeOC, S_WARP_LIFT_BARRIER, 1)
        pathprog = (FloorIndex * 90.0) + 9.0
        calcpath(pathprog)
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | 0x400000
        changestate(WarpLift_Wait)
    }
}

sub CheckPlayerStance() {
    if (player -> speed == 0
        && y - 0.1m < player -> y
        && player -> y < y + 0.1m
        && distance(player, DIST_EXACT | DIST_NO_Y) <= 0.5m
        && ((player -> stateflag & 0x2000) || dirhold(PAD_NONE))) {
            var0 = 1
            stateflag |= 0x400000
        }
    else {
        var0 = 0
        stateflag &= ~0x400000
    }
}

state WarpLift_Wait { // 29
    statusc 0x200002
    code() {
        LiftBarrierFloor = FloorIndex
        sleepanim(0, WARP_LIFT)
    }
    event(e, a) {
        if (e == EventTriggered) {
            accev()
            LiftBarrierFloor = -1
        }
        if (e == Event14) {
            accev()
            LiftBarrierFloor = FloorIndex
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            zindex = 40
        }
        CheckPlayerStance()
        if (!var0) {
            statetime = frametime
            return
        }
        if (frametime - statetime >= 0.5s) {
            changestate(Warp_Lift_Ready)
        }
    }
}

state Warp_Lift_Ready { // 30
    stateflag 0x400001
    statusc 0x200002
    code() {
        LiftBarrierFloor = FloorIndex
        sleepanim(0, WARP_LIFT)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            zindex = 40
            LiftAllowedDirections = 0
            if (FloorIndex < 5) {
                misc = 0
                CountPoolBits(SAVEDCRYSTALPOOL1)
                CountPoolBits(SAVEDCRYSTALPOOL2)
                if (GLOBAL_21 & 1 || misc >= ((FloorIndex + 1) * 5)) {
                    LiftAllowedDirections += 1
                }
            }
            if (FloorIndex) {
                LiftAllowedDirections += 2
            }
            sendevent(Event77, player, LiftAllowedDirections)
        }
        if (buttonhold(PAD_X)) {
            sendevent(EventBounce, player, 12.64912m)
            changestate(WarpLift_Wait)
        }
        LiftMoveDirection = 0
        if (dirhold(PAD_N)) {
            if (LiftAllowedDirections & 1) {
                LiftMoveDirection = 1
                sendevent(Event77, player, 1)
                changestate(WarpLift_Move)
            }
        }
        else if (dirhold(PAD_S)) {
            if (LiftAllowedDirections & 2) {
                LiftMoveDirection = -1
                sendevent(Event77, player, 2)
                changestate(WarpLift_Move)
            }
        }
    }
}

state WarpLift_Move { // 31
    stateflag 0x400001
    statusc 0x200002
    code() {
        LiftBarrierFloor = FloorIndex
        soundpitch(0x6E4)
        sounddecay(0xFF)
        soundplay([ElL2A], 0.3V)
        sleepanim(0, WARP_LIFT)
    }
    trans {
        once {
            LiftCarryRestoreStep = 0
            LiftStartPathProg = (FloorIndex * 90.0) + 9.0
            LiftTargetPathProg = LiftStartPathProg
            if (LiftMoveDirection > 0) {
                LiftTargetPathProg += 90.0
            }
            else {
                LiftTargetPathProg -= 90.0
            }

            {
                var next_floor = 0
                if (LiftMoveDirection < 0) {
                    next_floor = FloorIndex - 1
                }
                else {
                    next_floor = FloorIndex + 1
                }

                if (next_floor == 0) {
                    loadfile([Wrp1T])
                    loadfile([WrpaT])
                }
                else if (next_floor == 1) {
                    loadfile([Wrp2T])
                    loadfile([WrpbT])
                }
                else if (next_floor == 2) {
                    loadfile([Wrp3T])
                    loadfile([WrpcT])
                }
                else if (next_floor == 3) {
                    loadfile([Wrp4T])
                    loadfile([WrpdT])
                }
                else if (next_floor == 4) {
                    loadfile([Wrp5T])
                    loadfile([WrpeT])
                }
            }
            LiftRotationSpeed = 0
        }
        changestateif(WarpLift_Arrive, pathprog == LiftTargetPathProg && abs(degdist(player -> troty, CAMROTY)) <= 5deg)
        var0 = pathprog - LiftStartPathProg
        field_61 = (pathprog - 9.0) % 90.0
        if (field_61 >= 6.0 && field_61 <= 25.0) {
            statusb |= 0x40000000
            field_61 -= 6.0
            if (field_61 >= 12.0) {
                field_61 = 12.0
            }
            zindex = ((60 * field_61) / 12.0) + 40
        }
        else {
            zindex = 40
            statusb &= ~0x40000000
        }
        if (LiftTargetPathProg > pathprog) {
            pathprog += 61
            if (pathprog > LiftTargetPathProg) {
                pathprog = LiftTargetPathProg
            }
            if (var0 >= 17.0 && var0 <= 25.0) {
                if (((!(GLOBAL_21 & 1) || buttonpress(PAD_TRIANGLE)) && !(DEBUG && buttonpress(PAD_R2))) || FloorIndex == 4) {
                    if (FloorIndex == 0) {
                        if (!(0x40 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossRipperRoo
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 1) {
                        if (!(0x100 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossKimodo
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 2) {
                        if (!(0x8 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossTazTiger
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 3) {
                        if (!(0x200 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossNGin
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                    else if (FloorIndex == 4) {
                        misc = 0
                        CountPoolBits(SAVEDGEMPOOL1)
                        CountPoolBits(SAVEDGEMPOOL2)
                        var gem_count = misc
                        if (!(0x80 & GLOBAL_27) || buttonpress(PAD_TRIANGLE)) {
                            CURRENTLEVEL = LEVEL_BossCortex
                            var0 = CURRENTLEVEL
                            changestate(WarpLift_Load_Boss)
                        }
                        else if (gem_count >= 42) {
                            var0 = LEVEL_GameWin
                            changestate(WarpLift_Load_Boss)
                        }
                        else {
                            var0 = LEVEL_GameEnd
                            changestate(WarpLift_Load_Boss)
                        }
                    }
                }
                LiftCarryRestoreStep = 1
                zindex = 40
                ins72(0, 0x1000)
                soundpitch(0x6E4)
                sounddelay(1s)
                sounddecay(0xFF)
                soundplay([ElA2A], 0.3V)
                pathprog = LiftStartPathProg + 79.0
                if (pathprog >= pathlen) {
                    pathprog = pathlen - 1
                }
                calcpath(pathprog)
                player -> x = x
                player -> z = z
                player -> troty = (CAMROTY + 285deg) % 360deg
                player -> roty = player -> troty
                ins72(0x400, 0x100)
                FloorIndex += 1
                LiftBarrierFloor = FloorIndex
            }
        }
        else {
            pathprog -= 61
            if (pathprog < LiftTargetPathProg) {
                pathprog = LiftTargetPathProg
            }
            if (var0 >= -18.5 && var0 <= -9.5) {
                LiftCarryRestoreStep = 1
                ins72(0, 0x2000)
                soundpitch(6.893)
                sounddelay(1s)
                sounddecay(10.22s)
                soundplay([ElA2A], 0.3V)
                pathprog = LiftStartPathProg - 78.1
                calcpath(pathprog)
                player -> x = x
                player -> z = z
                player -> troty = (CAMROTY + 230deg) % 360deg
                ins72(0x400, 0x100)
                FloorIndex -= 1
                LiftBarrierFloor = FloorIndex
            }
        }
        if (abs(LiftTargetPathProg - pathprog) < 10.0) {
            LiftRotationSpeed -= 0.4deg
            if (LiftRotationSpeed < 4.75deg) {
                LiftRotationSpeed = 4.75deg
            }
        }
        else {
            LiftRotationSpeed += 0.38deg
            if (LiftRotationSpeed > 16deg) {
                LiftRotationSpeed = 16deg
            }
        }
        roty += LiftRotationSpeed
        calcpath(pathprog)
        if (LiftCarryRestoreStep) {
            if (LiftCarryRestoreStep == 1) {
                statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_HAS_SHADOW | 0x40000000
            }
            if (LiftCarryRestoreStep == 4) {
                LiftCarryRestoreStep += 1
                statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | FLAG_HAS_SHADOW | 0x40000000
            }
            if (LiftCarryRestoreStep < 5) {
                LiftCarryRestoreStep += 1
                player -> y = y
                statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL | FLAG_CARRY_COLLIDER | 0x400000
            }
        }
    }
}

state WarpLift_Arrive { // 32
    statusc 0x200002
    code() {
        if (player -> stateflag & 0x2000) {
            if (FloorIndex == 0) {
                deloadfile([Wrp1T])
                deloadfile([WrpaT])
            }
            else if (FloorIndex == 1) {
                deloadfile([Wrp2T])
                deloadfile([WrpbT])
            }
            else if (FloorIndex == 2) {
                deloadfile([Wrp3T])
                deloadfile([WrpcT])
            }
            else if (FloorIndex == 3) {
                deloadfile([Wrp4T])
                deloadfile([WrpdT])
            }
            else if (FloorIndex == 4) {
                deloadfile([Wrp5T])
                deloadfile([WrpeT])
            }
        }
        changestate(WarpLift_Wait)
    }
}

state Warp_Lift_Barrier { // 33
    code() {
        zindex = 200
        x -= 8.0
        do {
            if (LiftBarrierFloor >= 0) {
                playanim(0, WARP_LIFT_BARRIER)
            }
            else {
                playnull()
            }
        } while (1)
    }
    trans {
        LiftBarrierFloor = creator -> LiftBarrierFloor
        FloorIndex = creator -> FloorIndex
        if (LiftBarrierFloor >= 0) {
            var S3, S4
            S3 = LiftBarrierFloor * 100m
            y = S3 - 8.0
            roty = (CAMROTY / 30deg) * 30deg
        }
    }
}

state Cutscene_Extras { // 34
    code(type, spawner, f) {
        var0 = 0
        statusb = 0x80000000 | 0x100000
        vfx = (vfx & 0xFFFF00FF) | 0x800
        CutsceneExtraTargetFade = 16.0
        moda = CutsceneExtraTargetFade
        creator = spawner
        if (type == 0) {
            if (getfreepages() < 2) {
                goto exit;
            }
            loadfile([Sis1T])
            loadfile([S402V])
            loadfile([Si12G])
        }
        else if (type == 1) {
            if (getfreepages() < 2) {
                goto exit;
            }
            loadfile([Sis1T])
            loadfile([S602V])
            loadfile([Si12G])
        }
        else if (type == 2) {
            if (getfreepages() < 1) {
                goto exit;
            }
            loadfile([Sis1T])
            loadfile([S702V])
            loadfile([Si12G])
        }
        until (v0 || creator -> pathprog >= f) {
            playnull()
        }
        if (type == 0) {
            CutsceneExtraTargetFade = 0
            loadfile([S412V])
            loadfile([Si12G])
            setanim(SIS_HEAD_9)
            do {
                animframe = creator -> pathprog - f << 8
                if (var0 || animframe > 254.0) {
                    break
                }
                playframe()
            } while (1)
            deloadfile([S402V])
            deloadfile([Si12G])
            setanim(SIS_HEAD_10)
            do {
                animframe = creator -> pathprog - (f + 0xFF) << 8
                if (var0 || animframe > 225.0) {
                    break
                }
                if (animframe >= 215.0) {
                    CutsceneExtraTargetFade = 16.0
                }
                playframe()
            } while (1)
            deloadfile([S412V])
            deloadfile([Si12G])
            deloadfile([Sis1T])
        }
        else if (type == 1) {
            CutsceneExtraTargetFade = 0
            loadfile([S612V])
            loadfile([Si12G])
            setanim(SIS_HEAD_1)
            do {
                animframe = creator -> pathprog - f << 8
                if (var0 || animframe > 254.0) {
                    break
                }
                playframe()
            } while (1)
            deloadfile([S602V])
            deloadfile([Si12G])
            setanim(SIS_HEAD_2)
            do {
                animframe = creator -> pathprog - (f + 0xFF) << 8
                if (var0 || animframe > 140.0) {
                    break
                }
                if (animframe >= 130.0) {
                    CutsceneExtraTargetFade = 16.0
                }
                playframe()
            } while (1)
            deloadfile([S612V])
            deloadfile([Si12G])
            deloadfile([Sis1T])
        }
        else if (type == 2) {
            CutsceneExtraTargetFade = 0
            setanim(SIS_HEAD_0)
            do {
                animframe = creator -> pathprog - f << 8
                if (var0 || animframe > 153.0) {
                    break
                }
                playframe()
            } while (1)
            deloadfile([S602V])
            deloadfile([Si12G])
            deloadfile([Sis1T])
        }
        else if (type == 3) {
            settrans(CrystalRotate)
            SetScale(0S)
            spawn(9, 47, 1, 0)
            SetColor2(-0xCCC, -0x800, 0x000)
            vfx = (vfx & 0xFFFFFF00) | 0xA
            vfx = (vfx & 0xFF00FFFF) | 0x40000
            moda = 4.0
            CutsceneExtraTargetFade = moda
            x = x + player -> x >> 1
            z = z + player -> z >> 1
            do (var start = frametime) {
                scalex = seek(scalex, 0.5S, 0.04S)
                scaley = seek(scaley, 0.5S, 0.04S)
                scalez = seek(scalez, 0.5S, 0.04S)
                playanim(0, CRYSTAL)
            } while (frametime - start < 4s)
            do (var start = frametime) {
                scalex = seek(scalex, 0S, 0.04S)
                scaley = seek(scaley, 0S, 0.04S)
                scalez = seek(scalez, 0S, 0.04S)
                playanim(0, CRYSTAL)
            } while (frametime - start < 0.5s)
        }
        exit:
    }
    event(e, a) {
        if (e == Event12) {
            accev()
            var0 = 1.0
        }
    }
    trans {
        roty = parent -> roty
        stalltime = parent -> stalltime
        vecy = parent -> vecy
        vecx = parent -> vecx
        moda = seek(moda, CutsceneExtraTargetFade, 1.925)
    }
}

sub CrystalRotate() {
    roty = spd(roty, 90deg)
    if (child) {
        child -> scalex = scalex
        child -> scaley = scaley
        child -> scalez = scalez
    }
}
